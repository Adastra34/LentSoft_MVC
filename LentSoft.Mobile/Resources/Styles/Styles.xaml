    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Lavender}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource PurpleDeep}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource White}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource White}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource Gray400}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource Gray300}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource White}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Purple}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Purple}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Muted}" />
    </Style>

    <!-- LentSoft Custom Design System Styles -->
    <Style x:Key="LentSoftCard" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
        <Setter Property="Stroke" Value="{StaticResource Line}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Card}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource Muted}" Offset="0,4" Radius="12" Opacity="0.08"/>
        </Setter>
    </Style>

    <Style x:Key="LentSoftCardHighlight" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
        <Setter Property="Stroke" Value="{StaticResource Purple}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Card}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource Purple}" Offset="0,4" Radius="14" Opacity="0.12"/>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Purple}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HeightRequest" Value="48"/>
    </Style>

    <Style x:Key="GoldButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Gold}"/>
        <Setter Property="TextColor" Value="{StaticResource Ink}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HeightRequest" Value="40"/>
    </Style>

    <Style x:Key="CoralButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Coral}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HeightRequest" Value="48"/>
    </Style>

    <Style x:Key="InputContainer" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="Stroke" Value="{StaticResource Line}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="HeightRequest" Value="50"/>
    </Style>

    <Style x:Key="CategoryChipActive" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Stroke" Value="{StaticResource Purple}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Purple}"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style x:Key="CategoryChipInactive" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Stroke" Value="{StaticResource Line}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>
</ResourceDictionary>
