<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LentSoft.Mobile.ViewModels"
             x:Class="LentSoft.Mobile.Views.InicioPage"
             x:DataType="vm:InicioViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Lavender}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadDataCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="0,0,0,30">

                <!-- Custom AppBar with Purple Gradient & Golden Radial Glow -->
                <Border HeightRequest="130"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0,0,24,24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Purple}" Offset="0.0"/>
                            <GradientStop Color="{StaticResource PurpleDeep}" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid Padding="20,16,20,16">
                        <!-- Golden Radial Glow in Top Right Corner -->
                        <Ellipse WidthRequest="130" HeightRequest="130"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 TranslationX="25" TranslationY="-30"
                                 Opacity="0.22">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                                    <GradientStop Color="{StaticResource Gold}" Offset="0.0"/>
                                    <GradientStop Color="Transparent" Offset="1.0"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Header Texts & Brand Motif -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding Greeting}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                                <Label Text="{Binding CurrentDate}"
                                       FontSize="13"
                                       TextColor="{StaticResource Line}"/>
                            </VerticalStackLayout>

                            <!-- Brand Lens Motif Icon -->
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 18"
                                    Stroke="{StaticResource Gold}"
                                    StrokeThickness="2"
                                    BackgroundColor="White"
                                    WidthRequest="48" HeightRequest="36"
                                    HorizontalOptions="End" VerticalOptions="Center">
                                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16" Fill="{StaticResource Purple}"/>
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="White" TranslationX="-2" TranslationY="-2"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="14" Padding="16,0,16,0">

                    <!-- TARJETA: Próxima Cita -->
                    <Border Style="{StaticResource LentSoftCardHighlight}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <!-- Lens badge icon -->
                                    <Border StrokeShape="RoundRectangle 10"
                                            Stroke="{StaticResource Purple}"
                                            StrokeThickness="1"
                                            BackgroundColor="{StaticResource PurpleLight}"
                                            WidthRequest="28" HeightRequest="22">
                                        <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource Purple}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="Próxima cita"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Purple}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <!-- Status Badge -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding ProximaCita.BadgeBackgroundColor}"
                                        Padding="10,4"
                                        IsVisible="{Binding HasProximaCita}">
                                    <Label Text="{Binding ProximaCita.Estado}"
                                           TextColor="{Binding ProximaCita.BadgeTextColor}"
                                           FontSize="11"
                                           FontAttributes="Bold"/>
                                </Border>
                            </Grid>

                            <!-- Cita Info o Placeholder -->
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding HasProximaCita}">
                                <Label Text="{Binding ProximaCita.Servicio}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}"/>
                                <Label Text="{Binding ProximaCita.DisplayFechaHora}"
                                       FontSize="13"
                                       TextColor="{StaticResource Muted}"/>
                                <Label Text="{Binding ProximaCita.OptometraNombre}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Purple}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4" IsVisible="{Binding NoProximaCita}">
                                <Label Text="No tienes citas agendadas"
                                       FontSize="14"
                                       TextColor="{StaticResource Muted}"/>
                                <Button Text="Agendar consulta"
                                        Command="{Binding GoToCitasCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HeightRequest="38"
                                        FontSize="13"
                                        Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- TARJETA: Última Factura -->
                    <Border Style="{StaticResource LentSoftCard}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Última factura"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}"
                                       VerticalOptions="Center"/>

                                <!-- Status Badge -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding UltimaFactura.BadgeBackgroundColor}"
                                        Padding="10,4"
                                        IsVisible="{Binding HasUltimaFactura}">
                                    <Label Text="{Binding UltimaFactura.Estado}"
                                           TextColor="{Binding UltimaFactura.BadgeTextColor}"
                                           FontSize="11"
                                           FontAttributes="Bold"/>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasUltimaFactura}">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding UltimaFactura.NumeroFactura}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Ink}"/>
                                    <Label Text="{Binding UltimaFactura.DisplayFecha}"
                                           FontSize="12"
                                           TextColor="{StaticResource Muted}"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="1"
                                       Text="{Binding UltimaFactura.DisplayTotal}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Purple}"
                                       VerticalOptions="Center"/>
                            </Grid>

                            <Label Text="No hay facturas registradas recientemente."
                                   FontSize="13"
                                   TextColor="{StaticResource Muted}"
                                   IsVisible="{Binding NoUltimaFactura}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- BANNER PROMOCIONAL: Morado con CTA Dorado "Ver tienda" -->
                    <Border StrokeShape="RoundRectangle 18"
                            StrokeThickness="0"
                            Padding="20"
                            Margin="0,4,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource PurpleDeep}" Offset="0.0"/>
                                <GradientStop Color="{StaticResource Purple}" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Border StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource Gold}"
                                        Padding="6,2"
                                        HorizontalOptions="Start">
                                    <Label Text="NUEVA COLECCIÓN"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Ink}"/>
                                </Border>

                                <Label Text="Monturas &amp; Lentes 2026"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"/>

                                <Label Text="Descubre las últimas tendencias en salud visual y estilo."
                                       FontSize="12"
                                       TextColor="{StaticResource Line}"/>
                            </VerticalStackLayout>

                            <!-- CTA Button Dorado -->
                            <Button Grid.Column="1"
                                    Text="Ver tienda"
                                    Command="{Binding GoToTiendaCommand}"
                                    Style="{StaticResource GoldButton}"
                                    VerticalOptions="Center"
                                    Padding="14,0"/>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
