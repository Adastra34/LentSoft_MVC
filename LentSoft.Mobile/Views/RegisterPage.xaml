<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LentSoft.Mobile.ViewModels"
             x:Class="LentSoft.Mobile.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Lavender}">

    <ScrollView>
        <Grid RowDefinitions="Auto,*" VerticalOptions="FillAndExpand">

            <!-- Header -->
            <Border Grid.Row="0"
                    HeightRequest="150"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 0,0,32,32">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Purple}" Offset="0.0"/>
                        <GradientStop Color="{StaticResource PurpleDeep}" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Padding="20">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                        <Label Text="Crear Cuenta"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="Únete a LentSoft en pocos segundos"
                               FontSize="13"
                               TextColor="{StaticResource Line}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Register Card Form -->
            <Border Grid.Row="1"
                    Style="{StaticResource LentSoftCard}"
                    Margin="20,-20,20,30"
                    Padding="20">
                <VerticalStackLayout Spacing="14">

                    <!-- Error Banner -->
                    <Border BackgroundColor="{StaticResource CoralLight}"
                            Stroke="{StaticResource Coral}"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,8"
                            IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Coral}"
                               FontSize="12"/>
                    </Border>

                    <!-- Nombre y Apellido en 2 columnas -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Nombre" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding Nombre}" Placeholder="Ej: Carlos" TextColor="{StaticResource Ink}"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Apellido" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding Apellido}" Placeholder="Ej: Pérez" TextColor="{StaticResource Ink}"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Documento -->
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Tipo Doc" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding TipoDocumento}" TextColor="{StaticResource Ink}"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Número de Documento" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Text="{Binding NumeroDocumento}" Placeholder="12345678" Keyboard="Numeric" TextColor="{StaticResource Ink}"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Teléfono -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Teléfono" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding Telefono}" Placeholder="300 123 4567" Keyboard="Telephone" TextColor="{StaticResource Ink}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Correo Electrónico" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding Email}" Placeholder="correo@ejemplo.com" Keyboard="Email" TextColor="{StaticResource Ink}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Contraseña" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding Password}" Placeholder="Mínimo 8 caracteres" IsPassword="True" TextColor="{StaticResource Ink}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Confirm Password -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Confirmar Contraseña" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding ConfirmPassword}" Placeholder="Repite tu contraseña" IsPassword="True" TextColor="{StaticResource Ink}"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Submit Button -->
                    <Button Text="Crear cuenta"
                            Command="{Binding RegisterCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,10,0,0"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Purple}"
                                       HorizontalOptions="Center"/>

                    <!-- Back to Login -->
                    <Button Text="¿Ya tienes cuenta? Inicia sesión"
                            Command="{Binding BackToLoginCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Purple}"
                            FontSize="13"
                            HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>

</ContentPage>
