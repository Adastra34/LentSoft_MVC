<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LentSoft.Mobile.ViewModels"
             xmlns:models="clr-namespace:LentSoft.Mobile.Models"
             x:Class="LentSoft.Mobile.Views.FacturasPage"
             x:DataType="vm:FacturasViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Lavender}, Dark={StaticResource DarkPageBg}}">

    <Grid RowDefinitions="Auto,*" VerticalOptions="FillAndExpand">

        <!-- Custom AppBar with Purple Gradient & Golden Glow -->
        <Border Grid.Row="0"
                HeightRequest="100"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,24,24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Purple}" Offset="0.0"/>
                    <GradientStop Color="{StaticResource PurpleDeep}" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Padding="20,16">
                <!-- Radial Glow decoration -->
                <Ellipse WidthRequest="100" HeightRequest="100"
                         HorizontalOptions="End" VerticalOptions="Start"
                         TranslationX="20" TranslationY="-20"
                         Opacity="0.2">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                            <GradientStop Color="{StaticResource Gold}" Offset="0.0"/>
                            <GradientStop Color="Transparent" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label Text="Mis Facturas"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Comprobantes y recibos de pago"
                           FontSize="13"
                           TextColor="{StaticResource Line}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Invoice List -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadInvoicesCommand}">
            <CollectionView ItemsSource="{Binding Invoices}"
                             Margin="16,16,16,16">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:InvoiceDto">
                        <Border Style="{StaticResource LentSoftCard}"
                                Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FacturasViewModel}}, Path=InvoiceSelectedCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                                <!-- Document icon with lens touch -->
                                <Border Grid.Column="0"
                                        WidthRequest="46" HeightRequest="46"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource PurpleLight}"
                                        Stroke="{StaticResource Purple}"
                                        StrokeThickness="1"
                                        VerticalOptions="Center">
                                    <Label Text="📄"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <!-- Number & Date -->
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding NumeroFactura}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark=White}"/>
                                    <Label Text="{Binding DisplayFecha}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark=#AAAAAA}"/>
                                    <Label Text="{Binding DisplayTotal}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Purple}"/>
                                </VerticalStackLayout>

                                <!-- Status Badge (Green: Pagada, Amber: Pendiente) -->
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding BadgeBackgroundColor}"
                                        Padding="12,6"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Estado}"
                                           TextColor="{Binding BadgeTextColor}"
                                           FontSize="11"
                                           FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
                        <Label Text="🧾" FontSize="44" HorizontalOptions="Center"/>
                        <Label Text="Sin facturas registradas"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark=White}"
                               HorizontalOptions="Center"/>
                        <Label Text="Cuando realices compras o pagos, tus facturas aparecerán aquí."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark=#AAAAAA}"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- Detailed Invoice Receipt Modal Card -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsDetailModalVisible}"
              BackgroundColor="#80000000"
              Padding="16,20">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseDetailModalCommand}"/>
            </Grid.GestureRecognizers>

            <Border BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkModalBg}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkModalBorder}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Margin="0"
                    Padding="18"
                    VerticalOptions="Center"
                    BindingContext="{Binding SelectedInvoice}"
                    x:DataType="models:InvoiceDto">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer/>
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="12">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="🧾" FontSize="22" VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="{Binding NumeroFactura}" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Purple}, Dark=#A78BFA}"/>
                                <Label Text="LentSoft Óptica S.A.S. - NIT 901.458.921-3" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource DarkMutedText}}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Button Grid.Column="1"
                                Text="✕"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FacturasViewModel}}, Path=CloseDetailModalCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Lavender}, Dark={StaticResource DarkInnerBoxBg}}"
                                TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark=White}"
                                CornerRadius="14"
                                WidthRequest="32" HeightRequest="32"
                                Padding="0" FontSize="14"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLineColor}}"/>

                    <!-- Invoice Body Info Card -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Lavender}, Dark={StaticResource DarkInnerBoxBg}}"
                            StrokeThickness="1"
                            Stroke="{StaticResource Purple}"
                            StrokeShape="RoundRectangle 14"
                            Padding="14">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Fecha de Emisión:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark=White}"/>
                                <Label Grid.Column="1" Text="{Binding DisplayFecha}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark=#AAAAAA}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Estado de Pago:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark=White}"/>
                                <Border Grid.Column="1" BackgroundColor="{Binding BadgeBackgroundColor}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2">
                                    <Label Text="{Binding Estado}" FontSize="10" FontAttributes="Bold" TextColor="{Binding BadgeTextColor}"/>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Método de Pago:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark=White}"/>
                                <Label Grid.Column="1" Text="{Binding MetodoPago}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark=#AAAAAA}"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,4"/>

                            <!-- Purchased Items Breakdown -->
                            <Label Text="Detalle de la Compra:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Purple}"/>
                            <Label Text="{Binding ItemsSummary}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark=White}"/>

                            <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,4"/>

                            <!-- Math breakdown -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Subtotal (Sin IVA):" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark=#AAAAAA}"/>
                                <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:N0} COP'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark=White}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Impuestos (IVA 19%):" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark=#AAAAAA}"/>
                                <Label Grid.Column="1" Text="{Binding Impuestos, StringFormat='${0:N0} COP'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark=White}"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Line}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Total Facturado:" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark=White}"/>
                                <Label Grid.Column="1" Text="{Binding DisplayTotal}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Purple}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Cerrar Factura"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FacturasViewModel}}, Path=CloseDetailModalCommand}"
                            BackgroundColor="{StaticResource Purple}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="44"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
