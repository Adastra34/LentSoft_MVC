<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LentSoft.Mobile.ViewModels"
             xmlns:models="clr-namespace:LentSoft.Mobile.Models"
             x:Class="LentSoft.Mobile.Views.TiendaPage"
             x:DataType="vm:TiendaViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Lavender}">

    <Grid RowDefinitions="Auto,Auto,*" VerticalOptions="FillAndExpand">

        <!-- Custom AppBar with Search Field -->
        <Border Grid.Row="0"
                HeightRequest="120"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,24,24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Purple}" Offset="0.0"/>
                    <GradientStop Color="{StaticResource PurpleDeep}" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Padding="16,12,16,12" VerticalOptions="Center">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tienda Óptica"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <!-- Search Input Bar -->
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="White"
                            HeightRequest="42"
                            Padding="12,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding SearchText}"
                                   Placeholder="Buscar monturas, lentes..."
                                   PlaceholderColor="{StaticResource Muted}"
                                   TextColor="{StaticResource Ink}"
                                   FontSize="13"
                                   ReturnCommand="{Binding SearchCommand}"
                                   VerticalOptions="Center"/>
                            <Button Grid.Column="1"
                                    Text="🔍"
                                    Command="{Binding SearchCommand}"
                                    BackgroundColor="Transparent"
                                    FontSize="14"
                                    Padding="0"
                                    WidthRequest="30"
                                    HeightRequest="30"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Horizontal Category Chips -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Padding="16,12,16,8">
            <HorizontalStackLayout Spacing="8">
                <!-- Chip Todas -->
                <Button Text="Todas"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="Todas"
                        BackgroundColor="{StaticResource Purple}"
                        TextColor="White"
                        CornerRadius="16"
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="36"
                        Padding="14,0"/>

                <!-- Chip Monturas -->
                <Button Text="Monturas"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="Monturas"
                        BackgroundColor="White"
                        TextColor="{StaticResource Ink}"
                        BorderColor="{StaticResource Line}"
                        BorderWidth="1"
                        CornerRadius="16"
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="36"
                        Padding="14,0"/>

                <!-- Chip Contacto -->
                <Button Text="Contacto"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="Contacto"
                        BackgroundColor="White"
                        TextColor="{StaticResource Ink}"
                        BorderColor="{StaticResource Line}"
                        BorderWidth="1"
                        CornerRadius="16"
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="36"
                        Padding="14,0"/>

                <!-- Chip Sol -->
                <Button Text="Sol"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="Sol"
                        BackgroundColor="White"
                        TextColor="{StaticResource Ink}"
                        BorderColor="{StaticResource Line}"
                        BorderWidth="1"
                        CornerRadius="16"
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="36"
                        Padding="14,0"/>

                <!-- Chip Accesorios -->
                <Button Text="Accesorios"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="Accesorios"
                        BackgroundColor="White"
                        TextColor="{StaticResource Ink}"
                        BorderColor="{StaticResource Line}"
                        BorderWidth="1"
                        CornerRadius="16"
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="36"
                        Padding="14,0"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Product Grid: 2 Columns -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadProductsCommand}">
            <CollectionView ItemsSource="{Binding Products}"
                            Margin="12,4,12,12">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProductDto">
                        <Border Style="{StaticResource LentSoftCard}"
                                Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TiendaViewModel}}, Path=ProductSelectedCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="8">
                                <!-- Image with Lens Badge decoration -->
                                <Border HeightRequest="110"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource Lavender}"
                                        StrokeThickness="0">
                                    <Grid>
                                        <Image Source="{Binding SafeImageUrl}"
                                               Aspect="AspectFit"
                                               Margin="8"/>

                                        <!-- Brand Lens badge top right -->
                                        <Border WidthRequest="22" HeightRequest="16"
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="{StaticResource Purple}"
                                                StrokeThickness="1"
                                                BackgroundColor="White"
                                                HorizontalOptions="End" VerticalOptions="Start"
                                                Margin="6">
                                            <Ellipse WidthRequest="6" HeightRequest="6" Fill="{StaticResource Purple}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Discount Badge -->
                                        <Border BackgroundColor="{StaticResource Gold}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="4,2"
                                                HorizontalOptions="Start" VerticalOptions="Start"
                                                Margin="6"
                                                IsVisible="{Binding HasDiscount}">
                                            <Label Text="{Binding DescuentoPorcentaje, StringFormat='-{0}%'}"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Ink}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Brand -->
                                <Label Text="{Binding Marca}"
                                       FontSize="11"
                                       TextColor="{StaticResource Muted}"
                                       TextTransform="Uppercase"
                                       FontAttributes="Bold"/>

                                <!-- Product Name -->
                                <Label Text="{Binding Nombre}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       HeightRequest="36"/>

                                <!-- Price COP -->
                                <Label Text="{Binding DisplayPrice}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Purple}"/>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
                        <Label Text="👓" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="No se encontraron productos"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Ink}"
                               HorizontalOptions="Center"/>
                        <Label Text="Prueba con otra categoría o búsqueda."
                               FontSize="13"
                               TextColor="{StaticResource Muted}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
