@model LentSoft.Web.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Finalizar Compra";
    var cartItems = Model.Cart?.CartItems.ToList() ?? new List<CartItem>();
    var totalGeneral = cartItems.Sum(ci => ci.Subtotal);
}

<main style="padding: 2.5rem 0; min-height: 80vh; background: var(--purple-50); font-family: var(--font-secondary);">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
        
        <nav aria-label="breadcrumb" style="margin-bottom: 2rem; font-size: 0.9rem;">
            <ol style="display: flex; list-style: none; padding: 0; margin: 0; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                <li><a asp-controller="Home" asp-action="Index" style="color: var(--purple-600); font-weight: 500;">Inicio</a></li>
                <li style="color: var(--gray-400); font-size: 0.8rem;">/</li>
                <li><a asp-controller="Cart" asp-action="Index" style="color: var(--purple-600); font-weight: 500;">Carrito</a></li>
                <li style="color: var(--gray-400); font-size: 0.8rem;">/</li>
                <li style="color: var(--gray-600); font-weight: 600;">Checkout</li>
            </ol>
        </nav>

        <h1 style="color: var(--purple-900); font-size: 2rem; font-weight: 800; font-family: var(--font-primary); margin-bottom: 2rem;">
            Finalizar Compra (Pago Simulado)
        </h1>

        <div style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: start;">
            
            <!-- Left: Simulated Payment Form -->
            <div style="background: white; border-radius: 1.25rem; padding: 2rem; box-shadow: var(--shadow-md); border: 1px solid var(--gray-100);">
                <h3 style="color: var(--purple-900); font-family: var(--font-primary); font-size: 1.25rem; font-weight: 700; margin: 0 0 1.5rem 0; border-bottom: 1.5px solid var(--gray-100); padding-bottom: 0.75rem;">
                    Método de Pago Simulado
                </h3>

                <form asp-action="ConfirmarPago" method="post" style="display: flex; flex-direction: column; gap: 1.25rem;">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" style="color: var(--error); font-size: 0.85rem;"></div>

                    <!-- Card Number -->
                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label asp-for="NumeroTarjeta" style="font-weight: 600; font-size: 0.85rem; color: var(--gray-700);">Número de Tarjeta</label>
                        <input asp-for="NumeroTarjeta" placeholder="0000 0000 0000 0000" maxlength="19" style="border-radius: 0.5rem; padding: 0.65rem 1rem; border: 1.5px solid var(--gray-200); font-size: 0.9rem; width: 100%; outline: none;" onfocus="this.style.borderColor='var(--purple-400)'" onblur="this.style.borderColor='var(--gray-200)'" />
                        <span asp-validation-for="NumeroTarjeta" style="color: var(--error); font-size: 0.75rem;"></span>
                    </div>

                    <!-- Card Holder Name -->
                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label asp-for="NombreTarjeta" style="font-weight: 600; font-size: 0.85rem; color: var(--gray-700);">Nombre en la Tarjeta</label>
                        <input asp-for="NombreTarjeta" placeholder="Ej. Juan Pérez" style="border-radius: 0.5rem; padding: 0.65rem 1rem; border: 1.5px solid var(--gray-200); font-size: 0.9rem; width: 100%; outline: none;" onfocus="this.style.borderColor='var(--purple-400)'" onblur="this.style.borderColor='var(--gray-200)'" />
                        <span asp-validation-for="NombreTarjeta" style="color: var(--error); font-size: 0.75rem;"></span>
                    </div>

                    <!-- Expiration & CVV -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                            <label asp-for="Expiracion" style="font-weight: 600; font-size: 0.85rem; color: var(--gray-700);">Fecha de Expiración</label>
                            <input asp-for="Expiracion" placeholder="MM/AA" maxlength="5" style="border-radius: 0.5rem; padding: 0.65rem 1rem; border: 1.5px solid var(--gray-200); font-size: 0.9rem; width: 100%; outline: none;" onfocus="this.style.borderColor='var(--purple-400)'" onblur="this.style.borderColor='var(--gray-200)'" />
                            <span asp-validation-for="Expiracion" style="color: var(--error); font-size: 0.75rem;"></span>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                            <label asp-for="Cvv" style="font-weight: 600; font-size: 0.85rem; color: var(--gray-700);">CVV</label>
                            <input asp-for="Cvv" type="password" placeholder="123" maxlength="4" style="border-radius: 0.5rem; padding: 0.65rem 1rem; border: 1.5px solid var(--gray-200); font-size: 0.9rem; width: 100%; outline: none;" onfocus="this.style.borderColor='var(--purple-400)'" onblur="this.style.borderColor='var(--gray-200)'" />
                            <span asp-validation-for="Cvv" style="color: var(--error); font-size: 0.75rem;"></span>
                        </div>
                    </div>

                    <!-- Shipping Address -->
                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label asp-for="DireccionEnvio" style="font-weight: 600; font-size: 0.85rem; color: var(--gray-700);">Dirección de Envío</label>
                        <textarea asp-for="DireccionEnvio" rows="3" placeholder="Ingresa tu dirección completa de entrega" style="border-radius: 0.5rem; padding: 0.65rem 1rem; border: 1.5px solid var(--gray-200); font-size: 0.9rem; width: 100%; outline: none; resize: vertical;" onfocus="this.style.borderColor='var(--purple-400)'" onblur="this.style.borderColor='var(--gray-200)'"></textarea>
                        <span asp-validation-for="DireccionEnvio" style="color: var(--error); font-size: 0.75rem;"></span>
                    </div>

                    <div style="background: var(--purple-50); border: 1px solid var(--purple-200); border-radius: 0.75rem; padding: 1rem; margin-top: 0.5rem; display: flex; align-items: center; gap: 0.75rem;">
                        <span style="font-size: 1.5rem;">🔒</span>
                        <p style="font-size: 0.75rem; color: var(--purple-800); margin: 0; line-height: 1.3;">
                            <strong>Entorno Seguro de Simulación:</strong> Las transacciones bancarias son simuladas internamente. Ningún dato real de tarjeta de crédito será enviado a procesadores externos ni validado contra instituciones bancarias.
                        </p>
                    </div>

                    <button type="submit" class="btn" style="width: 100%; background: linear-gradient(135deg, var(--purple-600), var(--purple-800)); color: white; border: none; border-radius: 0.75rem; padding: 0.9rem; font-size: 1rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: transform 0.2s; box-shadow: 0 4px 12px rgba(124,58,237,0.3); margin-top: 0.5rem;"
                            onmouseover="this.style.transform='translateY(-2px)'"
                            onmouseout="this.style.transform='translateY(0)'">
                        Confirmar Pago 💳
                    </button>
                </form>
            </div>

            <!-- Right: Order Summary Box -->
            <div style="background: white; border-radius: 1.25rem; padding: 2rem; box-shadow: var(--shadow-md); border: 1px solid var(--gray-100);">
                <h3 style="color: var(--purple-900); font-family: var(--font-primary); font-size: 1.25rem; font-weight: 700; margin: 0 0 1.5rem 0; border-bottom: 1.5px solid var(--gray-100); padding-bottom: 0.75rem;">
                    Resumen del Pedido
                </h3>

                <!-- Items list -->
                <div style="display: flex; flex-direction: column; gap: 1rem; max-height: 250px; overflow-y: auto; padding-right: 0.5rem; margin-bottom: 1.5rem;">
                    @foreach (var item in cartItems)
                    {
                        <div style="display: flex; align-items: center; gap: 1rem; justify-content: space-between;">
                            <div style="display: flex; align-items: center; gap: 0.75rem; flex: 1;">
                                <div style="width: 45px; height: 45px; background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: 0.35rem; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;">
                                    @if (item.Product.ImagenUrl != null)
                                    {
                                        <img src="@item.Product.ImagenUrl" alt="@item.Product.Nombre" style="max-width: 100%; max-height: 100%; object-fit: contain; padding: 0.15rem;" />
                                    }
                                    else
                                    {
                                        <span style="font-size: 1rem;">👓</span>
                                    }
                                </div>
                                <div style="display: flex; flex-direction: column; gap: 0.1rem; flex: 1;">
                                    <span style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; line-height: 1.2; font-family: var(--font-primary);">
                                        @item.Product.Nombre
                                    </span>
                                    <span style="color: var(--gray-400); font-size: 0.75rem;">Cantidad: @item.Cantidad</span>
                                </div>
                            </div>
                            <span style="font-weight: 700; color: var(--purple-700); font-size: 0.85rem; text-wrap: nowrap;">
                                @item.Subtotal.ToString("C")
                            </span>
                        </div>
                    }
                </div>

                <div style="border-top: 1.5px solid var(--gray-100); padding-top: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.9rem;">
                    <div style="display: flex; justify-content: space-between; color: var(--gray-600);">
                        <span>Subtotal</span>
                        <span style="font-weight: 600;">@totalGeneral.ToString("C")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; color: var(--gray-600);">
                        <span>Envío</span>
                        <span style="color: var(--success); font-weight: 700;">Gratis</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-top: 1.5px solid var(--gray-100); padding-top: 1rem; margin-top: 0.5rem;">
                        <strong style="color: var(--purple-900); font-size: 1.1rem; font-family: var(--font-primary);">Total a Pagar</strong>
                        <strong style="color: var(--purple-700); font-size: 1.25rem;">@totalGeneral.ToString("C")</strong>
                    </div>
                </div>
            </div>

        </div>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Simple automatic card number space formatting for UX
        const cardInput = document.querySelector('input[name="NumeroTarjeta"]');
        if (cardInput) {
            cardInput.addEventListener('input', (e) => {
                let val = e.target.value.replace(/\s+/g, '').replace(/[^0-9]/gi, '');
                let matches = val.match(/\d{4,16}/g);
                let match = matches && matches[0] || '';
                let parts = [];

                for (let i = 0, len = match.length; i < len; i += 4) {
                    parts.push(match.substring(i, i + 4));
                }

                if (parts.length > 0) {
                    e.target.value = parts.join(' ');
                } else {
                    e.target.value = val;
                }
            });
        }

        // Expiration MM/AA autocompletion
        const expInput = document.querySelector('input[name="Expiracion"]');
        if (expInput) {
            expInput.addEventListener('input', (e) => {
                let val = e.target.value.replace(/[^0-9]/g, '');
                if (val.length >= 2) {
                    e.target.value = val.substring(0, 2) + '/' + val.substring(2, 4);
                } else {
                    e.target.value = val;
                }
            });
        }
    </script>
}
