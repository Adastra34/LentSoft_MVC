@model LentSoft.Web.Models.Entities.Order
@{
    ViewData["Title"] = "Pago Confirmado";
}

<main style="padding: 3rem 0; min-height: 80vh; background: var(--purple-50); font-family: var(--font-secondary); display: flex; align-items: center;">
    <div class="container" style="max-width: 650px; margin: 0 auto; padding: 0 1.5rem; width: 100%;">
        
        <div style="background: white; border-radius: 1.5rem; padding: 2.5rem; box-shadow: var(--shadow-xl); border: 1px solid var(--gray-100); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem;">
            
            <!-- Success Icon -->
            <div style="width: 80px; height: 80px; border-radius: 50%; background: #DCFCE7; display: flex; align-items: center; justify-content: center; font-size: 3rem; color: var(--success); box-shadow: 0 4px 10px rgba(34, 197, 94, 0.2); animation: scaleIn 0.5s ease-out;">
                ✓
            </div>

            <!-- Title & Subtitle -->
            <div>
                <h1 style="color: var(--purple-900); font-size: 1.75rem; font-weight: 800; font-family: var(--font-primary); margin-bottom: 0.5rem;">
                    ¡Pago simulado exitosamente!
                </h1>
                <p style="color: var(--gray-500); font-size: 0.95rem; margin: 0; max-width: 420px; margin-left: auto; margin-right: auto;">
                    Tu pedido ha sido procesado de forma simulada. A continuación se detallan los datos de tu orden de compra.
                </p>
            </div>

            <!-- Order info card -->
            <div style="background: var(--purple-50); border: 1.5px solid var(--purple-100); border-radius: 1rem; width: 100%; padding: 1.25rem; text-align: left; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.9rem;">
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--purple-200); padding-bottom: 0.5rem;">
                    <span style="color: var(--purple-800); font-weight: 700;">Número de Orden</span>
                    <strong style="color: var(--purple-900);">#@Model.Id</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: var(--gray-500);">Fecha del pedido</span>
                    <span style="color: var(--gray-800); font-weight: 500;">@Model.FechaPedido.ToLocalTime().ToString("g")</span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: var(--gray-500);">Método de pago</span>
                    <span style="color: var(--gray-800); font-weight: 500;">@(Model.MetodoPagoSimulado ?? "Tarjeta simulada")</span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: var(--gray-500);">Estado</span>
                    <span style="background: var(--success); color: white; font-size: 0.75rem; font-weight: 700; padding: 0.15rem 0.65rem; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.5px;">
                        @Model.Estado
                    </span>
                </div>
            </div>

            <!-- Items Purchased -->
            <div style="width: 100%; text-align: left;">
                <h4 style="color: var(--purple-900); font-family: var(--font-primary); font-size: 1rem; font-weight: 700; margin: 0 0 1rem 0; border-bottom: 1.5px solid var(--gray-100); padding-bottom: 0.5rem;">
                    Artículos Adquiridos
                </h4>
                
                <div style="display: flex; flex-direction: column; gap: 0.75rem; max-height: 180px; overflow-y: auto; padding-right: 0.25rem;">
                    @foreach (var item in Model.OrderItems)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
                            <span style="color: var(--gray-700); font-weight: 600;">
                                @item.Product.Nombre <span style="color: var(--gray-400); font-weight: 400; margin-left: 0.25rem;">x @item.Cantidad</span>
                            </span>
                            <span style="font-weight: 700; color: var(--purple-700);">
                                @item.Subtotal.ToString("C")
                            </span>
                        </div>
                    }
                </div>

                <div style="display: flex; justify-content: space-between; border-top: 1.5px solid var(--gray-100); padding-top: 1rem; margin-top: 1rem; font-size: 1rem;">
                    <strong style="color: var(--purple-900);">Total Pagado</strong>
                    <strong style="color: var(--purple-700); font-size: 1.15rem;">@Model.Total.ToString("C")</strong>
                </div>
            </div>

            <!-- Go back button -->
            <a asp-controller="Product" asp-action="Tienda" class="btn" style="width: 100%; background: linear-gradient(135deg, var(--purple-600), var(--purple-800)); color: white; border: none; border-radius: 0.75rem; padding: 0.9rem; font-size: 1rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: transform 0.2s; box-shadow: 0 4px 12px rgba(124,58,237,0.3); text-decoration: none;"
               onmouseover="this.style.transform='translateY(-2px)'"
               onmouseout="this.style.transform='translateY(0)'">
                Volver a la Tienda 👓
            </a>
            
        </div>

    </div>
</main>

<style>
    @@keyframes scaleIn {
        from { transform: scale(0.5); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
</style>
