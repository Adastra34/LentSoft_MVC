@model MisFacturasListaViewModel

@if (Model.Facturas == null || Model.Facturas.Count == 0)
{
    <div style="text-align: center; padding: 3rem 1rem; background-color: var(--purple-50); border-radius: 0.75rem; border: 1px dashed var(--purple-200);">
        <icon name="file-text" class="icon-xl" style="width: 2.5rem; height: 2.5rem; display: block; margin: 0 auto 0.5rem auto; color: var(--purple-400);" />
        <p style="color: var(--gray-600); margin: 0 0 1rem 0; font-size: 1rem;">Aún no tienes facturas electrónicas registradas.</p>
        <a asp-controller="Product" asp-action="Tienda" class="btn btn-primary" style="background: var(--purple-600); color: white; text-decoration: none; padding: 0.6rem 1.25rem; border-radius: 0.375rem; display: inline-block; font-weight: 600;">
            Ir a la Tienda
        </a>
    </div>
}
else
{
    <div style="background-color: white; border: 1px solid var(--purple-200); border-radius: 0.75rem; overflow: hidden; box-shadow: 0 4px 12px rgba(124,58,237,0.05);">
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                <thead>
                    <tr style="background-color: var(--purple-900); color: white;">
                        <th style="padding: 0.85rem 1rem; font-weight: 700;">N° Factura</th>
                        <th style="padding: 0.85rem 1rem; font-weight: 700;">Pedido</th>
                        <th style="padding: 0.85rem 1rem; font-weight: 700;">Fecha Emisión</th>
                        <th style="padding: 0.85rem 1rem; font-weight: 700;">Estado</th>
                        <th style="padding: 0.85rem 1rem; font-weight: 700; text-align: right;">Total</th>
                        <th style="padding: 0.85rem 1rem; font-weight: 700; text-align: center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fac in Model.Facturas)
                    {
                        var estadoLower = fac.Estado?.ToLowerInvariant() ?? "pendiente";
                        var badgeStyle = estadoLower switch
                        {
                            "pagada" => "background:#dcfce7; color:#15803d; border:1px solid #bbf7d0;",
                            "parcial" => "background:#fef3c7; color:#92400e; border:1px solid #fde68a;",
                            "cancelada" => "background:#fee2e2; color:#b91c1c; border:1px solid #fecaca;",
                            _ => "background:#f3e8ff; color:#6b21a8; border:1px solid #e9d5ff;"
                        };

                        <tr style="border-bottom: 1px solid var(--purple-100);">
                            <td style="padding: 0.85rem 1rem; font-weight: 700; color: var(--purple-900);">
                                @fac.NumeroFactura
                            </td>
                            <td style="padding: 0.85rem 1rem; color: var(--gray-700); font-weight: 600;">
                                #ORD-@fac.OrderId.ToString("D4")
                            </td>
                            <td style="padding: 0.85rem 1rem; color: var(--gray-700);">
                                @fac.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td style="padding: 0.85rem 1rem;">
                                <span style="@badgeStyle padding: 0.25rem 0.65rem; border-radius: 9999px; font-weight: 600; font-size: 0.78rem; display: inline-block; text-transform: capitalize;">
                                    @fac.Estado
                                </span>
                            </td>
                            <td style="padding: 0.85rem 1rem; text-align: right; font-weight: 700; color: var(--purple-800);">
                                @fac.Total.ToString("C")
                            </td>
                            <td style="padding: 0.85rem 1rem; text-align: center;">
                                <div style="display: inline-flex; gap: 0.5rem; align-items: center; justify-content: center;">
                                    <button type="button"
                                            onclick="abrirDetalleFactura(@fac.Id)"
                                            style="background: var(--purple-100); color: var(--purple-800); border: 1px solid var(--purple-300); padding: 0.35rem 0.75rem; border-radius: 0.375rem; font-size: 0.82rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.3rem;">
                                        <icon name="eye" class="icon-sm" /> <span>Ver</span>
                                    </button>
                                    <a href="/MisFacturas/Descargar/@fac.Id"
                                       style="background: var(--purple-600); color: white; border: none; padding: 0.35rem 0.75rem; border-radius: 0.375rem; font-size: 0.82rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem;">
                                        <icon name="file-text" class="icon-sm" /> <span>Descargar PDF</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{
            var startRecord = ((Model.Page - 1) * Model.PageSize) + 1;
            var endRecord = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
        }
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.9rem 1rem; background-color: var(--purple-50); border-top: 1px solid var(--purple-100); flex-wrap: wrap; gap: 0.5rem; font-size: 0.85rem; color: var(--gray-700);">
            <div>
                Mostrando facturas del <strong>@startRecord</strong> al <strong>@endRecord</strong> de un total de <strong>@Model.TotalCount</strong>
            </div>
            @if (Model.TotalPages > 1)
            {
                <div style="display: flex; gap: 0.3rem; flex-wrap: wrap;">
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <button type="button"
                                onclick="cargarMisFacturas(@p, @Model.PageSize)"
                                style="padding: 0.3rem 0.7rem; border-radius: 0.25rem; border: none; cursor: pointer; font-weight: 600; font-size: 0.82rem; color: @(p == Model.Page ? "white" : "var(--purple-800)"); background-color: @(p == Model.Page ? "var(--purple-600)" : "white"); box-shadow: 0 1px 2px rgba(0,0,0,0.06);">
                            @p
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}
