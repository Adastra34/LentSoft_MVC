@model FacturaDetalleViewModel

@{
    var estadoLower = Model.Estado?.ToLowerInvariant() ?? "pendiente";
    var badgeStyle = estadoLower switch
    {
        "pagada" => "background:#dcfce7; color:#15803d; border:1px solid #bbf7d0;",
        "parcial" => "background:#fef3c7; color:#92400e; border:1px solid #fde68a;",
        "cancelada" => "background:#fee2e2; color:#b91c1c; border:1px solid #fecaca;",
        _ => "background:#f3e8ff; color:#6b21a8; border:1px solid #e9d5ff;"
    };
}

<div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--purple-100); background-color: var(--purple-900); color: white; border-top-left-radius: 0.75rem; border-top-right-radius: 0.75rem;">
    <div>
        <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--purple-200); display: block;">
            Factura Electrónica de Venta (DIAN)
        </span>
        <h3 style="margin: 0.2rem 0 0 0; font-size: 1.25rem; font-weight: 800; color: white;">
            @Model.NumeroFactura
        </h3>
    </div>
    <button type="button"
            onclick="cerrarDetalleFactura()"
            aria-label="Cerrar"
            style="background: rgba(255,255,255,0.15); border: none; color: white; width: 32px; height: 32px; border-radius: 50%; font-size: 1.25rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;">
        &times;
    </button>
</div>

<div style="padding: 1.5rem; max-height: 75vh; overflow-y: auto; display: flex; flex-direction: column; gap: 1.15rem;">
    <!-- Resumen general -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; background-color: var(--purple-50); border: 1px solid var(--purple-200); border-radius: 0.6rem; padding: 0.9rem 1rem;">
        <div style="font-size: 0.875rem; color: var(--gray-700);">
            <div><strong>Pedido:</strong> #ORD-@Model.OrderId.ToString("D4")</div>
            <div><strong>Fecha Emisión:</strong> @Model.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            @if (Model.FechaPago.HasValue)
            {
                <div><strong>Fecha Pago:</strong> @Model.FechaPago.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.MetodoPago))
            {
                <div><strong>Medio de Pago:</strong> @Model.MetodoPago</div>
            }
        </div>
        <div>
            <span style="@badgeStyle padding: 0.35rem 0.85rem; border-radius: 9999px; font-weight: 700; font-size: 0.85rem; text-transform: uppercase;">
                @Model.Estado
            </span>
        </div>
    </div>

    <!-- Datos del Cliente -->
    <div style="border: 1px solid var(--purple-100); border-radius: 0.6rem; padding: 0.9rem 1rem;">
        <h4 style="margin: 0 0 0.5rem 0; font-size: 0.9rem; font-weight: 700; color: var(--purple-900);">
            Datos del Adquiriente (Cliente)
        </h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.4rem 1rem; font-size: 0.85rem; color: var(--gray-700);">
            <div><strong>Nombre:</strong> @Model.ClienteNombre</div>
            <div><strong>Documento:</strong> @(string.IsNullOrWhiteSpace(Model.ClienteDocumento) ? "N/A" : Model.ClienteDocumento)</div>
            @if (!string.IsNullOrWhiteSpace(Model.ClienteEmail))
            {
                <div><strong>Correo:</strong> @Model.ClienteEmail</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ClienteTelefono))
            {
                <div><strong>Teléfono:</strong> @Model.ClienteTelefono</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.DireccionEnvio))
            {
                <div style="grid-column: 1 / -1;"><strong>Dirección de Entrega:</strong> @Model.DireccionEnvio</div>
            }
        </div>
    </div>

    <!-- Ítems con IVA discriminado -->
    <div>
        <h4 style="margin: 0 0 0.5rem 0; font-size: 0.9rem; font-weight: 700; color: var(--purple-900);">
            Detalle de Productos y Servicios
        </h4>
        <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-radius: 0.5rem;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
                <thead>
                    <tr style="background-color: var(--purple-100); color: var(--purple-900);">
                        <th style="padding: 0.6rem 0.75rem; text-align: left;">Producto</th>
                        <th style="padding: 0.6rem 0.75rem; text-align: center;">Cant.</th>
                        <th style="padding: 0.6rem 0.75rem; text-align: right;">Base Unit.</th>
                        <th style="padding: 0.6rem 0.75rem; text-align: right;">IVA</th>
                        <th style="padding: 0.6rem 0.75rem; text-align: right;">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Count > 0)
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr style="border-top: 1px solid var(--purple-100);">
                                <td style="padding: 0.6rem 0.75rem; font-weight: 600; color: var(--purple-900);">@item.ProductoNombre</td>
                                <td style="padding: 0.6rem 0.75rem; text-align: center;">@item.Cantidad</td>
                                <td style="padding: 0.6rem 0.75rem; text-align: right;">@item.PrecioUnitarioBase.ToString("C")</td>
                                <td style="padding: 0.6rem 0.75rem; text-align: right;">(@item.PorcentajeIva.ToString("0.#")%) @item.ValorIva.ToString("C")</td>
                                <td style="padding: 0.6rem 0.75rem; text-align: right; font-weight: 700; color: var(--purple-800);">@item.Subtotal.ToString("C")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr style="border-top: 1px solid var(--purple-100);">
                            <td colspan="5" style="padding: 0.75rem; text-align: center; color: var(--gray-600);">
                                Productos ópticos según orden #ORD-@Model.OrderId.ToString("D4")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Totales -->
    <div style="display: flex; justify-content: flex-end;">
        <div style="min-width: 260px; background-color: var(--purple-50); border: 1px solid var(--purple-200); border-radius: 0.5rem; padding: 0.85rem 1rem; font-size: 0.88rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                <span style="color: var(--gray-700);">Subtotal Gravado:</span>
                <strong>@Model.Subtotal.ToString("C")</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.45rem;">
                <span style="color: var(--gray-700);">Impuestos (IVA):</span>
                <strong>@Model.Impuestos.ToString("C")</strong>
            </div>
            <div style="display: flex; justify-content: space-between; padding-top: 0.45rem; border-top: 1px solid var(--purple-200); font-size: 1rem; color: var(--purple-900);">
                <strong>Total Factura:</strong>
                <strong>@Model.Total.ToString("C")</strong>
            </div>
        </div>
    </div>

    <!-- Información DIAN / CUFE -->
    <div style="background-color: #fefce8; border: 1px solid #fde047; border-radius: 0.5rem; padding: 0.85rem 1rem; font-size: 0.8rem; color: #713f12;">
        <div style="font-weight: 700; margin-bottom: 0.25rem;">Información Tributaria DIAN</div>
        <div><strong>Resolución DIAN:</strong> @Model.ResolucionDianNumero | <strong>Rango Autorizado:</strong> @Model.RangoAutorizadoDesde a @Model.RangoAutorizadoHasta</div>
        <div style="margin-top: 0.35rem;">
            <strong>CUFE:</strong>
            <span style="font-family: monospace; word-break: break-all; color: #374151;">@(string.IsNullOrWhiteSpace(Model.CUFE) ? "Pendiente de cálculo" : Model.CUFE)</span>
        </div>
    </div>
</div>

<div style="display: flex; justify-content: flex-end; gap: 0.65rem; padding: 1rem 1.5rem; border-top: 1px solid var(--purple-100); background-color: #faf5ff; border-bottom-left-radius: 0.75rem; border-bottom-right-radius: 0.75rem;">
    <button type="button"
            onclick="cerrarDetalleFactura()"
            style="background: white; color: var(--gray-700); border: 1px solid var(--gray-300); padding: 0.5rem 1rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">
        Cerrar
    </button>
    <a href="/MisFacturas/Descargar/@Model.Id"
       style="background: var(--purple-600); color: white; border: none; padding: 0.5rem 1.15rem; border-radius: 0.375rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;">
        <icon name="file-text" class="icon-sm" /> <span>Descargar PDF</span>
    </a>
</div>
