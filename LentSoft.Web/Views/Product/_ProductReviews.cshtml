@model LentSoft.Web.Models.ViewModels.ProductReviewsViewModel
@{
    var summary = Model.Summary;
    var total = summary.TotalReviews;
    var avg = summary.AverageRating;
    var showForm = Model.IsAuthenticated && (Model.IsAdmin || Model.CurrentUserReview == null);
    var returnUrl = $"/Product/Details/{Model.ProductId}";

    string FormatRelativeTime(DateTime utcDate)
    {
        var diff = DateTime.UtcNow - utcDate;
        if (diff.TotalMinutes < 1) return "hace un momento";
        if (diff.TotalMinutes < 60)
        {
            var m = (int)Math.Floor(diff.TotalMinutes);
            return m == 1 ? "hace 1 minuto" : $"hace {m} minutos";
        }
        if (diff.TotalHours < 24)
        {
            var h = (int)Math.Floor(diff.TotalHours);
            return h == 1 ? "hace 1 hora" : $"hace {h} horas";
        }
        if (diff.TotalDays < 30)
        {
            var d = (int)Math.Floor(diff.TotalDays);
            return d == 1 ? "hace 1 día" : $"hace {d} días";
        }
        if (diff.TotalDays < 365)
        {
            var mo = (int)Math.Floor(diff.TotalDays / 30);
            return mo == 1 ? "hace 1 mes" : $"hace {mo} meses";
        }
        var y = (int)Math.Floor(diff.TotalDays / 365);
        return y == 1 ? "hace 1 año" : $"hace {y} años";
    }
}

<section id="reseñas" aria-labelledby="reviewsHeading" style="margin-top: 3.5rem; background: white; border-radius: 1.25rem; padding: 2rem; box-shadow: var(--shadow-md); border: 1px solid var(--purple-100);">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.75rem; border-bottom: 1px solid var(--purple-100); padding-bottom: 1rem;">
        <div>
            <span style="display: inline-block; background: var(--purple-100); color: var(--purple-700); padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.35rem;">Opiniones verificadas</span>
            <h2 id="reviewsHeading" style="color: var(--purple-900); font-size: 1.6rem; font-weight: 800; font-family: var(--font-primary); margin: 0;">
                Reseñas de clientes
            </h2>
        </div>
        <div style="color: var(--gray-500); font-size: 0.9rem; font-weight: 600;">
            @(total == 1 ? "1 opinión registrada" : $"{total} opiniones registradas")
        </div>
    </div>

    <!-- Resumen y Distribución -->
    <div style="display: grid; grid-template-columns: minmax(200px, 260px) 1fr; gap: 2rem; align-items: center; background: var(--purple-50); border-radius: 1rem; padding: 1.5rem; margin-bottom: 2rem;" class="reviews-summary-grid">
        <div style="text-align: center; padding: 0.5rem;">
            <div style="font-size: 3.25rem; font-weight: 900; color: var(--purple-900); line-height: 1; font-family: var(--font-primary);">
                @(total > 0 ? avg.ToString("0.0") : "0.0")
            </div>
            <div class="rating-stars" role="img" aria-label="@($"{avg:0.0} de 5 estrellas")" style="justify-content: center; margin: 0.5rem 0; font-size: 1.2rem;">
                @for (int i = 1; i <= 5; i++)
                {
                    var filled = total > 0 && (i <= Math.Floor(avg) || (i == Math.Floor(avg) + 1 && (avg - Math.Floor(avg)) >= 0.5));
                    <icon name="star" class="@(filled ? "icon-fill" : "")" />
                }
            </div>
            <div style="color: var(--gray-600); font-size: 0.85rem; font-weight: 600;">
                @(total == 0 ? "Sin calificaciones aún" : $"Basado en {total} {(total == 1 ? "reseña" : "reseñas")}")
            </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            @for (int star = 5; star >= 1; star--)
            {
                var count = summary.Distribution.TryGetValue(star, out var c) ? c : 0;
                var pct = total > 0 ? Math.Round((double)count / total * 100) : 0;
                <div style="display: grid; grid-template-columns: 48px 1fr 44px; align-items: center; gap: 0.75rem; font-size: 0.85rem;">
                    <span style="color: var(--purple-900); font-weight: 700; display: flex; align-items: center; gap: 0.2rem;">@star ★</span>
                    <div style="height: 10px; background: white; border-radius: 9999px; overflow: hidden; border: 1px solid var(--purple-200);" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="@($"{star} estrellas: {pct}%")">
                        <div style="height: 100%; width: @pct%; background: linear-gradient(90deg, var(--purple-500), var(--purple-700)); border-radius: 9999px; transition: width 0.3s ease;"></div>
                    </div>
                    <span style="color: var(--gray-600); text-align: right; font-weight: 600;">@count</span>
                </div>
            }
        </div>
    </div>

    <!-- Formulario o Invitación a Iniciar Sesión -->
    @if (!Model.IsAuthenticated)
    {
        <div style="background: linear-gradient(135deg, var(--purple-50), white); border: 1.5px dashed var(--purple-300); border-radius: 1rem; padding: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 2rem;">
            <div>
                <h3 style="color: var(--purple-900); font-size: 1.05rem; font-weight: 700; margin: 0 0 0.25rem 0;">¿Ya probaste estas gafas?</h3>
                <p style="color: var(--gray-600); font-size: 0.9rem; margin: 0;">Comparte tu experiencia con otros clientes de LentSoft.</p>
            </div>
            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@returnUrl"
               style="background: linear-gradient(135deg, var(--purple-600), var(--purple-800)); color: white; padding: 0.7rem 1.4rem; border-radius: 0.75rem; font-weight: 700; font-size: 0.9rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 10px rgba(124,58,237,0.25);">
                Inicia sesión para opinar
            </a>
        </div>
    }
    else if (showForm)
    {
        <form asp-controller="Reviews" asp-action="Create" method="post" class="js-review-form" data-product-id="@Model.ProductId"
              style="background: var(--gray-50); border: 1px solid var(--purple-200); border-radius: 1rem; padding: 1.5rem; margin-bottom: 2rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductId" />

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
                <h3 style="color: var(--purple-900); font-size: 1.05rem; font-weight: 700; margin: 0;">
                    @(Model.IsAdmin ? "Publicar reseña oficial (Equipo LentSoft)" : "Escribe tu reseña")
                </h3>
                @if (Model.IsAdmin)
                {
                    <span style="background: var(--purple-700); color: white; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.65rem; border-radius: 9999px;">Equipo LentSoft</span>
                }
            </div>

            <div style="margin-bottom: 1rem;">
                <label style="display: block; color: var(--purple-900); font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem;">Calificación *</label>
                <div class="star-picker" role="radiogroup" aria-label="Selecciona una calificación de 1 a 5 estrellas" style="display: inline-flex; gap: 0.35rem;">
                    <input type="hidden" name="rating" value="5" class="js-rating-input" />
                    @for (int s = 1; s <= 5; s++)
                    {
                        <button type="button"
                                class="js-star-btn"
                                data-value="@s"
                                role="radio"
                                aria-checked="@(s == 5 ? "true" : "false")"
                                aria-label="@($"{s} {(s == 1 ? "estrella" : "estrellas")}")"
                                tabindex="@(s == 5 ? "0" : "-1")"
                                style="background: white; border: 1.5px solid var(--purple-300); border-radius: 0.5rem; width: 40px; height: 40px; cursor: pointer; font-size: 1.25rem; color: #f59e0b; display: inline-flex; align-items: center; justify-content: center; transition: transform 0.15s, border-color 0.15s;">
                            ★
                        </button>
                    }
                </div>
            </div>

            <div style="margin-bottom: 1rem;">
                <label for="newReviewComment" style="display: block; color: var(--purple-900); font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem;">Tu comentario *</label>
                <textarea id="newReviewComment" name="comment" rows="3" minlength="10" maxlength="1000" required
                          class="js-review-textarea"
                          placeholder="Cuéntanos qué tal te parecieron el diseño, comodidad y calidad (mínimo 10 caracteres)..."
                          style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; border: 1.5px solid var(--purple-200); font-family: inherit; font-size: 0.95rem; resize: vertical; background: white; color: var(--gray-800); box-sizing: border-box;"></textarea>
                <div style="display: flex; justify-content: space-between; margin-top: 0.35rem; font-size: 0.78rem; color: var(--gray-500);">
                    <span>Mínimo 10 caracteres</span>
                    <span class="js-char-counter">0 / 1000</span>
                </div>
            </div>

            <button type="submit"
                    style="background: linear-gradient(135deg, var(--purple-600), var(--purple-800)); color: white; border: none; border-radius: 0.75rem; padding: 0.75rem 1.5rem; font-weight: 700; font-size: 0.95rem; cursor: pointer; box-shadow: 0 4px 10px rgba(124,58,237,0.25);">
                Publicar reseña
            </button>
        </form>
    }
    else if (Model.CurrentUserReview != null)
    {
        <div style="background: var(--purple-50); border: 1px solid var(--purple-200); border-radius: 0.85rem; padding: 1rem 1.25rem; margin-bottom: 1.75rem; color: var(--purple-900); font-size: 0.9rem; font-weight: 500;">
            Ya dejaste una reseña en este producto. Puedes editarla o eliminarla directamente en la lista inferior.
        </div>
    }

    <!-- Lista de Reseñas -->
    @if (!Model.Reviews.Any())
    {
        <div style="text-align: center; padding: 2.5rem 1rem; color: var(--gray-500); background: var(--gray-50); border-radius: 1rem;">
            <p style="font-size: 1.05rem; font-weight: 600; color: var(--purple-800); margin: 0 0 0.25rem 0;">Aún no hay reseñas. ¡Sé el primero en opinar!</p>
            <p style="font-size: 0.88rem; margin: 0;">Tu opinión ayuda a otros clientes a elegir su montura ideal.</p>
        </div>
    }
    else
    {
        <div id="reviewsList" style="display: flex; flex-direction: column; gap: 1rem;">
            @for (int idx = 0; idx < Model.Reviews.Count; idx++)
            {
                var review = Model.Reviews[idx];
                var isOwner = Model.IsAuthenticated && review.UserId == Model.CurrentUserId;
                var canEdit = isOwner || Model.IsAdmin;
                var canDelete = isOwner || Model.IsAdmin;
                var hiddenClass = idx >= 5 ? "js-review-extra" : "";
                var hiddenStyle = idx >= 5 ? "display: none;" : "";

                <article class="review-card @hiddenClass" style="border: 1px solid var(--gray-200); border-radius: 1rem; padding: 1.25rem; background: white; @hiddenStyle">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.65rem;">
                        <div>
                            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                <strong style="color: var(--purple-900); font-size: 0.98rem;">@review.UserName</strong>
                                @if (review.IsAdminReview)
                                {
                                    <span style="background: var(--purple-700); color: white; font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.55rem; border-radius: 9999px;">Equipo LentSoft</span>
                                }
                                <span style="color: var(--gray-400); font-size: 0.8rem;">· @FormatRelativeTime(review.CreatedAtUtc)</span>
                                @if (review.UpdatedAtUtc.HasValue)
                                {
                                    <span style="color: var(--gray-400); font-size: 0.75rem; font-style: italic;">(editada)</span>
                                }
                            </div>
                            <div class="rating-stars" role="img" aria-label="@($"{review.Rating} de 5 estrellas")" style="margin-top: 0.25rem; font-size: 0.95rem;">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <icon name="star" class="@(s <= review.Rating ? "icon-fill" : "")" />
                                }
                            </div>
                        </div>

                        @if (canEdit || canDelete)
                        {
                            <div style="display: flex; gap: 0.5rem; align-items: center;">
                                @if (canEdit)
                                {
                                    <button type="button" class="js-toggle-edit-btn" data-review-id="@review.Id"
                                            style="background: var(--purple-50); color: var(--purple-700); border: 1px solid var(--purple-200); border-radius: 0.5rem; padding: 0.35rem 0.75rem; font-size: 0.8rem; font-weight: 600; cursor: pointer;">
                                        Editar
                                    </button>
                                }
                                @if (canDelete)
                                {
                                    <form asp-controller="Reviews" asp-action="Delete" method="post" class="js-review-delete-form" data-product-id="@Model.ProductId" style="margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@review.Id" />
                                        <input type="hidden" name="productId" value="@Model.ProductId" />
                                        <button type="submit"
                                                style="background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 0.5rem; padding: 0.35rem 0.75rem; font-size: 0.8rem; font-weight: 600; cursor: pointer;">
                                            Eliminar
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>

                    <p style="color: var(--gray-700); font-size: 0.95rem; line-height: 1.55; margin: 0; white-space: pre-line;">@review.Comment</p>

                    @if (canEdit)
                    {
                        <form asp-controller="Reviews" asp-action="Edit" method="post" id="editForm-@review.Id" class="js-review-edit-form" data-product-id="@Model.ProductId"
                              style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--purple-200);">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@review.Id" />
                            <input type="hidden" name="productId" value="@Model.ProductId" />

                            <div style="margin-bottom: 0.75rem;">
                                <label style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--purple-900); margin-bottom: 0.3rem;">Nueva calificación</label>
                                <select name="rating" style="padding: 0.45rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.9rem;">
                                    @for (int s = 5; s >= 1; s--)
                                    {
                                        <option value="@s" selected="@(review.Rating == s ? "selected" : null)">@s @(s == 1 ? "estrella" : "estrellas")</option>
                                    }
                                </select>
                            </div>

                            <div style="margin-bottom: 0.75rem;">
                                <textarea name="comment" rows="3" minlength="10" maxlength="1000" required
                                          style="width: 100%; padding: 0.65rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-family: inherit; font-size: 0.9rem; box-sizing: border-box;">@review.Comment</textarea>
                            </div>

                            <div style="display: flex; gap: 0.5rem;">
                                <button type="submit" style="background: var(--purple-700); color: white; border: none; border-radius: 0.5rem; padding: 0.45rem 1rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
                                    Guardar cambios
                                </button>
                                <button type="button" class="js-cancel-edit-btn" data-review-id="@review.Id"
                                        style="background: white; color: var(--gray-600); border: 1px solid var(--gray-300); border-radius: 0.5rem; padding: 0.45rem 1rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
                                    Cancelar
                                </button>
                            </div>
                        </form>
                    }
                </article>
            }
        </div>

        @if (Model.Reviews.Count > 5)
        {
            <div style="text-align: center; margin-top: 1.5rem;">
                <button type="button" id="showMoreReviewsBtn"
                        style="background: white; color: var(--purple-700); border: 1.5px solid var(--purple-300); border-radius: 0.75rem; padding: 0.65rem 1.5rem; font-weight: 700; font-size: 0.9rem; cursor: pointer;">
                    Ver más reseñas (@(Model.Reviews.Count - 5) más)
                </button>
            </div>
        }
    }
</section>

<style>
    @@media (max-width: 768px) {
        .reviews-summary-grid {
            grid-template-columns: 1fr !important;
        }
    }
    .js-star-btn:focus-visible {
        outline: 3px solid var(--purple-600);
        outline-offset: 2px;
    }
</style>
