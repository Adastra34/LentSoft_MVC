@model DashboardVentasViewModel

<!-- 1. Modal para Registrar Nueva Venta -->
<partial name="_ModalRegistrarVenta" model="((IEnumerable<LentSoft.Web.Models.Entities.User>)Model.Clientes, (IEnumerable<LentSoft.Web.Models.Entities.Product>)Model.Productos)" />

<!-- 2. Modal para Nueva Factura (DIAN) -->
<div id="modal-factura" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 550px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div style="background: linear-gradient(135deg, var(--purple-700), var(--purple-600)); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem;"><icon name="receipt" /> <span>Generar Factura Electrónica</span></h3>
                <p style="margin: 0.25rem 0 0 0; font-size: 0.8rem; color: var(--purple-200);">Asociada a orden de venta activa</p>
            </div>
            <button type="button" onclick="document.getElementById('modal-factura').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white;">&times;</button>
        </div>

        <form asp-controller="Invoice" asp-action="Create" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <div>
                <label style="font-size: 0.85rem; font-weight: 600; color: var(--purple-900); display: block; margin-bottom: 0.35rem;">Seleccionar Pedido Activo *</label>
                <select name="OrderId" id="selectOrderIdFactura" required class="form-input" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.88rem;" onchange="actualizarInfoFactura(this)">
                    <option value="">-- Seleccionar Pedido para Facturar --</option>
                    @if (Model.PedidosDisponibles != null)
                    {
                        foreach (var ped in Model.PedidosDisponibles)
                        {
                            <option value="@ped.Id" data-total="@ped.Total" data-cliente="@(ped.User?.NombreCompleto ?? "Cliente")" data-metodo="@ped.MetodoPagoSimulado">
                                #ORD-@ped.Id.ToString("D4") - @(ped.User?.NombreCompleto ?? "Cliente") (COP $@ped.Total.ToString("N0"))
                            </option>
                        }
                    }
                </select>
            </div>

            <div style="background: var(--purple-50); border: 1px solid var(--purple-200); border-radius: 0.5rem; padding: 0.85rem;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem; font-size: 0.85rem;">
                    <span style="color: var(--gray-600);">Cliente:</span>
                    <strong id="facturaModalCliente" style="color: var(--purple-900);">-</strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem; font-size: 0.85rem;">
                    <span style="color: var(--gray-600);">Método de Pago:</span>
                    <strong id="facturaModalMetodo" style="color: var(--purple-900);">-</strong>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 1rem; border-top: 1px solid var(--purple-200); padding-top: 0.4rem;">
                    <span style="font-weight: 700; color: var(--purple-900);">Total a Facturar:</span>
                    <strong id="facturaModalTotal" style="color: var(--purple-700);">COP $0</strong>
                </div>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-factura').style.display='none'" style="flex: 1; border: 1px solid var(--purple-300); background: transparent; color: var(--purple-700); padding: 0.65rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" style="flex: 1.5; background: var(--purple-600); color: white; border: none; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; cursor: pointer;">Emitir Factura</button>
            </div>
        </form>
    </div>
</div>

<!-- 3. Modal para Registrar Abono -->
<div id="modal-abono" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 480px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div style="background: linear-gradient(135deg, var(--purple-700), var(--purple-600)); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; font-weight: 700;">
                <icon name="banknote" /> <span>Registrar Abono a Venta</span>
            </div>
            <button type="button" onclick="document.getElementById('modal-abono').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white;">&times;</button>
        </div>

        <form asp-controller="Ventas" asp-action="RegistrarAbono" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="abonoVentaId" name="ventaId" value="" />

            <div style="background: var(--purple-50); border: 1px solid var(--purple-200); border-radius: 0.5rem; padding: 0.85rem;">
                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 0.25rem;">
                    <span style="color: var(--gray-600);">Pedido:</span>
                    <strong id="abonoPedidoText" style="color: var(--purple-900);">-</strong>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 0.25rem;">
                    <span style="color: var(--gray-600);">Cliente:</span>
                    <strong id="abonoClienteText" style="color: var(--purple-900);">-</strong>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.95rem; border-top: 1px solid var(--purple-200); padding-top: 0.35rem;">
                    <span style="color: var(--gray-700); font-weight: 600;">Saldo Pendiente:</span>
                    <strong id="abonoSaldoText" style="color: var(--error, #EF4444); font-weight: 800;">COP $0</strong>
                </div>
            </div>

            <div>
                <label style="font-size: 0.82rem; font-weight: 700; color: var(--purple-900); display: block; margin-bottom: 0.3rem;">Monto a Abonar (COP) *</label>
                <input type="number" id="abonoMontoInput" name="monto" min="1" step="1" required class="form-input" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 1rem; font-weight: 700; color: var(--purple-900);" placeholder="Ej: 50000" />
            </div>

            <div>
                <label style="font-size: 0.82rem; font-weight: 700; color: var(--purple-900); display: block; margin-bottom: 0.3rem;">Método de Pago *</label>
                <select id="abonoMetodoPago" name="metodoPago" class="form-input" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.88rem;" onchange="handleMetodoPagoChange(this.value)">
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia Bancaria">Transferencia Bancaria (Nequi / Daviplata / Bancolombia)</option>
                    <option value="Tarjeta de Crédito / Débito">Tarjeta de Crédito (Pasarela)</option>
                </select>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-abono').style.display='none'" style="flex: 1; border: 1px solid var(--purple-300); background: transparent; color: var(--purple-700); padding: 0.65rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" id="btnConfirmarAbono" style="flex: 1.5; background: var(--purple-600); color: white; border: none; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; cursor: pointer;">Confirmar Abono</button>
            </div>
        </form>
    </div>
</div>

<!-- 4. Modal para Pasarela Tarjeta de Crédito (Requisito 4: autocomplete off, validación Luhn cliente) -->
<div id="modal-tarjeta" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1050; padding: 1rem;">
    <div style="width: 100%; max-width: 500px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div style="background: linear-gradient(135deg, #1E1B4B, var(--purple-800)); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; font-weight: 700;">
                <icon name="lock" /> <span>Cobro Seguro con Tarjeta</span>
            </div>
            <button type="button" onclick="document.getElementById('modal-tarjeta').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white;">&times;</button>
        </div>

        <form id="tarjetaForm" asp-controller="Ventas" asp-action="CobrarTarjeta" method="post" autocomplete="off" onsubmit="return validarTarjetaCliente(event)" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="tarjetaVentaId" name="VentaId" value="" />

            <div style="display: flex; justify-content: space-between; align-items: center; background: #EEF2FF; border: 1px solid #C7D2FE; padding: 0.75rem 1rem; border-radius: 0.5rem;">
                <div>
                    <span style="font-size: 0.75rem; color: #4338CA; font-weight: 700; text-transform: uppercase;">Monto a Cobrar:</span>
                    <div id="tarjetaMontoDisplay" style="font-size: 1.25rem; font-weight: 800; color: #312E81;">COP $0</div>
                </div>
                <span id="tarjetaMarcaBadge" style="background: #312E81; color: white; padding: 0.25rem 0.65rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 700;">Tarjeta</span>
            </div>
            <input type="hidden" id="tarjetaMontoInput" name="Monto" value="0" />

            <div>
                <label style="font-size: 0.8rem; font-weight: 700; color: var(--purple-900); display: block; margin-bottom: 0.25rem;">Nombre del Titular *</label>
                <input type="text" id="tarjetaTitular" name="NombreTitular" required autocomplete="off" placeholder="Como aparece en la tarjeta" class="form-input" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.88rem;" />
            </div>

            <div>
                <label style="font-size: 0.8rem; font-weight: 700; color: var(--purple-900); display: block; margin-bottom: 0.25rem;">Número de Tarjeta *</label>
                <input type="text" id="tarjetaNumero" name="NumeroTarjeta" required autocomplete="off" maxlength="19" placeholder="4532 0150 0000 0000" class="form-input" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.95rem; font-family: monospace;" oninput="formatearYDetectarTarjeta(this)" />
                <span id="tarjetaLuhnMsg" style="font-size: 0.72rem; display: block; min-height: 1rem; margin-top: 0.2rem; font-weight: 600;"></span>
            </div>

            <div style="display: flex; gap: 0.75rem;">
                <div style="flex: 1;">
                    <label style="font-size: 0.8rem; font-weight: 700; color: var(--purple-900); display: block; margin-bottom: 0.25rem;">Vencimiento (MM/YY) *</label>
                    <input type="text" id="tarjetaExp" name="FechaExpiracion" required autocomplete="off" maxlength="5" placeholder="MM/YY" class="form-input" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.88rem; text-align: center;" oninput="formatearExpiracion(this)" />
                </div>
                <div style="flex: 1;">
                    <label style="font-size: 0.8rem; font-weight: 700; color: var(--purple-900); display: block; margin-bottom: 0.25rem;">CVV *</label>
                    <input type="password" id="tarjetaCvv" name="Cvv" required autocomplete="off" maxlength="4" placeholder="123" class="form-input" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.88rem; text-align: center;" />
                </div>
            </div>

            <p style="font-size: 0.72rem; color: #6B7280; margin: 0; line-height: 1.3; display: flex; align-items: center; gap: 0.4rem;">
                <icon name="lock" class="icon-sm" /> Transacción simulada segura. No se almacena el número de tarjeta completo ni el CVV en el servidor.
            </p>

            <div style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-tarjeta').style.display='none'" style="flex: 1; border: 1px solid var(--purple-300); background: transparent; color: var(--purple-700); padding: 0.65rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" id="btnCobrarTarjetaSubmit" style="flex: 1.5; background: #312E81; color: white; border: none; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; cursor: pointer;">Procesar Pago</button>
            </div>
        </form>
    </div>
</div>

<!-- 5. Modal para Cambiar Estado del Pedido -->
<div id="modal-cambiar-estado" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 440px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div style="background: linear-gradient(135deg, var(--purple-700), var(--purple-600)); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; font-weight: 700;">
                <icon name="refresh-cw" /> <span>Cambiar Estado de la Venta</span>
            </div>
            <button type="button" onclick="document.getElementById('modal-cambiar-estado').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white;">&times;</button>
        </div>

        <form asp-controller="Ventas" asp-action="UpdateOrderStatus" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="cambiarEstadoOrderId" name="id" value="" />

            <div style="background: var(--purple-50); border: 1px solid var(--purple-200); border-radius: 0.5rem; padding: 0.85rem; font-size: 0.85rem;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                    <span>Pedido:</span>
                    <strong id="cambiarEstadoPedidoLabel" style="color: var(--purple-900);">-</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span>Estado Actual:</span>
                    <strong id="cambiarEstadoActualLabel" style="color: var(--purple-700); text-transform: capitalize;">-</strong>
                </div>
            </div>

            <div>
                <label style="font-size: 0.82rem; font-weight: 700; color: var(--purple-900); display: block; margin-bottom: 0.3rem;">Nuevo Estado *</label>
                <select id="cambiarEstadoSelect" name="estado" required class="form-input" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.88rem;">
                    <option value="pendiente">Pendiente</option>
                    <option value="procesando">Procesando</option>
                    <option value="enviado">Enviado</option>
                    <option value="entregado">Entregado</option>
                    <option value="pagado">Pagado (Requiere Saldo 0)</option>
                    <option value="cancelado">Cancelado (Solo sin abonos)</option>
                </select>
                <span id="cambiarEstadoHelpMsg" style="font-size: 0.74rem; color: #6B7280; display: block; margin-top: 0.25rem;">
                    Flujo permitido: Pendiente → Procesando → Enviado → Entregado.
                </span>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-cambiar-estado').style.display='none'" style="flex: 1; border: 1px solid var(--purple-300); background: transparent; color: var(--purple-700); padding: 0.65rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" style="flex: 1.5; background: var(--purple-600); color: white; border: none; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; cursor: pointer;">Actualizar Estado</button>
            </div>
        </form>
    </div>
</div>

<!-- 6. Modal para Ver / Vincular Fórmula Óptica (Requisito 2) -->
<div id="modal-formula" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 500px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div style="background: linear-gradient(135deg, #581C87, var(--purple-700)); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; font-weight: 700;">
                <icon name="eye" /> <span>Fórmula Óptica de la Venta</span>
            </div>
            <button type="button" onclick="document.getElementById('modal-formula').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white;">&times;</button>
        </div>

        <div style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            <div id="formulaModalContenido" style="font-size: 0.88rem;">
                <!-- Dinámico vía JS -->
            </div>

            <!-- Formulario para Vincular / Desvincular Fórmula -->
            <form asp-controller="Ventas" asp-action="VincularFormula" method="post" style="border-top: 1px solid var(--purple-200); padding-top: 1rem; display: flex; flex-direction: column; gap: 0.75rem;">
                @Html.AntiForgeryToken()
                <input type="hidden" id="vincularFormulaOrderId" name="orderId" value="" />
                
                <div>
                    <label style="font-size: 0.8rem; font-weight: 700; color: var(--purple-900); display: block; margin-bottom: 0.3rem;">Vincular Otra Fórmula del Paciente:</label>
                    <select id="vincularFormulaSelect" name="formulaOpticaId" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.85rem;">
                        <option value="">-- Sin Fórmula (Desvincular) --</option>
                    </select>
                </div>

                <div style="display: flex; gap: 0.75rem; margin-top: 0.25rem;">
                    <button type="button" onclick="document.getElementById('modal-formula').style.display='none'" style="flex: 1; border: 1px solid var(--purple-300); background: transparent; color: var(--purple-700); padding: 0.6rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer;">Cerrar</button>
                    <button type="submit" style="flex: 1.5; background: var(--purple-600); color: white; border: none; padding: 0.6rem; border-radius: 0.5rem; font-weight: 700; cursor: pointer;">Guardar Vinculación</button>
                </div>
            </form>
        </div>
    </div>
</div>
