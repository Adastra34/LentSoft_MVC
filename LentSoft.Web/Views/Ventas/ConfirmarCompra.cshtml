@model LentSoft.Web.Models.ViewModels.SaleConfirmationViewModel
@{
    ViewData["Title"] = "Detalle de mi Compra";
    var order = Model.Order;
    var clientName = order?.User != null ? order.User.NombreCompleto : "Cliente";
    var subtotalSum = order?.OrderItems?.Sum(oi => oi.Subtotal) ?? 0;
    var discountAmount = subtotalSum - (order?.Total ?? 0);
}

<div style="min-height: 80vh; background-color: var(--purple-50); padding: 3rem 1.5rem; display: flex; align-items: center; justify-content: center;">
    <div style="width: 100%; max-width: 650px; background-color: var(--white); border-radius: 1rem; box-shadow: var(--shadow-lg); overflow: hidden;">
        
        <!-- Header -->
        <div style="background: linear-gradient(135deg, var(--purple-800), var(--purple-600)); color: white; padding: 2rem; text-align: center;">
            <h1 style="font-family: var(--font-primary); font-size: 1.8rem; margin: 0; font-weight: 700; letter-spacing: 0.5px;">LentSoft</h1>
            <p style="font-family: var(--font-secondary); font-size: 0.9rem; color: var(--purple-100); margin: 0.5rem 0 0 0; font-weight: 500;">
                Resumen Oficial de Transacción
            </p>
        </div>

        <!-- Content Body -->
        <div style="padding: 2.5rem 2rem;">
            @if (!Model.IsValid || order == null)
            {
                <!-- Error State -->
                <div style="text-align: center; padding: 2rem 0;">
                    <div style="width: 70px; height: 70px; background-color: #FEE2E2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto; font-size: 2.5rem; color: var(--error);">
                        ⚠️
                    </div>
                    <h2 style="font-family: var(--font-primary); color: var(--purple-950); font-size: 1.4rem; margin-bottom: 0.75rem; font-weight: 700;">Enlace Expirado o Inválido</h2>
                    <p style="font-family: var(--font-secondary); color: var(--gray-600); font-size: 0.95rem; margin: 0; line-height: 1.6;">
                        @Model.ErrorMessage
                    </p>
                    <div style="margin-top: 2rem;">
                        <a href="/" style="display: inline-block; background-color: var(--purple-600); color: white; padding: 0.75rem 2rem; border-radius: 0.5rem; font-weight: 600; text-decoration: none; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='var(--purple-700)'" onmouseout="this.style.backgroundColor='var(--purple-600)'">
                            Ir al Inicio
                        </a>
                    </div>
                </div>
            }
            else
            {
                <!-- Order Detail State -->
                <div style="text-align: center; margin-bottom: 2rem;">
                    <div style="width: 60px; height: 60px; background-color: #DCFCE7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto; font-size: 2rem; color: var(--success);">
                        ✓
                    </div>
                    <h2 style="font-family: var(--font-primary); color: var(--purple-950); font-size: 1.5rem; margin: 0; font-weight: 700;">¡Gracias por tu confianza!</h2>
                    <p style="font-family: var(--font-secondary); color: var(--gray-500); font-size: 0.85rem; margin: 0.25rem 0 0 0;">
                        Tu venta se encuentra registrada y procesada en el sistema.
                    </p>
                </div>

                <!-- Info Cards -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem;">
                    <div style="background-color: var(--purple-50); padding: 1rem; border-radius: 0.75rem; border: 1px solid var(--purple-100);">
                        <span style="font-size: 0.75rem; color: var(--gray-500); font-weight: 600; text-transform: uppercase; display: block; margin-bottom: 0.25rem;">Datos del Cliente</span>
                        <strong style="color: var(--purple-900); font-size: 0.95rem; display: block;">@clientName</strong>
                        <span style="font-size: 0.8rem; color: var(--gray-600); display: block; margin-top: 0.25rem;">C.C. @(order.User?.NumeroDocumento ?? "N/A")</span>
                    </div>
                    <div style="background-color: var(--purple-50); padding: 1rem; border-radius: 0.75rem; border: 1px solid var(--purple-100);">
                        <span style="font-size: 0.75rem; color: var(--gray-500); font-weight: 600; text-transform: uppercase; display: block; margin-bottom: 0.25rem;">Datos del Pedido</span>
                        <strong style="color: var(--purple-900); font-size: 0.95rem; display: block;">#ORD-@order.Id.ToString("D4")</strong>
                        <span style="font-size: 0.8rem; color: var(--gray-600); display: block; margin-top: 0.25rem;">Fecha: @order.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

                <!-- Items Table -->
                <div style="border: 1px solid var(--purple-100); border-radius: 0.75rem; overflow: hidden; margin-bottom: 2rem;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
                        <thead>
                            <tr style="background-color: var(--purple-100); color: var(--purple-900); font-weight: 600;">
                                <th style="padding: 0.75rem 1rem;">Producto</th>
                                <th style="padding: 0.75rem 1rem; text-align: center; width: 60px;">Cant</th>
                                <th style="padding: 0.75rem 1rem; text-align: right; width: 110px;">Precio U.</th>
                                <th style="padding: 0.75rem 1rem; text-align: right; width: 110px;">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in order.OrderItems)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-50); color: var(--gray-800);">
                                    <td style="padding: 0.75rem 1rem; font-weight: 600;">@(item.Product?.Nombre ?? $"Producto #{item.ProductId}")</td>
                                    <td style="padding: 0.75rem 1rem; text-align: center;">@item.Cantidad</td>
                                    <td style="padding: 0.75rem 1rem; text-align: right;">@item.PrecioUnitario.ToString("C")</td>
                                    <td style="padding: 0.75rem 1rem; text-align: right; font-weight: 700; color: var(--purple-900);">@item.Subtotal.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Totales -->
                <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem; border-top: 1px solid var(--purple-100); padding-top: 1.5rem; font-size: 0.9rem; color: var(--gray-700);">
                    <div style="display: flex; justify-content: space-between; width: 280px;">
                        <span>Subtotal:</span>
                        <strong style="color: var(--gray-900);">@subtotalSum.ToString("C")</strong>
                    </div>
                    @if (discountAmount > 0)
                    {
                        var discountPercent = (int)Math.Round((discountAmount / subtotalSum) * 100);
                        <div style="display: flex; justify-content: space-between; width: 280px; color: var(--warning);">
                            <span>Descuento (@discountPercent%):</span>
                            <strong>-@discountAmount.ToString("C")</strong>
                        </div>
                    }
                    <div style="display: flex; justify-content: space-between; width: 280px; font-size: 1.15rem; color: var(--purple-900); border-top: 2px solid var(--purple-600); padding-top: 0.75rem; margin-top: 0.25rem;">
                        <strong>Total Pagado:</strong>
                        <strong>@order.Total.ToString("C")</strong>
                    </div>
                </div>

                <!-- Pago Status -->
                <div style="margin-top: 2rem; display: flex; align-items: center; gap: 0.75rem; background-color: var(--purple-50); padding: 1rem; border-radius: 0.75rem; border: 1px dashed var(--purple-300);">
                    <span style="font-size: 1.25rem;">💳</span>
                    <div style="font-size: 0.85rem; color: var(--purple-950);">
                        Método de pago: <strong>@order.MetodoPagoSimulado</strong> | Estado de la venta: <span style="background-color: var(--purple-200); color: var(--purple-900); padding: 0.15rem 0.5rem; border-radius: 9999px; font-weight: 600; font-size: 0.75rem;">@order.Estado</span>
                    </div>
                </div>
            }
        </div>

        <!-- Footer -->
        <div style="background-color: var(--purple-50); border-top: 1px solid var(--purple-100); padding: 1.25rem; text-align: center; font-size: 0.75rem; color: var(--text-muted);">
            LentSoft Optometría &copy; 2026. Todos los derechos reservados.
        </div>
    </div>
</div>
