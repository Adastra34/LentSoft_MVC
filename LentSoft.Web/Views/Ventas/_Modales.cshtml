@model LentSoft.Web.Models.ViewModels.DashboardVentasViewModel

<!-- Modal para Nueva Factura (DIAN) -->
<div id="modal-factura" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 550px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div style="background: linear-gradient(135deg, var(--purple-700), var(--purple-600)); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.2rem; font-weight: 700;">
                    <span>📄</span> <span>Factura Electrónica de Venta (DIAN)</span>
                </div>
                <div style="font-size: 0.78rem; color: var(--purple-100); margin-top: 0.25rem; font-weight: 500;">
                    Emisión con consecutivo consecutivo oficial y generación de CUFE
                </div>
            </div>
            <button type="button" onclick="document.getElementById('modal-factura').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white;">&times;</button>
        </div>

        <form asp-controller="Invoice" asp-action="Create" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
            @Html.AntiForgeryToken()

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Pedido Asociado *</label>
                <select id="invoiceOrderSelect" name="OrderId" class="form-input" required style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" onchange="onInvoiceOrderChange(this)">
                    <option value="">-- Seleccionar Pedido --</option>
                    @if (Model.PedidosDisponibles != null)
                    {
                        @foreach (var ord in Model.PedidosDisponibles)
                        {
                            var usrName = ord.User != null ? ord.User.NombreCompleto : "Cliente";
                            var metodo = !string.IsNullOrWhiteSpace(ord.MetodoPagoSimulado) ? ord.MetodoPagoSimulado : "Efectivo";
                            <option value="@ord.Id" data-total="@ord.Total" data-metodo="@metodo" data-saldopendiente="@ord.SaldoPendiente">#ORD-@ord.Id.ToString("D4") - @usrName (@ord.Total.ToString("C"))</option>
                        }
                    }
                </select>
            </div>

            <div style="display: flex; gap: 1rem;">
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Estado de Factura *</label>
                    <select id="invoiceEstadoSelect" name="Estado" class="form-input" required style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);">
                        <option value="pendiente" selected>Pendiente</option>
                        <option value="parcial">Parcial</option>
                        <option value="pagada">Pagada</option>
                        <option value="cancelada">Cancelada</option>
                    </select>
                </div>
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Método de Pago (Fijado) *</label>
                    <input type="text" id="invoiceMetodoPagoInput" name="MetodoPago" readonly value="Efectivo" class="form-input" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); background-color: var(--gray-100); font-weight: 600;" />
                </div>
            </div>

            <div style="display: flex; gap: 0.75rem;">
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem;">Subtotal Base</label>
                    <input id="newInvoiceSubtotal" name="Subtotal" type="number" step="0.01" class="form-input" readonly placeholder="Auto-calculado" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--gray-300); background-color: var(--gray-50);" />
                </div>
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem;">IVA Total</label>
                    <input id="newInvoiceImpuestos" name="Impuestos" type="number" step="0.01" class="form-input" readonly placeholder="Auto-calculado" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--gray-300); background-color: var(--gray-50);" />
                </div>
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 700; color: var(--purple-900); font-size: 0.8rem;">TOTAL</label>
                    <input id="newInvoiceTotal" name="Total" type="number" step="0.01" class="form-input" readonly placeholder="Auto-calculado" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); background-color: var(--purple-50); font-weight: 700; color: var(--purple-900);" />
                </div>
            </div>

            <div style="background-color: #FEFCE8; border: 1px solid #FDE047; color: #854D0E; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.78rem;">
                ⚠️ Los montos de subtotal e IVA son calculados automáticamente por ítem con su tasa de IVA respectiva.
            </div>

            <div style="display: flex; gap: 0.75rem;">
                <button type="button" onclick="document.getElementById('modal-factura').style.display='none'" 
                        style="flex: 1; border: 2px solid var(--purple-600); color: var(--purple-600); background: transparent; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.88rem; cursor: pointer;">
                    Cancelar
                </button>
                <button type="submit" 
                        style="flex: 1.5; background-color: var(--purple-600); color: white; border: none; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.88rem; cursor: pointer;">
                    📄 Emitir Factura Electrónica
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Registrar Abono / Pago Parcial -->
<div id="modal-abono" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 480px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div style="background: linear-gradient(135deg, #1E40AF, #2563EB); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div style="font-size: 1.1rem; font-weight: 700;">💵 Registrar Abono / Pago Parcial</div>
            <button type="button" onclick="document.getElementById('modal-abono').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white;">&times;</button>
        </div>

        <form asp-controller="Ventas" asp-action="RegistrarAbono" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="abonoVentaId" name="ventaId" />

            <div>
                <label style="font-size: 0.85rem; font-weight: 700; color: var(--purple-900);">Saldo Pendiente de la Venta:</label>
                <div id="abonoSaldoPendienteDisplay" style="font-size: 1.5rem; font-weight: 800; color: #DC2626; margin-top: 0.2rem;">$ 0</div>
            </div>

            <div>
                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Monto a Abonar (COP) *</label>
                <input type="number" id="abonoMontoInput" name="monto" step="0.01" min="1" required class="form-input" style="width: 100%; padding: 0.6rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); font-size: 1rem; font-weight: 700;" placeholder="Ej: 50000" />
            </div>

            <div>
                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Método de Pago *</label>
                <select name="metodoPago" class="form-input" style="width: 100%; padding: 0.6rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                    <option value="Efectivo" selected>Efectivo</option>
                    <option value="Transferencia / PSE">Transferencia / PSE</option>
                    <option value="Tarjeta Débito">Tarjeta Débito</option>
                    <option value="Tarjeta Crédito">Tarjeta Crédito</option>
                </select>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-abono').style.display='none'" style="flex: 1; padding: 0.6rem; border-radius: 0.375rem; border: 1px solid var(--gray-300); background: white; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" style="flex: 1.5; padding: 0.6rem; border-radius: 0.375rem; border: none; background: #2563EB; color: white; font-weight: 700; cursor: pointer;">Registrar Abono y Generar Recibo</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Cobrar Tarjeta de Crédito (Pasarela Sandbox Segura) -->
<div id="modal-tarjeta" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 500px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div style="background: linear-gradient(135deg, #6D28D9, #4C1D95); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div style="font-size: 1.1rem; font-weight: 700;">💳 Pasarela de Pago con Tarjeta</div>
            <button type="button" onclick="document.getElementById('modal-tarjeta').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white;">&times;</button>
        </div>

        <form asp-controller="Ventas" asp-action="CobrarTarjeta" method="post" autocomplete="off" onsubmit="return validarPagoTarjetaCliente()" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="tarjetaVentaId" name="VentaId" />

            <div>
                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Monto a Cobrar (COP) *</label>
                <input type="number" id="tarjetaMontoInput" name="Monto" step="0.01" min="1" required autocomplete="off" class="form-input" style="width: 100%; padding: 0.6rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); font-weight: 700;" />
            </div>

            <div>
                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Número de Tarjeta *</label>
                <input type="text" id="tarjetaNumeroInput" name="NumeroTarjeta" required autocomplete="off" placeholder="4532 1234 5678 9010" maxlength="19" class="form-input" style="width: 100%; padding: 0.6rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); font-family: monospace; font-size: 1rem;" oninput="onNumeroTarjetaInput(this)" />
                <span id="tarjetaLuhnFeedback" style="font-size: 0.75rem; display: block; margin-top: 0.25rem; font-weight: 600;"></span>
            </div>

            <div>
                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Nombre del Titular *</label>
                <input type="text" name="NombreTitular" required autocomplete="off" placeholder="Ej: CARLOS RAMIREZ" class="form-input" style="width: 100%; padding: 0.6rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); text-transform: uppercase;" />
            </div>

            <div style="display: flex; gap: 1rem;">
                <div style="flex: 1;">
                    <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Exp. (MM/YY) *</label>
                    <input type="text" id="tarjetaExpInput" name="FechaExpiracion" required autocomplete="off" placeholder="12/28" maxlength="5" class="form-input" style="width: 100%; padding: 0.6rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); text-align: center;" />
                </div>
                <div style="flex: 1;">
                    <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">CVV *</label>
                    <input type="password" name="Cvv" required autocomplete="off" placeholder="•••" maxlength="4" class="form-input" style="width: 100%; padding: 0.6rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); text-align: center;" />
                </div>
            </div>

            <div style="background: #F3E8FF; padding: 0.6rem 0.8rem; border-radius: 0.375rem; font-size: 0.78rem; color: #5B21B6;">
                🔒 Transacción segura encriptada. Validación Luhn en tiempo real. Las tarjetas terminadas en 9 simularán rechazo bancario de prueba.
            </div>

            <div style="display: flex; gap: 0.75rem;">
                <button type="button" onclick="document.getElementById('modal-tarjeta').style.display='none'" style="flex: 1; padding: 0.6rem; border-radius: 0.375rem; border: 1px solid var(--gray-300); background: white; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" style="flex: 1.5; padding: 0.6rem; border-radius: 0.375rem; border: none; background: #6D28D9; color: white; font-weight: 700; cursor: pointer;">💳 Procesar Pago con Tarjeta</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Detalle del Pedido e Integración con Fórmula Óptica -->
<div id="modal-detalle-pedido" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 620px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3); display: flex; flex-direction: column; max-height: 90vh;">
        <div style="background: linear-gradient(135deg, var(--purple-700), var(--purple-600)); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div style="font-size: 1.15rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem;">
                <span>👁️</span> <span>Detalle del Pedido</span> <span id="detalleModalOrderNumero" style="background: rgba(255,255,255,0.2); padding: 0.2rem 0.5rem; border-radius: 0.375rem; font-size: 0.9rem;"></span>
            </div>
            <button type="button" onclick="closeDetallePedidoModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white;">&times;</button>
        </div>

        <div style="padding: 1.5rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1.25rem;">
            <!-- Información Resumen -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; background-color: var(--purple-50); padding: 1rem; border-radius: 0.5rem; border: 1px solid var(--purple-200);">
                <div>
                    <span style="font-size: 0.75rem; font-weight: 600; color: var(--gray-500); text-transform: uppercase;">Cliente</span>
                    <div id="detalleModalCliente" style="font-weight: 700; color: var(--purple-900); font-size: 0.95rem; margin-top: 0.15rem;"></div>
                </div>
                <div>
                    <span style="font-size: 0.75rem; font-weight: 600; color: var(--gray-500); text-transform: uppercase;">Fecha Pedido</span>
                    <div id="detalleModalFecha" style="font-weight: 600; color: var(--gray-700); font-size: 0.9rem; margin-top: 0.15rem;"></div>
                </div>
                <div>
                    <span style="font-size: 0.75rem; font-weight: 600; color: var(--gray-500); text-transform: uppercase;">Total</span>
                    <div id="detalleModalTotal" style="font-weight: 800; color: var(--purple-900); font-size: 1rem; margin-top: 0.15rem;"></div>
                </div>
            </div>

            <!-- Tabla de Productos del Pedido -->
            <div>
                <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--purple-900); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.35rem;">
                    <span>📦</span> <span>Productos del Pedido</span>
                </h3>
                <div style="border: 1px solid var(--purple-200); border-radius: 0.5rem; overflow: hidden;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
                        <thead style="background-color: var(--purple-100); color: var(--purple-900);">
                            <tr>
                                <th style="padding: 0.6rem 0.75rem; font-weight: 700;">Producto</th>
                                <th style="padding: 0.6rem 0.75rem; font-weight: 700; text-align: center;">Cantidad</th>
                                <th style="padding: 0.6rem 0.75rem; font-weight: 700; text-align: right;">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody id="detalleModalProductosBody">
                            <!-- Inyectado vía JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Sección Fórmula Óptica Asociada -->
            <div id="seccionFormulaOptica" style="display: none; background: #FAF5FF; border: 1.5px solid var(--purple-300); border-radius: 0.5rem; padding: 1.25rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
                    <span style="font-size: 1.25rem;">🩺</span>
                    <div>
                        <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--purple-900); margin: 0;">Fórmula Óptica Asociada</h3>
                        <p style="font-size: 0.78rem; color: var(--purple-700); margin: 0.15rem 0 0 0;">Este pedido contiene lentes que requieren trazabilidad óptica.</p>
                    </div>
                </div>

                <form asp-controller="Ventas" asp-action="VincularFormula" method="post" id="formVincularFormula" style="display: flex; flex-direction: column; gap: 0.75rem;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="detallePedidoOrderId" name="orderId" />

                    <div id="contenedorSelectFormula">
                        <label for="detallePedidoFormulaSelect" style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--purple-900); margin-bottom: 0.25rem;">
                            Seleccionar Fórmula Óptica del Paciente:
                        </label>
                        <select id="detallePedidoFormulaSelect" name="formulaOpticaId" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); font-size: 0.88rem; background-color: white;">
                            <option value="">-- Sin fórmula vinculada --</option>
                        </select>
                    </div>

                    <div id="avisoSinFormulas" style="display: none; background: #EFF6FF; border: 1px solid #BFDBFE; color: #1E40AF; border-radius: 0.375rem; padding: 0.6rem 0.8rem; font-size: 0.82rem; font-weight: 500;">
                        ℹ️ Este paciente no tiene fórmulas ópticas registradas.
                    </div>

                    <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem;">
                        <button type="submit" style="background-color: var(--purple-600); color: white; border: none; padding: 0.5rem 1.25rem; border-radius: 0.375rem; font-weight: 700; font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.35rem; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='var(--purple-700)'" onmouseout="this.style.backgroundColor='var(--purple-600)'">
                            💾 Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div style="padding: 1rem 1.5rem; border-top: 1px solid var(--purple-100); display: flex; justify-content: flex-end; background: var(--gray-50);">
            <button type="button" onclick="closeDetallePedidoModal()" style="padding: 0.5rem 1.25rem; border: 1px solid var(--gray-300); background: white; color: var(--gray-700); border-radius: 0.375rem; font-weight: 600; font-size: 0.85rem; cursor: pointer;">
                Cerrar
            </button>
        </div>
    </div>
</div>
