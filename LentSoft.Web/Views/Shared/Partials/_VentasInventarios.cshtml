@model LentSoft.Web.Models.ViewModels.DashboardVentasViewModel

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;">Consulta de Inventario</h1>
</div>

<!-- Sub-tabs -->
<div style="display: flex; border-bottom: 2px solid var(--purple-200); margin-bottom: 1.5rem; gap: 0.5rem;">
    <a href="?section=inventarios&subtab=productos" 
       style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "productos" || string.IsNullOrEmpty(Model.ActiveSubTab) ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "productos" || string.IsNullOrEmpty(Model.ActiveSubTab) ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px; text-decoration: none;">
        📦 Productos
    </a>
    <a href="?section=inventarios&subtab=historial" 
       style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "historial" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "historial" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px; text-decoration: none;">
        📜 Historial de Movimientos
    </a>
    <a href="?section=inventarios&subtab=pedidos" 
       style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "pedidos" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "pedidos" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px; text-decoration: none;">
        🛒 Pedidos de Ventas
    </a>
</div>

@if (Model.ActiveSubTab == "historial")
{
    <!-- Historial de Movimientos de Inventario -->
    <div class="card" style="padding: 1.5rem; background: white;">
        <div style="margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
            <h2 style="color: var(--purple-900); font-size: 1.25rem; margin: 0;">Movimientos de Stock</h2>
            <span style="font-size: 0.85rem; color: var(--purple-700); font-weight: 600;">Total: @Model.MovimientosTotalCount registros</span>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600); background-color: var(--purple-50);">
                        <th style="padding: 0.75rem;">Fecha</th>
                        <th style="padding: 0.75rem;">Producto</th>
                        <th style="padding: 0.75rem; text-align: center;">Tipo</th>
                        <th style="padding: 0.75rem; text-align: center;">Cantidad</th>
                        <th style="padding: 0.75rem;">Responsable</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.HistorialMovimientos.Any())
                    {
                        @foreach (var mov in Model.HistorialMovimientos)
                        {
                            var badgeTipo = mov.Tipo == "Entrada" ? "#10B981" : (mov.Tipo == "Salida" ? "#EF4444" : "#F59E0B");
                            var prodName = mov.Product?.Nombre ?? mov.NombreProducto ?? ("Producto #" + mov.ProductId);
                            <tr style="border-bottom: 1px solid var(--purple-100);">
                                <td style="padding: 0.75rem; color: var(--gray-600);">@mov.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-900);">@prodName</td>
                                <td style="padding: 0.75rem; text-align: center;">
                                    <span style="background-color: @badgeTipo; color: white; padding: 0.2rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                                        @mov.Tipo
                                    </span>
                                </td>
                                <td style="padding: 0.75rem; text-align: center; font-weight: 700;">@mov.Cantidad</td>
                                <td style="padding: 0.75rem; color: var(--gray-700);">@(mov.Responsable ?? "Sistema")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="padding: 2rem; text-align: center; color: var(--gray-500); font-style: italic;">
                                No se registran movimientos de inventario.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.MovimientosTotalPages > 1)
        {
            <div class="pagination-container">
                <div style="color: var(--gray-600); font-weight: 500;">
                    Página <strong>@Model.MovimientosPage</strong> de <strong>@Model.MovimientosTotalPages</strong>
                </div>
                <div class="pagination-controls">
                    @if (Model.MovimientosPage > 1)
                    {
                        <a href="?section=inventarios&subtab=historial&movPage=@(Model.MovimientosPage - 1)" class="pagination-btn">&laquo; Anterior</a>
                    }
                    @for (int p = 1; p <= Model.MovimientosTotalPages; p++)
                    {
                        if (p == Model.MovimientosPage)
                        {
                            <span class="pagination-btn active">@p</span>
                        }
                        else if (p <= 3 || p > Model.MovimientosTotalPages - 2)
                        {
                            <a href="?section=inventarios&subtab=historial&movPage=@p" class="pagination-btn">@p</a>
                        }
                    }
                    @if (Model.MovimientosPage < Model.MovimientosTotalPages)
                    {
                        <a href="?section=inventarios&subtab=historial&movPage=@(Model.MovimientosPage + 1)" class="pagination-btn">Siguiente &raquo;</a>
                    }
                </div>
            </div>
        }
    </div>
}
else if (Model.ActiveSubTab == "pedidos")
{
    <!-- Pedidos de Ventas (SalesOrder) -->
    <div class="card" style="padding: 1.5rem; background: white;">
        <div style="margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
            <h2 style="color: var(--purple-900); font-size: 1.25rem; margin: 0;">Líneas de Pedidos de Venta</h2>
            <span style="font-size: 0.85rem; color: var(--purple-700); font-weight: 600;">Total: @Model.PedidosVentasTotalCount registros</span>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600); background-color: var(--purple-50);">
                        <th style="padding: 0.75rem;">Pedido</th>
                        <th style="padding: 0.75rem;">Cliente</th>
                        <th style="padding: 0.75rem;">Fecha</th>
                        <th style="padding: 0.75rem;">Producto</th>
                        <th style="padding: 0.75rem; text-align: center;">Cantidad</th>
                        <th style="padding: 0.75rem; text-align: right;">Total</th>
                        <th style="padding: 0.75rem; text-align: center;">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PedidosVentas.Any())
                    {
                        @foreach (var so in Model.PedidosVentas)
                        {
                            var prodName = so.Product != null ? so.Product.Nombre : (!string.IsNullOrEmpty(so.ProductoNombre) ? so.ProductoNombre : "Producto #" + so.ProductoId);
                            <tr style="border-bottom: 1px solid var(--purple-100);">
                                <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-700);">@so.NumeroPedido</td>
                                <td style="padding: 0.75rem; font-weight: 500;">@so.ClienteNombre</td>
                                <td style="padding: 0.75rem; color: var(--gray-600);">@so.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-900);">@prodName</td>
                                <td style="padding: 0.75rem; text-align: center; font-weight: 700;">@so.Cantidad</td>
                                <td style="padding: 0.75rem; text-align: right; font-weight: 700; color: var(--purple-900);">@so.Total.ToString("C")</td>
                                <td style="padding: 0.75rem; text-align: center;">
                                    <span style="background-color: var(--purple-100); color: var(--purple-800); padding: 0.2rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: capitalize;">
                                        @so.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="padding: 2rem; text-align: center; color: var(--gray-500); font-style: italic;">
                                No se registran pedidos de venta en el sistema.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PedidosVentasTotalPages > 1)
        {
            <div class="pagination-container">
                <div style="color: var(--gray-600); font-weight: 500;">
                    Página <strong>@Model.PedidosVentasPage</strong> de <strong>@Model.PedidosVentasTotalPages</strong>
                </div>
                <div class="pagination-controls">
                    @if (Model.PedidosVentasPage > 1)
                    {
                        <a href="?section=inventarios&subtab=pedidos&pedVentasPage=@(Model.PedidosVentasPage - 1)" class="pagination-btn">&laquo; Anterior</a>
                    }
                    @for (int p = 1; p <= Model.PedidosVentasTotalPages; p++)
                    {
                        if (p == Model.PedidosVentasPage)
                        {
                            <span class="pagination-btn active">@p</span>
                        }
                        else if (p <= 3 || p > Model.PedidosVentasTotalPages - 2)
                        {
                            <a href="?section=inventarios&subtab=pedidos&pedVentasPage=@p" class="pagination-btn">@p</a>
                        }
                    }
                    @if (Model.PedidosVentasPage < Model.PedidosVentasTotalPages)
                    {
                        <a href="?section=inventarios&subtab=pedidos&pedVentasPage=@(Model.PedidosVentasPage + 1)" class="pagination-btn">Siguiente &raquo;</a>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Productos y Stock -->
    <div class="card" style="padding: 1.5rem; background: white;">
        <div style="margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
            <input type="text" id="searchInvSales" placeholder="Buscar producto o categoría..." class="form-input" style="width: 300px; padding: 0.45rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" onkeyup="filterTable('searchInvSales', 'tableInvSales')" />
            <span style="font-size: 0.85rem; color: var(--purple-700); font-weight: 600;">Total: @Model.Productos.Count productos</span>
        </div>
        <div style="overflow-x: auto;">
            <table id="tableInvSales" style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600); background-color: var(--purple-50);">
                        <th style="padding: 0.75rem;">ID</th>
                        <th style="padding: 0.75rem;">Producto</th>
                        <th style="padding: 0.75rem; text-align: center;">Categoría</th>
                        <th style="padding: 0.75rem; text-align: center;">Precio</th>
                        <th style="padding: 0.75rem; text-align: center;">Stock</th>
                        <th style="padding: 0.75rem; text-align: center;">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in Model.Productos)
                    {
                        var isAgotado = prod.Stock <= 0;
                        <tr style="border-bottom: 1px solid var(--purple-100);">
                            <td style="padding: 0.75rem; color: var(--gray-500);">#@prod.Id</td>
                            <td style="padding: 0.75rem; font-weight: 500;">@prod.Nombre</td>
                            <td style="padding: 0.75rem; text-align: center; color: var(--gray-600);">@prod.Categoria</td>
                            <td style="padding: 0.75rem; text-align: center; font-weight: 600;">@prod.Precio.ToString("C")</td>
                            <td style="padding: 0.75rem; text-align: center; font-weight: 700; color: @(isAgotado ? "var(--error)" : "var(--purple-900)");">
                                @prod.Stock
                            </td>
                            <td style="padding: 0.75rem; text-align: center;">
                                <span style="background-color: @(isAgotado ? "var(--error)" : "var(--success)"); color: white; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                                    @(isAgotado ? "Agotado" : "Activo")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
