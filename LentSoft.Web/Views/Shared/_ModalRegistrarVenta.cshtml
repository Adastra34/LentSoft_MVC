@model (IEnumerable<LentSoft.Web.Models.Entities.User> Clientes, IEnumerable<LentSoft.Web.Models.Entities.Product> Productos)

<!-- Modal para Registrar Nueva Venta (Múltiples Productos) -->
<div id="modal-venta" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 600px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3); max-height: 90vh; display: flex; flex-direction: column;">
        
        <!-- Header Morado -->
        <div style="background: linear-gradient(135deg, var(--purple-700), var(--purple-600)); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.2rem; font-weight: 700;">
                <span>💳</span> <span data-i18n="modal.sale.title">Registrar Nueva Venta</span>
            </div>
            <button type="button" onclick="document.getElementById('modal-venta').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white; line-height: 1;">&times;</button>
        </div>

        <!-- Formulario -->
        <form asp-controller="Order" asp-action="Create" method="post" onsubmit="return validateSaleForm()" style="padding: 1.5rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1.25rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="saleItemsJson" name="ItemsJson" value="[]" />
            <input type="hidden" id="saleFormulaOpticaId" name="FormulaOpticaId" value="" />

            <!-- Sección 1: Datos del Cliente -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span data-i18n="modal.sale.sec.client">👤 DATOS DEL CLIENTE</span>
                </div>

                <input type="hidden" id="selectedUserId" name="UserId" value="" />

                @{
                    var soloClientes = Model.Clientes?
                        .Where(u => u.Role == "usuario" || string.Equals(u.Role, "usuario", StringComparison.OrdinalIgnoreCase))
                        .ToList() ?? new List<LentSoft.Web.Models.Entities.User>();
                    var clientesPorNombre = soloClientes.OrderBy(u => u.Nombre).ThenBy(u => u.Apellido).ToList();
                    var clientesPorCedula = soloClientes.OrderBy(u => u.NumeroDocumento).ToList();
                }

                <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem;">
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="modal.sale.search.name">🔍 Buscar por Nombre (Clientes)</label>
                        <select id="userSelectNombre" class="form-input" onchange="onClientSelectedByName(this)" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.85rem; background-color: white;">
                            <option value="" data-i18n="modal.sale.search.name.placeholder">-- Buscar por Nombre --</option>
                            @foreach (var user in clientesPorNombre)
                            {
                                <option value="@user.Id" 
                                        data-nombre="@user.Nombre" 
                                        data-apellido="@user.Apellido" 
                                        data-cedula="@user.NumeroDocumento" 
                                        data-telefono="@user.Telefono" 
                                        data-direccion="@user.Direccion">
                                    @user.NombreCompleto @(string.IsNullOrEmpty(user.NumeroDocumento) ? "" : "(C.C. " + user.NumeroDocumento + ")")
                                </option>
                            }
                        </select>
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="modal.sale.search.doc">🪪 Buscar por C.C. / Documento (Clientes)</label>
                        <select id="userSelectCedula" class="form-input" onchange="onClientSelectedByCedula(this)" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.85rem; background-color: white;">
                            <option value="" data-i18n="modal.sale.search.doc.placeholder">-- Buscar por C.C. --</option>
                            @foreach (var user in clientesPorCedula)
                            {
                                <option value="@user.Id" 
                                        data-nombre="@user.Nombre" 
                                        data-apellido="@user.Apellido" 
                                        data-cedula="@user.NumeroDocumento" 
                                        data-telefono="@user.Telefono" 
                                        data-direccion="@user.Direccion">
                                    @(string.IsNullOrEmpty(user.NumeroDocumento) ? "Sin C.C." : "C.C. " + user.NumeroDocumento) - @user.NombreCompleto
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem;">
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="modal.sale.firstname">Nombre *</label>
                        <input id="saleNombre" name="Nombre" type="text" required placeholder="Ej: Juan" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" />
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="modal.sale.lastname">Apellido *</label>
                        <input id="saleApellido" name="Apellido" type="text" required placeholder="Ej: Pérez" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" />
                    </div>
                </div>
                <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem;">
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="modal.sale.docnum">N° Cédula / Documento *</label>
                        <input id="saleCedula" name="NumeroDocumento" type="text" required placeholder="Ej: 1012345678" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" />
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="modal.sale.phone">Teléfono *</label>
                        <input id="saleTelefono" name="Telefono" type="text" required placeholder="Ej: 3001234567" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" />
                    </div>
                </div>
                <div style="margin-bottom: 0.75rem;">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="modal.sale.address">Dirección *</label>
                    <input id="saleDireccion" name="Direccion" type="text" required placeholder="Ej: Calle 123 # 45-67" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" />
                </div>

                <!-- Requisito 3: Panel de Fórmula Óptica de Solo Lectura -->
                <div id="panelFormulaOptica" style="display: none; background: #FAF5FF; border: 1px solid #D8B4FE; border-radius: 0.5rem; padding: 0.85rem; margin-bottom: 0.75rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <span style="font-size: 0.82rem; font-weight: 700; color: #6B21A8; display: flex; align-items: center; gap: 0.35rem;">
                            👁️ Fórmula Óptica Registrada por Optometría
                        </span>
                        <span id="formulaBadgeEstado" style="padding: 0.2rem 0.55rem; border-radius: 9999px; font-size: 0.72rem; font-weight: 700;"></span>
                    </div>
                    <div id="formulaDetalleContenido" style="font-size: 0.8rem; color: #4B5563;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.5rem; background: white; padding: 0.5rem; border-radius: 0.375rem; border: 1px solid #E9D5FF;">
                            <div>
                                <strong style="color: #6B21A8; font-size: 0.75rem;">Ojo Derecho (OD):</strong><br />
                                <span>Esf: <b id="formEsfOD">-</b> | Cil: <b id="formCilOD">-</b> | Eje: <b id="formEjeOD">-</b></span>
                            </div>
                            <div>
                                <strong style="color: #6B21A8; font-size: 0.75rem;">Ojo Izquierdo (OI):</strong><br />
                                <span>Esf: <b id="formEsfOI">-</b> | Cil: <b id="formCilOI">-</b> | Eje: <b id="formEjeOI">-</b></span>
                            </div>
                        </div>
                        <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; font-size: 0.78rem;">
                            <span>Tipo Recomendado: <strong id="formTipoLente" style="color: #581C87;">-</strong></span>
                            <span>Dist. Pupilar: <strong id="formDistPupilar" style="color: #581C87;">-</strong></span>
                            <span>Fecha Examen: <span id="formFechaExamen" style="color: #6B7280;">-</span></span>
                        </div>
                    </div>
                    <div id="formulaSinRegistro" style="display: none; font-size: 0.78rem; color: #6B7280; font-style: italic;">
                        El cliente no cuenta con una fórmula óptica registrada.
                    </div>
                </div>

                <!-- Requisito 3: Alerta Visible para Lentes Graduados sin Fórmula Vigente (no bloqueante) -->
                <div id="alertaFormulaOptica" style="display: none; background: #FFFBEB; border-left: 4px solid #F59E0B; border: 1px solid #FDE68A; padding: 0.65rem 0.85rem; border-radius: 0.375rem; margin-bottom: 0.75rem; font-size: 0.8rem; color: #92400E; align-items: center; gap: 0.5rem;">
                    <span style="font-size: 1.1rem;">⚠️</span>
                    <span><strong>Aviso al vendedor:</strong> Este cliente no tiene una fórmula óptica vigente registrada por el optómetra.</span>
                </div>
            </div>

            <!-- Sección 2: Agregar Productos -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span data-i18n="modal.sale.sec.products">👓 SELECCIONAR PRODUCTOS</span>
                </div>
                <!-- Filtro Inteligente Adaptado a la Fórmula Óptica -->
                <div id="filtroFormulaContainer" style="display: none; margin-bottom: 0.65rem; background: linear-gradient(135deg, #FAF5FF 0%, #F3E8FF 100%); border: 1px solid #D8B4FE; border-radius: 0.5rem; padding: 0.55rem 0.75rem; box-shadow: 0 1px 3px rgba(124, 58, 237, 0.08);">
                    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                        <div style="display: flex; align-items: center; gap: 0.45rem;">
                            <span style="font-size: 1.05rem; line-height: 1;">✨</span>
                            <span style="font-size: 0.8rem; font-weight: 700; color: #581C87;">
                                Catálogo adaptado a fórmula: <span id="filtroFormulaTipoNombre" style="color: #6B21A8; font-weight: 800; background: #EDE9FE; padding: 0.15rem 0.45rem; border-radius: 0.25rem;">-</span>
                            </span>
                        </div>
                        <label style="display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.78rem; font-weight: 700; color: #581C87; user-select: none; margin: 0;">
                            <input type="checkbox" id="chkSoloCompatibles" checked onchange="toggleFiltroFormula(this.checked)" style="accent-color: #7C3AED; width: 16px; height: 16px; cursor: pointer;" />
                            <span>Solo compatibles con fórmula</span>
                        </label>
                    </div>
                    <div id="filtroFormulaInfoSub" style="font-size: 0.72rem; color: #7E22CE; margin-top: 0.25rem; display: flex; align-items: center; gap: 0.35rem;">
                        <span>💡</span>
                        <span>Se filtran y organizan los productos según la prescripción clínica. Desmarca la casilla si deseas ver todo el inventario.</span>
                    </div>
                </div>

                <div style="display: flex; gap: 0.5rem; align-items: flex-end; margin-bottom: 0.3rem;">
                    <div style="flex: 2;">
                        <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="modal.sale.selectproduct">Producto</label>
                        <select id="newSaleProdSelect" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);">
                            <option value="" data-i18n="modal.sale.selectproduct.placeholder">-- Seleccionar Producto --</option>
                            @if (Model.Productos != null)
                            {
                                foreach (var prod in Model.Productos)
                                {
                                    var precioFinal = prod.PrecioDescuento ?? prod.Precio;
                                    <option value="@prod.Id" 
                                            data-nombre="@prod.Nombre" 
                                            data-categoria="@prod.Categoria" 
                                            data-descripcion="@(prod.Descripcion ?? "")"
                                            data-proteccion="@(prod.Proteccion ?? "")"
                                            data-material="@(prod.Material ?? "")"
                                            data-precio="@precioFinal.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                                            data-iva="@prod.PorcentajeIva.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                                            data-stock="@prod.Stock">@prod.Nombre (@precioFinal.ToString("C") - Stock: @prod.Stock)</option>
                                }
                            }
                        </select>
                    </div>
                    <div style="width: 85px;">
                        <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="modal.sale.qty">Cantidad</label>
                        <input id="newSaleQtyInput" type="number" min="1" value="1" class="form-input" style="width: 100%; padding: 0.55rem 0.5rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); text-align: center;" />
                    </div>
                    <button type="button" onclick="addSaleItem()" style="background-color: var(--purple-600); color: white; border: none; padding: 0.6rem 0.9rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.82rem; cursor: pointer; white-space: nowrap; height: 38px;">
                        <span data-i18n="modal.sale.additem">+ Agregar</span>
                    </button>
                </div>
                <div style="margin-bottom: 0.75rem;">
                    <span id="stock-availability-msg" style="font-size: 0.75rem; color: var(--purple-700); font-weight: 600; display: block; min-height: 1rem;"></span>
                </div>

                <!-- Tabla Lista de Productos Agregados -->
                <div style="border: 1px solid var(--purple-200); border-radius: 0.5rem; overflow: hidden; background: var(--gray-50);">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem;">
                        <thead>
                            <tr style="background-color: var(--purple-100); color: var(--purple-900); text-align: left;">
                                <th style="padding: 0.5rem 0.75rem;" data-i18n="modal.sale.selectproduct">Producto</th>
                                <th style="padding: 0.5rem; text-align: center;" data-i18n="modal.sale.qty">Cant.</th>
                                <th style="padding: 0.5rem; text-align: right;" data-i18n="confirmation.unitprice">P. Unit.</th>
                                <th style="padding: 0.5rem; text-align: center;">IVA</th>
                                <th style="padding: 0.5rem 0.75rem; text-align: right;" data-i18n="confirmation.subtotal">Subtotal</th>
                                <th style="padding: 0.5rem; text-align: center;"></th>
                            </tr>
                        </thead>
                        <tbody id="saleItemsTableBody">
                            <tr>
                                <td colspan="6" style="padding: 1rem; text-align: center; color: var(--gray-500); font-style: italic;" data-i18n="modal.sale.noitems">
                                    No ha agregado productos a esta venta aún.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Sección 3: Totales y Descuento -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span data-i18n="modal.sale.sec.summary">💰 DESCUENTO Y TOTALES</span>
                </div>
                <div style="display: flex; gap: 0.75rem;">
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="confirmation.discount">Descuento (%) *</label>
                        <select id="descuentoSelect" name="DescuentoPercent" class="form-input" required onchange="calculateSaleTotals()" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-weight: 600;">
                            @for (int d = 0; d <= 30; d++)
                            {
                                var label = d == 0 ? "0% (Sin Descuento)" : $"{d}% Descuento";
                                <option value="@d">@label</option>
                            }
                        </select>
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="confirmation.subtotal">Subtotal (COP)</label>
                        <input id="subtotalDisplay" type="text" readonly value="COP $0" class="form-input" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--gray-300); background-color: var(--gray-50); font-weight: 600; text-align: right;" />
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 700; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="sales.modal.invoice.total">TOTAL VENTA (COP)</label>
                        <input id="totalDisplay" type="text" readonly value="COP $0" class="form-input" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); background-color: var(--purple-50); font-weight: 800; color: var(--purple-900); text-align: right; font-size: 0.95rem;" />
                    </div>
                </div>
            </div>

            <!-- Sección 4: Pago y Estado -->
            <div style="display: flex; gap: 0.75rem;">
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="sales.modal.invoice.paymentmethod">Método de Pago *</label>
                    <select name="MetodoPagoSimulado" class="form-input" required style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);">
                        <option value="Efectivo" selected data-i18n="sales.modal.invoice.cash">Efectivo</option>
                        <option value="Tarjeta" data-i18n="sales.modal.invoice.card">Tarjeta Débito/Crédito</option>
                        <option value="Transferencia" data-i18n="sales.modal.invoice.transfer">Transferencia / PSE</option>
                    </select>
                </div>
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;" data-i18n="sales.table.status">Estado Inicial *</label>
                    <select name="Estado" class="form-input" required style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);">
                        <option value="pendiente" selected data-i18n="sales.status.pending">Pendiente</option>
                        <option value="procesando" data-i18n="sales.status.processing">Procesando</option>
                        <option value="enviado" data-i18n="sales.status.shipped">Enviado</option>
                        <option value="entregado" data-i18n="sales.status.delivered">Entregado</option>
                    </select>
                </div>
            </div>

            <!-- Botones -->
            <div style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-venta').style.display='none'" 
                        style="flex: 1; border: 2px solid var(--purple-600); color: var(--purple-600); background: transparent; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.88rem; cursor: pointer;" data-i18n="sales.modal.invoice.cancel">
                    Cancelar
                </button>
                <button type="submit" 
                        style="flex: 1.5; background-color: var(--purple-600); color: white; border: none; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.88rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem;">
                    <span>💳</span> <span data-i18n="modal.sale.confirm">Registrar Venta</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let saleItems = [];

    async function addSaleItem() {
        const prodSelect = document.getElementById('newSaleProdSelect');
        const qtyInput = document.getElementById('newSaleQtyInput');
        if (!prodSelect || !qtyInput) return;

        const productId = parseInt(prodSelect.value || '0', 10);
        const cantidad = parseInt(qtyInput.value || '1', 10);

        if (productId <= 0 || cantidad <= 0) {
            if (typeof alertify !== 'undefined') alertify.error('Seleccione un producto válido y una cantidad mayor a 0');
            else alert('Seleccione un producto válido y una cantidad mayor a 0');
            return;
        }

        const existingIndex = saleItems.findIndex(i => i.productId === productId);
        let totalQty = cantidad;
        if (existingIndex >= 0) {
            totalQty += saleItems[existingIndex].cantidad;
        }

        // Validar stock en el servidor
        try {
            const response = await fetch(`/Product/CheckStock?productId=${productId}&quantity=${totalQty}`);
            if (!response.ok) throw new Error('Error al consultar stock.');
            const result = await response.json();

            if (!result.success) {
                if (typeof alertify !== 'undefined') alertify.error(result.message);
                else alert(result.message);
                return;
            }

            if (!result.sufficient) {
                const alreadyInGrid = existingIndex >= 0 ? saleItems[existingIndex].cantidad : 0;
                const msg = `Stock insuficiente en el servidor. Disponible real: ${result.available}.` + 
                            (alreadyInGrid > 0 ? ` Ya tienes ${alreadyInGrid} en la lista.` : '');
                if (typeof alertify !== 'undefined') alertify.error(msg);
                else alert(msg);
                return;
            }

            const opt = prodSelect.options[prodSelect.selectedIndex];
            const nombre = opt.getAttribute('data-nombre');
            const categoria = opt.getAttribute('data-categoria') || '';
            const precio = parseFloat(opt.getAttribute('data-precio') || '0');
            const iva = parseFloat(opt.getAttribute('data-iva') || '19');

            if (existingIndex >= 0) {
                saleItems[existingIndex].cantidad = totalQty;
                saleItems[existingIndex].subtotal = saleItems[existingIndex].cantidad * precio;
            } else {
                saleItems.push({
                    productId: productId,
                    nombre: nombre,
                    categoria: categoria,
                    cantidad: cantidad,
                    precioUnitario: precio,
                    ivaPercent: iva,
                    subtotal: precio * cantidad
                });
            }

            prodSelect.value = '';
            qtyInput.value = 1;

            // Reset stock message
            const stockMsg = document.getElementById('stock-availability-msg');
            if (stockMsg) stockMsg.innerText = '';
            qtyInput.removeAttribute('max');

            renderSaleItems();
            evaluarAlertaLenteGraduado();
        } catch (err) {
            console.error(err);
            if (typeof alertify !== 'undefined') alertify.error('Error al validar el stock en el servidor.');
            else alert('Error al validar el stock en el servidor.');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const prodSelect = document.getElementById('newSaleProdSelect');
        const qtyInput = document.getElementById('newSaleQtyInput');
        const stockMsg = document.getElementById('stock-availability-msg');

        if (prodSelect && qtyInput) {
            prodSelect.addEventListener('change', function () {
                if (!this.value) {
                    qtyInput.removeAttribute('max');
                    if (stockMsg) stockMsg.innerText = '';
                    return;
                }
                const opt = this.options[this.selectedIndex];
                const stock = parseInt(opt.getAttribute('data-stock') || '0', 10);
                qtyInput.setAttribute('max', stock);
                if (stockMsg) {
                    stockMsg.innerText = 'Stock disponible: ' + stock;
                }
                
                let val = parseInt(qtyInput.value || '1', 10);
                if (val > stock) {
                    qtyInput.value = stock;
                }
            });

            qtyInput.addEventListener('input', function () {
                if (!prodSelect.value) return;
                const opt = prodSelect.options[prodSelect.selectedIndex];
                const stock = parseInt(opt.getAttribute('data-stock') || '0', 10);
                let val = parseInt(this.value || '1', 10);
                if (val > stock) {
                    this.value = stock;
                }
                if (val < 1) {
                    this.value = 1;
                }
            });
        }
    });

    function removeSaleItem(index) {
        saleItems.splice(index, 1);
        renderSaleItems();
        evaluarAlertaLenteGraduado();
    }

    function renderSaleItems() {
        const tbody = document.getElementById('saleItemsTableBody');
        if (!tbody) return;

        if (saleItems.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" style="padding: 1rem; text-align: center; color: var(--gray-500); font-style: italic;" data-i18n="modal.sale.noitems">No ha agregado productos a esta venta aún.</td></tr>`;
        } else {
            tbody.innerHTML = saleItems.map((item, idx) => `
                <tr style="border-bottom: 1px solid var(--purple-100);">
                    <td style="padding: 0.5rem 0.75rem; font-weight: 600; color: var(--purple-900);">${item.nombre}</td>
                    <td style="padding: 0.5rem; text-align: center;">${item.cantidad}</td>
                    <td style="padding: 0.5rem; text-align: right;">COP $${Math.round(item.precioUnitario).toLocaleString('es-CO')}</td>
                    <td style="padding: 0.5rem; text-align: center;"><span style="background: var(--purple-100); color: var(--purple-800); padding: 0.15rem 0.45rem; border-radius: 0.25rem; font-weight: 700; font-size: 0.75rem;">${item.ivaPercent}%</span></td>
                    <td style="padding: 0.5rem 0.75rem; text-align: right; font-weight: 700;">COP $${Math.round(item.subtotal).toLocaleString('es-CO')}</td>
                    <td style="padding: 0.5rem; text-align: center;">
                        <button type="button" onclick="removeSaleItem(${idx})" style="background: none; border: none; color: var(--error); cursor: pointer; font-size: 1rem; font-weight: bold;">&times;</button>
                    </td>
                </tr>
            `).join('');
        }

        if (typeof window.applyTranslations === 'function' && typeof window.getCurrentLang === 'function') {
            window.applyTranslations(window.getCurrentLang());
        }

        calculateSaleTotals();
    }

    function calculateSaleTotals() {
        const subtotalSum = saleItems.reduce((acc, i) => acc + i.subtotal, 0);
        const descSelect = document.getElementById('descuentoSelect');
        const descPercent = parseInt(descSelect ? descSelect.value : '0', 10);

        const totalFinal = subtotalSum * (1 - (descPercent / 100));

        const subtotalDisplay = document.getElementById('subtotalDisplay');
        const totalDisplay = document.getElementById('totalDisplay');
        const jsonInput = document.getElementById('saleItemsJson');

        if (subtotalDisplay) subtotalDisplay.value = 'COP $' + Math.round(subtotalSum).toLocaleString('es-CO');
        if (totalDisplay) totalDisplay.value = 'COP $' + Math.round(totalFinal).toLocaleString('es-CO');
        if (jsonInput) jsonInput.value = JSON.stringify(saleItems.map(i => ({ productId: i.productId, cantidad: i.cantidad })));
    }

    function setCustomerFieldsReadOnly(isReadOnly) {
        const fieldIds = ['saleNombre', 'saleApellido', 'saleCedula', 'saleTelefono', 'saleDireccion'];
        fieldIds.forEach(id => {
            const input = document.getElementById(id);
            if (input) {
                input.readOnly = isReadOnly;
                if (isReadOnly) {
                    input.style.backgroundColor = 'var(--gray-100)';
                    input.style.cursor = 'not-allowed';
                } else {
                    input.style.backgroundColor = 'white';
                    input.style.cursor = 'text';
                }
            }
        });
    }

    function populateCustomerData(option) {
        if (!option || !option.value) {
            document.getElementById('selectedUserId').value = '';
            document.getElementById('saleNombre').value = '';
            document.getElementById('saleApellido').value = '';
            document.getElementById('saleCedula').value = '';
            document.getElementById('saleTelefono').value = '';
            document.getElementById('saleDireccion').value = '';
            setCustomerFieldsReadOnly(false);
            consultarFormulaCliente(null);
            return;
        }

        const id = option.value;
        const nombre = option.getAttribute('data-nombre') || '';
        const apellido = option.getAttribute('data-apellido') || '';
        const cedula = option.getAttribute('data-cedula') || '';
        const telefono = option.getAttribute('data-telefono') || '';
        const direccion = option.getAttribute('data-direccion') || '';

        document.getElementById('selectedUserId').value = id;
        document.getElementById('saleNombre').value = nombre;
        document.getElementById('saleApellido').value = apellido;
        document.getElementById('saleCedula').value = cedula;
        document.getElementById('saleTelefono').value = telefono;
        document.getElementById('saleDireccion').value = direccion;

        // Solo ver, no editar (Read-only)
        setCustomerFieldsReadOnly(true);

        // Requisito 3: Consultar fórmula óptica vigente del cliente
        consultarFormulaCliente(id);
    }

    function onClientSelectedByName(selectEl) {
        const val = selectEl.value;
        const cedulaSelect = document.getElementById('userSelectCedula');
        if (cedulaSelect) cedulaSelect.value = val;
        
        const option = selectEl.options[selectEl.selectedIndex];
        populateCustomerData(option);
    }

    function onClientSelectedByCedula(selectEl) {
        const val = selectEl.value;
        const nombreSelect = document.getElementById('userSelectNombre');
        if (nombreSelect) nombreSelect.value = val;
        
        const option = selectEl.options[selectEl.selectedIndex];
        populateCustomerData(option);
    }

    function validateSaleForm() {
        if (saleItems.length === 0) {
            if (typeof alertify !== 'undefined') alertify.error('Debe agregar al menos un producto a la venta.');
            else alert('Debe agregar al menos un producto a la venta.');
            return false;
        }
        return true;
    }

    // ── Requisito 3: Funciones de Conectividad con Fórmula Óptica y Filtro Adaptativo ──
    let currentClientFormula = null;
    let allRawProducts = [];

    function initProductosCache() {
        if (allRawProducts.length > 0) return;
        const prodSelect = document.getElementById('newSaleProdSelect');
        if (!prodSelect) return;
        
        Array.from(prodSelect.querySelectorAll('option')).forEach(opt => {
            if (!opt.value) return; // ignorar placeholder
            allRawProducts.push({
                value: opt.value,
                nombre: opt.getAttribute('data-nombre') || opt.text,
                categoria: (opt.getAttribute('data-categoria') || '').toLowerCase(),
                descripcion: (opt.getAttribute('data-descripcion') || '').toLowerCase(),
                proteccion: (opt.getAttribute('data-proteccion') || '').toLowerCase(),
                material: (opt.getAttribute('data-material') || '').toLowerCase(),
                precio: opt.getAttribute('data-precio') || '0',
                iva: opt.getAttribute('data-iva') || '19',
                stock: opt.getAttribute('data-stock') || '0',
                rawText: opt.text
            });
        });
    }

    function isPrescriptionProduct(categoria, nombre) {
        const text = ((categoria || '') + ' ' + (nombre || '')).toLowerCase();
        return text.includes('lente') || text.includes('contacto') || text.includes('graduad') || text.includes('formulad') || text.includes('oftalmic') || text.includes('oftálmic');
    }

    function evaluarCompatibilidadProducto(prod, formula) {
        if (!formula) return { compatible: true, esRecomendado: false, razon: '' };

        const tipo = (formula.tipoLente || '').toLowerCase();
        const obs = (formula.observaciones || '').toLowerCase();
        const cat = prod.categoria;
        const nom = prod.nombre.toLowerCase();
        const desc = prod.descripcion;
        const prot = prod.proteccion;
        const fullText = `${cat} ${nom} ${desc} ${prot}`;

        // Caso 1: Prescripción de Lentes de Contacto
        const esFormulaContacto = tipo.includes('contacto');
        if (esFormulaContacto) {
            if (cat === 'lentes-contacto' || fullText.includes('contacto')) {
                if (tipo.includes('blando') && fullText.includes('blando')) {
                    return { compatible: true, esRecomendado: true, razon: 'Lente de contacto blando formulado' };
                }
                if (tipo.includes('rígido') && fullText.includes('rígido')) {
                    return { compatible: true, esRecomendado: true, razon: 'Lente de contacto rígido formulado' };
                }
                return { compatible: true, esRecomendado: true, razon: 'Lente de contacto compatible' };
            }
            // Insumos y accesorios para lentes de contacto
            if (fullText.includes('solución') || fullText.includes('solucion') || fullText.includes('líquido') || fullText.includes('gotas') || fullText.includes('limpiador')) {
                return { compatible: true, esRecomendado: false, razon: 'Solución/Cuidado de lentes de contacto' };
            }
            return { compatible: false, esRecomendado: false, razon: '' };
        }

        // Caso 2: Prescripción de Lentes Oftálmicos (Monofocal, Bifocal, Progresivo, Graduado)
        if (cat === 'lentes-graduados' || fullText.includes('graduad') || fullText.includes('oftalmic') || fullText.includes('oftálmic')) {
            if (tipo.includes('progresivo') && (fullText.includes('progresiv') || fullText.includes('multifocal'))) {
                return { compatible: true, esRecomendado: true, razon: 'Lente Progresivo sugerido' };
            }
            if (tipo.includes('bifocal') && fullText.includes('bifocal')) {
                return { compatible: true, esRecomendado: true, razon: 'Lente Bifocal sugerido' };
            }
            if ((tipo.includes('antirreflejo') || obs.includes('antirreflejo')) && (fullText.includes('antirreflejo') || fullText.includes('ar'))) {
                return { compatible: true, esRecomendado: true, razon: 'Tratamiento Antirreflejo formulado' };
            }
            if ((tipo.includes('azul') || tipo.includes('blue') || obs.includes('azul') || obs.includes('blue')) && (fullText.includes('azul') || fullText.includes('blue'))) {
                return { compatible: true, esRecomendado: true, razon: 'Filtro Luz Azul formulado' };
            }
            if (tipo.includes('monofocal')) {
                return { compatible: true, esRecomendado: true, razon: 'Lente Monofocal compatible' };
            }
            return { compatible: true, esRecomendado: true, razon: 'Lente Graduado compatible' };
        }

        // Monturas aptas para graduación
        if (cat === 'monturas' || fullText.includes('montura') || fullText.includes('marco')) {
            return { compatible: true, esRecomendado: false, razon: 'Montura apta para graduación' };
        }

        // Accesorios compatibles
        if (cat === 'accesorios' && (fullText.includes('estuche') || fullText.includes('paño') || fullText.includes('limpiador') || fullText.includes('cordón') || fullText.includes('cordon'))) {
            return { compatible: true, esRecomendado: false, razon: 'Accesorio compatible' };
        }

        // Lentes de sol formulables
        if (cat === 'lentes-sol' && (fullText.includes('graduable') || fullText.includes('polarizado') || fullText.includes('uv'))) {
            return { compatible: true, esRecomendado: false, razon: 'Gafa con protección' };
        }

        return { compatible: false, esRecomendado: false, razon: '' };
    }

    function crearOptionElement(p, esEstrella, tag) {
        const opt = document.createElement('option');
        opt.value = p.value;
        opt.setAttribute('data-nombre', p.nombre);
        opt.setAttribute('data-categoria', p.categoria);
        opt.setAttribute('data-descripcion', p.descripcion);
        opt.setAttribute('data-proteccion', p.proteccion);
        opt.setAttribute('data-material', p.material);
        opt.setAttribute('data-precio', p.precio);
        opt.setAttribute('data-iva', p.iva);
        opt.setAttribute('data-stock', p.stock);

        const prefix = esEstrella ? '⭐ ' : '';
        const suffix = tag ? ` [${tag}]` : '';
        opt.textContent = `${prefix}${p.rawText}${suffix}`;
        return opt;
    }

    function aplicarFiltroProductos(soloCompatibles) {
        initProductosCache();
        const select = document.getElementById('newSaleProdSelect');
        if (!select || allRawProducts.length === 0) return;

        const valorPrevio = select.value;
        select.innerHTML = '';

        const defaultOpt = document.createElement('option');
        defaultOpt.value = '';
        defaultOpt.textContent = '-- Seleccionar Producto --';
        select.appendChild(defaultOpt);

        const f = (currentClientFormula && currentClientFormula.encontrado && currentClientFormula.formula) ? currentClientFormula.formula : null;

        if (!f) {
            allRawProducts.forEach(p => {
                select.appendChild(crearOptionElement(p, false, ''));
            });
            if (valorPrevio) select.value = valorPrevio;
            return;
        }

        const evaluados = allRawProducts.map(p => {
            const evalResult = evaluarCompatibilidadProducto(p, f);
            return { product: p, ...evalResult };
        });

        const recomendados = evaluados.filter(e => e.esRecomendado);
        const compatiblesOtros = evaluados.filter(e => e.compatible && !e.esRecomendado);
        const noCompatibles = evaluados.filter(e => !e.compatible);

        if (soloCompatibles) {
            if (recomendados.length > 0) {
                const grpRec = document.createElement('optgroup');
                grpRec.label = `⭐ RECOMENDADOS SEGÚN FÓRMULA (${recomendados.length})`;
                recomendados.forEach(e => grpRec.appendChild(crearOptionElement(e.product, true, e.razon)));
                select.appendChild(grpRec);
            }

            if (compatiblesOtros.length > 0) {
                const grpComp = document.createElement('optgroup');
                grpComp.label = `👓 MONTURAS Y COMPONENTES COMPATIBLES (${compatiblesOtros.length})`;
                compatiblesOtros.forEach(e => grpComp.appendChild(crearOptionElement(e.product, false, e.razon)));
                select.appendChild(grpComp);
            }

            if (recomendados.length === 0 && compatiblesOtros.length === 0) {
                const grpTodos = document.createElement('optgroup');
                grpTodos.label = '📦 TODOS LOS PRODUCTOS (Sin coincidencias estrictas)';
                allRawProducts.forEach(p => grpTodos.appendChild(crearOptionElement(p, false, '')));
                select.appendChild(grpTodos);
            }
        } else {
            if (recomendados.length > 0) {
                const grpRec = document.createElement('optgroup');
                grpRec.label = `⭐ RECOMENDADOS SEGÚN FÓRMULA (${recomendados.length})`;
                recomendados.forEach(e => grpRec.appendChild(crearOptionElement(e.product, true, e.razon)));
                select.appendChild(grpRec);
            }

            if (compatiblesOtros.length > 0) {
                const grpComp = document.createElement('optgroup');
                grpComp.label = `👓 MONTURAS Y COMPATIBLES (${compatiblesOtros.length})`;
                compatiblesOtros.forEach(e => grpComp.appendChild(crearOptionElement(e.product, false, e.razon)));
                select.appendChild(grpComp);
            }

            if (noCompatibles.length > 0) {
                const grpOtros = document.createElement('optgroup');
                grpOtros.label = `📦 OTROS PRODUCTOS DEL CATÁLOGO (${noCompatibles.length})`;
                noCompatibles.forEach(e => grpOtros.appendChild(crearOptionElement(e.product, false, '')));
                select.appendChild(grpOtros);
            }
        }

        if (valorPrevio) {
            select.value = valorPrevio;
        }
    }

    function toggleFiltroFormula(checked) {
        aplicarFiltroProductos(checked);
        evaluarAlertaLenteGraduado();
    }

    async function consultarFormulaCliente(userId) {
        initProductosCache();
        const panel = document.getElementById('panelFormulaOptica');
        const badge = document.getElementById('formulaBadgeEstado');
        const contenido = document.getElementById('formulaDetalleContenido');
        const sinReg = document.getElementById('formulaSinRegistro');
        const hiddenId = document.getElementById('saleFormulaOpticaId');
        const filtroContainer = document.getElementById('filtroFormulaContainer');
        const filtroTipoNombre = document.getElementById('filtroFormulaTipoNombre');
        const chkSolo = document.getElementById('chkSoloCompatibles');

        if (!userId) {
            currentClientFormula = null;
            if (panel) panel.style.display = 'none';
            if (hiddenId) hiddenId.value = '';
            if (filtroContainer) filtroContainer.style.display = 'none';
            aplicarFiltroProductos(false);
            evaluarAlertaLenteGraduado();
            return;
        }

        try {
            const res = await fetch(`/Ventas/GetFormulaVigentePorCliente?userId=${encodeURIComponent(userId)}`);
            if (!res.ok) throw new Error('Error al consultar fórmula');
            const data = await res.json();
            currentClientFormula = data;

            if (panel) panel.style.display = 'block';

            if (data.encontrado && data.formula) {
                const f = data.formula;
                if (hiddenId) hiddenId.value = data.esVigente ? f.id : '';

                if (contenido) contenido.style.display = 'block';
                if (sinReg) sinReg.style.display = 'none';

                document.getElementById('formEsfOD').innerText = f.esferaOD || '-';
                document.getElementById('formCilOD').innerText = f.cilindroOD || '-';
                document.getElementById('formEjeOD').innerText = f.ejeOD || '-';

                document.getElementById('formEsfOI').innerText = f.esferaOI || '-';
                document.getElementById('formCilOI').innerText = f.cilindroOI || '-';
                document.getElementById('formEjeOI').innerText = f.ejeOI || '-';

                document.getElementById('formTipoLente').innerText = f.tipoLente || 'Estándar';
                document.getElementById('formDistPupilar').innerText = f.distanciaPupilar || 'N/A';
                document.getElementById('formFechaExamen').innerText = f.fechaFormato || f.fecha;

                if (badge) {
                    if (data.esVigente) {
                        badge.innerText = 'VIGENTE';
                        badge.style.backgroundColor = '#10B981';
                        badge.style.color = 'white';
                    } else {
                        badge.innerText = 'VENCIDA';
                        badge.style.backgroundColor = '#EF4444';
                        badge.style.color = 'white';
                    }
                }

                // Activar banner de catálogo adaptado a la fórmula
                if (filtroContainer) filtroContainer.style.display = 'block';
                if (filtroTipoNombre) filtroTipoNombre.innerText = f.tipoLente || 'Fórmula Registrada';
                if (chkSolo) chkSolo.checked = true;

                // Adaptar el selector de productos automáticamente
                aplicarFiltroProductos(true);
            } else {
                if (hiddenId) hiddenId.value = '';
                if (contenido) contenido.style.display = 'none';
                if (sinReg) sinReg.style.display = 'block';
                if (badge) {
                    badge.innerText = 'SIN FÓRMULA';
                    badge.style.backgroundColor = '#9CA3AF';
                    badge.style.color = 'white';
                }
                if (filtroContainer) filtroContainer.style.display = 'none';
                aplicarFiltroProductos(false);
            }
        } catch (e) {
            console.warn('No se pudo cargar la fórmula óptica:', e);
            currentClientFormula = null;
            if (panel) panel.style.display = 'none';
            if (filtroContainer) filtroContainer.style.display = 'none';
            aplicarFiltroProductos(false);
        }

        evaluarAlertaLenteGraduado();
    }

    function evaluarAlertaLenteGraduado() {
        const alerta = document.getElementById('alertaFormulaOptica');
        if (!alerta) return;

        // Determinar si el cliente seleccionado tiene fórmula vigente
        const tieneFormulaVigente = currentClientFormula && currentClientFormula.encontrado && currentClientFormula.esVigente;

        // Comprobar producto actualmente preseleccionado en el combo
        const prodSelect = document.getElementById('newSaleProdSelect');
        let hayProductoGraduado = false;

        if (prodSelect && prodSelect.value) {
            const opt = prodSelect.options[prodSelect.selectedIndex];
            const cat = opt.getAttribute('data-categoria') || '';
            const nom = opt.getAttribute('data-nombre') || '';
            if (isPrescriptionProduct(cat, nom)) {
                hayProductoGraduado = true;
            }
        }

        // Comprobar productos ya agregados en la lista de venta
        if (!hayProductoGraduado && typeof saleItems !== 'undefined') {
            for (let item of saleItems) {
                if (isPrescriptionProduct(item.categoria, item.nombre)) {
                    hayProductoGraduado = true;
                    break;
                }
            }
        }

        if (hayProductoGraduado && !tieneFormulaVigente) {
            alerta.style.display = 'flex';
        } else {
            alerta.style.display = 'none';
        }
    }

    // Escuchar eventos en la selección de producto y precargar catálogo
    document.addEventListener('DOMContentLoaded', () => {
        initProductosCache();
        const prodSelect = document.getElementById('newSaleProdSelect');
        if (prodSelect) {
            prodSelect.addEventListener('change', evaluarAlertaLenteGraduado);
        }
    });
</script>
