            <!-- Modal para Generar Pedido de Venta desde Fórmula Óptica -->
            <div id="modal-crear-pedido-formula" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 500px; background: white; border-radius: 0.5rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); max-height: 90vh; overflow-y: auto;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--purple-100); padding-bottom: 0.75rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem; display: flex; align-items: center; gap: 0.5rem;" data-i18n="optometra.formula.modal.title">
                            <icon name="shopping-bag" class="icon-md" style="color: var(--purple-600);" />
                            <span>Generar Pedido de Venta</span>
                        </h2>
                        <button type="button" onclick="cerrarModalCrearPedidoFormula()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500); line-height: 1;">&times;</button>
                    </div>

                    <div id="pedido-formula-error" style="display: none; background-color: #FEE2E2; color: #991B1B; padding: 0.65rem 0.85rem; border-radius: 0.375rem; font-size: 0.85rem; border: 1px solid #FCA5A5; margin-bottom: 1rem; align-items: center; gap: 0.5rem;">
                        <icon name="alert-circle" class="icon-sm" style="flex-shrink: 0;" />
                        <span id="pedido-formula-error-msg"></span>
                    </div>

                    <form id="form-crear-pedido-formula" onsubmit="enviarCrearPedidoFormula(event)" style="display:flex; flex-direction:column; gap:1rem;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="formulaId" id="pedido-formula-id" />

                        <!-- Datos de solo lectura de la fórmula -->
                        <div style="background-color: var(--purple-50); border: 1px solid var(--purple-100); border-radius: 0.375rem; padding: 0.85rem; font-size: 0.85rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
                            <div>
                                <span style="color: var(--gray-500); font-size: 0.75rem; font-weight: 600; text-transform: uppercase;" data-i18n="optometra.formula.modal.patient">Paciente</span>
                                <div id="pedido-formula-paciente" style="font-weight: 600; color: var(--purple-950);"></div>
                            </div>
                            <div>
                                <span style="color: var(--gray-500); font-size: 0.75rem; font-weight: 600; text-transform: uppercase;" data-i18n="optometra.formula.modal.date">Fecha</span>
                                <div id="pedido-formula-fecha" style="font-weight: 600; color: var(--gray-700);"></div>
                            </div>
                            <div style="grid-column: span 2;">
                                <span style="color: var(--gray-500); font-size: 0.75rem; font-weight: 600; text-transform: uppercase;" data-i18n="optometra.formula.modal.lens">Tipo de Lente</span>
                                <div id="pedido-formula-tipolente" style="font-weight: 600; color: var(--purple-800);"></div>
                            </div>
                        </div>

                        <!-- Selector de Producto -->
                        <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);" data-i18n="optometra.formula.modal.product">Producto en Inventario *</label>
                            <select name="productId" id="pedido-formula-productid" class="form-input" required style="width: 100%; padding: 0.5rem; border: 1.5px solid var(--purple-200); border-radius: 0.375rem; font-size: 0.875rem; background: white;" onchange="actualizarMaxCantidadStock()">
                                <option value="" data-i18n="optometra.formula.modal.selectproduct">-- Seleccionar producto en inventario --</option>
                                @foreach (var prod in Model.ProductosDisponibles)
                                {
                                    <option value="@prod.Id" data-stock="@prod.Stock" data-precio="@prod.Precio">
                                        @prod.Nombre - Stock: @prod.Stock - $@prod.Precio.ToString("N0")
                                    </option>
                                }
                            </select>
                            <small id="pedido-formula-stock-hint" style="color: var(--gray-500); font-size: 0.75rem;"></small>
                        </div>

                        <!-- Cantidad -->
                        <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);" data-i18n="optometra.formula.modal.qty">Cantidad *</label>
                            <input name="cantidad" id="pedido-formula-cantidad" type="number" min="1" max="10000" value="1" class="form-input" required style="width: 100%; padding: 0.5rem; border: 1.5px solid var(--purple-200); border-radius: 0.375rem; font-size: 0.875rem;" />
                        </div>

                        <!-- Notas Opcionales -->
                        <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);" data-i18n="optometra.formula.modal.notes">Notas / Observaciones (opcional)</label>
                            <textarea name="notas" id="pedido-formula-notas" rows="2" maxlength="250" placeholder="Instrucciones para taller o laboratorio..." class="form-input" style="width: 100%; padding: 0.5rem; border: 1.5px solid var(--purple-200); border-radius: 0.375rem; font-size: 0.875rem;"></textarea>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="optometra-modal-actions" style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                            <button type="button" onclick="cerrarModalCrearPedidoFormula()" style="flex: 1; padding: 0.55rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer; font-weight: 600;" data-i18n="optometra.formula.modal.cancel">Cancelar</button>
                            <button type="submit" id="btn-submit-pedido-formula" style="flex: 1; padding: 0.55rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;">
                                <icon name="check" class="icon-sm" /> <span data-i18n="optometra.formula.modal.submit">Generar Pedido</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>