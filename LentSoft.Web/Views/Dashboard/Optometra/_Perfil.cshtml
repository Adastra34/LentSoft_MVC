@model DashboardOptometraViewModel

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem; font-family: var(--font-primary, sans-serif);">Perfil Profesional</h1>
                <button onclick="document.getElementById('modal-editar-perfil').style.display='flex'" class="btn" style="background-color: var(--purple-600); color: white; padding: 0.6rem 1rem; border: none; border-radius: 0.375rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                    <icon name="pencil" class="icon-sm" /> <span>Editar Perfil</span>
                </button>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; max-width: 900px; margin-bottom: 2rem;">
                <!-- Tarjeta Lateral (Foto / Info Principal) -->
                <div class="card" style="padding: 2rem; background: white; border-radius: 0.5rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; align-items: center; text-align: center;">
                    @if (!string.IsNullOrEmpty(Model.UsuarioActual?.FotoUrl))
                    {
                        <img src="@Model.UsuarioActual.FotoUrl" alt="Foto de Perfil" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 4px solid var(--purple-100); margin-bottom: 1rem;" />
                    }
                    else
                    {
                        <div style="width: 120px; height: 120px; border-radius: 50%; background-color: var(--purple-600); color: white; display: flex; align-items: center; justify-content: center; font-size: 3.5rem; font-weight: bold; margin-bottom: 1rem;">
                            @(Model.UsuarioActual?.Nombre?.FirstOrDefault() ?? 'O')
                        </div>
                    }
                    
                    <h2 style="margin: 0; color: var(--purple-900); font-size: 1.35rem; font-family: var(--font-primary, sans-serif);">@Model.UsuarioActual?.NombreCompleto</h2>
                    <p style="margin: 0.25rem 0 0 0; color: var(--purple-600); font-weight: 600; font-size: 0.9rem;">Especialista Optómetra</p>
                    <span style="background-color: var(--purple-100); color: var(--purple-800); font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.75rem; border-radius: 9999px; margin-top: 0.75rem;">
                        R.M. @(Model.UsuarioActual?.RegistroMedico ?? "Sin registro")
                    </span>
                </div>

                <!-- Tarjeta de Detalles de Credenciales -->
                <div class="card" style="padding: 2rem; background: white; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                    <h3 style="margin-top: 0; color: var(--purple-900); font-size: 1.1rem; border-bottom: 1px solid var(--purple-100); padding-bottom: 0.5rem; margin-bottom: 1.25rem;">Credenciales Clínicas & Académicas</h3>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; font-size: 0.9rem;">
                        <div>
                            <label style="color: var(--gray-500); font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Universidad de Egreso</label>
                            <p style="margin: 0.25rem 0 0 0; font-weight: 600; color: var(--gray-800);">@(Model.UsuarioActual?.Universidad ?? "No registrada")</p>
                        </div>
                        <div>
                            <label style="color: var(--gray-500); font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Especialidad / Detalle</label>
                            <p style="margin: 0.25rem 0 0 0; font-weight: 600; color: var(--gray-800);">@(Model.UsuarioActual?.EspecialidadDetalle ?? "Optometría General")</p>
                        </div>
                        <div>
                            <label style="color: var(--gray-500); font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Años de Experiencia</label>
                            <p style="margin: 0.25rem 0 0 0; font-weight: 600; color: var(--gray-800);">@(Model.UsuarioActual?.AniosExperiencia != null ? Model.UsuarioActual.AniosExperiencia + " años" : "No registrado")</p>
                        </div>
                        <div>
                            <label style="color: var(--gray-500); font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Registro Médico Profesional</label>
                            <p style="margin: 0.25rem 0 0 0; font-weight: 600; color: var(--gray-800);">@(Model.UsuarioActual?.RegistroMedico ?? "No registrado")</p>
                        </div>
                    </div>

                    <h3 style="color: var(--purple-900); font-size: 1.1rem; border-bottom: 1px solid var(--purple-100); padding-bottom: 0.5rem; margin-top: 2rem; margin-bottom: 1.25rem;">Información de Contacto</h3>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; font-size: 0.9rem;">
                        <div>
                            <label style="color: var(--gray-500); font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Correo Electrónico</label>
                            <p style="margin: 0.25rem 0 0 0; font-weight: 600; color: var(--gray-800);">@Model.UsuarioActual?.Email</p>
                        </div>
                        <div>
                            <label style="color: var(--gray-500); font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Teléfono de Contacto</label>
                            <p style="margin: 0.25rem 0 0 0; font-weight: 600; color: var(--gray-800);">@(Model.UsuarioActual?.Telefono ?? "No registrado")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal para Editar Perfil Profesional -->
            <div id="modal-editar-perfil" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 550px; background: white; border-radius: 0.5rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); max-height: 90vh; overflow-y: auto;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--purple-100); padding-bottom:0.5rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem;">Editar Perfil Profesional</h2>
                        <button onclick="document.getElementById('modal-editar-perfil').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
                    </div>

                    <form asp-controller="Optometra" asp-action="UpdateProfile" method="post" style="display:flex; flex-direction:column; gap:1rem;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Nombre</label>
                                <input name="nombre" value="@Model.UsuarioActual?.Nombre" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Apellido</label>
                                <input name="apellido" value="@Model.UsuarioActual?.Apellido" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Email</label>
                                <input name="email" value="@Model.UsuarioActual?.Email" type="email" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Teléfono</label>
                                <input name="telefono" value="@Model.UsuarioActual?.Telefono" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Registro Médico Profesional</label>
                                <input name="registroMedico" value="@Model.UsuarioActual?.RegistroMedico" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Universidad de Egreso</label>
                                <input name="universidad" value="@Model.UsuarioActual?.Universidad" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Especialidad / Detalle</label>
                                <input name="especialidadDetalle" value="@Model.UsuarioActual?.EspecialidadDetalle" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Años Experiencia</label>
                                <input name="aniosExperiencia" value="@Model.UsuarioActual?.AniosExperiencia" type="number" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                        </div>

                        <div class="optometra-modal-actions" style="display: flex; gap: 1rem; margin-top: 1rem;">
                            <button type="button" onclick="document.getElementById('modal-editar-perfil').style.display='none'" style="flex: 1; padding: 0.5rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer;">Cancelar</button>
                            <button type="submit" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600;">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>