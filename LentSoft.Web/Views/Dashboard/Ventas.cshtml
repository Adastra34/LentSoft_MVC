                    </div>
                </div>
            </div>
        }

    </main>
</div>

<!-- Modal para Nueva Factura (Estilo DIAN) -->
<div id="modal-factura" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 550px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        
        <!-- Header Morado Tipo DIAN -->
        <div style="background: linear-gradient(135deg, var(--purple-700), var(--purple-600)); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.2rem; font-weight: 700;">
                    <span>📄</span> <span data-i18n="sales.modal.invoice.title">Factura Electrónica de Venta</span>
                </div>
                <div style="font-size: 0.78rem; color: var(--purple-100); margin-top: 0.25rem; font-weight: 500;" data-i18n="sales.modal.invoice.resolution">
                    Resolución DIAN Nº 18764028920000 | Rango: FAC-0001 a FAC-5000
                </div>
            </div>
            <button type="button" onclick="document.getElementById('modal-factura').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white; line-height: 1;">&times;</button>
        </div>

        <!-- Formulario DIAN -->
        <form asp-controller="Invoice" asp-action="Create" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
            @Html.AntiForgeryToken()

            <!-- Seccion 1: Datos del Pedido -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span data-i18n="sales.modal.invoice.sec1">📋 DATOS DEL PEDIDO</span>
                </div>
                <div class="form-group">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;" data-i18n="sales.modal.invoice.orderassoc">Pedido Asociado *</label>
                    <select name="OrderId" class="form-input" required style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" onchange="updateNewInvoiceAmounts(this)">
                        <option value="" data-i18n="sales.modal.invoice.selectorder">-- Seleccionar Pedido --</option>
                        @foreach (var ord in Model.PedidosDisponibles)
                        {
                            var usrName = ord.User != null ? ord.User.NombreCompleto : "Cliente";
                            <option value="@ord.Id" data-total="@ord.Total">#ORD-@ord.Id.ToString("D4") - @usrName (@ord.Total.ToString("C"))</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Seccion 2: Datos de Facturación -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span data-i18n="sales.modal.invoice.sec2">📑 DATOS DE FACTURACIÓN (NÚMERO AUTO-GENERADO)</span>
                </div>
                <div style="display: flex; gap: 1rem;">
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;" data-i18n="sales.modal.invoice.status">Estado *</label>
                        <select name="Estado" class="form-input" required style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);">
                            <option value="pendiente" selected data-i18n="sales.status.pending">Pendiente</option>
                            <option value="pagada" data-i18n="sales.invoices.paid">Pagada</option>
                            <option value="cancelada" data-i18n="sales.status.cancelled">Cancelada</option>
                        </select>
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;" data-i18n="sales.modal.invoice.paymentmethod">Método de Pago *</label>
                        <select name="MetodoPago" class="form-input" required style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);">
                            <option value="Efectivo" selected data-i18n="sales.modal.invoice.cash">Efectivo</option>
                            <option value="Tarjeta" data-i18n="sales.modal.invoice.card">Tarjeta Débito/Crédito</option>
                            <option value="Transferencia" data-i18n="sales.modal.invoice.transfer">Transferencia / PSE</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Seccion 3: Valores -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span data-i18n="sales.modal.invoice.sec3">💰 VALORES (IVA 19% — ART. 468 E.T.)</span>
                </div>
                <div style="display: flex; gap: 0.75rem;">
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem; margin-bottom: 0.35rem; display: block;" data-i18n="sales.modal.invoice.subtotal">Subtotal</label>
                        <input id="newInvoiceSubtotal" name="Subtotal" type="number" step="0.01" class="form-input" readonly placeholder="Auto-calculado" data-i18n-placeholder="sales.modal.invoice.autocalc" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--gray-300); background-color: var(--gray-50);" />
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem; margin-bottom: 0.35rem; display: block;" data-i18n="sales.modal.invoice.tax">IVA 19%</label>
                        <input id="newInvoiceImpuestos" name="Impuestos" type="number" step="0.01" class="form-input" readonly placeholder="Auto-calculado" data-i18n-placeholder="sales.modal.invoice.autocalc" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--gray-300); background-color: var(--gray-50);" />
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 700; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.35rem; display: block;" data-i18n="sales.modal.invoice.total">TOTAL</label>
                        <input id="newInvoiceTotal" name="Total" type="number" step="0.01" class="form-input" readonly placeholder="Auto-calculado" data-i18n-placeholder="sales.modal.invoice.autocalc" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); background-color: var(--purple-50); font-weight: 700; color: var(--purple-900);" />
                    </div>
                </div>
            </div>

            <!-- Warning Box CUFE DIAN -->
            <div style="background-color: #FEFCE8; border: 1px solid #FDE047; color: #854D0E; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.78rem; line-height: 1.4; display: flex; gap: 0.5rem; align-items: flex-start;">
                <span style="font-size: 0.9rem;">⚠️</span>
                <div data-i18n="sales.modal.invoice.warning">
                    Al crear esta factura se generará un <strong>CUFE</strong> (Código Único de Factura Electrónica) y estará disponible para descarga en formato PDF conforme a la Resolución DIAN.
                </div>
            </div>

            <!-- Botones -->
            <div style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-factura').style.display='none'" 
                        style="flex: 1; border: 2px solid var(--purple-600); color: var(--purple-600); background: transparent; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.88rem; cursor: pointer;" data-i18n="sales.modal.invoice.cancel">
                    Cancelar
                </button>
                <button type="submit" 
                        style="flex: 1.5; background-color: var(--purple-600); color: white; border: none; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.88rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem;">
                    <span data-i18n="sales.modal.invoice.emit">📄 Emitir Factura Electrónica</span>
                </button>
            </div>
        </form>
    </div>
</div>

<partial name="_ModalRegistrarVenta" model="((IEnumerable<LentSoft.Web.Models.Entities.User>)Model.Clientes, (IEnumerable<LentSoft.Web.Models.Entities.Product>)Model.Productos)" />

<script>
    function filterTable(inputId, tableId) {
        const input = document.getElementById(inputId);
        if (!input) return;
        const filter = input.value.toLowerCase();
        const table = document.getElementById(tableId);
        if (!table) return;
        const trs = table.getElementsByTagName('tr');

        for (let i = 1; i < trs.length; i++) {
            let show = false;
            const tds = trs[i].getElementsByTagName('td');
            for (let j = 0; j < tds.length; j++) {
                if (tds[j] && tds[j].textContent.toLowerCase().includes(filter)) {
                    show = true;
                    break;
                }
            }
            trs[i].style.display = show ? '' : 'none';
        }
    }

    function toggleFilterMenu(submodule) {
        const menu = document.getElementById('filter-menu-' + submodule);
        if (!menu) return;
        const isVisible = menu.style.display === 'block';
        document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
        menu.style.display = isVisible ? 'none' : 'block';
    }

    function toggleCategoryMenu(submodule) {
        const menu = document.getElementById('category-menu-' + submodule);
        if (!menu) return;
        const isVisible = menu.style.display === 'block';
        document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
        menu.style.display = isVisible ? 'none' : 'block';
    }

    function filterTableByValue(inputId, tableId, value) {
        const input = document.getElementById(inputId);
        if (input) {
            input.value = value;
            filterTable(inputId, tableId);
        }
        document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
    }

    document.addEventListener('click', function(e) {
        if (!e.target.closest('[id^="filter-menu-"]') && !e.target.closest('[id^="category-menu-"]') && !e.target.closest('button')) {
            document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
        }
    });

    function updateNewInvoiceAmounts(selectElem) {
        const selectedOpt = selectElem.options[selectElem.selectedIndex];
        const total = parseFloat(selectedOpt.getAttribute('data-total') || '0');
        if (total > 0) {
            const subtotal = (total / 1.19).toFixed(2);
            const impuestos = (total - subtotal).toFixed(2);
            document.getElementById('newInvoiceSubtotal').value = subtotal;
            document.getElementById('newInvoiceImpuestos').value = impuestos;
            document.getElementById('newInvoiceTotal').value = total.toFixed(2);
        }
    }

    function openEditInvoiceModal(id, numero, orderId, subtotal, impuestos, total, estado, metodoPago, cliente) {
        document.getElementById('editInvoiceId').value = id;
        document.getElementById('editInvoiceOrderId').value = orderId;
        document.getElementById('editInvoiceNumeroDisplay').innerText = 'Factura ' + numero;
        document.getElementById('editInvoiceClienteDisplay').innerText = 'Cliente: ' + cliente;
        document.getElementById('editInvoiceEstado').value = estado.toLowerCase();
        document.getElementById('editInvoiceMetodoPago').value = metodoPago || 'Efectivo';
        document.getElementById('editInvoiceSubtotal').value = subtotal;
        document.getElementById('editInvoiceImpuestos').value = impuestos;
        document.getElementById('editInvoiceTotal').value = total;
        document.getElementById('modal-edit-factura').style.display = 'flex';
    }

    function confirmDeleteInvoice(id, numero) {
        if (typeof alertify !== 'undefined') {
            alertify.confirm(
                'Eliminar Factura',
                '¿Está seguro de que desea eliminar la factura <strong>' + numero + '</strong>? Esta acción no se puede deshacer.',
                function () {
                    executeInvoiceDelete(id);
                },
                function () {
                    alertify.message('Eliminación cancelada');
                }
            ).set('labels', { ok: 'Sí, eliminar', cancel: 'Cancelar' });
        } else if (confirm('¿Está seguro de eliminar la factura ' + numero + '?')) {
            executeInvoiceDelete(id);
        }
    }

    function executeInvoiceDelete(id) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Invoice/Delete/' + id;
        
        const tokenElem = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenElem) {
            const hiddenToken = document.createElement('input');
            hiddenToken.type = 'hidden';
            hiddenToken.name = '__RequestVerificationToken';
            hiddenToken.value = tokenElem.value;
            form.appendChild(hiddenToken);
        }

        document.body.appendChild(form);
        form.submit();
    }

    function filterClientSideFacturas(filterVal) {
        const filter = filterVal.toLowerCase();
        const table = document.getElementById('tableFacturas');
        if (!table) return;
        const trs = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < trs.length; i++) {
            let show = false;
            const tds = trs[i].getElementsByTagName('td');
            if (tds.length <= 1) continue;
            for (let j = 0; j < tds.length - 1; j++) {
                if (tds[j] && tds[j].textContent.toLowerCase().includes(filter)) {
                    show = true;
                    break;
                }
            }
            trs[i].style.display = show ? '' : 'none';
        }
    }

    function openEditSalesOrderModal(id, numero, cliente, producto, cantidad, precio, estado, notas) {
        document.getElementById('editSalesOrderId').value = id;
        document.getElementById('editSalesOrderNumero').value = numero;
        document.getElementById('editSalesOrderCliente').value = cliente;
        document.getElementById('editSalesOrderProducto').value = producto;
        document.getElementById('editSalesOrderCantidad').value = cantidad;
        document.getElementById('editSalesOrderPrecio').value = precio;
        document.getElementById('editSalesOrderEstado').value = estado ? estado.toLowerCase() : 'pendiente';
        document.getElementById('editSalesOrderNotas').value = notas || '';
        document.getElementById('modal-editar-pedido-venta').style.display = 'flex';
    }
</script>

