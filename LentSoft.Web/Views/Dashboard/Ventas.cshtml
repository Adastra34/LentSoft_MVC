@model DashboardVentasViewModel
@{
    ViewData["Title"] = "Panel de Ventas";
}

<!-- DataTables Local CSS (Sin CDN) -->
<link rel="stylesheet" href="~/lib/datatables/jquery.dataTables.min.css" />

<style>
    /* ── Personalización de DataTables para LentSoft (Tema Morado) ── */
    .dataTables_wrapper {
        font-family: inherit;
        padding-top: 0.5rem;
    }
    .dataTables_wrapper .dt-top-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1rem;
    }
    .dataTables_wrapper .dataTables_filter input,
    .dataTables_wrapper .dataTables_length select {
        border: 1px solid var(--purple-300) !important;
        border-radius: 0.375rem !important;
        padding: 0.4rem 0.75rem !important;
        font-size: 0.85rem !important;
        outline: none;
        background: white;
    }
    .dataTables_wrapper .dataTables_filter input:focus,
    .dataTables_wrapper .dataTables_length select:focus {
        border-color: var(--purple-600) !important;
        box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.2) !important;
    }
    .dataTables_wrapper .dataTables_info {
        color: var(--purple-900) !important;
        font-size: 0.85rem !important;
        font-weight: 500 !important;
        padding-top: 0.75rem !important;
    }
    .dataTables_wrapper .dataTables_paginate {
        padding-top: 0.75rem !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 0.375rem !important;
        border: 1px solid var(--purple-200) !important;
        background: white !important;
        color: var(--purple-900) !important;
        font-size: 0.82rem !important;
        font-weight: 600 !important;
        padding: 0.35rem 0.75rem !important;
        margin: 0 2px !important;
        transition: all 0.15s ease !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: var(--purple-100) !important;
        color: var(--purple-900) !important;
        border-color: var(--purple-400) !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
        background: var(--purple-600) !important;
        color: white !important;
        border-color: var(--purple-600) !important;
        box-shadow: 0 2px 4px rgba(124, 58, 237, 0.25) !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
        opacity: 0.5;
        background: #F3F4F6 !important;
        border-color: #E5E7EB !important;
        color: #9CA3AF !important;
        cursor: not-allowed !important;
    }
    table.dataTable.no-footer {
        border-bottom: 2px solid var(--purple-200) !important;
    }
    table.dataTable thead th {
        border-bottom: 2px solid var(--purple-300) !important;
        background-color: var(--purple-50) !important;
        color: var(--purple-900) !important;
        font-weight: 700 !important;
        padding: 0.75rem !important;
    }
</style>

<div style="display: flex; min-height: 85vh; background-color: var(--purple-50);">
    <!-- Sidebar Navigation -->
    <aside style="width: 260px; background-color: var(--purple-900); color: white; padding: 1.5rem 1rem; flex-shrink: 0;">
        <div style="padding: 0 0.5rem 1.5rem 0.5rem; border-bottom: 1px solid var(--purple-700); margin-bottom: 1.5rem;">
            <h2 style="color: white; font-size: 1.25rem; margin: 0;" data-i18n="sales.portal">Portal de Ventas</h2>
            <p style="color: var(--purple-200); font-size: 0.85rem; margin: 0.25rem 0 0 0;" data-i18n="sales.management">Gestión Comercial</p>
        </div>

        <nav style="display: flex; flex-direction: column; gap: 0.5rem;">
            <a href="?section=general" class="nav-item @(Model.ActiveSection == "general" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "general" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "general" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.general">
                📊 General
            </a>
            <a href="?section=ventas" class="nav-item @(Model.ActiveSection == "ventas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "ventas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "ventas" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.sales">
                💳 Ventas
            </a>
            <a href="?section=facturas" class="nav-item @(Model.ActiveSection == "facturas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "facturas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "facturas" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.invoices">
                🧾 Facturas
            </a>
            <a href="?section=inventarios" class="nav-item @(Model.ActiveSection == "inventarios" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "inventarios" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "inventarios" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.inventory">
                📦 Inventarios
            </a>
            <a href="?section=perfil" class="nav-item @(Model.ActiveSection == "perfil" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "perfil" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "perfil" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.profile">
                ⚙️ Mi Perfil
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main style="flex: 1; padding: 2rem; overflow-y: auto;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background-color: #D1FAE5; border-left: 4px solid #10B981; color: #065F46; padding: 1rem; border-radius: 0.375rem; margin-bottom: 1.5rem; font-weight: 600;">
                ✓ @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div style="background-color: #FEE2E2; border-left: 4px solid #EF4444; color: #991B1B; padding: 1rem; border-radius: 0.375rem; margin-bottom: 1.5rem; font-weight: 600;">
                ⚠ @TempData["ErrorMessage"]
            </div>
        }

        <!-- 1. GENERAL / RESUMEN -->
        @if (Model.ActiveSection == "general")
        {
            <partial name="~/Views/Dashboard/Ventas/_Indicadores.cshtml" model="Model" />
        }

        <!-- 2. VENTAS -->
        @if (Model.ActiveSection == "ventas")
        {
            <partial name="~/Views/Dashboard/Ventas/_TablaVentas.cshtml" model="Model" />
        }

        <!-- 3. FACTURAS -->
        @if (Model.ActiveSection == "facturas")
        {
            <partial name="~/Views/Dashboard/Ventas/_Facturas.cshtml" model="Model" />
        }

        <!-- 4. INVENTARIOS -->
        @if (Model.ActiveSection == "inventarios")
        {
            var initialTab = string.IsNullOrEmpty(Model.ActiveSubTab) ? "productos" : Model.ActiveSubTab;
            <div class="inv-header">
                <h1 class="inv-title" data-i18n="admin.inv.title">
                    <svg class="inv-icon" viewBox="0 0 24 24"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    Gestión de Inventario
                </h1>
            </div>

            <!-- Sub-tabs (Exactamente 3 pestañas: Productos, Historial, Pedidos) -->
            <div class="inv-subtabs">
                <button id="nav-subtab-productos" type="button" onclick="switchInventorySubTab('productos')" class="inv-subtab-btn @(initialTab == "productos" ? "active" : "")" data-i18n="admin.inv.tab.products">
                    <svg class="inv-icon" viewBox="0 0 24 24"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    Productos
                </button>
                <button id="nav-subtab-historial" type="button" onclick="switchInventorySubTab('historial')" class="inv-subtab-btn @(initialTab == "historial" ? "active" : "")" data-i18n="admin.inv.tab.history">
                    <svg class="inv-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Historial de Movimientos
                </button>
                <button id="nav-subtab-pedidos" type="button" onclick="switchInventorySubTab('pedidos')" class="inv-subtab-btn @(initialTab == "pedidos" ? "active" : "")">
                    <svg class="inv-icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    Pedidos
                </button>
            </div>

            <!-- Vistas Parciales del Módulo de Inventario de Ventas -->
            <partial name="~/Views/Dashboard/Ventas/_InvProductos.cshtml" model="Model" />
            <partial name="~/Views/Dashboard/Ventas/_InvHistorial.cshtml" model="Model" />
            <partial name="~/Views/Dashboard/Ventas/_InvPedidosVentas.cshtml" model="Model" />
        }

        <!-- 5. PERFIL -->
        @if (Model.ActiveSection == "perfil")
        {
            <h1 style="color: var(--purple-900); margin-bottom: 1.5rem; font-size: 1.75rem;">Perfil Ejecutivo de Ventas</h1>

            <div class="card" style="padding: 2rem; background: white; max-width: 600px;">
                <div style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem;">
                    <div style="width: 70px; height: 70px; border-radius: 50%; background-color: var(--purple-600); color: white; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold;">
                        @(Model.UsuarioActual?.Nombre?.FirstOrDefault() ?? 'V')
                    </div>
                    <div>
                        <h2 style="margin: 0; color: var(--purple-900); font-size: 1.5rem;">@Model.UsuarioActual?.Nombre</h2>
                        <p style="margin: 0; color: var(--purple-600); font-weight: 600;">Asesor Comercial / Ventas</p>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 1rem; border-top: 1px solid var(--purple-100); padding-top: 1.5rem;">
                    <div>
                        <span style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">Correo Electrónico</span>
                        <p style="margin: 0.25rem 0 0 0; font-size: 1rem; color: var(--purple-900); font-weight: 500;">@Model.UsuarioActual?.Email</p>
                    </div>
                    <div>
                        <span style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">Teléfono de Contacto</span>
                        <p style="margin: 0.25rem 0 0 0; font-size: 1rem; color: var(--purple-900); font-weight: 500;">@(string.IsNullOrEmpty(Model.UsuarioActual?.Telefono) ? "No registrado" : Model.UsuarioActual.Telefono)</p>
                    </div>
                    <div>
                        <span style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">Documento de Identidad</span>
                        <p style="margin: 0.25rem 0 0 0; font-size: 1rem; color: var(--purple-900); font-weight: 500;">@Model.UsuarioActual?.NumeroDocumento</p>
                    </div>
                </div>
            </div>
        }
    </main>
</div>

<!-- Modales Centralizados -->
<partial name="~/Views/Dashboard/Ventas/_Modales.cshtml" model="Model" />
<partial name="~/Views/Dashboard/Ventas/_InvModales.cshtml" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- DataTables Local Scripts (Sin CDN) -->
    <script src="~/lib/datatables/jquery.min.js"></script>
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>

    <script>
        var dtVentas = null;
        var currentFiltroRapido = '';

        $(document).ready(function () {
            if ($('#tableVentasSales').length && !$.fn.DataTable.isDataTable('#tableVentasSales')) {
                dtVentas = $('#tableVentasSales').DataTable({
                    serverSide: true,
                    processing: true,
                    ajax: {
                        url: '/Ventas/ListarVentas',
                        type: 'POST',
                        data: function (d) {
                            d.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').first().val();
                            d.filtroEstado = $('#filtroEstadoVenta').val();
                            d.filtroEstadoPago = $('#filtroEstadoPago').val();
                            d.filtroRapido = currentFiltroRapido;
                            d.fechaDesde = $('#filtroFechaDesde').val();
                            d.fechaHasta = $('#filtroFechaHasta').val();
                        }
                    },
                    language: {
                        url: '/lib/datatables/es-ES.json'
                    },
                    columns: [
                        {
                            data: 'id',
                            name: 'Id',
                            render: function (data) {
                                return '<span style="font-weight: 700; color: var(--purple-700);">#ORD-' + String(data).padStart(4, '0') + '</span>';
                            }
                        },
                        {
                            data: 'clienteNombre',
                            name: 'Cliente',
                            render: function (data, type, row) {
                                var html = '<div style="font-weight: 600; color: var(--purple-900);">' + (data || 'Cliente General') + '</div>';
                                if (row.clienteTelefono) {
                                    html += '<div style="font-size: 0.75rem; color: var(--gray-500);">' + row.clienteTelefono + '</div>';
                                }
                                return html;
                            }
                        },
                        {
                            data: 'fechaPedido',
                            name: 'Fecha',
                            render: function (data) {
                                if (!data) return '-';
                                var d = new Date(data);
                                return '<span style="color: var(--gray-700);">' + d.toLocaleDateString('es-CO') + ' ' + d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' }) + '</span>';
                            }
                        },
                        {
                            data: 'total',
                            name: 'Total',
                            className: 'dt-body-right',
                            render: function (data) {
                                return '<strong style="color: var(--purple-900);">$ ' + parseFloat(data || 0).toLocaleString('es-CO') + '</strong>';
                            }
                        },
                        {
                            data: 'saldoPendiente',
                            name: 'Saldo',
                            className: 'dt-body-right',
                            render: function (data) {
                                var val = parseFloat(data || 0);
                                var color = val > 0 ? '#DC2626' : '#16A34A';
                                return '<strong style="color: ' + color + '; font-weight: 800;">$ ' + val.toLocaleString('es-CO') + '</strong>';
                            }
                        },
                        {
                            data: 'estadoPago',
                            name: 'EstadoPago',
                            className: 'dt-body-center',
                            render: function (data) {
                                var st = (data || 'pendiente').toLowerCase();
                                var bg = st === 'pagado' ? 'var(--success)' : (st === 'abonado' || st === 'parcial' ? '#D97706' : '#DC2626');
                                return '<span style="background-color: ' + bg + '; color: white; padding: 0.25rem 0.55rem; border-radius: 9999px; font-size: 0.72rem; font-weight: 700; text-transform: capitalize;">' + (data || 'Pendiente') + '</span>';
                            }
                        },
                        {
                            data: 'estado',
                            name: 'Estado',
                            className: 'dt-body-center',
                            render: function (data) {
                                var st = (data || 'pendiente').toLowerCase();
                                var bg = st === 'entregado' ? '#047857' : (st === 'cancelado' ? '#DC2626' : 'var(--purple-100)');
                                var color = (st === 'entregado' || st === 'cancelado') ? 'white' : 'var(--purple-800)';
                                return '<span style="background-color: ' + bg + '; color: ' + color + '; padding: 0.25rem 0.55rem; border-radius: 9999px; font-size: 0.72rem; font-weight: 600; text-transform: capitalize;">' + (data || 'Pendiente') + '</span>';
                            }
                        },
                        {
                            data: 'formulaDetalle',
                            name: 'Formula',
                            className: 'dt-body-center',
                            orderable: false,
                            render: function (data, type, row) {
                                if (row.formulaOpticaId) {
                                    return '<button type="button" class="btn btn-sm" onclick="openFormulaModal(' + row.id + ', ' + row.clienteId + ', ' + row.formulaOpticaId + ', \'' + (row.formulaDetalle || '') + '\')" style="background:#EDE9FE; color:#6D28D9; border:1px solid #C4B5FD; padding:0.2rem 0.5rem; border-radius:0.375rem; font-size:0.75rem; font-weight:700; cursor:pointer;" title="Ver fórmula vinculada">🩺 ' + (row.formulaDetalle || ('#' + row.formulaOpticaId)) + '</button>';
                                }
                                return '<button type="button" class="btn btn-sm" onclick="openFormulaModal(' + row.id + ', ' + row.clienteId + ', null, \'\')" style="background:white; color:var(--gray-500); border:1px dashed var(--gray-300); padding:0.2rem 0.45rem; border-radius:0.375rem; font-size:0.72rem; cursor:pointer;" title="Vincular fórmula óptica">+ Vincular</button>';
                            }
                        },
                        {
                            data: 'id',
                            name: 'Acciones',
                            orderable: false,
                            className: 'dt-body-center',
                            render: function (data, type, row) {
                                var estadoLower = (row.estado || '').toLowerCase();
                                var html = '<div style="display: flex; gap: 0.35rem; justify-content: center; align-items: center; flex-wrap: wrap;">';

                                // Botones de Abono y Tarjeta
                                if (row.saldoPendiente > 0 && estadoLower !== 'cancelado') {
                                    var numPed = '#ORD-' + String(row.id).padStart(4, '0');
                                    var nomCli = (row.clienteNombre || 'Cliente').replace(/'/g, "\\'");
                                    html += '<button type="button" class="btn-action" style="background:#2563EB; color:white; border:none; padding:0.25rem 0.55rem; border-radius:0.375rem; font-size:0.75rem; font-weight:700; cursor:pointer;" onclick="openAbonoModal(' + row.id + ', \'' + numPed + '\', \'' + nomCli + '\', ' + row.saldoPendiente + ')">💵 Abono</button>';
                                    html += '<button type="button" class="btn-action" style="background:#6D28D9; color:white; border:none; padding:0.25rem 0.55rem; border-radius:0.375rem; font-size:0.75rem; font-weight:700; cursor:pointer;" onclick="openTarjetaModal(' + row.id + ', ' + row.saldoPendiente + ')">💳 Tarjeta</button>';
                                }

                                // Botón Cambiar Estado
                                if (estadoLower !== 'cancelado' && estadoLower !== 'entregado') {
                                    var numPed = '#ORD-' + String(row.id).padStart(4, '0');
                                    html += '<button type="button" class="btn-action" style="background:var(--purple-100); color:var(--purple-900); border:1px solid var(--purple-300); padding:0.25rem 0.55rem; border-radius:0.375rem; font-size:0.75rem; font-weight:600; cursor:pointer;" onclick="openCambiarEstadoModal(' + row.id + ', \'' + numPed + '\', \'' + row.estado + '\', ' + row.saldoPendiente + ', ' + row.totalAbonos + ')">🔄 Estado</button>';
                                }

                                // Factura
                                if (row.tieneFactura && row.facturaId) {
                                    html += '<a href="/Invoice/DownloadPdf/' + row.facturaId + '" target="_blank" style="background:#F3E8FF; color:#581C87; border:1px solid #D8B4FE; padding:0.25rem 0.55rem; border-radius:0.375rem; font-size:0.75rem; font-weight:700; text-decoration:none;" title="Ver Factura ' + (row.facturaNumero || '') + '">📄 ' + (row.facturaNumero || 'Factura') + '</a>';
                                }

                                html += '</div>';
                                return html;
                            }
                        }
                    ],
                    pageLength: 10,
                    lengthMenu: [10, 25, 50, 100],
                    order: [[2, 'desc']],
                    responsive: true
                });
            }
        });

        // ── Funciones de Filtros DataTables ──
        function recargarTablaVentas() {
            if (dtVentas) {
                dtVentas.ajax.reload();
            }
        }

        function aplicarFiltroRapido(valor, btn) {
            currentFiltroRapido = valor;
            $('.btn-filtro-rapido').css({ 'background': 'white', 'color': 'var(--purple-900)' });
            $(btn).css({ 'background': 'var(--purple-600)', 'color': 'white' });
            recargarTablaVentas();
        }

        function limpiarFiltrosVentas() {
            currentFiltroRapido = '';
            $('#filtroFechaDesde').val('');
            $('#filtroFechaHasta').val('');
            $('#filtroEstadoVenta').val('');
            $('#filtroEstadoPago').val('');
            $('.btn-filtro-rapido').css({ 'background': 'white', 'color': 'var(--purple-900)' });
            $('.btn-filtro-rapido').first().css({ 'background': 'var(--purple-600)', 'color': 'white' });
            recargarTablaVentas();
        }

        // ── Modales de Ventas ──
        function openAbonoModal(ventaId, pedidoNum, clienteNombre, saldo) {
            document.getElementById('abonoVentaId').value = ventaId;
            document.getElementById('abonoPedidoText').innerText = pedidoNum;
            document.getElementById('abonoClienteText').innerText = clienteNombre;
            document.getElementById('abonoSaldoText').innerText = '$ ' + parseFloat(saldo).toLocaleString('es-CO');
            var inputMonto = document.getElementById('abonoMontoInput');
            inputMonto.value = saldo;
            inputMonto.max = saldo;
            document.getElementById('modal-abono').style.display = 'flex';
        }

        function handleMetodoPagoChange(val) {
            if (val === 'Tarjeta de Crédito / Débito') {
                var ventaId = document.getElementById('abonoVentaId').value;
                var saldo = parseFloat(document.getElementById('abonoMontoInput').value || 0);
                document.getElementById('modal-abono').style.display = 'none';
                openTarjetaModal(ventaId, saldo);
            }
        }

        function openTarjetaModal(ventaId, saldo) {
            document.getElementById('tarjetaVentaId').value = ventaId;
            document.getElementById('tarjetaMontoDisplay').innerText = '$ ' + parseFloat(saldo).toLocaleString('es-CO');
            document.getElementById('tarjetaMontoInput').value = saldo;
            document.getElementById('tarjetaNumero').value = '';
            document.getElementById('tarjetaTitular').value = '';
            document.getElementById('tarjetaExp').value = '';
            document.getElementById('tarjetaCvv').value = '';
            document.getElementById('tarjetaLuhnMsg').innerText = '';
            document.getElementById('tarjetaMarcaBadge').innerText = 'Tarjeta';
            document.getElementById('modal-tarjeta').style.display = 'flex';
        }

        function openCambiarEstadoModal(orderId, pedidoNum, estadoActual, saldo, totalAbonos) {
            document.getElementById('cambiarEstadoOrderId').value = orderId;
            document.getElementById('cambiarEstadoPedidoLabel').textContent = pedidoNum;
            document.getElementById('cambiarEstadoActualLabel').textContent = estadoActual;

            var sel = document.getElementById('cambiarEstadoSelect');
            sel.value = estadoActual.toLowerCase();

            var opPagado = sel.querySelector('option[value="pagado"]');
            var opCancelado = sel.querySelector('option[value="cancelado"]');
            if (opPagado) {
                opPagado.disabled = (saldo > 0);
                opPagado.text = saldo > 0 ? 'Pagado (Bloqueado: Saldo pendiente > 0)' : 'Pagado';
            }
            if (opCancelado) {
                opCancelado.disabled = (totalAbonos > 0);
                opCancelado.text = totalAbonos > 0 ? 'Cancelado (Bloqueado: Ya tiene abonos)' : 'Cancelado';
            }

            document.getElementById('modal-cambiar-estado').style.display = 'flex';
        }

        function openFormulaModal(orderId, clienteId, formulaId, formulaDetalle) {
            document.getElementById('vincularFormulaOrderId').value = orderId;
            var contenido = document.getElementById('formulaModalContenido');
            if (formulaId) {
                contenido.innerHTML = '<div style="background:#FAF5FF; border:1px solid var(--purple-300); padding:0.75rem; border-radius:0.5rem; margin-bottom:0.75rem;"><strong style="color:var(--purple-900);">Fórmula Actual:</strong> ' + formulaDetalle + '</div>';
            } else {
                contenido.innerHTML = '<div style="background:#F3F4F6; border:1px solid #E5E7EB; padding:0.75rem; border-radius:0.5rem; margin-bottom:0.75rem; color:#6B7280;">Sin fórmula óptica vinculada a este pedido.</div>';
            }

            var sel = document.getElementById('vincularFormulaSelect');
            sel.innerHTML = '<option value="">-- Sin Fórmula (Desvincular) --</option>';

            if (clienteId) {
                fetch('/Ventas/GetFormulasPorPaciente?userId=' + clienteId)
                    .then(function(r) { return r.json(); })
                    .then(function(formulas) {
                        if (formulas && formulas.length > 0) {
                            formulas.forEach(function(f) {
                                var opt = document.createElement('option');
                                opt.value = f.id;
                                opt.textContent = '#' + f.id + ' — ' + (f.tipoLente || 'Fórmula') + ' (' + (f.fecha || '') + ')';
                                if (formulaId && f.id == formulaId) {
                                    opt.selected = true;
                                }
                                sel.appendChild(opt);
                            });
                        }
                    })
                    .catch(function(err) {
                        console.error('Error al cargar fórmulas:', err);
                    });
            }

            document.getElementById('modal-formula').style.display = 'flex';
        }

        function actualizarInfoFactura(selectElem) {
            var selectedOpt = selectElem.options[selectElem.selectedIndex];
            var total = parseFloat(selectedOpt.getAttribute('data-total') || '0');
            var cliente = selectedOpt.getAttribute('data-cliente') || '-';
            var metodo = selectedOpt.getAttribute('data-metodo') || 'Efectivo';

            document.getElementById('facturaModalCliente').innerText = cliente;
            document.getElementById('facturaModalMetodo').innerText = metodo;
            document.getElementById('facturaModalTotal').innerText = 'COP $' + total.toLocaleString('es-CO');
        }

        function confirmDeleteInvoice(id, numero) {
            if (confirm('¿Está seguro de eliminar la factura ' + numero + '?')) {
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Invoice/Delete/' + id;

                var tokenElem = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenElem) {
                    var hiddenToken = document.createElement('input');
                    hiddenToken.type = 'hidden';
                    hiddenToken.name = '__RequestVerificationToken';
                    hiddenToken.value = tokenElem.value;
                    form.appendChild(hiddenToken);
                }

                document.body.appendChild(form);
                form.submit();
            }
        }

        // ── Validación Luhn & Tarjeta Client-Side (Requisito 4) ──
        function validarLuhn(numero) {
            var digits = (numero || '').replace(/\D/g, '');
            if (digits.length < 13 || digits.length > 19) return false;
            var sum = 0;
            var alternate = false;
            for (var i = digits.length - 1; i >= 0; i--) {
                var n = parseInt(digits.charAt(i), 10);
                if (alternate) {
                    n *= 2;
                    if (n > 9) n = (n % 10) + 1;
                }
                sum += n;
                alternate = !alternate;
            }
            return (sum % 10 === 0);
        }

        function detectarFranquicia(numero) {
            var clean = (numero || '').replace(/\D/g, '');
            if (clean.startsWith('4')) return 'Visa';
            if (/^5[1-5]/.test(clean)) return 'Mastercard';
            if (/^3[47]/.test(clean)) return 'American Express';
            if (/^(6011|65)/.test(clean)) return 'Discover';
            return 'Tarjeta';
        }

        function formatearYDetectarTarjeta(input) {
            var val = input.value.replace(/\D/g, '').substring(0, 16);
            var formatted = val.match(/.{1,4}/g)?.join(' ') || val;
            input.value = formatted;

            var marca = detectarFranquicia(val);
            document.getElementById('tarjetaMarcaBadge').textContent = marca;

            var msg = document.getElementById('tarjetaLuhnMsg');
            if (val.length >= 13) {
                if (validarLuhn(val)) {
                    msg.textContent = '✓ Tarjeta válida (' + marca + ')';
                    msg.style.color = '#16A34A';
                } else {
                    msg.textContent = '✗ Número de tarjeta no válido (Algoritmo de Luhn)';
                    msg.style.color = '#DC2626';
                }
            } else {
                msg.textContent = '';
            }
        }

        function formatearExpiracion(input) {
            var val = input.value.replace(/\D/g, '').substring(0, 4);
            if (val.length >= 3) {
                input.value = val.substring(0, 2) + '/' + val.substring(2);
            } else {
                input.value = val;
            }
        }

        function validarTarjetaCliente(e) {
            var num = document.getElementById('tarjetaNumero').value.replace(/\D/g, '');
            if (!validarLuhn(num)) {
                alert('El número de tarjeta no es válido según el algoritmo de Luhn.');
                e.preventDefault();
                return false;
            }
            var exp = document.getElementById('tarjetaExp').value;
            if (!/^\d{2}\/\d{2}$/.test(exp)) {
                alert('La fecha de expiración debe tener el formato MM/YY.');
                e.preventDefault();
                return false;
            }
            var cvv = document.getElementById('tarjetaCvv').value;
            if (cvv.length < 3 || cvv.length > 4) {
                alert('El CVV debe tener 3 o 4 dígitos.');
                e.preventDefault();
                return false;
            }
            return true;
        }

        // ── Gestión de Sub-tabs de Inventario (Ventas) ──
        function switchInventorySubTab(subtabName) {
            const tabs = ['productos', 'historial', 'pedidos'];
            tabs.forEach(t => {
                const content = document.getElementById('subtab-content-' + t);
                const btnNav = document.getElementById('nav-subtab-' + t);

                if (t === subtabName) {
                    if (content) content.style.display = 'block';
                    if (btnNav) {
                        btnNav.style.color = 'var(--purple-700)';
                        btnNav.style.borderBottom = '3px solid var(--purple-600)';
                        btnNav.classList.add('active');
                    }
                } else {
                    if (content) content.style.display = 'none';
                    if (btnNav) {
                        btnNav.style.color = 'var(--gray-500)';
                        btnNav.style.borderBottom = 'none';
                        btnNav.classList.remove('active');
                    }
                }
            });

            if (window.history && window.history.pushState) {
                const newUrl = '?section=inventarios&subtab=' + subtabName;
                window.history.pushState({ path: newUrl }, '', newUrl);
            }
        }

        // ── Filtrado genérico de tablas (Pedidos de Venta) ──
        function filterTable(inputId, tableId) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const filter = input.value.toLowerCase().trim();
            const table = document.getElementById(tableId);
            if (!table) return;
            const trs = table.getElementsByTagName('tr');

            for (let i = 1; i < trs.length; i++) {
                if (!filter) {
                    trs[i].style.display = '';
                    continue;
                }
                let show = false;
                const tds = trs[i].getElementsByTagName('td');
                for (let j = 0; j < tds.length; j++) {
                    if (!tds[j]) continue;
                    const cellText = tds[j].textContent.toLowerCase().trim();
                    if (cellText.includes(filter)) {
                        show = true;
                        break;
                    }
                }
                trs[i].style.display = show ? '' : 'none';
            }
        }

        function toggleFilterMenu(submodule) {
            const menu = document.getElementById('filter-menu-' + submodule);
            if (!menu) return;
            const isVisible = menu.style.display === 'block';
            document.querySelectorAll('[id^="filter-menu-"]').forEach(m => m.style.display = 'none');
            menu.style.display = isVisible ? 'none' : 'block';
        }

        function filterTableByValue(inputId, tableId, value) {
            const input = document.getElementById(inputId);
            if (input) {
                input.value = value;
                filterTable(inputId, tableId);
            }
            document.querySelectorAll('[id^="filter-menu-"]').forEach(m => m.style.display = 'none');
        }

        // ── Alternar Estado de Producto en Ventas ──
        async function toggleProductStatus(id, btnElem) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const res = await fetch('/Ventas/ToggleProductStatus/' + id, {
                    method: 'POST',
                    headers: { 
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token
                    }
                });
                const data = await res.json();
                if (data.success) {
                    btnElem.innerText = data.active ? 'Activo' : 'Inactivo';
                    btnElem.className = 'inv-chip inv-chip-btn ' + (data.active ? 'inv-chip-success' : 'inv-chip-error');
                    const row = btnElem.closest('tr');
                    if (row) {
                        row.setAttribute('data-estado', data.active ? 'activo' : 'inactivo');
                    }
                    showToast(data.message, 'success');
                } else {
                    showToast(data.message || 'Error al cambiar estado', 'error');
                }
            } catch (e) {
                showToast('Error de comunicación con el servidor', 'error');
            }
        }

        function showToast(msg, type = 'info') {
            if (typeof alertify !== 'undefined') {
                if (type === 'success') alertify.success(msg);
                else if (type === 'error') alertify.error(msg);
                else if (type === 'warning') (alertify.warning ? alertify.warning(msg) : alertify.error(msg));
                else alertify.message(msg);
                return;
            }
            let container = document.getElementById('inv-toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'inv-toast-container';
                container.style.cssText = 'position: fixed; bottom: 24px; right: 24px; z-index: 99999; display: flex; flex-direction: column; gap: 8px; max-width: 380px; pointer-events: none; font-family: system-ui, -apple-system, sans-serif;';
                document.body.appendChild(container);
            }
            const toast = document.createElement('div');
            const bg = type === 'success' ? '#059669' : (type === 'error' ? '#DC2626' : (type === 'warning' ? '#D97706' : '#7C3AED'));
            toast.style.cssText = `pointer-events: auto; padding: 12px 18px; border-radius: 8px; color: white; font-weight: 500; font-size: 0.875rem; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3); transition: all 0.25s ease; opacity: 0; transform: translateY(12px); display: flex; align-items: center; gap: 10px; background: ${bg};`;
            toast.innerHTML = `<span>${msg}</span>`;
            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.style.opacity = '1';
                toast.style.transform = 'translateY(0)';
            });
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(12px)';
                setTimeout(() => toast.remove(), 250);
            }, 4000);
        }

        // ── Manejadores delegados para edición y eliminación de Inventario ──
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('[data-record]');
            if (!btn) return;
            let rec;
            try { rec = JSON.parse(btn.dataset.record); } catch { return; }

            if (btn.classList.contains('btn-edit-product')) {
                if (typeof openEditProductModal === 'function') {
                    openEditProductModal(
                        rec.id, rec.nombre, rec.descripcion, rec.precio,
                        rec.precioDescuento, rec.categoria, rec.marca,
                        rec.stock, rec.activo, rec.imagenUrl,
                        rec.sku, rec.costoCompra, rec.stockMinimo,
                        rec.ubicacion, rec.supplierId, rec.rowVersion
                    );
                }
            } else if (btn.classList.contains('btn-edit-sales-order')) {
                if (typeof openEditSalesOrderModal === 'function') {
                    openEditSalesOrderModal(
                        rec.id, rec.numeroPedido, rec.clienteNombre,
                        rec.productoNombre, rec.cantidad, rec.precioUnitario,
                        rec.estado, rec.notas
                    );
                }
            }
        });

        document.addEventListener('submit', function(e) {
            const form = e.target;
            if (form.classList.contains('form-delete-product')) {
                const nombre = form.dataset.nombre || '';
                if (!confirm('¿Deseas eliminar el producto ' + nombre + '?')) {
                    e.preventDefault();
                }
            } else if (form.classList.contains('form-delete-sales-order')) {
                if (!confirm('¿Seguro que deseas eliminar este pedido de venta?')) {
                    e.preventDefault();
                }
            }
        });

        // ── Activar sub-tab si viene en URL ──
        $(document).ready(function() {
            var urlParams = new URLSearchParams(window.location.search);
            var subtab = urlParams.get('subtab') || '@(Model.ActiveSubTab ?? "productos")';
            if (subtab && ['productos', 'historial', 'pedidos'].includes(subtab)) {
                switchInventorySubTab(subtab);
            }
        });
    </script>
}
