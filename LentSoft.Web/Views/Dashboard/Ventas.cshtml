@model DashboardVentasViewModel
@{
    ViewData["Title"] = "Panel de Ventas";
}

<div style="display: flex; min-height: 85vh; background-color: var(--purple-50);">
    <!-- Sidebar Navigation -->
    <aside style="width: 260px; background-color: var(--purple-900); color: white; padding: 1.5rem 1rem; flex-shrink: 0;">
        <div style="padding: 0 0.5rem 1.5rem 0.5rem; border-bottom: 1px solid var(--purple-700); margin-bottom: 1.5rem;">
            <h2 style="color: white; font-size: 1.25rem; margin: 0;" data-i18n="sales.portal">Portal de Ventas</h2>
            <p style="color: var(--purple-200); font-size: 0.85rem; margin: 0.25rem 0 0 0;" data-i18n="sales.management">Gestión Comercial</p>
        </div>

        <nav style="display: flex; flex-direction: column; gap: 0.5rem;">
            <a href="?section=general" class="nav-item @(Model.ActiveSection == "general" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "general" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "general" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.general">
                📊 General
            </a>
            <a href="?section=ventas" class="nav-item @(Model.ActiveSection == "ventas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "ventas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "ventas" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.sales">
                💳 Ventas
            </a>
            <a href="?section=facturas" class="nav-item @(Model.ActiveSection == "facturas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "facturas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "facturas" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.invoices">
                🧾 Facturas
            </a>
            <a href="?section=inventarios" class="nav-item @(Model.ActiveSection == "inventarios" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "inventarios" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "inventarios" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.inventory">
                📦 Inventarios
            </a>
            <a href="?section=perfil" class="nav-item @(Model.ActiveSection == "perfil" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "perfil" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "perfil" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.profile">
                ⚙️ Mi Perfil
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main style="flex: 1; padding: 2rem; overflow-y: auto;">

        <!-- GENERAL / RESUMEN -->
        @if (Model.ActiveSection == "general")
        {
            <h1 style="color: var(--purple-900); margin-bottom: 1.5rem; font-size: 1.75rem;" data-i18n="sales.general.title">Resumen Comercial</h1>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--purple-600); background: white;">
                    <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="sales.general.monthly">Ventas del Mes</p>
                    <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.VentasDelMes.ToString("C")</h3>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--info); background: white;">
                    <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="sales.general.activeorders">Pedidos Activos</p>
                    <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.PedidosActivos</h3>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--success); background: white;">
                    <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="sales.general.clients">Clientes Atendidos</p>
                    <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.ClientesAtendidos</h3>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--warning); background: white;">
                    <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="sales.general.averageticket">Ticket Promedio</p>
                    <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.TicketPromedio.ToString("C")</h3>
                </div>
            </div>

            <!-- Últimas Ventas -->
            <div class="card" style="padding: 1.5rem; background: white;">
                <h2 style="color: var(--purple-800); font-size: 1.25rem; margin-bottom: 1rem;" data-i18n="sales.general.recentsales">Últimas Ventas Registradas</h2>
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;" data-i18n="sales.table.order">Pedido</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.client">Cliente</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.date">Fecha</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.total">Total</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.status">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Ventas.Take(5))
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-700);">#ORD-@v.Id.ToString("D4")</td>
                                    <td style="padding: 0.75rem;">@(v.User?.Nombre ?? "Cliente")</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@v.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="padding: 0.75rem; font-weight: 700; color: var(--purple-900);">@v.Total.ToString("C")</td>
                                    <td style="padding: 0.75rem;">
                                        <span style="background-color: var(--purple-100); color: var(--purple-800); padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem;">
                                            @v.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- VENTAS -->
        @if (Model.ActiveSection == "ventas")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;" data-i18n="sales.management.title">Gestión de Ventas</h1>
                <button type="button" onclick="document.getElementById('modal-venta').style.display='flex'" 
                        style="background-color: var(--purple-600); color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: background-color 0.2s ease;"
                        onmouseover="this.style.backgroundColor='var(--purple-700)'" onmouseout="this.style.backgroundColor='var(--purple-600)'">
                    <span data-i18n="sales.btn.new">+ Registrar Nueva Venta</span>
                </button>
            </div>

            <div class="card" style="padding: 1.5rem; background: white;">
                <div style="margin-bottom: 1rem;">
                    <input type="text" id="searchVentasSales" placeholder="Buscar venta o cliente..." data-i18n-placeholder="sales.search.placeholder" class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchVentasSales', 'tableVentasSales')" />
                </div>
                <div style="overflow-x: auto;">
                    <table id="tableVentasSales" style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;" data-i18n="sales.table.order">Venta</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.client">Cliente</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.date">Fecha</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.total">Total</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.currentstatus">Estado Actual</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.action">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Ventas)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-700);">#ORD-@v.Id.ToString("D4")</td>
                                    <td style="padding: 0.75rem;">@(v.User?.Nombre ?? "Cliente")</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@v.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="padding: 0.75rem; font-weight: 700; color: var(--purple-900);">@v.Total.ToString("C")</td>
                                    <td style="padding: 0.75rem;">
                                        <span style="background-color: var(--purple-100); color: var(--purple-800); padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem;">
                                            @v.Estado
                                        </span>
                                    </td>
                                    <td style="padding: 0.75rem;">
                                        <form asp-controller="Ventas" asp-action="UpdateOrderStatus" method="post" style="display:flex; gap:0.5rem; align-items:center;">
                                            <input type="hidden" name="id" value="@v.Id" />
                                            <select name="estado" style="padding: 0.2rem 0.4rem; border-radius: 0.25rem; font-size: 0.8rem;">
                                                <option value="pendiente" selected="@(v.Estado == "pendiente")" data-i18n="sales.status.pending">Pendiente</option>
                                                <option value="procesando" selected="@(v.Estado == "procesando")" data-i18n="sales.status.processing">Procesando</option>
                                                <option value="enviado" selected="@(v.Estado == "enviado")" data-i18n="sales.status.shipped">Enviado</option>
                                                <option value="entregado" selected="@(v.Estado == "entregado")" data-i18n="sales.status.delivered">Entregado</option>
                                                <option value="cancelado" selected="@(v.Estado == "cancelado")" data-i18n="sales.status.cancelled">Cancelado</option>
                                            </select>
                                            <button type="submit" class="btn btn-primary" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;" data-i18n="sales.btn.update">Actualizar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- FACTURAS -->
        @if (Model.ActiveSection == "facturas")
        {
            <div style="margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); font-size: 1.75rem; margin: 0;" data-i18n="sales.invoices.title">Facturas</h1>
                <p style="color: var(--gray-500); font-size: 0.9rem; margin-top: 0.25rem;" data-i18n="sales.invoices.subtitle">Gestiona tu negocio desde un solo lugar</p>
            </div>

            <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.75rem; box-shadow: var(--shadow-md);">
                <!-- Header de la sección de la tabla con botón Nueva Factura -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                    <h2 style="color: var(--purple-900); font-size: 1.35rem; font-weight: 700; margin: 0;" data-i18n="sales.invoices.mgmt">Gestión de Facturas</h2>
                    <button type="button" onclick="document.getElementById('modal-factura').style.display='flex'" 
                            style="background-color: var(--purple-600); color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: background-color 0.2s ease;"
                            onmouseover="this.style.backgroundColor='var(--purple-700)'" onmouseout="this.style.backgroundColor='var(--purple-600)'">
                        <span data-i18n="sales.invoices.new">+ Nueva Factura</span>
                    </button>
                </div>

                <!-- Barra Superior DataTable (Fondo morado) -->
                <form id="facturasFilterForm" method="get" action="/Ventas" style="background-color: var(--purple-900); color: white; padding: 0.85rem 1.25rem; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                    <input type="hidden" name="section" value="facturas" />
                    <input type="hidden" name="page" value="1" />

                    <!-- Selector Registros por página -->
                    <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500;">
                        <span data-i18n="sales.invoices.show">Mostrar</span>
                        <select name="pageSize" style="background-color: white; color: var(--gray-900); border: 1px solid var(--purple-300); border-radius: 0.375rem; padding: 0.35rem 0.6rem; font-size: 0.875rem; cursor: pointer; font-weight: 600;" onchange="document.getElementById('facturasFilterForm').submit();">
                            @foreach (var size in new[] { 5, 10, 25, 50 })
                            {
                                if (Model.FacturasPageSize == size)
                                {
                                    <option value="@size" selected>@size</option>
                                }
                                else
                                {
                                    <option value="@size">@size</option>
                                }
                            }
                        </select>
                        <span data-i18n="sales.invoices.records">registros</span>
                    </div>

                    <!-- Búsqueda en tiempo real / envío -->
                    <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem;">
                        <label for="searchFacturasInput" style="font-weight: 500;" data-i18n="sales.invoices.searchlabel">Buscar:</label>
                        <input type="text" id="searchFacturasInput" name="searchTerm" value="@Model.FacturasSearchTerm" 
                               placeholder="Buscar por número, cliente" data-i18n-placeholder="sales.invoices.searchplaceholder"
                               style="padding: 0.4rem 0.8rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); font-size: 0.875rem; width: 240px; color: var(--gray-900);" 
                               onkeyup="filterClientSideFacturas(this.value)" />
                        <button type="submit" style="background-color: var(--purple-600); color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.85rem; font-weight: 600;" data-i18n="sales.invoices.filter">Filtrar</button>
                    </div>
                </form>

                <!-- Tabla de Facturas -->
                <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-top: none; border-bottom-left-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                    <table id="tableFacturas" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                        <thead>
                            <tr style="background-color: var(--purple-50); border-bottom: 2px solid var(--purple-200); color: var(--purple-900);">
                                <th style="padding: 0.85rem 1rem; font-weight: 700;" data-i18n="sales.invoices.number">Número</th>
                                <th style="padding: 0.85rem 1rem; font-weight: 700;" data-i18n="sales.table.client">Cliente</th>
                                <th style="padding: 0.85rem 1rem; font-weight: 700;" data-i18n="sales.table.date">Fecha</th>
                                <th style="padding: 0.85rem 1rem; font-weight: 700;" data-i18n="sales.table.total">Total</th>
                                <th style="padding: 0.85rem 1rem; font-weight: 700;" data-i18n="sales.table.status">Estado</th>
                                <th style="padding: 0.85rem 1rem; font-weight: 700; text-align: center;" data-i18n="sales.table.actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Facturas.Any())
                            {
                                @foreach (var fac in Model.Facturas)
                                {
                                    var clientName = fac.Order?.User != null ? fac.Order.User.NombreCompleto : "Cliente N/A";
                                    var badgeBg = fac.Estado.ToLower() switch
                                    {
                                        "pagada" => "var(--success)",
                                        "cancelada" => "var(--error)",
                                        _ => "var(--warning)"
                                    };
                                    var estadoDisplay = fac.Estado.ToLower() switch
                                    {
                                        "pagada" => "Pagada",
                                        "cancelada" => "Cancelada",
                                        _ => "Pendiente"
                                    };
                                    var estadoI18nKey = fac.Estado.ToLower() switch
                                    {
                                        "pagada" => "sales.invoices.paid",
                                        "cancelada" => "sales.status.cancelled",
                                        _ => "sales.status.pending"
                                    };

                                    <tr style="border-bottom: 1px solid var(--purple-100); transition: background-color 0.15s ease;" onmouseover="this.style.backgroundColor='var(--purple-50)'" onmouseout="this.style.backgroundColor='transparent'">
                                        <td style="padding: 0.85rem 1rem; font-weight: 700; color: var(--purple-700);">@fac.NumeroFactura</td>
                                        <td style="padding: 0.85rem 1rem; font-weight: 500; color: var(--gray-800);">@clientName</td>
                                        <td style="padding: 0.85rem 1rem; color: var(--gray-600);">@fac.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td style="padding: 0.85rem 1rem; font-weight: 700; color: var(--purple-900);">@fac.Total.ToString("C")</td>
                                        <td style="padding: 0.85rem 1rem;">
                                            <span style="background-color: @badgeBg; color: white; padding: 0.3rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; display: inline-block;" data-i18n="@estadoI18nKey">
                                                @estadoDisplay
                                            </span>
                                        </td>
                                        <td style="padding: 0.85rem 1rem; text-align: center;">
                                            <div style="display: flex; gap: 0.5rem; justify-content: center; align-items: center;">
                                                <!-- Botón Eliminar -->
                                                <button type="button" 
                                                        onclick="confirmDeleteInvoice(@fac.Id, '@fac.NumeroFactura')"
                                                        style="background: transparent; color: var(--error); border: 1px solid var(--error); padding: 0.35rem 0.65rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;"
                                                        onmouseover="this.style.backgroundColor='var(--error)'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--error)';" data-i18n="sales.invoices.delete">
                                                    🗑️ Eliminar
                                                </button>

                                                <!-- Botón Descargar PDF -->
                                                <a href="/Invoice/DownloadPdf/@fac.Id" target="_blank"
                                                   style="background-color: var(--purple-100); color: var(--purple-900); border: 1px solid var(--purple-300); padding: 0.35rem 0.65rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem; transition: all 0.2s ease;"
                                                   onmouseover="this.style.backgroundColor='var(--purple-700)'; this.style.color='white';" onmouseout="this.style.backgroundColor='var(--purple-100)'; this.style.color='var(--purple-900)';" data-i18n="sales.invoices.pdf">
                                                    📄 PDF
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" style="padding: 2rem; text-align: center; color: var(--gray-500); font-style: italic;" data-i18n="sales.invoices.empty">
                                        No se encontraron facturas registradas o que coincidan con la búsqueda.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer DataTable: Conteo y Paginación -->
                @{
                    var inicioReg = Model.FacturasTotalCount == 0 ? 0 : ((Model.FacturasPage - 1) * Model.FacturasPageSize) + 1;
                    var finReg = Math.Min(Model.FacturasPage * Model.FacturasPageSize, Model.FacturasTotalCount);
                }
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.25rem; flex-wrap: wrap; gap: 1rem; font-size: 0.875rem;">
                    <div style="color: var(--gray-600); font-weight: 500;">
                        <span data-i18n="sales.invoices.showing">Mostrando registros del</span> <strong>@inicioReg</strong> <span data-i18n="sales.invoices.to">al</span> <strong>@finReg</strong> <span data-i18n="sales.invoices.of">de un total de</span> <strong>@Model.FacturasTotalCount</strong> <span data-i18n="sales.invoices.records">registros</span>
                    </div>

                    @if (Model.FacturasTotalPages > 1)
                    {
                        <div style="display: flex; gap: 0.35rem; align-items: center;">
                            <!-- Botón Anterior -->
                            @if (Model.FacturasPage > 1)
                            {
                                <a href="/Ventas?section=facturas&page=@(Model.FacturasPage - 1)&pageSize=@Model.FacturasPageSize&searchTerm=@Model.FacturasSearchTerm"
                                   style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;" data-i18n="sales.invoices.prev">
                                    &laquo; Anterior
                                </a>
                            }
                            else
                            {
                                <span style="padding: 0.35rem 0.75rem; border: 1px solid var(--gray-200); border-radius: 0.375rem; color: var(--gray-400); font-size: 0.85rem; background: var(--gray-50); cursor: not-allowed;" data-i18n="sales.invoices.prev">
                                    &laquo; Anterior
                                </span>
                            }

                            <!-- Números de Página -->
                            @for (int p = 1; p <= Model.FacturasTotalPages; p++)
                            {
                                if (p == Model.FacturasPage)
                                {
                                    <span style="padding: 0.35rem 0.75rem; border-radius: 0.375rem; background-color: var(--purple-600); color: white; font-weight: 700; font-size: 0.85rem;">
                                        @p
                                    </span>
                                }
                                else
                                {
                                    <a href="/Ventas?section=facturas&page=@p&pageSize=@Model.FacturasPageSize&searchTerm=@Model.FacturasSearchTerm"
                                       style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                        @p
                                    </a>
                                }
                            }

