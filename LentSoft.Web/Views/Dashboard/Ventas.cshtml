@model LentSoft.Web.Models.ViewModels.DashboardVentasViewModel
@{
    ViewData["Title"] = "Panel de Ventas";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />
<link rel="stylesheet" href="~/css/ventas.css" asp-append-version="true" />

<div class="sales-layout">
    <!-- Sidebar Navigation -->
    <aside class="sales-sidebar">
        <div class="sales-sidebar-header">
            <h2 data-i18n="sales.portal">Portal de Ventas</h2>
            <p data-i18n="sales.management">Gestión Comercial</p>
        </div>

        <nav class="sales-sidebar-nav">
            <a href="?section=general" class="sales-nav-item @(Model.ActiveSection == "general" ? "active" : "")" data-i18n="sales.nav.general">
                📊 General
            </a>
            <a href="?section=ventas" class="sales-nav-item @(Model.ActiveSection == "ventas" ? "active" : "")" data-i18n="sales.nav.sales">
                💳 Ventas
            </a>
            <a href="?section=facturas" class="sales-nav-item @(Model.ActiveSection == "facturas" ? "active" : "")" data-i18n="sales.nav.invoices">
                🧾 Facturas
            </a>
            <a href="?section=inventarios" class="sales-nav-item @(Model.ActiveSection == "inventarios" ? "active" : "")" data-i18n="sales.nav.inventory">
                📦 Inventarios
            </a>
            <a href="?section=perfil" class="sales-nav-item @(Model.ActiveSection == "perfil" ? "active" : "")" data-i18n="sales.nav.profile">
                ⚙️ Mi Perfil
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="sales-main-content">
        @switch (Model.ActiveSection)
        {
            case "ventas":
                <partial name="~/Views/Dashboard/Partials/_VentasListado.cshtml" model="Model" />
                break;
            case "facturas":
                <partial name="~/Views/Dashboard/Partials/_VentasFacturas.cshtml" model="Model" />
                break;
            case "inventarios":
                <partial name="~/Views/Dashboard/Partials/_VentasInventarios.cshtml" model="Model" />
                break;
            case "perfil":
                <partial name="~/Views/Dashboard/Partials/_VentasPerfil.cshtml" model="Model" />
                break;
            default:
                <partial name="~/Views/Dashboard/Partials/_VentasGeneral.cshtml" model="Model" />
                break;
        }
    </main>
</div>

<!-- Modales del Módulo de Ventas -->
<partial name="_ModalRegistrarVenta" model="((IEnumerable<LentSoft.Web.Models.Entities.User>)Model.Clientes, (IEnumerable<LentSoft.Web.Models.Entities.Product>)Model.Productos)" />
<partial name="~/Views/Dashboard/Partials/_ModalFactura.cshtml" model="Model" />
<partial name="~/Views/Dashboard/Partials/_ModalAbono.cshtml" />
<partial name="~/Views/Dashboard/Partials/_ModalTarjeta.cshtml" />
<partial name="~/Views/Dashboard/Partials/_ModalDetallePedido.cshtml" />

<!-- Serialización de Datos para Detalle de Pedidos -->
@{
    var ordersSerialized = System.Text.Json.JsonSerializer.Serialize(Model.Ventas.Select(v => new {
        id = v.Id,
        numero = $"#ORD-{v.Id:D4}",
        cliente = v.User?.NombreCompleto ?? "Cliente Genérico",
        userId = v.UserId,
        fecha = v.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm"),
        total = v.Total.ToString("C"),
        formulaOpticaId = v.FormulaOpticaId,
        requiereFormula = v.OrderItems.Any(oi => oi.Product != null && (oi.Product.Categoria == "lentes-graduados" || oi.Product.Categoria == "lentes-contacto")),
        items = v.OrderItems.Select(oi => new {
            nombre = oi.Product?.Nombre ?? "Producto",
            cantidad = oi.Cantidad,
            subtotal = (oi.Cantidad * oi.PrecioUnitario).ToString("C"),
            categoria = oi.Product?.Categoria ?? ""
        }).ToList()
    }));
}
<script>
    const ventasPedidosData = @Html.Raw(ordersSerialized);
    const ventasPedidosMap = {};
    if (Array.isArray(ventasPedidosData)) {
        ventasPedidosData.forEach(p => { ventasPedidosMap[p.id] = p; });
    }
</script>

<script src="~/js/shared-tables.js" asp-append-version="true"></script>
<script src="~/js/ventas.js" asp-append-version="true"></script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- DataTables CDN Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                showToast('@Html.Raw(TempData["Success"])', 'success');
            });
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                showToast('@Html.Raw(TempData["Error"])', 'error');
            });
        </script>
    }

    <script>
        $(document).ready(function () {
            if ($('#tableVentasSales').length && !$.fn.DataTable.isDataTable('#tableVentasSales')) {
                $('#tableVentasSales').DataTable({
                    language: {
                        search: "🔍 Buscar en página:",
                        searchPlaceholder: "Cliente, pedido, estado...",
                        lengthMenu: "Mostrar _MENU_ ventas",
                        info: "Mostrando _START_ a _END_ de _TOTAL_ ventas",
                        infoEmpty: "Mostrando 0 a 0 de 0 ventas",
                        infoFiltered: "(filtrado de _MAX_ ventas en esta página)",
                        zeroRecords: "No se encontraron ventas que coincidan con la búsqueda",
                        paginate: {
                            first: "«",
                            last: "»",
                            next: "Siguiente ›",
                            previous: "‹ Anterior"
                        }
                    },
                    dom: '<"dt-top-container"<"dt-buttons-group"B><"dt-search-group"f>l>rt<"dt-bottom-container"ip>',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '📊 Exportar a Excel',
                            className: 'btn-dt-export btn-dt-excel',
                            title: 'LentSoft_Reporte_Ventas',
                            exportOptions: {
                                columns: [0, 1, 2, 3, 4, 5, 6, 7],
                                format: {
                                    body: function (data, row, column, node) {
                                        if (column === 7) {
                                            var sel = $(node).find('select');
                                            return sel.length ? sel.val() : $(node).text().trim();
                                        }
                                        return $(node).text().trim().replace(/🔗/g, '').replace(/\s+/g, ' ');
                                    }
                                }
                            }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '📄 Exportar a PDF',
                            className: 'btn-dt-export btn-dt-pdf',
                            title: 'LentSoft - Reporte de Ventas',
                            orientation: 'landscape',
                            pageSize: 'A4',
                            exportOptions: {
                                columns: [0, 1, 2, 3, 4, 5, 6, 7],
                                format: {
                                    body: function (data, row, column, node) {
                                        if (column === 7) {
                                            var sel = $(node).find('select');
                                            return sel.length ? sel.val() : $(node).text().trim();
                                        }
                                        return $(node).text().trim().replace(/🔗/g, '').replace(/\s+/g, ' ');
                                    }
                                }
                            }
                        }
                    ],
                    paging: false, // Usar paginación server-side provista por backend
                    info: false,
                    order: [[2, 'desc']], // Fecha descendente
                    columnDefs: [
                        { orderable: false, targets: [8] }, // Columna acciones
                        { orderable: false, targets: [7] }  // Columna form estado orden
                    ],
                    responsive: true
                });
            }
        });
    </script>
}
