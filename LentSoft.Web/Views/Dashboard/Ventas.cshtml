                    </div>
                    <div>
                        <label style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600;" data-i18n="sales.profile.phone">TELÉFONO</label>
                        <p style="margin: 0; font-weight: 500;" data-i18n="@(string.IsNullOrEmpty(Model.UsuarioActual?.Telefono) ? "sales.profile.nophone" : "")">@(Model.UsuarioActual?.Telefono ?? "No registrado")</p>
                    </div>
                    <div>
                        <label style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600;" data-i18n="sales.profile.role">ROL DE ACCESO</label>
