@model LentSoft.Web.Models.ViewModels.DashboardVentasViewModel
@{
    ViewData["Title"] = "Panel de Ventas";
}

<!-- DataTables Local CSS (Sin CDN) -->
<link rel="stylesheet" href="~/lib/datatables/datatables.min.css" />

<style>
    /* ── Personalización de DataTables para LentSoft (Tema Morado) ── */
    .dataTables_wrapper {
        font-family: inherit;
        padding-top: 0.5rem;
    }
    .dataTables_wrapper .dataTables_filter input,
    .dataTables_wrapper .dataTables_length select {
        border: 1px solid var(--purple-300) !important;
        border-radius: 0.375rem !important;
        padding: 0.4rem 0.75rem !important;
        font-size: 0.85rem !important;
        outline: none;
        background: white;
    }
    .dataTables_wrapper .dataTables_filter input:focus,
    .dataTables_wrapper .dataTables_length select:focus {
        border-color: var(--purple-600) !important;
        box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.2) !important;
    }
    .dataTables_wrapper .dataTables_info {
        color: var(--purple-900) !important;
        font-size: 0.85rem !important;
        font-weight: 500 !important;
        padding-top: 0.75rem !important;
    }
    .dataTables_wrapper .dataTables_paginate {
        padding-top: 0.75rem !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 0.375rem !important;
        border: 1px solid var(--purple-200) !important;
        background: white !important;
        color: var(--purple-900) !important;
        font-size: 0.82rem !important;
        font-weight: 600 !important;
        padding: 0.35rem 0.75rem !important;
        margin: 0 2px !important;
        transition: all 0.15s ease !important;
        cursor: pointer !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: var(--purple-100) !important;
        color: var(--purple-900) !important;
        border-color: var(--purple-400) !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
        background: var(--purple-600) !important;
        color: white !important;
        border-color: var(--purple-600) !important;
        box-shadow: 0 2px 4px rgba(124, 58, 237, 0.25) !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
        opacity: 0.5;
        background: #F3F4F6 !important;
        border-color: #E5E7EB !important;
        color: #9CA3AF !important;
        cursor: not-allowed !important;
    }
    table.dataTable.no-footer {
        border-bottom: 2px solid var(--purple-200) !important;
    }
    table.dataTable thead th {
        border-bottom: 2px solid var(--purple-300) !important;
        background-color: var(--purple-50) !important;
        color: var(--purple-900) !important;
        font-weight: 700 !important;
        padding: 0.75rem !important;
    }
</style>

<div style="display: flex; min-height: 85vh; background-color: var(--purple-50);">
    <!-- Sidebar Navigation -->
    <aside style="width: 260px; background-color: var(--purple-900); color: white; padding: 1.5rem 1rem; flex-shrink: 0;">
        <div style="padding: 0 0.5rem 1.5rem 0.5rem; border-bottom: 1px solid var(--purple-700); margin-bottom: 1.5rem;">
            <h2 style="color: white; font-size: 1.25rem; margin: 0;" data-i18n="sales.portal">Portal de Ventas</h2>
            <p style="color: var(--purple-200); font-size: 0.85rem; margin: 0.25rem 0 0 0;" data-i18n="sales.management">Gestión Comercial</p>
        </div>

        <nav style="display: flex; flex-direction: column; gap: 0.5rem;">
            <a href="?section=general" class="nav-item @(Model.ActiveSection == "general" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "general" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "general" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.general">
                📊 General
            </a>
            <a href="?section=ventas" class="nav-item @(Model.ActiveSection == "ventas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "ventas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "ventas" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.sales">
                💳 Ventas
            </a>
            <a href="?section=facturas" class="nav-item @(Model.ActiveSection == "facturas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "facturas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "facturas" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.invoices">
                🧾 Facturas
            </a>
            <a href="?section=inventarios" class="nav-item @(Model.ActiveSection == "inventarios" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "inventarios" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "inventarios" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.inventory">
                📦 Inventarios
            </a>
            <a href="?section=perfil" class="nav-item @(Model.ActiveSection == "perfil" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "perfil" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "perfil" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="sales.nav.profile">
                ⚙️ Mi Perfil
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main style="flex: 1; padding: 2rem; overflow-y: auto;">
        @if (Model.ActiveSection == "general")
        {
            <partial name="~/Views/Ventas/_Indicadores.cshtml" model="Model" />
        }
        else if (Model.ActiveSection == "ventas")
        {
            <partial name="~/Views/Ventas/_TablaVentas.cshtml" model="Model" />
        }
        else if (Model.ActiveSection == "facturas")
        {
            <partial name="~/Views/Ventas/_Facturas.cshtml" model="Model" />
        }
        else if (Model.ActiveSection == "inventarios")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;">Consulta de Inventario</h1>
            </div>

            <div style="display: flex; border-bottom: 2px solid var(--purple-200); margin-bottom: 1.5rem;">
                <a href="?section=inventarios&subtab=productos" style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "productos" || string.IsNullOrEmpty(Model.ActiveSubTab) ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "productos" || string.IsNullOrEmpty(Model.ActiveSubTab) ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px; text-decoration: none;">
                    📦 Productos
                </a>
                <a href="?section=inventarios&subtab=historial" style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "historial" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "historial" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px; text-decoration: none;">
                    📜 Historial de Movimientos
                </a>
            </div>

            <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">ID</th>
                                <th style="padding: 0.75rem;">Producto</th>
                                <th style="padding: 0.75rem; text-align: center;">Categoría</th>
                                <th style="padding: 0.75rem; text-align: center;">Precio</th>
                                <th style="padding: 0.75rem; text-align: center;">Cantidad</th>
                                <th style="padding: 0.75rem; text-align: center;">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Productos != null)
                            {
                                @foreach (var prod in Model.Productos)
                                {
                                    var isAgotado = prod.Stock <= 0;
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; color: var(--gray-500);">#@prod.Id</td>
                                        <td style="padding: 0.75rem; font-weight: 500;">@prod.Nombre</td>
                                        <td style="padding: 0.75rem; text-align: center; color: var(--gray-600);">@prod.Categoria</td>
                                        <td style="padding: 0.75rem; text-align: center; font-weight: 600;">@prod.Precio.ToString("C")</td>
                                        <td style="padding: 0.75rem; text-align: center; font-weight: 700; color: @(isAgotado ? "var(--error)" : "var(--purple-900)");">
                                            @prod.Stock
                                        </td>
                                        <td style="padding: 0.75rem; text-align: center;">
                                            <span style="background-color: @(isAgotado ? "var(--error)" : "var(--success)"); color: white; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                                                @(isAgotado ? "Agotado" : "Activo")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (Model.ActiveSection == "perfil")
        {
            <h1 style="color: var(--purple-900); margin-bottom: 1.5rem; font-size: 1.75rem;">Perfil Ejecutivo de Ventas</h1>

            <div class="card" style="padding: 2rem; background: white; max-width: 600px; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                <div style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem;">
                    <div style="width: 70px; height: 70px; border-radius: 50%; background-color: var(--purple-600); color: white; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold;">
                        @(Model.UsuarioActual?.Nombre?.FirstOrDefault() ?? 'V')
                    </div>
                    <div>
                        <h2 style="margin: 0; color: var(--purple-900); font-size: 1.5rem;">@Model.UsuarioActual?.Nombre @Model.UsuarioActual?.Apellido</h2>
                        <p style="margin: 0; color: var(--purple-600); font-weight: 600;">Asesor Comercial / Ventas</p>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 1rem; border-top: 1px solid var(--purple-100); padding-top: 1.5rem;">
                    <div>
                        <label style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600;">CORREO ELECTRÓNICO</label>
                        <p style="margin: 0; font-weight: 500;">@Model.UsuarioActual?.Email</p>
                    </div>
                    <div>
                        <label style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600;">TELÉFONO</label>
                        <p style="margin: 0; font-weight: 500;">@(Model.UsuarioActual?.Telefono ?? "No registrado")</p>
                    </div>
                    <div>
                        <label style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600;">ROL DE ACCESO</label>
                        <p style="margin: 0; text-transform: capitalize; font-weight: 600; color: var(--purple-700);">@Model.UsuarioActual?.Role</p>
                    </div>
                </div>
            </div>
        }
    </main>
</div>

<!-- Modales del Módulo de Ventas -->
<partial name="~/Views/Ventas/_Modales.cshtml" model="Model" />
<partial name="_ModalRegistrarVenta" model="((IEnumerable<LentSoft.Web.Models.Entities.User>)Model.Clientes, (IEnumerable<LentSoft.Web.Models.Entities.Product>)Model.Productos)" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- DataTables Scripts Locales (Sin CDN) -->
    <script src="~/lib/datatables/jquery.min.js"></script>
    <script src="~/lib/datatables/datatables.min.js"></script>

    <script>
        let dtVentasInstance = null;
        const currentSalesCache = {};

        $(document).ready(function () {
            if ($('#tableVentasSales').length && !$.fn.DataTable.isDataTable('#tableVentasSales')) {
                dtVentasInstance = $('#tableVentasSales').DataTable({
                    serverSide: true,
                    processing: true,
                    ajax: {
                        url: '/Ventas/ListarVentas',
                        type: 'GET',
                        data: function (d) {
                            d.draw = d.draw;
                            d.start = d.start;
                            d.length = d.length;
                            d.searchValue = d.search ? d.search.value : '';
                            if (d.order && d.order.length > 0) {
                                d.sortColumnIndex = d.order[0].column;
                                d.sortDirection = d.order[0].dir;
                            }
                            d.filtroRapido = $('#dtFiltroRapido').val();
                            d.fechaDesde = $('#dtFechaDesde').val();
                            d.fechaHasta = $('#dtFechaHasta').val();
                            d.estado = $('#dtFiltroEstado').val();
                            d.estadoPago = $('#dtFiltroEstadoPago').val();
                        },
                        dataSrc: function (json) {
                            if (json && json.data) {
                                json.data.forEach(item => {
                                    currentSalesCache[item.id] = item;
                                });
                            }
                            return json.data || [];
                        }
                    },
                    language: {
                        search: "🔍 Buscar en ventas:",
                        searchPlaceholder: "Cliente, pedido, estado...",
                        lengthMenu: "Mostrar _MENU_ ventas",
                        info: "Mostrando _START_ a _END_ de _TOTAL_ ventas",
                        infoEmpty: "Mostrando 0 a 0 de 0 ventas",
                        infoFiltered: "(filtrado de _MAX_ ventas en total)",
                        zeroRecords: "No se encontraron ventas que coincidan con los criterios de búsqueda",
                        loadingRecords: "Cargando ventas...",
                        processing: "Procesando ventas...",
                        paginate: {
                            first: "«",
                            last: "»",
                            next: "Siguiente ›",
                            previous: "‹ Anterior"
                        }
                    },
                    pageLength: 10,
                    lengthMenu: [10, 25, 50, 100],
                    order: [[2, 'desc']],
                    columns: [
                        {
                            data: 'numeroPedido',
                            render: function (data, type, row) {
                                let badgeFormula = row.tieneFormula
                                    ? '<span title="Fórmula Óptica Vinculada (#' + row.formulaOpticaId + ')" style="display: inline-flex; align-items: center; justify-content: center; margin-left: 0.35rem; font-size: 0.75rem; background-color: #E0E7FF; color: #4338CA; border: 1px solid #C7D2FE; border-radius: 9999px; padding: 0.1rem 0.4rem; font-weight: 700; vertical-align: middle;">🔗</span>'
                                    : '';
                                return '<span style="font-weight: 700; color: var(--purple-700);">' + data + '</span>' + badgeFormula;
                            }
                        },
                        { data: 'clienteNombre', render: function (d) { return '<span style="font-weight: 500;">' + d + '</span>'; } },
                        { data: 'fecha' },
                        {
                            data: 'total',
                            render: function (d) { return '<span style="font-weight: 700; color: var(--purple-900);">' + formatMoney(d) + '</span>'; }
                        },
                        {
                            data: 'totalAbonado',
                            render: function (d) { return '<span style="font-weight: 600; color: #16A34A;">' + formatMoney(d) + '</span>'; }
                        },
                        {
                            data: 'saldoPendiente',
                            render: function (d) {
                                const color = d > 0 ? '#DC2626' : '#16A34A';
                                return '<span style="font-weight: 700; color: ' + color + ';">' + formatMoney(d) + '</span>';
                            }
                        },
                        {
                            data: 'estadoPago',
                            render: function (d) {
                                const bg = d === 'Pagado' ? '#10B981' : (d === 'Abonado' ? '#F59E0B' : '#EF4444');
                                return '<span style="background-color: ' + bg + '; color: white; padding: 0.2rem 0.55rem; border-radius: 9999px; font-size: 0.72rem; font-weight: 700;">' + d + '</span>';
                            }
                        },
                        {
                            data: 'estadoOrden',
                            orderable: false,
                            render: function (d, type, row) {
                                const estados = ['pendiente', 'procesando', 'enviado', 'entregado', 'pagado', 'cancelado'];
                                let options = estados.map(e => {
                                    const sel = (row.estadoOrden.toLowerCase() === e) ? 'selected' : '';
                                    const label = e.charAt(0).toUpperCase() + e.slice(1);
                                    return '<option value="' + e + '" ' + sel + '>' + label + '</option>';
                                }).join('');

                                const token = $('input[name="__RequestVerificationToken"]').first().val() || '';
                                return '<form method="post" action="/Ventas/UpdateOrderStatus" style="display:flex; gap:0.35rem; align-items:center;">' +
                                       '<input type="hidden" name="__RequestVerificationToken" value="' + token + '" />' +
                                       '<input type="hidden" name="id" value="' + row.id + '" />' +
                                       '<select name="estado" style="padding: 0.2rem 0.35rem; border-radius: 0.25rem; font-size: 0.75rem; border: 1px solid var(--purple-300);">' + options + '</select>' +
                                       '<button type="submit" style="background-color: var(--purple-600); color: white; border: none; padding: 0.2rem 0.45rem; border-radius: 0.25rem; font-size: 0.72rem; font-weight: 600; cursor: pointer;">OK</button>' +
                                       '</form>';
                            }
                        },
                        {
                            data: null,
                            orderable: false,
                            className: 'text-center',
                            render: function (data, type, row) {
                                let html = '<div style="display: flex; gap: 0.35rem; justify-content: center; flex-wrap: wrap;">';

                                html += '<button type="button" onclick="openDetallePedidoModal(' + row.id + ')" ' +
                                        'style="background-color: var(--purple-600); color: white; border: none; padding: 0.3rem 0.55rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600; cursor: pointer;">' +
                                        '👁️ Ver' +
                                        '</button>';

                                if (row.saldoPendiente > 0 && row.estadoOrden.toLowerCase() !== 'cancelado') {
                                    html += '<button type="button" onclick="openAbonoModal(' + row.id + ', ' + row.total + ', ' + row.saldoPendiente + ')" ' +
                                            'style="background-color: #2563EB; color: white; border: none; padding: 0.3rem 0.55rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600; cursor: pointer;">' +
                                            '💵 Abonar' +
                                            '</button>';

                                    html += '<button type="button" onclick="openTarjetaModal(' + row.id + ', ' + row.saldoPendiente + ')" ' +
                                            'style="background-color: #7C3AED; color: white; border: none; padding: 0.3rem 0.55rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600; cursor: pointer;">' +
                                            '💳 Tarjeta' +
                                            '</button>';
                                }

                                html += '</div>';
                                return html;
                            }
                        }
                    ],
                    responsive: true
                });
            }
        });

        function formatMoney(num) {
            return 'COP $' + Math.round(num || 0).toLocaleString('es-CO');
        }

        function onFiltroRapidoChange(val) {
            const divDesde = document.getElementById('divDtFechaDesde');
            const divHasta = document.getElementById('divDtFechaHasta');
            if (val === 'personalizado') {
                divDesde.style.display = 'block';
                divHasta.style.display = 'block';
            } else {
                divDesde.style.display = 'none';
                divHasta.style.display = 'none';
                $('#dtFechaDesde').val('');
                $('#dtFechaHasta').val('');
            }
            aplicarFiltrosVentas();
        }

        function aplicarFiltrosVentas() {
            if (dtVentasInstance) {
                dtVentasInstance.ajax.reload();
            }
        }

        function limpiarFiltrosVentas() {
            $('#dtFiltroRapido').val('');
            $('#dtFechaDesde').val('');
            $('#dtFechaHasta').val('');
            $('#dtFiltroEstado').val('');
            $('#dtFiltroEstadoPago').val('');
            document.getElementById('divDtFechaDesde').style.display = 'none';
            document.getElementById('divDtFechaHasta').style.display = 'none';
            if (dtVentasInstance) {
                dtVentasInstance.search('').ajax.reload();
            }
        }

        function openAbonoModal(ventaId, total, saldo) {
            document.getElementById('abonoVentaId').value = ventaId;
            document.getElementById('abonoSaldoPendienteDisplay').innerText = formatMoney(saldo);
            document.getElementById('abonoMontoInput').value = saldo;
            document.getElementById('abonoMontoInput').max = saldo;
            document.getElementById('modal-abono').style.display = 'flex';
        }

        function openTarjetaModal(ventaId, saldo) {
            document.getElementById('tarjetaVentaId').value = ventaId;
            document.getElementById('tarjetaMontoInput').value = saldo;
            document.getElementById('tarjetaMontoInput').max = saldo;
            document.getElementById('tarjetaNumeroInput').value = '';
            document.getElementById('tarjetaLuhnFeedback').innerText = '';
            document.getElementById('modal-tarjeta').style.display = 'flex';
        }

        function onNumeroTarjetaInput(input) {
            let val = input.value.replace(/\D/g, '');
            if (val.length > 19) val = val.substring(0, 19);
            
            // Formatear cada 4 dígitos
            let formatted = val.match(/.{1,4}/g)?.join(' ') || val;
            input.value = formatted;

            const feedback = document.getElementById('tarjetaLuhnFeedback');
            if (val.length >= 13) {
                if (validarAlgoritmoLuhn(val)) {
                    feedback.style.color = '#10B981';
                    feedback.innerText = '✓ Tarjeta válida según algoritmo de Luhn' + (val.endsWith('9') ? ' (Prueba: simulará rechazo)' : '');
                } else {
                    feedback.style.color = '#DC2626';
                    feedback.innerText = '✗ Número de tarjeta no supera validación Luhn';
                }
            } else {
                feedback.innerText = '';
            }
        }

        function validarAlgoritmoLuhn(numStr) {
            const clean = numStr.replace(/\D/g, '');
            if (clean.length < 13 || clean.length > 19) return false;
            let sum = 0;
            let alt = false;
            for (let i = clean.length - 1; i >= 0; i--) {
                let n = parseInt(clean.charAt(i), 10);
                if (alt) {
                    n *= 2;
                    if (n > 9) n -= 9;
                }
                sum += n;
                alt = !alt;
            }
            return (sum % 10 === 0);
        }

        function validarPagoTarjetaCliente() {
            const num = document.getElementById('tarjetaNumeroInput').value.replace(/\D/g, '');
            if (!validarAlgoritmoLuhn(num)) {
                alert('El número de tarjeta ingresado no es válido según el algoritmo de Luhn.');
                return false;
            }
            return true;
        }

        function openDetallePedidoModal(orderId) {
            const pedido = currentSalesCache[orderId];
            if (!pedido) return;

            document.getElementById('detalleModalOrderNumero').textContent = pedido.numeroPedido;
            document.getElementById('detalleModalCliente').textContent = pedido.clienteNombre;
            document.getElementById('detalleModalFecha').textContent = pedido.fecha;
            document.getElementById('detalleModalTotal').textContent = formatMoney(pedido.total);
            document.getElementById('detallePedidoOrderId').value = pedido.id;

            const tbody = document.getElementById('detalleModalProductosBody');
            tbody.innerHTML = '';
            if (pedido.items && pedido.items.length > 0) {
                pedido.items.forEach(item => {
                    const tr = document.createElement('tr');
                    tr.style.borderBottom = '1px solid var(--purple-100)';
                    tr.innerHTML = `
                        <td style="padding: 0.6rem 0.75rem; font-weight: 500;">
                            ${item.nombre}
                            ${item.categoria ? `<span style="font-size: 0.72rem; color: var(--purple-600); display: block;">(${item.categoria})</span>` : ''}
                        </td>
                        <td style="padding: 0.6rem 0.75rem; text-align: center;">${item.cantidad}</td>
                        <td style="padding: 0.6rem 0.75rem; text-align: right; font-weight: 600; color: var(--purple-900);">${formatMoney(item.subtotal)}</td>
                    `;
                    tbody.appendChild(tr);
                });
            } else {
                tbody.innerHTML = '<tr><td colspan="3" style="padding: 1rem; text-align: center; color: var(--gray-500);">No hay productos en este pedido.</td></tr>';
            }

            const seccionFormula = document.getElementById('seccionFormulaOptica');
            const formulaSelect = document.getElementById('detallePedidoFormulaSelect');
            const avisoSinFormulas = document.getElementById('avisoSinFormulas');
            const contenedorSelect = document.getElementById('contenedorSelectFormula');

            if (pedido.requiereFormula) {
                seccionFormula.style.display = 'block';
                formulaSelect.innerHTML = '<option value="">Cargando fórmulas...</option>';
                avisoSinFormulas.style.display = 'none';
                contenedorSelect.style.display = 'block';

                fetch('/Ventas/GetFormulasPorPaciente?userId=' + pedido.userId)
                    .then(res => res.json())
                    .then(formulas => {
                        formulaSelect.innerHTML = '<option value="">-- Sin fórmula vinculada --</option>';
                        if (!formulas || formulas.length === 0) {
                            avisoSinFormulas.style.display = 'block';
                        } else {
                            avisoSinFormulas.style.display = 'none';
                            formulas.forEach(f => {
                                const opt = document.createElement('option');
                                opt.value = f.id;
                                opt.textContent = `${f.fecha} — ${f.tipoLente} (${f.estado})`;
                                if (pedido.formulaOpticaId && pedido.formulaOpticaId === f.id) {
                                    opt.selected = true;
                                }
                                formulaSelect.appendChild(opt);
                            });
                        }
                    })
                    .catch(err => {
                        console.error('Error al cargar fórmulas del paciente:', err);
                        formulaSelect.innerHTML = '<option value="">Error al cargar fórmulas</option>';
                    });
            } else {
                seccionFormula.style.display = 'none';
            }

            document.getElementById('modal-detalle-pedido').style.display = 'flex';
        }

        function closeDetallePedidoModal() {
            document.getElementById('modal-detalle-pedido').style.display = 'none';
        }

        function onInvoiceOrderChange(selectElem) {
            const selectedOpt = selectElem.options[selectElem.selectedIndex];
            const total = parseFloat(selectedOpt.getAttribute('data-total') || '0');
            const metodo = selectedOpt.getAttribute('data-metodo') || 'Efectivo';
            const saldo = parseFloat(selectedOpt.getAttribute('data-saldopendiente') || '0');

            document.getElementById('invoiceMetodoPagoInput').value = metodo;

            const estadoSelect = document.getElementById('invoiceEstadoSelect');
            if (estadoSelect) {
                if (saldo <= 0) {
                    estadoSelect.value = 'pagada';
                } else if (saldo < total) {
                    estadoSelect.value = 'parcial';
                } else {
                    estadoSelect.value = 'pendiente';
                }
            }

            if (total > 0) {
                const subtotal = (total / 1.19).toFixed(2);
                const impuestos = (total - subtotal).toFixed(2);
                document.getElementById('newInvoiceSubtotal').value = subtotal;
                document.getElementById('newInvoiceImpuestos').value = impuestos;
                document.getElementById('newInvoiceTotal').value = total.toFixed(2);
            }
        }

        function confirmDeleteInvoice(id, numero) {
            if (confirm('¿Está seguro de eliminar la factura ' + numero + '?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Invoice/Delete/' + id;
                
                const tokenElem = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenElem) {
                    const hiddenToken = document.createElement('input');
                    hiddenToken.type = 'hidden';
                    hiddenToken.name = '__RequestVerificationToken';
                    hiddenToken.value = tokenElem.value;
                    form.appendChild(hiddenToken);
                }

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}
