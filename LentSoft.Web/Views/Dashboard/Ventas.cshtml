                        lengthMenu: "Mostrar _MENU_ ventas",
                        info: "Mostrando _START_ a _END_ de _TOTAL_ ventas",
                        infoEmpty: "Mostrando 0 a 0 de 0 ventas",
                        infoFiltered: "(filtrado de _MAX_ ventas en total)",
                        zeroRecords: "No se encontraron ventas que coincidan con la búsqueda",
                        paginate: {
                            first: "«",
                            last: "»",
                            next: "Siguiente ›",
                            previous: "‹ Anterior"
                        }
                    },
                    dom: '<"dt-top-container"<"dt-buttons-group"B><"dt-search-group"f>l>rt<"dt-bottom-container"ip>',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '📊 Exportar a Excel',
                            className: 'btn-dt-export btn-dt-excel',
                            title: 'LentSoft_Reporte_Ventas',
                            exportOptions: {
                                columns: [0, 1, 2, 3, 4, 5, 6, 7],
                                format: {
                                    body: function (data, row, column, node) {
                                        if (column === 7) {
                                            var sel = $(node).find('select');
                                            return sel.length ? sel.val() : $(node).text().trim();
                                        }
                                        return $(node).text().trim().replace(/🔗/g, '').replace(/\s+/g, ' ');
                                    }
                                }
                            }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '📄 Exportar a PDF',
                            className: 'btn-dt-export btn-dt-pdf',
                            title: 'LentSoft - Reporte de Ventas',
                            orientation: 'landscape',
                            pageSize: 'A4',
                            exportOptions: {
                                columns: [0, 1, 2, 3, 4, 5, 6, 7],
                                format: {
                                    body: function (data, row, column, node) {
                                        if (column === 7) {
                                            var sel = $(node).find('select');
                                            return sel.length ? sel.val() : $(node).text().trim();
                                        }
                                        return $(node).text().trim().replace(/🔗/g, '').replace(/\s+/g, ' ');
                                    }
                                }
                            }
                        }
                    ],
                    pageLength: 10,
                    lengthMenu: [10, 25, 50, 100],
                    order: [[2, 'desc']], // Fecha descendente
                    columnDefs: [
                        { orderable: false, targets: [8] }, // Columna acciones
                        { orderable: false, targets: [7] }  // Columna form estado orden
                    ],
                    responsive: true
                });
            }
        });
    </script>
}
