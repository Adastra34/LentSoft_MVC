                    </table>
                </div>
            </div>
        }

        <!-- EXAMEN VISUAL -->
        @if (Model.ActiveSection == "examenes")
        {
            <h1 style="color: var(--purple-900); margin-bottom: 1.5rem; font-size: 1.75rem; font-family: var(--font-primary, sans-serif);">Examen Visual</h1>

            <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">Paciente</th>
                                <th style="padding: 0.75rem;">Fecha</th>
                                <th style="padding: 0.75rem;">Tipo de Examen</th>
                                <th style="padding: 0.75rem;">Ojo Derecho (OD)</th>
                                <th style="padding: 0.75rem;">Ojo Izquierdo (OI)</th>
                                <th style="padding: 0.75rem;">Resultado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ex in Model.ExamenesVisuales)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; font-weight: 500;">@ex.Paciente</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@ex.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td style="padding: 0.75rem;">@ex.TipoExamen</td>
                                    <td style="padding: 0.75rem;">@ex.OjoDerecho</td>
                                    <td style="padding: 0.75rem;">@ex.OjoIzquierdo</td>
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-800);">@ex.Resultado</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- FÓRMULAS ÓPTICAS -->
        @if (Model.ActiveSection == "formulas")
        {
            <h1 style="color: var(--purple-900); margin-bottom: 1.5rem; font-size: 1.75rem; font-family: var(--font-primary, sans-serif);">Fórmulas Ópticas</h1>

            <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">Paciente</th>
                                <th style="padding: 0.75rem;">Fecha</th>
                                <th style="padding: 0.75rem;">Esfera OD / OI</th>
                                <th style="padding: 0.75rem;">Cilindro OD / OI</th>
                                <th style="padding: 0.75rem;">Eje OD / OI</th>
                                <th style="padding: 0.75rem;">Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.FormulasOpticas)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; font-weight: 500;">@f.Paciente</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@f.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td style="padding: 0.75rem;">OD: @f.EsferaOD / OI: @f.EsferaOI</td>
                                    <td style="padding: 0.75rem;">OD: @f.CilindroOD / OI: @f.CilindroOI</td>
                                    <td style="padding: 0.75rem;">OD: @f.EjeOD / OI: @f.EjeOI</td>
                                    <td style="padding: 0.75rem; font-size: 0.85rem; color: var(--gray-600);">@f.Observaciones</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- PERFIL -->
        @if (Model.ActiveSection == "perfil")
        {
            <h1 style="color: var(--purple-900); margin-bottom: 1.5rem; font-size: 1.75rem; font-family: var(--font-primary, sans-serif);">Perfil Profesional</h1>

            <div class="card" style="padding: 2rem; background: white; max-width: 600px; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                <div style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem;">
                    <div style="width: 70px; height: 70px; border-radius: 50%; background-color: var(--purple-600); color: white; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold;">
                        @(Model.UsuarioActual?.Nombre?.FirstOrDefault() ?? 'O')
                    </div>
                    <div>
                        <h2 style="margin: 0; color: var(--purple-900); font-size: 1.5rem; font-family: var(--font-primary, sans-serif);">@Model.UsuarioActual?.Nombre</h2>
                        <p style="margin: 0; color: var(--purple-600); font-weight: 600;">Especialista Optómetra</p>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 1rem; border-top: 1px solid var(--purple-100); padding-top: 1.5rem;">
                    <div>
