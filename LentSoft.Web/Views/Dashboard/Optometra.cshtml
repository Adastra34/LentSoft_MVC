                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--purple-100); padding-bottom: 0.5rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem;">Ficha Detallada del Paciente</h2>
                        <button onclick="document.getElementById('modal-ver-paciente').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
