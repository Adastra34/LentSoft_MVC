                                <label style="font-size: 0.8rem; font-weight: 600; color: var(--gray-700);">Tratamiento / Plan</label>
                                <input name="Tratamiento" id="edit-examen-tratamiento" type="text" style="padding: 0.4rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.8rem; font-weight: 600; color: var(--gray-700);">Observaciones Generales</label>
                            <textarea name="Observaciones" id="edit-examen-observaciones" style="padding: 0.4rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="1"></textarea>
                        </div>

                        <div style="display: flex; gap: 1rem; margin-top: 0.5rem;">
                            <button type="button" onclick="document.getElementById('modal-editar-examen').style.display='none'" style="flex: 1; padding: 0.5rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer;">Cancelar</button>
                            <button type="submit" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600;">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <!-- FÓRMULAS ÓPTICAS -->
        @if (Model.ActiveSection == "formulas")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem; font-family: var(--font-primary, sans-serif);">Fórmulas Ópticas</h1>
                <button onclick="document.getElementById('modal-nueva-formula').style.display='flex'" class="btn" style="background-color: var(--purple-600); color: white; padding: 0.6rem 1rem; border: none; border-radius: 0.375rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                    👓 + Nueva Fórmula
                </button>
            </div>

            <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">Paciente</th>
                                <th style="padding: 0.75rem;">Fecha</th>
                                <th style="padding: 0.75rem;">Tipo Lente</th>
                                <th style="padding: 0.75rem;">Esfera OD / OI</th>
                                <th style="padding: 0.75rem;">Cilindro OD / OI</th>
                                <th style="padding: 0.75rem;">Eje OD / OI</th>
                                <th style="padding: 0.75rem;">Estado</th>
                                <th style="padding: 0.75rem;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.FormulasOpticas.Any())
                            {
                                <tr>
                                    <td colspan="8" style="padding: 1.5rem; text-align: center; color: var(--gray-500);">No hay fórmulas ópticas registradas.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var f in Model.FormulasOpticas)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; font-weight: 500;">@(f.User?.NombreCompleto ?? "N/A")</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@f.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td style="padding: 0.75rem; font-weight: 500;">@f.TipoLente</td>
                                        <td style="padding: 0.75rem;">OD: @f.EsferaOD / OI: @f.EsferaOI</td>
                                        <td style="padding: 0.75rem;">OD: @f.CilindroOD / OI: @f.CilindroOI</td>
                                        <td style="padding: 0.75rem;">OD: @f.EjeOD / OI: @f.EjeOI</td>
                                        <td style="padding: 0.75rem;">
                                            @{
                                                var vig = f.Estado == "Vigente";
                                                var bgF = vig ? "#D1FAE5" : "#FEE2E2";
                                                var fgF = vig ? "#065F46" : "#991B1B";
                                            }
                                            <span style="background-color: @bgF; color: @fgF; padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                                                @f.Estado
                                            </span>
                                        </td>
                                        <td style="padding: 0.75rem; display: flex; gap: 0.4rem; align-items: center;">
                                            <button onclick="abrirModalVerFormula(this)"
                                                    data-id="@f.Id"
                                                    data-paciente="@(f.User?.NombreCompleto ?? "N/A")"
                                                    data-documento="@(f.User?.TipoDocumento): @(f.User?.NumeroDocumento)"
                                                    data-fecha="@f.Fecha.ToLocalTime().ToString("dd/MM/yyyy")"
                                                    data-esferaod="@f.EsferaOD"
                                                    data-cilindrood="@f.CilindroOD"
                                                    data-ejeod="@f.EjeOD"
                                                    data-esferaoi="@f.EsferaOI"
                                                    data-cilindrooi="@f.CilindroOI"
                                                    data-ejeoi="@f.EjeOI"
                                                    data-observaciones="@(f.Observaciones ?? "Sin observaciones.")"
                                                    data-tipolente="@f.TipoLente"
                                                    data-distanciapupilar="@(f.DistanciaPupilar ?? "N/A")"
                                                    data-estado="@f.Estado"
                                                    data-optometra="@(f.Optometra?.NombreCompleto ?? "N/A")"
                                                    data-registroopto="@(f.Optometra?.RegistroMedico ?? "N/A")"
                                                    class="btn" style="background-color: var(--purple-50); color: var(--purple-800); padding: 0.3rem 0.6rem; border: none; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer; font-weight: 600;" title="Ver e Imprimir Receta">
                                                👁️
                                            </button>
                                            <button onclick="abrirModalEditarFormula(this)"
                                                    data-id="@f.Id"
                                                    data-userid="@f.UserId"
                                                    data-fecha="@f.Fecha.ToString("yyyy-MM-dd")"
                                                    data-esferaod="@f.EsferaOD"
                                                    data-cilindrood="@f.CilindroOD"
                                                    data-ejeod="@f.EjeOD"
                                                    data-esferaoi="@f.EsferaOI"
                                                    data-cilindrooi="@f.CilindroOI"
                                                    data-ejeoi="@f.EjeOI"
                                                    data-observaciones="@f.Observaciones"
                                                    data-tipolente="@f.TipoLente"
                                                    data-distanciapupilar="@f.DistanciaPupilar"
                                                    class="btn" style="background-color: var(--purple-100); color: var(--purple-700); padding: 0.3rem 0.6rem; border: none; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer; font-weight: 600;" title="Editar">
                                                ✏️
                                            </button>
                                            <form asp-controller="Optometra" asp-action="DeleteFormula" method="post" style="display:inline;" onsubmit="return confirm('¿Estás seguro de eliminar esta fórmula?')">
                                                <input type="hidden" name="id" value="@f.Id" />
                                                <button type="submit" style="background: none; border: none; color: #ef4444; font-size: 1.1rem; cursor: pointer; padding: 0.2rem;" title="Eliminar fórmula">🗑️</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Modal para Ver e Imprimir Receta de Fórmula Óptica -->
            <div id="modal-ver-formula" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 600px; background: white; border-radius: 0.5rem; padding: 2rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); max-height: 95vh; overflow-y: auto;" id="receta-imprimible">
                    
                    <!-- Formato de Receta Médica -->
                    <div style="border: 2px solid var(--purple-600); padding: 1.5rem; border-radius: 0.375rem; background-color: white;">
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.75rem; margin-bottom: 1rem;">
                            <div>
                                <h2 style="color: var(--purple-900); margin: 0; font-size: 1.5rem; font-family: var(--font-primary, sans-serif); font-weight:700;">LentSoft Optometría</h2>
                                <p style="margin:0; font-size:0.8rem; color:var(--gray-600);">Clínica de Especialidades Visuales</p>
                            </div>
                            <div style="text-align:right;">
                                <h3 style="color: var(--purple-600); margin:0; font-size: 1rem; font-weight:700;">RECETA CLÍNICA</h3>
                                <p style="margin:0; font-size:0.75rem; color:var(--gray-600);">Fórmula #FOR-<span id="ver-formula-id"></span></p>
                            </div>
                        </div>

                        <!-- Información Paciente -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; font-size: 0.85rem; margin-bottom: 1rem; background-color: var(--purple-50); padding: 0.75rem; border-radius:0.25rem;">
                            <p style="margin:0;"><strong>Paciente:</strong> <span id="ver-formula-paciente"></span></p>
                            <p style="margin:0;"><strong>Identificación:</strong> <span id="ver-formula-documento"></span></p>
                            <p style="margin:0;"><strong>Fecha Emisión:</strong> <span id="ver-formula-fecha"></span></p>
                            <p style="margin:0;"><strong>Tipo Lente:</strong> <span id="ver-formula-tipolente" style="font-weight:600; color:var(--purple-800);"></span></p>
                        </div>

                        <!-- Grilla de Corrección Visual -->
                        <table style="width: 100%; border-collapse: collapse; text-align: center; font-size: 0.85rem; margin-bottom: 1.5rem;">
                            <thead>
                                <tr style="background-color: var(--purple-600); color: white; font-weight:600;">
                                    <th style="padding: 0.5rem; border: 1px solid var(--purple-300);">Ojo</th>
                                    <th style="padding: 0.5rem; border: 1px solid var(--purple-300);">Esfera (SPH)</th>
                                    <th style="padding: 0.5rem; border: 1px solid var(--purple-300);">Cilindro (CYL)</th>
                                    <th style="padding: 0.5rem; border: 1px solid var(--purple-300);">Eje (AXIS)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding: 0.5rem; border: 1px solid var(--purple-200); font-weight:600;">Ojo Derecho (OD)</td>
                                    <td style="padding: 0.5rem; border: 1px solid var(--purple-200);" id="ver-formula-esferaod"></td>
                                    <td style="padding: 0.5rem; border: 1px solid var(--purple-200);" id="ver-formula-cilindrood"></td>
                                    <td style="padding: 0.5rem; border: 1px solid var(--purple-200);" id="ver-formula-ejeod"></td>
                                </tr>
                                <tr>
                                    <td style="padding: 0.5rem; border: 1px solid var(--purple-200); font-weight:600;">Ojo Izquierdo (OI)</td>
                                    <td style="padding: 0.5rem; border: 1px solid var(--purple-200);" id="ver-formula-esferaoi"></td>
                                    <td style="padding: 0.5rem; border: 1px solid var(--purple-200);" id="ver-formula-cilindrooi"></td>
                                    <td style="padding: 0.5rem; border: 1px solid var(--purple-200);" id="ver-formula-ejeoi"></td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="font-size:0.85rem; margin-bottom:1.5rem; display:flex; justify-content:space-between; align-items:center;">
                            <span><strong>Distancia Pupilar (DP):</strong> <span id="ver-formula-distanciapupilar" style="font-weight:600;"></span> mm</span>
                            <span><strong>Estado de Validez:</strong> <span id="ver-formula-validez" style="font-weight:600;"></span></span>
                        </div>

                        <!-- Observaciones / Indicaciones -->
                        <div style="font-size: 0.85rem; border-top: 1px dashed var(--purple-300); padding-top: 0.75rem; margin-bottom: 2rem;">
                            <p style="margin-top:0; font-weight:600;">Observaciones y Recomendaciones:</p>
                            <p style="font-style: italic; color: var(--gray-700); margin:0;" id="ver-formula-observaciones"></p>
                        </div>

                        <!-- Firmas -->
                        <div style="display: flex; justify-content: flex-end; align-items: flex-end; font-size: 0.8rem; border-top: 1px solid var(--purple-200); padding-top: 2rem;">
                            <div style="text-align: center; width: 45%;">
                                <p style="font-weight:600; margin:0;" id="ver-formula-optometra"></p>
                                <p style="margin:0; font-size:0.75rem; color:var(--gray-600);">Optómetra Especialista</p>
                                <p style="margin:0; font-size:0.75rem; color:var(--gray-600);">R.M. <span id="ver-formula-registroopto"></span></p>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de Acción (Ocultar al Imprimir en CSS) -->
                    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;" class="no-print">
                        <button type="button" onclick="document.getElementById('modal-ver-formula').style.display='none'" style="flex: 1; padding: 0.5rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer; font-weight:600;">Cerrar</button>
                        <button type="button" onclick="descargarFormulaPdf()" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-100); color: var(--purple-800); cursor: pointer; font-weight:600;">📄 Descargar PDF</button>
                        <button type="button" onclick="imprimirFormula()" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight:600;">🖨️ Imprimir</button>
                    </div>
                </div>
            </div>

            <!-- Modal para Nueva Formula -->
            <div id="modal-nueva-formula" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 550px; background: white; border-radius: 0.5rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); max-height: 90vh; overflow-y: auto;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem;">Crear Fórmula Óptica</h2>
                        <button onclick="document.getElementById('modal-nueva-formula').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
                    </div>

                    <form asp-controller="Optometra" asp-action="CreateFormula" method="post" id="form-nueva-formula" style="display:flex; flex-direction:column; gap:1rem;">
                        <!-- Selector de Plantilla Rápida -->
                        <div style="display: flex; flex-direction: column; gap: 0.25rem; background-color: var(--purple-50); padding: 0.75rem; border-radius: 0.375rem; border: 1px dashed var(--purple-300);">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--purple-950); margin-bottom: 0.25rem;">✨ Cargar Plantilla Rápida</label>
                            <select id="select-plantilla-rapida" onchange="aplicarPlantillaFormula(this.value)" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem; background: white; cursor: pointer;">
                                <option value="">-- Seleccionar diagnóstico (Manual) --</option>
                                <option value="miopia-leve">Miopía Leve (OD/OI: -1.00, Monofocal)</option>
                                <option value="miopia-moderada">Miopía Moderada (OD/OI: -3.00, Filtro Azul)</option>
                                <option value="astigmatismo">Astigmatismo Común (Cilindro: -1.00, Eje: 180)</option>
                                <option value="presbicia">Presbicia Inicial (OD/OI: +1.00, Progresivo)</option>
                                <option value="ojo-sano">Examen de Control (OD/OI: 0.00, Monofocal)</option>
                            </select>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Paciente</label>
                                <select name="UserId" class="searchable-select" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                    @foreach (var cli in Model.Pacientes)
                                    {
                                        <option value="@cli.Id">@cli.NombreCompleto</option>
                                    }
                                </select>
                            </div>

                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Fecha de Emisión</label>
                                <input name="Fecha" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Tipo de Lente</label>
                                <select name="TipoLente" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                    <option value="Monofocal - Antirreflejo">Monofocal - Antirreflejo</option>
                                    <option value="Monofocal - Filtro Azul">Monofocal - Filtro Azul</option>
                                    <option value="Bifocal">Bifocal</option>
                                    <option value="Progresivo">Progresivo</option>
                                    <option value="Lente de Contacto Blando">Lente de Contacto Blando</option>
                                    <option value="Lente de Contacto Rígido">Lente de Contacto Rígido</option>
                                </select>
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Distancia Pupilar (DP) (mm)</label>
                                <input name="DistanciaPupilar" placeholder="Ej: 63" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                        </div>

                        <h3 style="margin: 0; font-size: 0.95rem; color: var(--purple-800); border-bottom: 1px solid var(--purple-100); padding-bottom: 0.25rem;">Ojo Derecho (OD)</h3>
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.75rem; font-weight: 600; color: var(--gray-600);">Esfera</label>
                                <input name="EsferaOD" placeholder="Ej: -1.25" type="text" style="width: 100%; box-sizing: border-box; min-width: 0; padding: 0.4rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.75rem; font-weight: 600; color: var(--gray-600);">Cilindro</label>
                                <input name="CilindroOD" placeholder="Ej: -0.50" type="text" style="width: 100%; box-sizing: border-box; min-width: 0; padding: 0.4rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.75rem; font-weight: 600; color: var(--gray-600);">Eje</label>
                                <input name="EjeOD" placeholder="Ej: 180" type="text" style="width: 100%; box-sizing: border-box; min-width: 0; padding: 0.4rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                        </div>

                        <h3 style="margin: 0.5rem 0 0 0; font-size: 0.95rem; color: var(--purple-800); border-bottom: 1px solid var(--purple-100); padding-bottom: 0.25rem;">Ojo Izquierdo (OI)</h3>
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.75rem; font-weight: 600; color: var(--gray-600);">Esfera</label>
                                <input name="EsferaOI" placeholder="Ej: -1.50" type="text" style="width: 100%; box-sizing: border-box; min-width: 0; padding: 0.4rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.75rem; font-weight: 600; color: var(--gray-600);">Cilindro</label>
                                <input name="CilindroOI" placeholder="Ej: -0.75" type="text" style="width: 100%; box-sizing: border-box; min-width: 0; padding: 0.4rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.75rem; font-weight: 600; color: var(--gray-600);">Eje</label>
                                <input name="EjeOI" placeholder="Ej: 175" type="text" style="width: 100%; box-sizing: border-box; min-width: 0; padding: 0.4rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Observaciones / Recomendaciones</label>
                            <textarea name="Observaciones" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2"></textarea>
                        </div>

                        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                            <button type="button" onclick="document.getElementById('modal-nueva-formula').style.display='none'" style="flex: 1; padding: 0.5rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer;">Cancelar</button>
                            <button type="submit" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600;">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Modal para Editar Formula -->
            <div id="modal-editar-formula" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 550px; background: white; border-radius: 0.5rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); max-height: 90vh; overflow-y: auto;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem;">Editar Fórmula Óptica</h2>
                        <button onclick="document.getElementById('modal-editar-formula').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
                    </div>

