    function imprimirFormula() {
        var modal = document.getElementById('modal-ver-formula');
        var main = document.querySelector('main');
        
        // Move modal to body so print media query works
        document.body.appendChild(modal);
        
        // Print
        window.print();
        
        // Return modal back to main container
        if (main) {
            main.appendChild(modal);
        }
