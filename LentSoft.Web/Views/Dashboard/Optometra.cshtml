    function aplicarPlantillaFormula(value) {
        var form = document.getElementById('form-nueva-formula');
        if (!form) return;

        var presets = {
            'miopia-leve': {
                esferaOD: '-1.00', cilindroOD: '0.00', ejeOD: '0',
                esferaOI: '-1.00', cilindroOI: '0.00', ejeOI: '0',
                tipoLente: 'Monofocal - Antirreflejo',
                distDP: '62',
                obs: 'Filtro antirreflejo básico. Uso para pantallas y conducción nocturna. Control en 12 meses.'
            },
            'miopia-moderada': {
                esferaOD: '-3.00', cilindroOD: '-0.50', ejeOD: '180',
                esferaOI: '-3.25', cilindroOI: '-0.25', ejeOI: '175',
                tipoLente: 'Monofocal - Filtro Azul',
                distDP: '63',
                obs: 'Protección filtro azul obligatoria por alta exposición a pantallas. Uso permanente.'
            },
            'astigmatismo': {
                esferaOD: '0.00', cilindroOD: '-1.00', ejeOD: '180',
                esferaOI: '0.00', cilindroOI: '-1.00', ejeOI: '180',
                tipoLente: 'Monofocal - Antirreflejo',
                distDP: '64',
                obs: 'Astigmatismo regular bilateral. Uso para lectura, lectura en computador y estudio.'
            },
            'presbicia': {
                esferaOD: '+1.00', cilindroOD: '0.00', ejeOD: '0',
                esferaOI: '+1.00', cilindroOI: '0.00', ejeOI: '0',
                tipoLente: 'Progresivo',
                distDP: '64',
                obs: 'Presbicia inicial. Se recomiendan lentes progresivos para uso intermitente en tareas de cerca.'
            },
            'ojo-sano': {
                esferaOD: '0.00', cilindroOD: '0.00', ejeOD: '0',
                esferaOI: '0.00', cilindroOI: '0.00', ejeOI: '0',
                tipoLente: 'Monofocal - Antirreflejo',
                distDP: '62',
                obs: 'Examen de control. Agudeza visual 20/20. No requiere corrección óptica de momento. Control preventivo en un año.'
            }
        };

        if (value && presets[value]) {
            var p = presets[value];
            form.querySelector('[name="EsferaOD"]').value = p.esferaOD;
            form.querySelector('[name="CilindroOD"]').value = p.cilindroOD;
            form.querySelector('[name="EjeOD"]').value = p.ejeOD;
            form.querySelector('[name="EsferaOI"]').value = p.esferaOI;
            form.querySelector('[name="CilindroOI"]').value = p.cilindroOI;
            form.querySelector('[name="EjeOI"]').value = p.ejeOI;
            form.querySelector('[name="TipoLente"]').value = p.tipoLente;
            form.querySelector('[name="DistanciaPupilar"]').value = p.distDP;
            form.querySelector('[name="Observaciones"]').value = p.obs;
            alertify.success('Plantilla cargada correctamente');
        }
    }

