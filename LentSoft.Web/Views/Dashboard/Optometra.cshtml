                        <button type="button" id="btn-ver-editar-paciente" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600;">Editar Paciente</button>
                    </div>
                </div>
