            <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">ID</th>
                                <th style="padding: 0.75rem;">Paciente</th>
                                <th style="padding: 0.75rem;">Fecha</th>
                                <th style="padding: 0.75rem;">Diagnóstico</th>
                                <th style="padding: 0.75rem;">Tratamiento</th>
                                <th style="padding: 0.75rem;">Optómetra</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.HistorialClinico)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; color: var(--gray-500);">#HC-@h.Id</td>
                                    <td style="padding: 0.75rem; font-weight: 500;">@h.Paciente</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@h.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td style="padding: 0.75rem;">@h.Diagnostico</td>
                                    <td style="padding: 0.75rem;">@h.Tratamiento</td>
                                    <td style="padding: 0.75rem;">@h.Optometra</td>
                                </tr>
                            }
