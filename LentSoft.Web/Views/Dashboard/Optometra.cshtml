                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Correo Electrónico</label>
                                <input name="email" type="email" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Dirección</label>
                                <input name="direccion" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">EPS</label>
                                <input name="eps" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Observaciones Clínicas del Paciente</label>
                            <textarea name="observacionesPaciente" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2"></textarea>
                        </div>

                        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                            <button type="button" onclick="document.getElementById('modal-nuevo-paciente').style.display='none'" style="flex: 1; padding: 0.5rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer;">Cancelar</button>
                            <button type="submit" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600;">Registrar Paciente</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Modal para Editar Paciente -->
            <div id="modal-editar-paciente" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 550px; background: white; border-radius: 0.5rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); max-height: 90vh; overflow-y: auto;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem;">Editar Datos del Paciente</h2>
                        <button onclick="document.getElementById('modal-editar-paciente').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
                    </div>

                    <form asp-controller="Optometra" asp-action="EditPaciente" method="post" style="display:flex; flex-direction:column; gap:1rem;">
                        <input type="hidden" name="id" id="edit-paciente-id" />
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Tipo de Documento</label>
                                <select name="tipoDocumento" id="edit-paciente-tipodoc" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                    <option value="CC">CC</option>
                                    <option value="CE">CE</option>
                                    <option value="TI">TI</option>
                                    <option value="Pasaporte">Pasaporte</option>
                                </select>
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Número de Documento</label>
                                <input name="numeroDocumento" id="edit-paciente-numdoc" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Nombre</label>
                                <input name="nombre" id="edit-paciente-nombre" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Apellido</label>
                                <input name="apellido" id="edit-paciente-apellido" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Fecha de Nacimiento</label>
                                <input name="fechaNacimiento" id="edit-paciente-fechanac" type="date" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Género</label>
                                <select name="genero" id="edit-paciente-genero" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;">
                                    <option value="">Seleccionar...</option>
                                    <option value="Femenino">Femenino</option>
                                    <option value="Masculino">Masculino</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Teléfono</label>
                                <input name="telefono" id="edit-paciente-telefono" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Email</label>
                                <input name="email" id="edit-paciente-email" type="email" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Dirección</label>
                                <input name="direccion" id="edit-paciente-direccion" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">EPS</label>
                                <input name="eps" id="edit-paciente-eps" type="text" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Estado</label>
                                <select name="estadoPaciente" id="edit-paciente-estado" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                    <option value="Activo">Activo</option>
                                    <option value="Inactivo">Inactivo</option>
                                </select>
                            </div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Observaciones Clínicas del Paciente</label>
                            <textarea name="observacionesPaciente" id="edit-paciente-observaciones" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2"></textarea>
                        </div>

                        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                            <button type="button" onclick="document.getElementById('modal-editar-paciente').style.display='none'" style="flex: 1; padding: 0.5rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer;">Cancelar</button>
                            <button type="submit" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600;">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <!-- CITAS CON VISTA CALENDARIO -->
        @if (Model.ActiveSection == "citas")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem; font-family: var(--font-primary, sans-serif);">Agenda de Citas</h1>
                <button onclick="document.getElementById('modal-nueva-cita').style.display='flex'" class="btn" style="background-color: var(--purple-600); color: white; padding: 0.6rem 1rem; border: none; border-radius: 0.375rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                    📅 + Nueva Cita
                </button>
            </div>

            <!-- Vista Resumen Calendario Próxima Semana -->
            <div class="card" style="padding: 1.5rem; background: white; margin-bottom: 1.5rem; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                <h2 style="color: var(--purple-800); font-size: 1.1rem; margin-bottom: 1rem; font-family: var(--font-primary, sans-serif);">Citas Programadas por Día</h2>
                <div style="display: flex; gap: 1rem; overflow-x: auto; padding-bottom: 0.5rem;">
                    @for (int i = 0; i < 7; i++)
                    {
                        var dia = DateTime.UtcNow.Date.AddDays(i);
                        var citasDia = Model.Citas.Where(c => c.FechaHora.Date == dia).ToList();
                        <div style="min-width: 120px; padding: 0.75rem; border: 1px solid var(--purple-200); border-radius: 0.5rem; background-color: @(i == 0 ? "var(--purple-50)" : "white"); text-align: center;">
                            <p style="font-size: 0.8rem; color: var(--gray-500); margin-bottom: 0.25rem; font-weight: 600;">@dia.ToString("ddd dd/MM")</p>
                            <span style="font-size: 1.25rem; font-weight: 700; color: var(--purple-700);">@citasDia.Count</span>
                            <p style="font-size: 0.75rem; color: var(--gray-600); margin: 0;">citas</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Tabs de Filtros de Estado -->
            <div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; overflow-x: auto; padding-bottom: 0.25rem;">
                <button class="filter-tab active" onclick="filterCitasByEstado('Todos', this)" style="background-color: var(--purple-600); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">Todos</button>
                <button class="filter-tab" onclick="filterCitasByEstado('pendiente', this)" style="background-color: var(--purple-50); color: var(--purple-700); border: 1px solid var(--purple-200); padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">Pendientes</button>
                <button class="filter-tab" onclick="filterCitasByEstado('confirmada', this)" style="background-color: var(--purple-50); color: var(--purple-700); border: 1px solid var(--purple-200); padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">Confirmadas</button>
                <button class="filter-tab" onclick="filterCitasByEstado('en proceso', this)" style="background-color: var(--purple-50); color: var(--purple-700); border: 1px solid var(--purple-200); padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">En Proceso</button>
                <button class="filter-tab" onclick="filterCitasByEstado('atendida', this)" style="background-color: var(--purple-50); color: var(--purple-700); border: 1px solid var(--purple-200); padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">Atendidas</button>
                <button class="filter-tab" onclick="filterCitasByEstado('cancelada', this)" style="background-color: var(--purple-50); color: var(--purple-700); border: 1px solid var(--purple-200); padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">Canceladas</button>
            </div>

            <!-- Tabla de Citas -->
            <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                <div style="margin-bottom: 1rem;">
                    <input type="text" id="searchCitasOpto" placeholder="Buscar por N° cita, paciente o servicio..." class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchCitasOpto', 'tableCitasOpto')" />
                </div>
                <div style="overflow-x: auto;">
                    <table id="tableCitasOpto" style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">N° Cita</th>
                                <th style="padding: 0.75rem;">Paciente</th>
                                <th style="padding: 0.75rem;">Servicio</th>
                                <th style="padding: 0.75rem;">Fecha y Hora</th>
                                <th style="padding: 0.75rem;">Estado</th>
                                <th style="padding: 0.75rem;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Citas)
                            {
                                <tr class="cita-row" data-estado="@c.Estado?.ToLower()" style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; color: var(--gray-500); font-weight: 600;">#CIT-@c.Id</td>
                                    <td style="padding: 0.75rem; font-weight: 500;">@(c.User?.NombreCompleto ?? "Paciente")</td>
                                    <td style="padding: 0.75rem;">@c.Servicio</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@c.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="padding: 0.75rem;">
                                        @{
                                            var st = c.Estado?.ToLower() ?? "pendiente";
                                            var bg = st == "confirmada" ? "#D1FAE5" : st == "pendiente" ? "#FEF3C7" : st == "en proceso" ? "#DBEAFE" : st == "atendida" ? "var(--purple-100)" : "#FEE2E2";
                                            var fg = st == "confirmada" ? "#065F46" : st == "pendiente" ? "#92400E" : st == "en proceso" ? "#1E40AF" : st == "atendida" ? "var(--purple-800)" : "#991B1B";
                                        }
                                        <span style="background-color: @bg; color: @fg; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: capitalize;">
                                            @c.Estado
                                        </span>
                                    </td>
                                    <td style="padding: 0.75rem; display: flex; gap: 0.4rem; align-items: center;">
                                        <button onclick="abrirModalVerCita(this)" 
                                                data-id="@c.Id"
                                                data-paciente="@(c.User?.NombreCompleto ?? "Paciente")"
                                                data-servicio="@c.Servicio"
                                                data-fechahorastr="@c.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")"
                                                data-notas="@(c.Notas ?? "")"
                                                data-estado="@c.Estado"
                                                class="btn" style="background-color: var(--purple-50); color: var(--purple-800); padding: 0.3rem 0.6rem; border: none; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer; font-weight: 600;" title="Ver Detalle">
                                            👁️
                                        </button>
                                        <button onclick="abrirModalEditarCita(this)" 
                                                data-id="@c.Id"
                                                data-userid="@c.UserId"
                                                data-servicio="@c.Servicio"
                                                data-fechahora="@c.FechaHora.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")"
                                                data-notas="@(c.Notas ?? "")"
                                                data-estado="@c.Estado"
                                                class="btn" style="background-color: var(--purple-100); color: var(--purple-700); padding: 0.3rem 0.6rem; border: none; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer; font-weight: 600;" title="Editar">
                                            ✏️
                                        </button>
                                        <form asp-controller="Optometra" asp-action="DeleteAppointment" method="post" style="display:inline;" onsubmit="return confirm('¿Estás seguro de eliminar esta cita?')">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" style="background: none; border: none; color: #ef4444; font-size: 1.1rem; cursor: pointer; padding: 0.2rem;" title="Eliminar cita">🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Modal para Ver Cita (Solo Lectura) -->
            <div id="modal-ver-cita" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 500px; background: white; border-radius: 0.5rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--purple-100); padding-bottom: 0.5rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem;">Detalle de la Cita <span id="ver-cita-id"></span></h2>
                        <button onclick="document.getElementById('modal-ver-cita').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.95rem;">
                        <p><strong>Paciente:</strong> <span id="ver-cita-paciente"></span></p>
                        <p><strong>Servicio:</strong> <span id="ver-cita-servicio"></span></p>
                        <p><strong>Fecha y Hora:</strong> <span id="ver-cita-fechahora"></span></p>
                        <p><strong>Estado:</strong> <span id="ver-cita-estado" style="font-weight: 600; text-transform: capitalize;"></span></p>
                        
                        <div style="margin-top: 0.5rem; border-top: 1px solid var(--purple-100); padding-top: 0.5rem;">
                            <p><strong>Notas de la Consulta:</strong></p>
                            <p id="ver-cita-notas" style="background-color: var(--purple-50); padding: 0.75rem; border-radius: 0.375rem; color: var(--gray-700); margin: 0; font-style: italic; white-space: pre-line;"></p>
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
                        <button type="button" onclick="document.getElementById('modal-ver-cita').style.display='none'" style="flex: 1; padding: 0.5rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer; font-weight: 600;">Cerrar</button>
                        <button type="button" id="btn-ver-editar-cita" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600;">Editar Cita</button>
                    </div>
                </div>
            </div>

            <!-- Modal para Nueva Cita -->
            <div id="modal-nueva-cita" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 500px; background: white; border-radius: 0.5rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem;">Programar Nueva Cita</h2>
                        <button onclick="document.getElementById('modal-nueva-cita').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
                    </div>

                    <form asp-controller="Optometra" asp-action="CreateAppointment" method="post" style="display:flex; flex-direction:column; gap:1rem;">
                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Seleccionar Paciente</label>
                            <select name="UserId" class="searchable-select" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                @foreach (var cli in Model.Pacientes)
                                {
                                    <option value="@cli.Id">@cli.NombreCompleto (@cli.Email)</option>
                                }
                            </select>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Servicio</label>
                            <select name="Servicio" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                <option value="Examen visual completo">Examen visual completo</option>
                                <option value="Examen de vista">Examen de vista básico</option>
                                <option value="Control de lentes">Control de lentes</option>
                                <option value="Primera consulta">Primera consulta</option>
                                <option value="Seguimiento glaucoma">Seguimiento de glaucoma / presión</option>
                                <option value="Adaptación lentes contacto">Adaptación de lentes de contacto</option>
                                <option value="Ajuste de lentes">Ajuste y reparación de monturas</option>
                                <option value="Consulta por lentes de contacto">Consulta por lentes de contacto</option>
                                <option value="Control optometría">Control de optometría general</option>
                                <option value="Examen de agudeza visual (Certificado)">Examen de agudeza visual (Certificado)</option>
                                <option value="Terapia visual / Ortóptica">Terapia visual / Ortóptica</option>
                                <option value="Examen de fondo de ojo / Retinoscopia">Examen de fondo de ojo / Retinoscopia</option>
                                <option value="Consulta de urgencia ocular leve">Consulta de urgencia ocular leve</option>
                            </select>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Fecha y Hora</label>
                            <input name="FechaHora" type="datetime-local" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Notas Adicionales</label>
                            <textarea name="Notas" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2"></textarea>
                        </div>

                        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                            <button type="button" onclick="document.getElementById('modal-nueva-cita').style.display='none'" style="flex: 1; padding: 0.5rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer;">Cancelar</button>
                            <button type="submit" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600;">Crear Cita</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Modal para Editar Cita -->
            <div id="modal-editar-cita" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 500px; background: white; border-radius: 0.5rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem;">Editar Cita</h2>
                        <button onclick="document.getElementById('modal-editar-cita').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
                    </div>

                    <form asp-controller="Optometra" asp-action="EditAppointment" method="post" style="display:flex; flex-direction:column; gap:1rem;">
                        <input type="hidden" name="id" id="edit-cita-id" />

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Seleccionar Paciente</label>
                            <select name="UserId" id="edit-cita-userid" class="searchable-select" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                @foreach (var cli in Model.Pacientes)
                                {
                                    <option value="@cli.Id">@cli.NombreCompleto (@cli.Email)</option>
                                }
                            </select>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Servicio</label>
                            <select name="Servicio" id="edit-cita-servicio" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                <option value="Examen visual completo">Examen visual completo</option>
                                <option value="Examen de vista">Examen de vista básico</option>
                                <option value="Control de lentes">Control de lentes</option>
                                <option value="Primera consulta">Primera consulta</option>
                                <option value="Seguimiento glaucoma">Seguimiento de glaucoma / presión</option>
                                <option value="Adaptación lentes contacto">Adaptación de lentes de contacto</option>
                                <option value="Ajuste de lentes">Ajuste y reparación de monturas</option>
                                <option value="Consulta por lentes de contacto">Consulta por lentes de contacto</option>
                                <option value="Control optometría">Control de optometría general</option>
                                <option value="Examen de agudeza visual (Certificado)">Examen de agudeza visual (Certificado)</option>
                                <option value="Terapia visual / Ortóptica">Terapia visual / Ortóptica</option>
                                <option value="Examen de fondo de ojo / Retinoscopia">Examen de fondo de ojo / Retinoscopia</option>
                                <option value="Consulta de urgencia ocular leve">Consulta de urgencia ocular leve</option>
                            </select>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Fecha y Hora</label>
                            <input name="FechaHora" id="edit-cita-fechahora" type="datetime-local" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Estado</label>
                            <select name="Estado" id="edit-cita-estado" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                <option value="pendiente">Pendiente</option>
                                <option value="confirmada">Confirmada</option>
                                <option value="en proceso">En proceso</option>
                                <option value="atendida">Atendida</option>
                                <option value="cancelada">Cancelada</option>
                            </select>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Notas Adicionales</label>
                            <textarea name="Notas" id="edit-cita-notas" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2"></textarea>
                        </div>

                        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                            <button type="button" onclick="document.getElementById('modal-editar-cita').style.display='none'" style="flex: 1; padding: 0.5rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer;">Cancelar</button>
                            <button type="submit" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600;">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <!-- HISTORIAL MÉDICO -->
        @if (Model.ActiveSection == "historial")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem; font-family: var(--font-primary, sans-serif);">Historial Clínico</h1>
                <button onclick="document.getElementById('modal-nuevo-historial').style.display='flex'" class="btn" style="background-color: var(--purple-600); color: white; padding: 0.6rem 1rem; border: none; border-radius: 0.375rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                    📋 + Nuevo Registro
                </button>
            </div>

            <!-- Vista de Detalle Clínico (Tarea 3) -->
            @if (ViewBag.DetalleId != null)
            {
                var detId = (int)ViewBag.DetalleId;
                var hcDetalle = Model.HistorialClinico.FirstOrDefault(h => h.Id == detId);
                if (hcDetalle != null)
                {
                    var formulaCercana = Model.FormulasOpticas
                        .Where(f => f.UserId == hcDetalle.UserId)
                        .OrderByDescending(f => f.Fecha)
                        .FirstOrDefault();
                    
                    <div class="card" style="padding: 1.5rem; background: var(--purple-50); border: 2px solid var(--purple-300); border-radius: 0.5rem; margin-bottom: 1.5rem; box-shadow: var(--shadow-md);">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1.5px solid var(--purple-200); padding-bottom: 0.5rem;">
                            <h2 style="color: var(--purple-900); font-size: 1.2rem; margin: 0; font-family: var(--font-primary, sans-serif); font-weight: 700;">📋 Ficha de Historia Clínica #HC-@hcDetalle.Id</h2>
                            <a href="?section=historial" style="background-color: var(--purple-200); color: var(--purple-800); text-decoration: none; padding: 0.3rem 0.75rem; border-radius: 0.25rem; font-size: 0.85rem; font-weight: 600;">Cerrar Detalle</a>
                        </div>
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-size: 0.9rem; margin-bottom: 1rem;">
                            <div>
                                <p><strong>Paciente:</strong> @hcDetalle.User?.NombreCompleto (@hcDetalle.User?.TipoDocumento: @hcDetalle.User?.NumeroDocumento)</p>
                                <p><strong>Fecha Registro:</strong> @hcDetalle.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                <p><strong>Optómetra:</strong> @(hcDetalle.Optometra?.NombreCompleto ?? "N/A")</p>
                                <p><strong>Estado del Registro:</strong> <span style="font-weight: 600;">@hcDetalle.Estado</span></p>
                            </div>
                            <div>
                                <p><strong>Antecedentes Personales y Familiares:</strong></p>
                                <div style="background: white; padding: 0.5rem; border-radius: 0.25rem; border: 1px solid var(--purple-200); font-style: italic; min-height: 50px; white-space: pre-line;">
                                    @(hcDetalle.Antecedentes ?? "Sin antecedentes registrados.")
                                </div>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-size: 0.9rem; margin-bottom: 1rem;">
                            <div>
                                <p><strong>Exámenes Realizados:</strong></p>
                                <div style="background: white; padding: 0.5rem; border-radius: 0.25rem; border: 1px solid var(--purple-200); min-height: 50px; white-space: pre-line;">
                                    @(hcDetalle.ExamenesRealizados ?? "No especificados.")
                                </div>
                            </div>
                            <div>
                                <p><strong>Observaciones Adicionales:</strong></p>
                                <div style="background: white; padding: 0.5rem; border-radius: 0.25rem; border: 1px solid var(--purple-200); min-height: 50px; white-space: pre-line;">
                                    @(hcDetalle.Observaciones ?? "Ninguna observación registrada.")
                                </div>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-size: 0.9rem; margin-bottom: 1rem;">
                            <div>
                                <p><strong>Diagnóstico Principal:</strong></p>
                                <div style="background: white; padding: 0.75rem; border-radius: 0.25rem; border: 1px solid var(--purple-200); font-weight: 600; color: var(--purple-950); white-space: pre-line;">
                                    @hcDetalle.Diagnostico
                                </div>
                            </div>
                            <div>
                                <p><strong>Tratamiento y Plan de Manejo:</strong></p>
                                <div style="background: white; padding: 0.75rem; border-radius: 0.25rem; border: 1px solid var(--purple-200); font-weight: 600; color: var(--purple-950); white-space: pre-line;">
                                    @hcDetalle.Tratamiento
                                </div>
                            </div>
                        </div>

                        <!-- Enlace a Fórmula Óptica -->
                        <div style="border-top: 1.5px dashed var(--purple-300); padding-top: 1rem; margin-top: 1rem;">
                            <h3 style="color: var(--purple-800); font-size: 1rem; margin-top: 0; margin-bottom: 0.5rem;">👓 Fórmula Óptica Reciente del Paciente</h3>
                            @if (formulaCercana != null)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; background: white; padding: 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-200);">
                                    <div style="font-size: 0.9rem;">
                                        <span><strong>Fórmula #FOR-@formulaCercana.Id</strong> del @formulaCercana.Fecha.ToLocalTime().ToString("dd/MM/yyyy") (Tipo: @formulaCercana.TipoLente)</span>
                                    </div>
                                    <a href="?section=formulas" style="background-color: var(--purple-600); color: white; text-decoration: none; padding: 0.4rem 0.8rem; border-radius: 0.25rem; font-size: 0.85rem; font-weight: 600;">Ir a Fórmulas</a>
                                </div>
                            }
                            else
                            {
                                <p style="color: var(--gray-500); font-size: 0.85rem; margin: 0; font-style: italic;">No se encontró ninguna fórmula óptica cargada para este paciente en el sistema.</p>
                            }
                        </div>
                    </div>
                }
            }

            <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">ID</th>
                                <th style="padding: 0.75rem;">Paciente</th>
                                <th style="padding: 0.75rem;">Fecha</th>
                                <th style="padding: 0.75rem;">Diagnóstico</th>
                                <th style="padding: 0.75rem;">Estado</th>
                                <th style="padding: 0.75rem;">Optómetra</th>
                                <th style="padding: 0.75rem;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.HistorialClinico.Any())
                            {
                                <tr>
                                    <td colspan="7" style="padding: 1.5rem; text-align: center; color: var(--gray-500);">No hay registros de historial clínico.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var h in Model.HistorialClinico)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; color: var(--gray-500);">#HC-@h.Id</td>
                                        <td style="padding: 0.75rem; font-weight: 500;">@(h.User?.NombreCompleto ?? "N/A")</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@h.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td style="padding: 0.75rem;">@h.Diagnostico</td>
                                        <td style="padding: 0.75rem;">
                                            @{
                                                var actHc = (h.Estado ?? "Activo").Equals("Activo", StringComparison.OrdinalIgnoreCase);
                                                var bgHc = actHc ? "#D1FAE5" : "#FEE2E2";
                                                var fgHc = actHc ? "#065F46" : "#991B1B";
                                            }
                                            <span style="background-color: @bgHc; color: @fgHc; padding: 0.2rem 0.5rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600;">
                                                @(h.Estado ?? "Activo")
                                            </span>
                                        </td>
                                        <td style="padding: 0.75rem;">@(h.Optometra?.NombreCompleto ?? "Optómetra")</td>
                                        <td style="padding: 0.75rem; display: flex; gap: 0.4rem; align-items: center;">
                                            <a href="?section=historial&detalleId=@h.Id" class="btn" style="background-color: var(--purple-50); color: var(--purple-800); padding: 0.3rem 0.6rem; border: none; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer; font-weight: 600; text-decoration: none;" title="Ver Ficha Clínica">
                                                👁️
                                            </a>
                                            <button onclick="abrirModalEditarHistorial(this)" 
                                                    data-id="@h.Id" 
                                                    data-userid="@h.UserId" 
                                                    data-fecha="@h.Fecha.ToString("yyyy-MM-dd")" 
                                                    data-diagnostico="@h.Diagnostico" 
                                                    data-tratamiento="@h.Tratamiento"
                                                    data-antecedentes="@(h.Antecedentes ?? "")"
                                                    data-examenes="@(h.ExamenesRealizados ?? "")"
                                                    data-observaciones="@(h.Observaciones ?? "")"
                                                    data-estado="@(h.Estado ?? "Activo")"
                                                    class="btn" style="background-color: var(--purple-100); color: var(--purple-700); padding: 0.3rem 0.6rem; border: none; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer; font-weight: 600;" title="Editar">
                                                ✏️
                                            </button>
                                            <form asp-controller="Optometra" asp-action="DeleteHistorial" method="post" style="display:inline;" onsubmit="return confirm('¿Estás seguro de eliminar este registro?')">
                                                <input type="hidden" name="id" value="@h.Id" />
                                                <button type="submit" style="background: none; border: none; color: #ef4444; font-size: 1.1rem; cursor: pointer; padding: 0.2rem;" title="Eliminar registro">🗑️</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Modal para Nuevo Historial -->
            <div id="modal-nuevo-historial" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 550px; background: white; border-radius: 0.5rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); max-height: 90vh; overflow-y: auto;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem;">Crear Registro de Historial</h2>
                        <button onclick="document.getElementById('modal-nuevo-historial').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
                    </div>

                    <form asp-controller="Optometra" asp-action="CreateHistorial" method="post" style="display:flex; flex-direction:column; gap:1rem;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Paciente</label>
                                <select name="UserId" class="searchable-select" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                    @foreach (var cli in Model.Pacientes)
                                    {
                                        <option value="@cli.Id">@cli.NombreCompleto</option>
                                    }
                                </select>
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Fecha de Consulta</label>
                                <input name="Fecha" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Antecedentes Personales/Familiares</label>
                            <textarea name="Antecedentes" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2"></textarea>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Exámenes Realizados</label>
                            <textarea name="ExamenesRealizados" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2"></textarea>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Diagnóstico</label>
                            <textarea name="Diagnostico" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2" required></textarea>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Tratamiento</label>
                            <textarea name="Tratamiento" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2" required></textarea>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Observaciones Generales</label>
                            <textarea name="Observaciones" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2"></textarea>
                        </div>

                        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                            <button type="button" onclick="document.getElementById('modal-nuevo-historial').style.display='none'" style="flex: 1; padding: 0.5rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer;">Cancelar</button>
                            <button type="submit" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600;">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Modal para Editar Historial -->
            <div id="modal-editar-historial" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 550px; background: white; border-radius: 0.5rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); max-height: 90vh; overflow-y: auto;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem;">Editar Registro de Historial</h2>
                        <button onclick="document.getElementById('modal-editar-historial').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
                    </div>

                    <form asp-controller="Optometra" asp-action="EditHistorial" method="post" style="display:flex; flex-direction:column; gap:1rem;">
                        <input type="hidden" name="Id" id="edit-historial-id" />
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Paciente</label>
                                <select name="UserId" id="edit-historial-userid" class="searchable-select" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                    @foreach (var cli in Model.Pacientes)
                                    {
                                        <option value="@cli.Id">@cli.NombreCompleto</option>
                                    }
                                </select>
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Fecha de Consulta</label>
                                <input name="Fecha" id="edit-historial-fecha" type="date" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required />
                            </div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Antecedentes Personales/Familiares</label>
                            <textarea name="Antecedentes" id="edit-historial-antecedentes" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2"></textarea>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Exámenes Realizados</label>
                            <textarea name="ExamenesRealizados" id="edit-historial-examenes" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2"></textarea>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Diagnóstico</label>
                            <textarea name="Diagnostico" id="edit-historial-diagnostico" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2" required></textarea>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Tratamiento</label>
                            <textarea name="Tratamiento" id="edit-historial-tratamiento" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2" required></textarea>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Observaciones Generales</label>
                                <textarea name="Observaciones" id="edit-historial-observaciones" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" rows="2"></textarea>
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Estado</label>
                                <select name="Estado" id="edit-historial-estado" style="padding: 0.5rem; border: 1px solid var(--purple-200); border-radius: 0.375rem;" required>
                                    <option value="Activo">Activo</option>
                                    <option value="Inactivo">Inactivo</option>
                                </select>
                            </div>
                        </div>

                        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                            <button type="button" onclick="document.getElementById('modal-editar-historial').style.display='none'" style="flex: 1; padding: 0.5rem 1rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; background: white; color: var(--purple-700); cursor: pointer;">Cancelar</button>
                            <button type="submit" style="flex: 1; padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; background: var(--purple-600); color: white; cursor: pointer; font-weight: 600;">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <!-- EXAMEN VISUAL -->
        @if (Model.ActiveSection == "examenes")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem; font-family: var(--font-primary, sans-serif);">Exámenes Visuales</h1>
                <button onclick="document.getElementById('modal-nuevo-examen').style.display='flex'" class="btn" style="background-color: var(--purple-600); color: white; padding: 0.6rem 1rem; border: none; border-radius: 0.375rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                    👁️ + Registrar Examen
                </button>
            </div>

            <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">Paciente</th>
                                <th style="padding: 0.75rem;">Fecha</th>
                                <th style="padding: 0.75rem;">Tipo de Examen</th>
                                <th style="padding: 0.75rem;">Agudeza OD</th>
                                <th style="padding: 0.75rem;">Agudeza OI</th>
                                <th style="padding: 0.75rem;">Diagnóstico</th>
                                <th style="padding: 0.75rem;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ExamenesVisuales.Any())
                            {
                                <tr>
                                    <td colspan="7" style="padding: 1.5rem; text-align: center; color: var(--gray-500);">No hay exámenes registrados.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var ex in Model.ExamenesVisuales)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; font-weight: 500;">@(ex.User?.NombreCompleto ?? "N/A")</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@ex.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td style="padding: 0.75rem;">@ex.TipoExamen</td>
                                        <td style="padding: 0.75rem;">@ex.OjoDerecho</td>
                                        <td style="padding: 0.75rem;">@ex.OjoIzquierdo</td>
                                        <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-800);">@ex.Diagnostico</td>
                                        <td style="padding: 0.75rem; display: flex; gap: 0.4rem; align-items: center;">
                                            <button onclick="abrirModalVerExamen(this)"
                                                    data-id="@ex.Id"
                                                    data-paciente="@(ex.User?.NombreCompleto ?? "N/A")"
                                                    data-fecha="@ex.Fecha.ToLocalTime().ToString("dd/MM/yyyy")"
                                                    data-tipoexamen="@ex.TipoExamen"
                                                    data-ojoderecho="@ex.OjoDerecho"
                                                    data-ojoizquierdo="@ex.OjoIzquierdo"
                                                    data-tonometriaod="@(ex.TonometriaOD ?? "N/A")"
                                                    data-tonometriaoi="@(ex.TonometriaOI ?? "N/A")"
                                                    data-esferaod="@(ex.EsferaOD ?? "0.00")"
                                                    data-cilindrood="@(ex.CilindroOD ?? "0.00")"
                                                    data-ejeod="@(ex.EjeOD ?? "0")"
                                                    data-adicionod="@(ex.AdicionOD ?? "0.00")"
                                                    data-esferaoi="@(ex.EsferaOI ?? "0.00")"
                                                    data-cilindrooi="@(ex.CilindroOI ?? "0.00")"
                                                    data-ejeoi="@(ex.EjeOI ?? "0")"
                                                    data-adicionoi="@(ex.AdicionOI ?? "0.00")"
                                                    data-segmentoanterior="@(ex.SegmentoAnterior ?? "Sin hallazgos.")"
                                                    data-segmentoposterior="@(ex.SegmentoPosterior ?? "Sin hallazgos.")"
                                                    data-diagnostico="@ex.Diagnostico"
                                                    data-tratamiento="@(ex.Tratamiento ?? "Ninguno.")"
                                                    data-observaciones="@(ex.Observaciones ?? "Ninguna.")"
                                                    class="btn" style="background-color: var(--purple-50); color: var(--purple-800); padding: 0.3rem 0.6rem; border: none; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer; font-weight: 600;" title="Ver Detalle">
                                                👁️
                                            </button>
                                            <button onclick="abrirModalEditarExamen(this)"
                                                    data-id="@ex.Id"
                                                    data-userid="@ex.UserId"
                                                    data-fecha="@ex.Fecha.ToString("yyyy-MM-dd")"
                                                    data-tipoexamen="@ex.TipoExamen"
                                                    data-ojoderecho="@ex.OjoDerecho"
                                                    data-ojoizquierdo="@ex.OjoIzquierdo"
                                                    data-tonometriaod="@(ex.TonometriaOD ?? "")"
                                                    data-tonometriaoi="@(ex.TonometriaOI ?? "")"
                                                    data-esferaod="@(ex.EsferaOD ?? "")"
                                                    data-cilindrood="@(ex.CilindroOD ?? "")"
                                                    data-ejeod="@(ex.EjeOD ?? "")"
                                                    data-adicionod="@(ex.AdicionOD ?? "")"
                                                    data-esferaoi="@(ex.EsferaOI ?? "")"
                                                    data-cilindrooi="@(ex.CilindroOI ?? "")"
                                                    data-ejeoi="@(ex.EjeOI ?? "")"
                                                    data-adicionoi="@(ex.AdicionOI ?? "")"
                                                    data-segmentoanterior="@(ex.SegmentoAnterior ?? "")"
                                                    data-segmentoposterior="@(ex.SegmentoPosterior ?? "")"
                                                    data-diagnostico="@ex.Diagnostico"
                                                    data-tratamiento="@(ex.Tratamiento ?? "")"
                                                    data-observaciones="@(ex.Observaciones ?? "")"
                                                    class="btn" style="background-color: var(--purple-100); color: var(--purple-700); padding: 0.3rem 0.6rem; border: none; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer; font-weight: 600;" title="Editar">
                                                ✏️
                                            </button>
                                            <form asp-controller="Optometra" asp-action="DeleteExamen" method="post" style="display:inline;" onsubmit="return confirm('¿Estás seguro de eliminar este examen?')">
                                                <input type="hidden" name="id" value="@ex.Id" />
                                                <button type="submit" style="background: none; border: none; color: #ef4444; font-size: 1.1rem; cursor: pointer; padding: 0.2rem;" title="Eliminar examen">🗑️</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Modal para Ver Examen Clínico Detallado (Solo Lectura) -->
            <div id="modal-ver-examen" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div style="width: 100%; max-width: 650px; background: white; border-radius: 0.5rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); max-height: 90vh; overflow-y: auto;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--purple-100); padding-bottom: 0.5rem;">
                        <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem;">Resultados de Examen Clínico Visual</h2>
                        <button onclick="document.getElementById('modal-ver-examen').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-size: 0.9rem; margin-bottom: 1rem;">
                        <p><strong>Paciente:</strong> <span id="ver-examen-paciente"></span></p>
                        <p><strong>Fecha Examen:</strong> <span id="ver-examen-fecha"></span></p>
                        <p><strong>Tipo de Examen:</strong> <span id="ver-examen-tipoexamen"></span></p>
                    </div>

                    <!-- Agudeza Visual & Tonometría -->
                    <div style="border: 1px solid var(--purple-200); border-radius: 0.375rem; padding: 1rem; margin-bottom: 1rem; background-color: var(--purple-50);">
                        <h3 style="margin-top:0; margin-bottom:0.75rem; font-size:0.95rem; color: var(--purple-900);">👁️ Agudeza Visual & Tonometría</h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-size: 0.875rem;">
                            <div>
                                <p><strong>Agudeza OD:</strong> <span id="ver-examen-ojoderecho"></span></p>
                                <p><strong>Tonometría OD:</strong> <span id="ver-examen-tonometriaod"></span></p>
                            </div>
                            <div>
                                <p><strong>Agudeza OI:</strong> <span id="ver-examen-ojoizquierdo"></span></p>
                                <p><strong>Tonometría OI:</strong> <span id="ver-examen-tonometriaoi"></span></p>
                            </div>
                        </div>
                    </div>

                    <!-- Refracción Clinica (Tabla) -->
                    <div style="border: 1px solid var(--purple-200); border-radius: 0.375rem; padding: 1rem; margin-bottom: 1rem;">
                        <h3 style="margin-top:0; margin-bottom:0.75rem; font-size:0.95rem; color: var(--purple-900);">👓 Refracción Clínica</h3>
                        <table style="width:100%; border-collapse:collapse; text-align:center; font-size:0.85rem;">
                            <thead>
                                <tr style="background-color: var(--purple-100); font-weight:600;">
                                    <th style="padding:0.4rem; border:1px solid var(--purple-200);">Ojo</th>
                                    <th style="padding:0.4rem; border:1px solid var(--purple-200);">Esfera</th>
                                    <th style="padding:0.4rem; border:1px solid var(--purple-200);">Cilindro</th>
                                    <th style="padding:0.4rem; border:1px solid var(--purple-200);">Eje</th>
                                    <th style="padding:0.4rem; border:1px solid var(--purple-200);">Adición</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding:0.4rem; border:1px solid var(--purple-200); font-weight:600;">OD</td>
                                    <td style="padding:0.4rem; border:1px solid var(--purple-200);" id="ver-examen-esferaod"></td>
                                    <td style="padding:0.4rem; border:1px solid var(--purple-200);" id="ver-examen-cilindrood"></td>
                                    <td style="padding:0.4rem; border:1px solid var(--purple-200);" id="ver-examen-ejeod"></td>
                                    <td style="padding:0.4rem; border:1px solid var(--purple-200);" id="ver-examen-adicionod"></td>
                                </tr>
                                <tr>
