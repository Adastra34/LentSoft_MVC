@model DashboardAdminViewModel
@inject Microsoft.Extensions.Options.IOptions<LentSoft.Web.Services.InventorySettings> InventoryOptions

<!-- ==================== MODALES DEL MÓDULO DE INVENTARIO ==================== -->

<!-- Modal Crear Producto -->
<div id="modal-producto" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;" onclick="if(event.target === this) this.style.display='none'">
    <div class="inv-card" style="width: 100%; max-width: 620px; max-height: 90vh; overflow-y: auto; padding: 0; margin-bottom: 0;">
        <div class="inv-dialog-header">
            <h2 class="inv-dialog-title">
                <svg class="inv-icon" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                Nuevo Producto
            </h2>
            <button type="button" class="inv-dialog-close" onclick="document.getElementById('modal-producto').style.display='none'">&times;</button>
        </div>
        
        <form id="form-crear-producto" asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <div class="inv-form-group">
                <label class="inv-form-label">Nombre del Producto *</label>
                <input name="Nombre" type="text" class="inv-form-input" required minlength="3" maxlength="200" placeholder="Ej: Montura Aviator Classic" />
            </div>

            <div class="inv-form-row">
                <div class="inv-form-group">
                    <label class="inv-form-label">SKU (Código único)</label>
                    <input name="Sku" type="text" class="inv-form-input" maxlength="50" placeholder="Automático (1010, 2020...) o personalizado" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Proveedor</label>
                    <select name="SupplierId" class="inv-form-input">
                        <option value="">-- Sin proveedor asignado --</option>
                        @foreach (var supp in Model.Proveedores)
                        {
                            <option value="@supp.Id">@supp.Nombre</option>
                        }
                    </select>
                </div>
            </div>

            <div class="inv-form-row">
                <div class="inv-form-group">
                    <label class="inv-form-label">Categoría *</label>
                    <select name="Categoria" class="inv-form-input" required>
                        <option value="lentes-sol">Gafas de Sol (lentes-sol)</option>
                        <option value="lentes-contacto">Lentes de Contacto (lentes-contacto)</option>
                        <option value="monturas">Monturas (monturas)</option>
                        <option value="lentes-graduados">Lentes Graduados (lentes-graduados)</option>
                        <option value="accesorios">Accesorios (accesorios)</option>
                    </select>
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Marca</label>
                    <input name="Marca" type="text" class="inv-form-input" placeholder="Ej: Ray-Ban, Oakley, LentSoft" />
                </div>
            </div>

            <div class="inv-form-row">
                <div class="inv-form-group">
                    <label class="inv-form-label">Precio Regular ($) *</label>
                    <input name="Precio" type="number" step="100" min="0" required class="inv-form-input" placeholder="Ej: 250000" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Costo de Compra ($)</label>
                    <input name="CostoCompra" type="number" step="100" min="0" class="inv-form-input" placeholder="Ej: 120000" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Precio con Descuento ($)</label>
                    <input name="PrecioDescuento" type="number" step="100" min="0" class="inv-form-input" placeholder="Opcional" />
                </div>
            </div>

            <div class="inv-form-row">
                <div class="inv-form-group">
                    <label class="inv-form-label">Stock * (Máx. @InventoryOptions.Value.MaxStock)</label>
                    <input name="Stock" type="number" min="0" max="@InventoryOptions.Value.MaxStock" value="@InventoryOptions.Value.LowStockThreshold" required class="inv-form-input" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Stock Mínimo (Alerta) *</label>
                    <input name="StockMinimo" type="number" min="0" value="@InventoryOptions.Value.LowStockThreshold" required class="inv-form-input" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Ubicación en Bodega</label>
                    <input name="Ubicacion" type="text" class="inv-form-input" maxlength="100" placeholder="Ej: Estante A-2, Pasillo 3" />
                </div>
            </div>

            <div class="inv-form-group">
                <label class="inv-form-label">Descripción</label>
                <textarea name="Descripcion" class="inv-form-input" rows="2" placeholder="Detalles o especificaciones del producto..."></textarea>
            </div>

            <!-- Campo de Subida de Imagen con Vista Previa -->
            <div style="background: var(--purple-50); border: 1.5px dashed var(--purple-300); border-radius: 0.5rem; padding: 1rem;">
                <label class="inv-form-label" style="display: flex; align-items: center; gap: 0.4rem; color: var(--purple-900); margin-bottom: 0.25rem;">
                    <svg class="inv-icon" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    Imagen del Producto (Subir Archivo)
                </label>
                <p style="font-size: 0.75rem; color: var(--gray-500); margin: 0 0 0.5rem 0;">Formatos admitidos: .jpg, .jpeg, .png, .webp (máx. 5 MB)</p>
                
                <input id="crearProductImagenArchivo" name="ImagenArchivo" type="file" accept=".jpg,.jpeg,.png,.webp,image/png,image/jpeg,image/webp" class="inv-form-input"
                       onchange="previewProductImage(this, 'preview-crear-producto', 'crearProductPreviewContainer', 'crearProductImageInfo')" />

                <!-- Contenedor Vista Previa -->
                <div id="crearProductPreviewContainer" style="display: none; margin-top: 0.75rem; text-align: center; background: white; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-200);">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                        <span id="crearProductImageInfo" style="font-size: 0.75rem; font-weight: 600; color: var(--purple-800);"></span>
                        <button type="button" onclick="clearProductImagePreview('crearProductImagenArchivo', 'preview-crear-producto', 'crearProductPreviewContainer', 'crearProductImageInfo')" style="background: none; border: none; color: var(--error); font-size: 0.75rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem;"><icon name="x" class="icon-sm" /> Quitar</button>
                    </div>
                    <img id="preview-crear-producto" src="" alt="Vista previa" style="max-height: 160px; max-width: 100%; object-fit: contain; border-radius: 0.375rem; border: 1px solid var(--gray-200);" />
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <input name="Activo" type="checkbox" id="crearProductActivo" value="true" checked style="width: 18px; height: 18px; accent-color: var(--purple-600);" />
                <label for="crearProductActivo" class="inv-form-label" style="cursor: pointer; margin: 0;">Producto Activo para la venta</label>
            </div>

            <div class="inv-dialog-footer" style="padding: 1rem 0 0 0; background: transparent;">
                <button type="button" class="inv-btn inv-btn-secondary" onclick="document.getElementById('modal-producto').style.display='none'">Cancelar</button>
                <button type="submit" class="inv-btn inv-btn-primary">Guardar Producto</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Producto -->
<div id="modal-editar-producto" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;" onclick="if(event.target === this) this.style.display='none'">
    <div class="inv-card" style="width: 100%; max-width: 620px; max-height: 90vh; overflow-y: auto; padding: 0; margin-bottom: 0;">
        <div class="inv-dialog-header">
            <h2 class="inv-dialog-title">
                <svg class="inv-icon" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Editar Producto
            </h2>
            <button type="button" class="inv-dialog-close" onclick="document.getElementById('modal-editar-producto').style.display='none'">&times;</button>
        </div>
        
        <form id="form-editar-producto" asp-controller="Product" asp-action="Edit" method="post" enctype="multipart/form-data" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editProductId" name="Id" />
            <input type="hidden" id="editProductExistingImagenUrl" name="ImagenUrl" />

            <div class="inv-form-group">
                <label class="inv-form-label">Nombre del Producto *</label>
                <input id="editProductNombre" name="Nombre" type="text" class="inv-form-input" required minlength="3" maxlength="200" />
            </div>

            <div class="inv-form-row">
                <div class="inv-form-group">
                    <label class="inv-form-label">SKU (Código único)</label>
                    <input id="editProductSku" name="Sku" type="text" class="inv-form-input" maxlength="50" placeholder="Automático (1010, 2020...) o personalizado" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Proveedor</label>
                    <select id="editProductSupplierId" name="SupplierId" class="inv-form-input">
                        <option value="">-- Sin proveedor asignado --</option>
                        @foreach (var supp in Model.Proveedores)
                        {
                            <option value="@supp.Id">@supp.Nombre</option>
                        }
                    </select>
                </div>
            </div>

            <div class="inv-form-row">
                <div class="inv-form-group">
                    <label class="inv-form-label">Categoría *</label>
                    <select id="editProductCategoria" name="Categoria" class="inv-form-input" required>
                        <option value="lentes-sol">Gafas de Sol (lentes-sol)</option>
                        <option value="lentes-contacto">Lentes de Contacto (lentes-contacto)</option>
                        <option value="monturas">Monturas (monturas)</option>
                        <option value="lentes-graduados">Lentes Graduados (lentes-graduados)</option>
                        <option value="accesorios">Accesorios (accesorios)</option>
                    </select>
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Marca</label>
                    <input id="editProductMarca" name="Marca" type="text" class="inv-form-input" />
                </div>
            </div>

            <div class="inv-form-row">
                <div class="inv-form-group">
                    <label class="inv-form-label">Precio Regular ($) *</label>
                    <input id="editProductPrecio" name="Precio" type="number" step="100" min="0" required class="inv-form-input" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Costo de Compra ($)</label>
                    <input id="editProductCostoCompra" name="CostoCompra" type="number" step="100" min="0" class="inv-form-input" placeholder="Opcional" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Precio con Descuento ($)</label>
                    <input id="editProductPrecioDescuento" name="PrecioDescuento" type="number" step="100" min="0" class="inv-form-input" placeholder="Opcional" />
                </div>
            </div>

            <div class="inv-form-row">
                <div class="inv-form-group">
                    <label class="inv-form-label">Stock * (Máx. @InventoryOptions.Value.MaxStock)</label>
                    <input id="editProductStock" name="Stock" type="number" min="0" max="@InventoryOptions.Value.MaxStock" required class="inv-form-input" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Stock Mínimo (Alerta) *</label>
                    <input id="editProductStockMinimo" name="StockMinimo" type="number" min="0" value="@InventoryOptions.Value.LowStockThreshold" required class="inv-form-input" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Ubicación en Bodega</label>
                    <input id="editProductUbicacion" name="Ubicacion" type="text" class="inv-form-input" maxlength="100" placeholder="Ej: Estante A-2, Pasillo 3" />
                </div>
            </div>

            <div class="inv-form-group">
                <label class="inv-form-label">Descripción</label>
                <textarea id="editProductDescripcion" name="Descripcion" class="inv-form-input" rows="2"></textarea>
            </div>

            <!-- Campo de Edición/Reemplazo de Imagen con Vista Previa -->
            <div style="background: var(--purple-50); border: 1.5px dashed var(--purple-300); border-radius: 0.5rem; padding: 1rem;">
                <label class="inv-form-label" style="display: flex; align-items: center; gap: 0.4rem; color: var(--purple-900); margin-bottom: 0.25rem;">
                    <svg class="inv-icon" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    Imagen del Producto
                </label>
                <p style="font-size: 0.75rem; color: var(--gray-500); margin: 0 0 0.5rem 0;">Sube un archivo nuevo para reemplazar la imagen actual, o déjalo vacío para conservarla.</p>
                
                <input id="editProductImagenArchivo" name="ImagenArchivo" type="file" accept=".jpg,.jpeg,.png,.webp,image/png,image/jpeg,image/webp" class="inv-form-input"
                       onchange="previewProductImage(this, 'preview-editar-producto', 'editProductPreviewContainer', 'editProductImageInfo')" />

                <!-- Contenedor Vista Previa -->
                <div id="editProductPreviewContainer" style="display: none; margin-top: 0.75rem; text-align: center; background: white; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-200);">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                        <span id="editProductImageInfo" style="font-size: 0.75rem; font-weight: 600; color: var(--purple-800);"></span>
                        <button type="button" onclick="clearProductImagePreview('editProductImagenArchivo', 'preview-editar-producto', 'editProductPreviewContainer', 'editProductImageInfo', document.getElementById('editProductExistingImagenUrl').value)" style="background: none; border: none; color: var(--purple-700); font-size: 0.75rem; font-weight: 600; cursor: pointer;">↺ Restaurar actual</button>
                    </div>
                    <img id="preview-editar-producto" src="" alt="Vista previa" style="max-height: 160px; max-width: 100%; object-fit: contain; border-radius: 0.375rem; border: 1px solid var(--gray-200);" />
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <input name="Activo" type="checkbox" id="editProductActivo" value="true" style="width: 18px; height: 18px; accent-color: var(--purple-600);" />
                <label for="editProductActivo" class="inv-form-label" style="cursor: pointer; margin: 0;">Producto Activo para la venta</label>
            </div>

            <div class="inv-dialog-footer" style="padding: 1rem 0 0 0; background: transparent;">
                <button type="button" class="inv-btn inv-btn-secondary" onclick="document.getElementById('modal-editar-producto').style.display='none'">Cancelar</button>
                <button type="submit" class="inv-btn inv-btn-primary">Actualizar Producto</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Crear Proveedor -->
<div id="modal-crear-proveedor" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;" onclick="if(event.target === this) this.style.display='none'">
    <div class="inv-card" style="width: 100%; max-width: 550px; max-height: 90vh; overflow-y: auto; padding: 0; margin-bottom: 0;">
        <div class="inv-dialog-header">
            <h2 class="inv-dialog-title">
                <svg class="inv-icon" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                Nuevo Proveedor
            </h2>
            <button type="button" class="inv-dialog-close" onclick="document.getElementById('modal-crear-proveedor').style.display='none'">&times;</button>
        </div>
        
        <form id="form-crear-proveedor" asp-controller="Supplier" asp-action="Create" method="post" enctype="multipart/form-data" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <div class="inv-form-group">
                <label class="inv-form-label">Nombre de la Empresa *</label>
                <input name="Nombre" type="text" class="inv-form-input" required placeholder="Ej: Luxottica Colombia" />
            </div>

            <div class="inv-form-group">
                <label class="inv-form-label">Persona de Contacto</label>
                <input name="Contacto" type="text" class="inv-form-input" placeholder="Ej: Carlos Gómez" />
            </div>

            <div class="inv-form-group">
                <label class="inv-form-label">Tipo de Productos *</label>
                <input name="TipoProductos" type="text" class="inv-form-input" required placeholder="Ej: Monturas, Lentes de Contacto" />
            </div>

            <div class="inv-form-row">
                <div class="inv-form-group">
                    <label class="inv-form-label">Teléfono *</label>
                    <input name="Telefono" type="text" class="inv-form-input" required placeholder="Ej: +57 300 1234567" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Email *</label>
                    <input name="Correo" type="email" class="inv-form-input" required placeholder="contacto@empresa.com" />
                </div>
            </div>

            <div class="inv-form-row">
                <div class="inv-form-group">
                    <label class="inv-form-label">Dirección</label>
                    <input name="Direccion" type="text" class="inv-form-input" placeholder="Ej: Carrera 15 # 85-30, Bogotá" />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Tiempo Estimado de Entrega (Días)</label>
                    <input name="TiempoEntregaDias" type="number" min="0" class="inv-form-input" placeholder="Ej: 5" />
                </div>
            </div>

            <!-- Campo de Subida de Logo con Vista Previa -->
            <div style="background: var(--purple-50); border: 1.5px dashed var(--purple-300); border-radius: 0.5rem; padding: 1rem;">
                <label class="inv-form-label" style="display: flex; align-items: center; gap: 0.4rem; color: var(--purple-900); margin-bottom: 0.25rem;">
                    <svg class="inv-icon" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    Logo del Proveedor (Subir Archivo)
                </label>
                <p style="font-size: 0.75rem; color: var(--gray-500); margin: 0 0 0.5rem 0;">Formatos admitidos: .jpg, .jpeg, .png, .webp (máx. 5 MB)</p>
                
                <input id="crearSupplierLogoArchivo" name="LogoArchivo" type="file" accept=".jpg,.jpeg,.png,.webp,image/png,image/jpeg,image/webp" class="inv-form-input"
                       onchange="previewProductImage(this, 'preview-crear-proveedor', 'crearSupplierPreviewContainer', 'crearSupplierLogoInfo')" />

                <div id="crearSupplierPreviewContainer" style="display: none; margin-top: 0.75rem; text-align: center; background: white; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-200);">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                        <span id="crearSupplierLogoInfo" style="font-size: 0.75rem; font-weight: 600; color: var(--purple-800);"></span>
                        <button type="button" onclick="clearProductImagePreview('crearSupplierLogoArchivo', 'preview-crear-proveedor', 'crearSupplierPreviewContainer', 'crearSupplierLogoInfo')" style="background: none; border: none; color: var(--error); font-size: 0.75rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem;"><icon name="x" class="icon-sm" /> Quitar</button>
                    </div>
                    <img id="preview-crear-proveedor" src="" alt="Vista previa" style="max-height: 120px; max-width: 100%; object-fit: contain; border-radius: 0.375rem; border: 1px solid var(--gray-200);" />
                </div>
            </div>

            <div class="inv-dialog-footer" style="padding: 1rem 0 0 0; background: transparent;">
                <button type="button" class="inv-btn inv-btn-secondary" onclick="document.getElementById('modal-crear-proveedor').style.display='none'">Cancelar</button>
                <button type="submit" class="inv-btn inv-btn-primary">Guardar Proveedor</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Proveedor -->
