            </div>

            <div class="inv-form-group">
                <label class="inv-form-label">Tipo de Productos *</label>
                <input id="editSupplierTipoProductos" name="TipoProductos" type="text" class="inv-form-input" required />
            </div>

            <div class="inv-form-row">
                <div class="inv-form-group">
                    <label class="inv-form-label">Teléfono *</label>
                    <input id="editSupplierTelefono" name="Telefono" type="text" class="inv-form-input" required />
                </div>
                <div class="inv-form-group">
                    <label class="inv-form-label">Email *</label>
                    <input id="editSupplierCorreo" name="Correo" type="email" class="inv-form-input" required />
                </div>
            </div>

            <div class="inv-form-row">
