    <div class="card" style="width: 100%; max-width: 450px; background: white; border-radius: 0.75rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--purple-100);">
            <h2 style="color: var(--purple-900); margin: 0; font-size: 1.2rem; font-weight: 700;">🗓️ Reprogramar Cita</h2>
            <button type="button" onclick="document.getElementById('modal-reprogramar-cita').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
        </div>
        
        <form action="/Dashboard/UserRescheduleAppointment" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="rescheduleCitaId" name="id" />

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Nueva Fecha y Hora *</label>
                <input id="rescheduleFechaHora" name="NuevaFechaHora" type="datetime-local" class="form-input" required style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem;">
                <button type="button" onclick="document.getElementById('modal-reprogramar-cita').style.display='none'" style="background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-300); padding: 0.5rem 1rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" style="background: var(--purple-600); color: white; border: none; padding: 0.5rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Guardar Cambio</button>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleOrderDetail(orderId) {
        const elem = document.getElementById('order-detail-' + orderId);
        if (elem) {
            elem.style.display = (elem.style.display === 'none' || elem.style.display === '') ? 'block' : 'none';
        }
    }

    function confirmCancelCita(id, servicio) {
        if (typeof alertify !== 'undefined') {
            alertify.confirm(
                'Cancelar Cita',
                '¿Está seguro de que desea cancelar su cita para <strong>' + servicio + '</strong>?',
                function () { executeCancelCita(id); },
                function () { alertify.message('Cancelación omitida'); }
            ).set('labels', { ok: 'Sí, cancelar cita', cancel: 'No' });
        } else if (confirm('¿Está seguro de cancelar su cita para ' + servicio + '?')) {
            executeCancelCita(id);
        }
    }

    function executeCancelCita(id) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Dashboard/UserCancelAppointment/' + id;
        
        const tokenElem = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenElem) {
            const hiddenToken = document.createElement('input');
            hiddenToken.type = 'hidden';
            hiddenToken.name = '__RequestVerificationToken';
            hiddenToken.value = tokenElem.value;
            form.appendChild(hiddenToken);
        }

        document.body.appendChild(form);
        form.submit();
    }

    function openRescheduleModal(id, currentFechaHora) {
        document.getElementById('rescheduleCitaId').value = id;
        if (currentFechaHora) {
            document.getElementById('rescheduleFechaHora').value = currentFechaHora;
        }
        document.getElementById('modal-reprogramar-cita').style.display = 'flex';
    }

    function filterClientSideCitas(filterVal) {
        const filter = filterVal.toLowerCase();
        const table = document.getElementById('tableCitasUsuario');
        if (!table) return;
        const trs = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < trs.length; i++) {
            let show = false;
            const tds = trs[i].getElementsByTagName('td');
            if (tds.length <= 1) continue;
            for (let j = 0; j < tds.length - 1; j++) {
                if (tds[j] && tds[j].textContent.toLowerCase().includes(filter)) {
                    show = true;
                    break;
                }
            }
            trs[i].style.display = show ? '' : 'none';
        }
    }

    async function removeFavoriteAsync(productId) {
        try {
            const resp = await fetch('/Product/ToggleFavorite', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'productId=' + productId
            });
            if (resp.ok) {
                const card = document.getElementById('fav-card-' + productId);
                if (card) {
                    card.remove();
                }
                if (typeof alertify !== 'undefined') {
                    alertify.success('Producto quitado de favoritos');
                }
                const grid = document.getElementById('favoritos-grid');
                if (grid && grid.children.length === 0) {
                    const container = document.getElementById('favoritos-container');
                    if (container) {
                        container.innerHTML = `
                            <div style="text-align: center; padding: 3rem 1rem; background-color: var(--purple-50); border-radius: 0.75rem;">
                                <p style="color: var(--gray-600); margin-bottom: 1rem;">Aún no tienes productos en tu lista de favoritos.</p>
                                <a href="/Product/Tienda" class="btn btn-primary" style="background: var(--purple-600); color: white; text-decoration: none; padding: 0.6rem 1.25rem; border-radius: 0.375rem; display: inline-block;">Explorar la Tienda</a>
                            </div>
                        `;
                    }
                }
            } else {
                if (typeof alertify !== 'undefined') {
                    alertify.error('No se pudo quitar de favoritos');
                }
            }
        } catch (e) {
            console.error('Error removing favorite:', e);
            if (typeof alertify !== 'undefined') {
                alertify.error('Error de conexión');
            }
        }
    }
</script>
