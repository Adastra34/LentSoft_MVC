        @section Scripts {

    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script>
        function toggleAuditoria() {
            const panel = document.getElementById('panel-auditoria');
            const icon  = document.getElementById('icon-auditoria');
            if (panel.style.display === 'none') {
                panel.style.display = 'block';
                icon.textContent = '▼';
            } else {
                panel.style.display = 'none';
                icon.textContent = '▶';
            }
        }

        function showToast(msg, type = 'info') {
            if (typeof alertify !== 'undefined') {
                if (type === 'success') alertify.success(msg);
                else if (type === 'error') alertify.error(msg);
                else alertify.message(msg);
            } else {
                alert(msg);
            }
        }

