                <icon name="calendar-days" class="icon-lg" />
                <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem; font-weight: 700;">Programar Nueva Cita</h2>
            </div>
            <button type="button" onclick="document.getElementById('modal-cita').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
