<!-- Modal para Ver / Recibir Pedido a Proveedor -->
<div id="modal-recibir-pedido" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div class="card" style="width: 100%; max-width: 700px; max-height: 90vh; overflow-y: auto; background: white; border-radius: 0.75rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--purple-100);">
            <h2 id="recibirModalTitle" style="color: var(--purple-900); margin: 0; font-size: 1.25rem; font-weight: 700;">Detalle y Recepción de Pedido</h2>
            <button onclick="document.getElementById('modal-recibir-pedido').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
        </div>

        <form asp-controller="PurchaseOrder" asp-action="Recibir" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="recibirOrderId" name="id" value="0" />

            <div id="recibirInfoContainer" style="background: var(--purple-50); padding: 0.75rem 1rem; border-radius: 0.375rem; font-size: 0.9rem; color: var(--purple-900);">
                <!-- Se llena con JS -->
            </div>

            <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-radius: 0.375rem;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
                    <thead>
                        <tr style="background: var(--purple-50); border-bottom: 1px solid var(--purple-200);">
                            <th style="padding: 0.6rem;">Producto</th>
                            <th style="padding: 0.6rem;">Costo Unit.</th>
                            <th style="padding: 0.6rem;">Solicitado</th>
                            <th style="padding: 0.6rem; width: 140px;">Cant. Recibida</th>
                        </tr>
                    </thead>
                    <tbody id="recibirItemsBody">
                        <!-- Se llena con JS -->
                    </tbody>
                </table>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem;">
                <button type="button" onclick="document.getElementById('modal-recibir-pedido').style.display='none'" style="background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-300); padding: 0.5rem 1rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Cerrar</button>
                <button type="submit" id="btnGuardarRecepcion" style="background: var(--purple-600); color: white; border: none; padding: 0.5rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Guardar Recepción</button>
            </div>
        </form>
    </div>
</div>

<script>
    function addPurchaseOrderItemRow() {
        const body = document.getElementById('poItemsBody');
        const firstRow = body.firstElementChild;
        if (!firstRow) return;
        const newRow = firstRow.cloneNode(true);
        newRow.querySelector('select').value = '';
        newRow.querySelector('input[type="number"][name="cantidades"]').value = '1';
        newRow.querySelector('input[type="number"][name="costos"]').value = '0.00';
        body.appendChild(newRow);
    }

    async function openRecibirPedidoModal(orderId) {
        document.getElementById('recibirOrderId').value = orderId;
        document.getElementById('recibirModalTitle').innerText = 'Detalle y Recepción del Pedido #PED-' + String(orderId).padStart(4, '0');
        
        const infoDiv = document.getElementById('recibirInfoContainer');
        const body = document.getElementById('recibirItemsBody');
        infoDiv.innerHTML = 'Cargando detalles...';
        body.innerHTML = '<tr><td colspan="4" style="padding:1rem; text-align:center;">Cargando...</td></tr>';
        
        document.getElementById('modal-recibir-pedido').style.display = 'flex';

        try {
            const resp = await fetch('/PurchaseOrder/Details/' + orderId);
            if (!resp.ok) throw new Error('Error al cargar datos');
            const data = await resp.json();

            infoDiv.innerHTML = `<strong>Proveedor:</strong> ${data.supplierNombre} | <strong>Fecha:</strong> ${data.fechaPedido} | <strong>Estado:</strong> <span style="font-weight:bold; color:var(--purple-700);">${data.estado}</span> | <strong>Total:</strong> $${data.total.toFixed(2)}`;

            let html = '';
            data.items.forEach(item => {
                const isDisabled = data.estado === 'Cancelado';
                html += `
                    <tr style="border-bottom: 1px solid var(--purple-100);">
                        <td style="padding: 0.6rem; font-weight: 500;">
                            ${item.productoNombre}
                            <input type="hidden" name="itemIds" value="${item.id}" />
                        </td>
                        <td style="padding: 0.6rem;">$${item.costoUnitario.toFixed(2)}</td>
                        <td style="padding: 0.6rem; font-weight: bold;">${item.cantidadSolicitada}</td>
                        <td style="padding: 0.6rem;">
                            <input type="number" name="cantidadesRecibidas" min="${item.cantidadRecibida}" max="${item.cantidadSolicitada * 2}" value="${item.cantidadRecibida}" ${isDisabled ? 'disabled' : ''} class="form-input" style="width: 100%; padding: 0.3rem;" />
                        </td>
                    </tr>
                `;
            });
            body.innerHTML = html;
            document.getElementById('btnGuardarRecepcion').style.display = data.estado === 'Cancelado' ? 'none' : 'block';
        } catch (e) {
            infoDiv.innerHTML = '<span style="color:var(--error);">Error al cargar los detalles del pedido.</span>';
            body.innerHTML = '';
        }
    }

    function validateCitaForm(form) {
        const input = form.querySelector('input[type="datetime-local"]');
        if (!input) return true;
        const datetimeVal = input.value;
        if (!datetimeVal) return true;
        
        const dt = new Date(datetimeVal);
        if (dt.getDay() === 0) {
            if (typeof alertify !== 'undefined') {
                alertify.error("Las citas solo pueden agendarse de lunes a sábado.");
            } else {
                alert("Las citas solo pueden agendarse de lunes a sábado.");
            }
            return false;
        }
        
        const hours = dt.getHours();
        const minutes = dt.getMinutes();
        const decimalHour = hours + minutes / 60.0;
        if (decimalHour < 8.0 || decimalHour > 18.0) {
            if (typeof alertify !== 'undefined') {
                alertify.error("El horario de citas es de 8:00 a.m. a 6:00 p.m.");
            } else {
                alert("El horario de citas es de 8:00 a.m. a 6:00 p.m.");
            }
            return false;
        }
        return true;
    }

    // Funciones específicas para Citas en Admin
    function filterAdminCitasByEstado(estado, btn) {
        document.querySelectorAll('#admin-citas-filters .filter-tab').forEach(b => b.classList.remove('active', 'selected-tab'));
        document.querySelectorAll('#admin-citas-filters .filter-tab').forEach(b => {
            b.style.backgroundColor = 'var(--purple-50)';
            b.style.color = 'var(--purple-700)';
            b.style.border = '1px solid var(--purple-200)';
        });
        
        btn.classList.add('active', 'selected-tab');
        btn.style.backgroundColor = 'var(--purple-600)';
        btn.style.color = 'white';
        btn.style.border = 'none';

        window.currentAdminCitaEstado = estado.toLowerCase();
        filterAdminCitasCombo();
    }

    function filterAdminCitasCombo() {
        var input = document.getElementById("searchAdminCitas");
        var filter = input.value.toLowerCase();
        var table = document.getElementById("tableAdminCitas");
        if (!table) return;
        var tr = table.getElementsByTagName("tbody")[0].getElementsByTagName("tr");
        var targetEstado = window.currentAdminCitaEstado || 'todos';

        for (var i = 0; i < tr.length; i++) {
            if (tr[i].getElementsByTagName("td").length > 1) {
                var textContent = tr[i].textContent || tr[i].innerText;
                var rowEstado = tr[i].getAttribute("data-estado");
                var matchText = textContent.toLowerCase().indexOf(filter) > -1;
                var matchEstado = (targetEstado === 'todos' || rowEstado === targetEstado);
                
                if (matchText && matchEstado) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }

    function abrirModalAdminVerCita(btn) {
        document.getElementById('admin-ver-cita-paciente').textContent = btn.getAttribute('data-paciente');
        document.getElementById('admin-ver-cita-optometra').textContent = btn.getAttribute('data-optometranombre');
        document.getElementById('admin-ver-cita-servicio').textContent = btn.getAttribute('data-servicio');
        
        const rawDate = btn.getAttribute('data-fechahora');
        if (rawDate) {
            const dateObj = new Date(rawDate);
            document.getElementById('admin-ver-cita-fecha').textContent = dateObj.toLocaleString();
        }
        
        document.getElementById('admin-ver-cita-estado').textContent = btn.getAttribute('data-estado').toUpperCase();
        document.getElementById('admin-ver-cita-reprog').textContent = btn.getAttribute('data-vecesreprogramada');
        document.getElementById('admin-ver-cita-notas').textContent = btn.getAttribute('data-notas') || 'Ninguna';
        
        // Colores de estado
        const statusVal = btn.getAttribute('data-estado').toLowerCase();
        const estSpan = document.getElementById('admin-ver-cita-estado');
        if (statusVal === 'confirmada' || statusVal === 'completada') {
            estSpan.style.color = '#065F46';
        } else if (statusVal === 'pendiente') {
            estSpan.style.color = '#92400E';
        } else {
            estSpan.style.color = '#991B1B';
        }

        window.currentAdminCitaBtn = btn;
        document.getElementById('modal-admin-ver-cita').style.display = 'flex';
    }

    function abrirModalAdminEditarCitaDesdeVer() {
        document.getElementById('modal-admin-ver-cita').style.display = 'none';
        if (window.currentAdminCitaBtn) {
            const btn = window.currentAdminCitaBtn;
            document.getElementById('admin-edit-cita-id').value = btn.getAttribute('data-id');
            document.getElementById('admin-edit-cita-userid').value = btn.getAttribute('data-userid');
            document.getElementById('admin-edit-cita-paciente-nombre').value = btn.getAttribute('data-paciente');
            document.getElementById('admin-edit-cita-servicio').value = btn.getAttribute('data-servicio');
            document.getElementById('admin-edit-cita-fechahora').value = btn.getAttribute('data-fechahora');
            document.getElementById('admin-edit-cita-notas').value = btn.getAttribute('data-notas');
            document.getElementById('admin-edit-cita-optometraid').value = btn.getAttribute('data-optometra');
        }
        document.getElementById('modal-admin-editar-cita').style.display = 'flex';
    }

</script>
