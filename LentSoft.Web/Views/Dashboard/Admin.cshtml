                                <span style="position: absolute; left: 0.75rem; color: var(--purple-600); font-size: 0.9rem; pointer-events: none; display: flex; align-items: center;"><icon name="search" class="icon-sm" /></span>
                                <input type="text" name="searchTerm" value="@Model.FacturasSearchTerm" placeholder="Buscar por número o cliente..." class="form-input" style="padding: 0.45rem 0.75rem 0.45rem 2.25rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); background: white; color: var(--gray-900); width: 260px; font-size: 0.85rem;" />
                            </div>
                            <button type="submit" class="btn" style="background-color: var(--purple-600); color: white; border: none; padding: 0.45rem 0.9rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='var(--purple-700)';" onmouseout="this.style.backgroundColor='var(--purple-600)';">
                                Filtrar
                            </button>
                            @if (!string.IsNullOrWhiteSpace(Model.FacturasSearchTerm))
                            {
                                <a href="?section=facturas&pageSize=@Model.FacturasPageSize" class="btn" style="padding: 0.45rem 0.85rem; font-size: 0.85rem; background: rgba(255,255,255,0.2); color: white; text-decoration: none; border-radius: 0.375rem; font-weight: 500;">
                                    Limpiar
                                </a>
                            }
