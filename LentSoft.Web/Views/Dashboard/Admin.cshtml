        // ==================== FILTRADO GENÉRICO DE TABLAS ====================
        function filterTable(inputId, tableId) {
            if (tableId === 'tableProducts') {
                searchProductsSubmit();
                return;
            }

            const input = document.getElementById(inputId);
            if (!input) return;
            const filter = input.value.toLowerCase().trim();
            const table = document.getElementById(tableId);
            if (!table) return;
            const trs = table.getElementsByTagName('tr');

            for (let i = 1; i < trs.length; i++) {
                if (!filter) {
                    trs[i].style.display = '';
                    continue;
                }
                let show = false;
                const tds = trs[i].getElementsByTagName('td');
                for (let j = 0; j < tds.length; j++) {
                    if (!tds[j]) continue;
                    const cellText = tds[j].textContent.toLowerCase().trim();
                    if (filter === 'activo') {
                        if (cellText === 'inactivo') continue; // Previene falso positivo con badge Inactivo
                        if (cellText === 'activo' || cellText.includes(filter)) {
                            show = true;
                            break;
                        }
                    } else if (filter === 'inactivo') {
                        if (cellText === 'inactivo' || cellText.includes(filter)) {
                            show = true;
                            break;
                        }
                    } else {
                        if (cellText.includes(filter)) {
                            show = true;
                            break;
                        }
                    }
                }
                trs[i].style.display = show ? '' : 'none';
            }
        }

        function toggleFilterMenu(submodule) {
            const menu = document.getElementById('filter-menu-' + submodule);
            if (!menu) return;
            const isVisible = menu.style.display === 'block';
            document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
            menu.style.display = isVisible ? 'none' : 'block';
        }

        function toggleCategoryMenu(submodule) {
            const menu = document.getElementById('category-menu-' + submodule);
            if (!menu) return;
            const isVisible = menu.style.display === 'block';
            document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
            menu.style.display = isVisible ? 'none' : 'block';
        }

        function filterTableByValue(inputId, tableId, value) {
            if (tableId === 'tableProducts') {
                const valLower = (value || '').toLowerCase().trim();
                if (valLower === 'activo' || valLower === 'inactivo') {
                    setProductStatusFilter(valLower);
                } else if (['lentes-sol', 'monturas', 'lentes-contacto', 'lentes-graduados', 'accesorios'].includes(valLower)) {
                    setProductCategoryFilter(valLower);
                } else {
                    const input = document.getElementById(inputId);
                    if (input) input.value = value;
                    productFilters.search = valLower;
                    applyProductFilters();
                }
                document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
                return;
            }

            const input = document.getElementById(inputId);
            if (input) {
                input.value = value;
                filterTable(inputId, tableId);
            }
            document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('[id^="filter-menu-"]') && !e.target.closest('[id^="category-menu-"]') && !e.target.closest('button')) {
                document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
            }
        });

        // ==================== GESTIÓN DE PRODUCTOS ====================
        function previewProductImage(input, previewImgId, containerId, infoId) {
            const file = input.files && input.files[0];
            const previewImg = document.getElementById(previewImgId);
            const container = document.getElementById(containerId);
            const infoText = infoId ? document.getElementById(infoId) : null;

            if (!file) return;

            const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/jpg'];
            const fileExt = '.' + file.name.split('.').pop().toLowerCase();
            const validExts = ['.jpg', '.jpeg', '.png', '.webp'];

            if (!validTypes.includes(file.type.toLowerCase()) && !validExts.includes(fileExt)) {
                showToast('Formato no permitido. Solo se aceptan imágenes JPG, PNG o WEBP.', 'error');
                input.value = '';
                if (infoText) infoText.textContent = '';
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                showToast('El archivo supera el tamaño máximo permitido de 5 MB.', 'error');
                input.value = '';
                if (infoText) infoText.textContent = '';
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                if (previewImg) previewImg.src = e.target.result;
                if (container) container.style.display = 'block';
                if (infoText) infoText.textContent = `${file.name} (${(file.size / 1024).toFixed(0)} KB)`;
            };
            reader.readAsDataURL(file);
        }

        function clearProductImagePreview(inputId, previewImgId, containerId, infoId, fallbackUrl = '') {
            const input = document.getElementById(inputId);
            if (input) input.value = '';
            const previewImg = document.getElementById(previewImgId);
            const container = document.getElementById(containerId);
            const infoText = infoId ? document.getElementById(infoId) : null;

            if (fallbackUrl && fallbackUrl.trim() !== '') {
                if (previewImg) previewImg.src = fallbackUrl;
                if (container) container.style.display = 'block';
                if (infoText) infoText.textContent = 'Imagen actual';
            } else {
                if (previewImg) previewImg.src = '';
                if (container) container.style.display = 'none';
                if (infoText) infoText.textContent = '';
            }
        }

        function openEditProductModal(id, nombre, descripcion, precio, precioDescuento, categoria, marca, stock, activo, imagenUrl, sku, costoCompra, stockMinimo, ubicacion, supplierId) {
            document.getElementById('editProductId').value = id;
            document.getElementById('editProductNombre').value = nombre || '';
            document.getElementById('editProductDescripcion').value = descripcion || '';
            document.getElementById('editProductPrecio').value = precio || 0;
            document.getElementById('editProductPrecioDescuento').value = precioDescuento || '';
            document.getElementById('editProductCategoria').value = categoria || 'lentes-sol';
            document.getElementById('editProductMarca').value = marca || '';
            document.getElementById('editProductStock').value = stock || 0;
            document.getElementById('editProductActivo').checked = (activo === true || activo === 'true');
            document.getElementById('editProductExistingImagenUrl').value = imagenUrl || '';

            if (document.getElementById('editProductSku')) document.getElementById('editProductSku').value = sku || '';
            if (document.getElementById('editProductCostoCompra')) document.getElementById('editProductCostoCompra').value = costoCompra || '';
            if (document.getElementById('editProductStockMinimo')) document.getElementById('editProductStockMinimo').value = (stockMinimo !== undefined && stockMinimo !== null) ? stockMinimo : 10;
            if (document.getElementById('editProductUbicacion')) document.getElementById('editProductUbicacion').value = ubicacion || '';
            if (document.getElementById('editProductSupplierId')) document.getElementById('editProductSupplierId').value = supplierId || '';

            const fileInput = document.getElementById('editProductImagenArchivo');
            if (fileInput) fileInput.value = '';

            const previewContainer = document.getElementById('editProductPreviewContainer');
            const previewImg = document.getElementById('preview-editar-producto');
            const previewInfo = document.getElementById('editProductImageInfo');

            if (imagenUrl && imagenUrl.trim() !== '') {
                if (previewImg) previewImg.src = imagenUrl;
                if (previewContainer) previewContainer.style.display = 'block';
                if (previewInfo) previewInfo.textContent = 'Imagen actual guardada';
            } else {
                if (previewImg) previewImg.src = '';
                if (previewContainer) previewContainer.style.display = 'none';
                if (previewInfo) previewInfo.textContent = '';
            }

            document.getElementById('modal-editar-producto').style.display = 'flex';
        }

        function openEditClientModal(rec) {
            document.getElementById('edit-client-id').value = rec.id;
            document.getElementById('edit-client-nombre').value = rec.nombre || '';
            document.getElementById('edit-client-apellido').value = rec.apellido || '';
            document.getElementById('edit-client-email').value = rec.email || '';
            document.getElementById('edit-client-telefono').value = rec.telefono || '';
            document.getElementById('edit-client-tipo-doc').value = rec.tipoDocumento || 'CC';
            document.getElementById('edit-client-numero-doc').value = rec.numeroDocumento || '';
            document.getElementById('modal-editar-cliente').style.display = 'flex';
        }

        function openEditEmployeeModal(rec) {
            document.getElementById('edit-emp-id').value = rec.id;
            document.getElementById('edit-emp-nombre').value = rec.nombre || '';
            document.getElementById('edit-emp-email').value = rec.email || '';
            document.getElementById('edit-emp-telefono').value = rec.telefono || '';
            document.getElementById('edit-emp-puesto').value = rec.puesto || '';
            document.getElementById('edit-emp-departamento').value = rec.departamento || '';
            document.getElementById('edit-emp-salario').value = rec.salario || 0;
            document.getElementById('edit-emp-rol').value = rec.rol || 'Trabajador';
            document.getElementById('edit-emp-activo').value = rec.activo ? 'true' : 'false';
            document.getElementById('modal-editar-trabajador').style.display = 'flex';
        }

        document.addEventListener("DOMContentLoaded", function() {
            setupAjaxForms();
            const urlParams = new URLSearchParams(window.location.search);
            const subtab = urlParams.get('subtab') || '@(Model.ActiveSubTab ?? "")';
            if (subtab && ['resumen', 'productos', 'proveedores', 'historial', 'pedidos'].includes(subtab)) {
                switchInventorySubTab(subtab);
            }
            if (subtab && ['clientes', 'trabajadores'].includes(subtab)) {
                switchUsersSubTab(subtab);
            }
            const innerTab = urlParams.get('innerTab');
            if (innerTab === 'proveedores') {
                switchPedidosTab('proveedores');
            } else {
                switchPedidosTab('ventas');
            }

            const chartCanvas = document.getElementById('chartEvolucionVentas');
            if (chartCanvas && (subtab === 'resumen' || window.getComputedStyle(chartCanvas).display !== 'none')) {
                setTimeout(initInventoryChart, 100);
            }

            // ── Delegated Edit Handlers (safe: no inline JS string interpolation) ──
            document.addEventListener('click', function(e) {
                const btn = e.target.closest('[data-record]');
                if (!btn) return;
                let rec;
                try { rec = JSON.parse(btn.dataset.record); } catch { return; }

                if (btn.classList.contains('btn-edit-product')) {
                    openEditProductModal(
                        rec.id, rec.nombre, rec.descripcion, rec.precio,
                        rec.precioDescuento, rec.categoria, rec.marca,
                        rec.stock, rec.activo, rec.imagenUrl,
                        rec.sku, rec.costoCompra, rec.stockMinimo,
                        rec.ubicacion, rec.supplierId
                    );
                } else if (btn.classList.contains('btn-edit-supplier')) {
                    if (typeof openEditSupplierModal === 'function') {
                        openEditSupplierModal(
                            rec.id, rec.nombre, rec.contacto,
                            rec.tipoProductos, rec.telefono, rec.correo, rec.logoUrl,
                            rec.direccion, rec.tiempoEntregaDias
                        );
                    } else {
                        showToast('El modal de edición de proveedores aún no está implementado.', 'info');
                    }
                } else if (btn.classList.contains('btn-edit-sales-order')) {
                    openEditSalesOrderModal(
                        rec.id, rec.numeroPedido, rec.clienteNombre,
                        rec.productoNombre, rec.cantidad, rec.precioUnitario,
                        rec.estado, rec.notas
                    );
                } else if (btn.classList.contains('btn-edit-supplier-order')) {
                    openEditSupplierOrderModal(
                        rec.id, rec.numeroPedido, rec.supplierId,
                        rec.productId, rec.cantidad, rec.precioUnitario,
                        rec.estado, rec.notas
                    );
                } else if (btn.classList.contains('btn-edit-client')) {
                    openEditClientModal(rec);
                } else if (btn.classList.contains('btn-edit-employee')) {
                    openEditEmployeeModal(rec);
                }
            });

            // ── Delegated Delete Form Handlers ──
            document.addEventListener('submit', function(e) {
                const form = e.target;
                let message = '';

                if (form.classList.contains('form-delete-product')) {
                    const nombre = form.dataset.nombre || '';
                    message = '¿Deseas eliminar el producto ' + nombre + '?';
                } else if (form.classList.contains('form-delete-supplier')) {
                    const nombre = form.dataset.nombre || '';
                    message = '¿Deseas eliminar al proveedor ' + nombre + '?';
                } else if (form.classList.contains('form-delete-movement')) {
                    const nombre = form.dataset.nombre || '';
                    message = '¿Seguro que deseas eliminar el movimiento ' + nombre + '?';
                } else if (form.classList.contains('form-delete-sales-order')) {
                    message = '¿Seguro que deseas eliminar este pedido de venta?';
                } else if (form.classList.contains('form-delete-supplier-order')) {
                    message = '¿Seguro que deseas eliminar este pedido a proveedor?';
                } else if (form.classList.contains('form-delete-client')) {
                    const nombre = form.dataset.nombre || '';
                    message = '¿Deseas desactivar al cliente ' + nombre + '?';
                    e.preventDefault();
                    if (typeof alertify !== 'undefined') {
                        alertify.confirm('Confirmar Desactivación', message,
                            function () { form.submit(); },
                            function () { showToast('Acción cancelada', 'info'); }
                        ).set('labels', { ok: 'Sí, desactivar', cancel: 'Cancelar' });
                    } else if (confirm(message)) {
                        form.submit();
                    }
                    return;
                } else if (form.classList.contains('form-delete-employee')) {
                    const nombre = form.dataset.nombre || '';
                    message = '¿Deseas desactivar al trabajador ' + nombre + '?';
                    e.preventDefault();
                    if (typeof alertify !== 'undefined') {
                        alertify.confirm('Confirmar Desactivación', message,
                            function () { form.submit(); },
                            function () { showToast('Acción cancelada', 'info'); }
                        ).set('labels', { ok: 'Sí, desactivar', cancel: 'Cancelar' });
                    } else if (confirm(message)) {
                        form.submit();
                    }
                    return;
                } else if (form.classList.contains('form-delete-invoice')) {
                    const nombre = form.dataset.nombre || '';
                    message = '¿Está seguro de que desea eliminar la factura ' + nombre + '? Esta acción no se puede deshacer.';
                } else {
                    return; // Not one of our delegated forms
                }

                confirmDelete(e, message, form);
            });
        });

        function updateNewInvoiceAmounts(selectElem) {
            const selectedOpt = selectElem.options[selectElem.selectedIndex];
            const total = parseFloat(selectedOpt.getAttribute('data-total') || '0');
            const subtotalInput = document.getElementById('newInvoiceSubtotal');
            const impuestosInput = document.getElementById('newInvoiceImpuestos');
            const totalInput = document.getElementById('newInvoiceTotal');
            if (total > 0) {
                const subtotal = (total / 1.19).toFixed(2);
                const impuestos = (total - subtotal).toFixed(2);
                if (subtotalInput) subtotalInput.value = subtotal;
                if (impuestosInput) impuestosInput.value = impuestos;
                if (totalInput) totalInput.value = total.toFixed(2);
            } else {
                if (subtotalInput) subtotalInput.value = '';
                if (impuestosInput) impuestosInput.value = '';
                if (totalInput) totalInput.value = '';
            }
        }
    </script>
}

