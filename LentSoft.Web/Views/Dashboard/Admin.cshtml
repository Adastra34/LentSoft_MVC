                <select id="editSupplierOrderProductId" name="ProductId" class="form-input" required style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                    @foreach (var p in Model.Productos)
                    {
                        <option value="@p.Id">@p.Nombre (Stock: @p.Stock)</option>
