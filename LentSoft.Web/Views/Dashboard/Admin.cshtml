        <form asp-controller="Dashboard" asp-action="CreateAppointment" method="post" onsubmit="return validateCitaForm(this);" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Paciente *</label>
                <select name="UserId" class="form-input" required style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                    <option value="" disabled selected>-- Seleccionar Paciente --</option>
                    @if (Model.TodosLosClientes != null)
                    {
                        foreach (var cli in Model.TodosLosClientes)
                        {
                            <option value="@cli.Id">@cli.Nombre @cli.Apellido (@cli.Email)</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Optómetra *</label>
                <select name="OptometraId" class="form-input" required style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                    <option value="" disabled selected>-- Seleccionar Optómetra --</option>
                    @{
                        var optsCrear = ViewBag.Optometras as IEnumerable<LentSoft.Web.Models.Entities.User> ?? Enumerable.Empty<LentSoft.Web.Models.Entities.User>();
                    }
                    @foreach (var opt in optsCrear)
                    {
                        <option value="@opt.Id">@opt.Nombre @opt.Apellido</option>
                    }
                </select>
            </div>

            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <div style="flex: 1; min-width: 220px;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Servicio *</label>
                    <select name="Servicio" class="form-input" required style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                        <option value="Examen visual completo">Examen visual completo</option>
                        <option value="Examen de vista">Examen de vista</option>
                        <option value="Primera consulta">Primera consulta</option>
                        <option value="Control de lentes">Control de lentes</option>
                        <option value="Ajuste de lentes">Ajuste de lentes</option>
                        <option value="Consulta por lentes de contacto">Consulta por lentes de contacto</option>
                        <option value="Adaptación lentes contacto">Adaptación lentes contacto</option>
                        <option value="Control optometría">Control optometría</option>
                        <option value="Seguimiento glaucoma">Seguimiento glaucoma</option>
                        <option value="Consulta General">Consulta General</option>
                    </select>
                </div>
                <div style="flex: 1; min-width: 220px;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Fecha y Hora *</label>
                    <input name="FechaHora" type="datetime-local" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="form-input" required style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
                    <span style="font-size: 0.75rem; color: var(--gray-500); display: block; margin-top: 0.25rem;">Lun - Sáb, 8:00 a.m. a 6:00 p.m.</span>
                </div>
            </div>

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Notas Adicionales</label>
                <textarea name="Notas" class="form-input" rows="2" placeholder="Motivo o notas clínicas opcionales..." style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); resize: vertical;"></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-cita').style.display='none'" style="background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-300); padding: 0.6rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" style="background: var(--purple-600); color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;">
