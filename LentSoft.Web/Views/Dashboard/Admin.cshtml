                </div>
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Precio Unitario ($) *</label>
                    <input id="editSupplierOrderPrecio" name="PrecioUnitario" type="number" step="100" min="0" class="form-input" required style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
