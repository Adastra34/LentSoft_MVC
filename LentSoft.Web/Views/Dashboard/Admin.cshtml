                    <div style="background-color: var(--purple-900); color: white; padding: 0.85rem 1.25rem; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                        <form method="get" style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin: 0;">
