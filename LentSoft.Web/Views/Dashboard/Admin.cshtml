@model DashboardAdminViewModel
@{
    ViewData["Title"] = "Panel de Administración";
}

<div style="display: flex; min-height: 85vh; background-color: var(--purple-50);">
    <!-- Sidebar Sidebar Navigation -->
    <aside style="width: 260px; background-color: var(--purple-900); color: white; padding: 1.5rem 1rem; flex-shrink: 0;">
        <div style="padding: 0 0.5rem 1.5rem 0.5rem; border-bottom: 1px solid var(--purple-700); margin-bottom: 1.5rem;">
            <h2 style="color: white; font-size: 1.25rem; margin: 0;">Admin Dashboard</h2>
            <p style="color: var(--purple-200); font-size: 0.85rem; margin: 0.25rem 0 0 0;">Gestión Integral LentSoft</p>
        </div>

        <nav style="display: flex; flex-direction: column; gap: 0.5rem;">
            <a href="?section=general" class="nav-item @(Model.ActiveSection == "general" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "general" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "general" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                📊 General
            </a>
            <a href="?section=inventario&subtab=productos" class="nav-item @(Model.ActiveSection == "inventario" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "inventario" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "inventario" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                📦 Inventario
            </a>
            <a href="?section=ventas" class="nav-item @(Model.ActiveSection == "ventas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "ventas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "ventas" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                💳 Ventas
            </a>
            <a href="?section=citas" class="nav-item @(Model.ActiveSection == "citas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "citas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "citas" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                📅 Citas Médicas
            </a>
            <a href="?section=usuarios&subtab=clientes" class="nav-item @(Model.ActiveSection == "usuarios" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "usuarios" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "usuarios" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                👥 Usuarios
            </a>
            <a href="?section=facturas" class="nav-item @(Model.ActiveSection == "facturas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "facturas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "facturas" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                🧾 Facturas
            </a>
        </nav>
    </aside>

    <!-- Main Content Area -->
    <main style="flex: 1; padding: 2rem; overflow-y: auto;">
        
        <!-- ==================== SECCIÓN GENERAL ==================== -->
        @if (Model.ActiveSection == "general")
        {
            <h1 style="color: var(--purple-900); margin-bottom: 1.5rem; font-size: 1.75rem;">Resumen General</h1>

            <!-- Stats Cards with % variation -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--purple-600); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;">Ventas del Mes</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.VentasDelMes.ToString("C")</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.VentasDelMes, Model.VentasDelMesAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.VentasDelMes, Model.VentasDelMesAnterior)
                        </span>
                    </div>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--info); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;">Pedidos Activos</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.PedidosActivos</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.PedidosActivos, Model.PedidosActivosAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.PedidosActivos, Model.PedidosActivosAnterior)
                        </span>
                    </div>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--success); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;">Clientes Totales</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.ClientesTotales</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.ClientesTotales, Model.ClientesTotalesAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.ClientesTotales, Model.ClientesTotalesAnterior)
                        </span>
                    </div>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--warning); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;">Productos en Stock</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.ProductosEnStock</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.ProductosEnStock, Model.ProductosEnStockAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.ProductosEnStock, Model.ProductosEnStockAnterior)
                        </span>
                    </div>
                </div>
            </div>

            <!-- Tabla de pedidos recientes -->
            <div class="card" style="padding: 1.5rem; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <h2 style="color: var(--purple-800); font-size: 1.25rem; margin: 0;">Pedidos Recientes</h2>
                    <input type="text" id="searchRecentOrders" placeholder="Buscar pedido..." class="form-input" style="width: 250px; padding: 0.4rem 0.75rem; font-size: 0.875rem;" onkeyup="filterTable('searchRecentOrders', 'tableRecentOrders')" />
                </div>
                <div style="overflow-x: auto;">
                    <table id="tableRecentOrders" style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">ID</th>
                                <th style="padding: 0.75rem;">Cliente</th>
                                <th style="padding: 0.75rem;">Fecha</th>
                                <th style="padding: 0.75rem;">Total</th>
                                <th style="padding: 0.75rem;">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.PedidosRecientes)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-700);">#ORD-@p.Id.ToString("D4")</td>
                                    <td style="padding: 0.75rem;">@(p.User?.Nombre ?? "Cliente")</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@p.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="padding: 0.75rem; font-weight: 600;">@p.Total.ToString("C")</td>
                                    <td style="padding: 0.75rem;">
                                        <span style="background-color: var(--purple-100); color: var(--purple-800); padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; text-transform: capitalize;">
                                            @p.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SECCIÓN INVENTARIO ==================== -->
        @if (Model.ActiveSection == "inventario")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;">Gestión de Inventario</h1>
                @if (Model.ActiveSubTab == "productos")
                {
                    <button class="btn btn-primary" onclick="document.getElementById('modal-producto').style.display='flex'">
                        + Nuevo Producto
                    </button>
                }
                else if (Model.ActiveSubTab == "proveedores")
                {
                    <button class="btn btn-primary" onclick="document.getElementById('modal-crear-proveedor').style.display='flex'">
                        + Nuevo Proveedor
                    </button>
                }
                else if (Model.ActiveSubTab == "pedidos")
                {
                    <button class="btn btn-primary" onclick="document.getElementById('modal-nuevo-pedido-proveedor').style.display='flex'">
                        + Nuevo Pedido
                    </button>
                }
                else if (Model.ActiveSubTab == "historial")
                {
                    <button class="btn btn-primary" onclick="document.getElementById('modal-nuevo-movimiento').style.display='flex'">
                        + Nuevo Movimiento
                    </button>
                }
            </div>

            <!-- Sub-tabs -->
            <div style="display: flex; border-bottom: 2px solid var(--purple-200); margin-bottom: 1.5rem;">
                <a href="?section=inventario&subtab=productos" style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "productos" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "productos" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px;">
                    Productos
                </a>
                <a href="?section=inventario&subtab=proveedores" style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "proveedores" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "proveedores" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px;">
                    Proveedores
                </a>
                <a href="?section=inventario&subtab=pedidos" style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "pedidos" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "pedidos" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px;">
                    Pedidos a Proveedores
                </a>
                <a href="?section=inventario&subtab=historial" style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "historial" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "historial" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px;">
                    Historial de Movimientos
                </a>
            </div>

            @if (Model.ActiveSubTab == "productos")
            {
                <div class="card" style="padding: 1.5rem; background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
                        <input type="text" id="searchProducts" placeholder="Buscar producto..." class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchProducts', 'tableProducts')" />

                        <form method="get" action="/Dashboard/Admin" style="display: flex; align-items: center; gap: 0.5rem;">
                            <input type="hidden" name="section" value="inventario" />
                            <input type="hidden" name="subtab" value="productos" />
                            <label style="font-size: 0.85rem; font-weight: 600; color: var(--purple-900);">Filtrar por Bodega:</label>
                            <select name="warehouseId" class="form-input" style="padding: 0.35rem 0.6rem; font-size: 0.85rem;" onchange="this.form.submit()">
                                <option value="">-- Todas las Bodegas --</option>
                                @foreach (var bod in Model.Bodegas)
                                {
                                    <option value="@bod.Id" selected="@(Model.SelectedWarehouseId == bod.Id)">@bod.Nombre</option>
                                }
                            </select>
                        </form>
                    </div>
                    <div style="overflow-x: auto;">
                        <table id="tableProducts" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                    <th style="padding: 0.75rem;">ID</th>
                                    <th style="padding: 0.75rem;">Nombre</th>
                                    <th style="padding: 0.75rem;">Categoría</th>
                                    <th style="padding: 0.75rem;">Costo</th>
                                    <th style="padding: 0.75rem;">Venta</th>
                                    <th style="padding: 0.75rem;">Margen</th>
                                    <th style="padding: 0.75rem;">Stock</th>
                                    <th style="padding: 0.75rem;">Estado</th>
                                    <th style="padding: 0.75rem;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prod in Model.Productos)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; color: var(--gray-500);">#@prod.Id</td>
                                        <td style="padding: 0.75rem; font-weight: 500; color: var(--purple-900);">@prod.Nombre</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@prod.Categoria</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@prod.CostoCompra.ToString("C")</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@prod.GetFinalPrice().ToString("C")</td>
                                        <td style="padding: 0.75rem; font-weight: 600; color: @(prod.GetMargenPorcentaje() > 0 ? "var(--success)" : "var(--gray-500)");">@prod.GetMargenPorcentaje()%</td>
                                        <td style="padding: 0.75rem; color: @(prod.Stock <= prod.StockMinimo ? "var(--error)" : "var(--gray-600)"); font-weight: @(prod.Stock <= prod.StockMinimo ? "bold" : "normal");">
                                            @prod.Stock
                                            @if (prod.Stock <= prod.StockMinimo)
                                            {
                                                <span style="background-color: var(--error); color: white; padding: 0.15rem 0.4rem; border-radius: 9999px; font-size: 0.7rem; font-weight: bold; margin-left: 0.35rem;" title="Stock mínimo: @prod.StockMinimo">⚠️ Bajo stock</span>
                                            }
                                        </td>
                                        <td style="padding: 0.75rem;">
                                            <span style="background-color: @(prod.Activo ? "var(--success)" : "var(--error)"); color: white; padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem;">
                                                @(prod.Activo ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td style="padding: 0.75rem;">
                                            <button type="button" onclick="openEditProductModal(@prod.Id, '@System.Web.HttpUtility.JavaScriptStringEncode(prod.Nombre)', '@System.Web.HttpUtility.JavaScriptStringEncode(prod.Descripcion ?? "")', @prod.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture), '@(prod.PrecioDescuento?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(prod.Categoria)', '@System.Web.HttpUtility.JavaScriptStringEncode(prod.Marca ?? "")', @prod.Stock, @(prod.Activo ? "true" : "false"), '@System.Web.HttpUtility.JavaScriptStringEncode(prod.ImagenUrl ?? "")')" style="background: none; border: none; color: var(--purple-700); cursor: pointer; font-size: 0.875rem; text-decoration: underline; margin-right: 0.5rem;">✏️ Editar</button>
                                            <form asp-controller="Product" asp-action="Delete" asp-route-id="@prod.Id" method="post" style="display:inline;" onsubmit="confirmDelete(event, '¿Deseas eliminar el producto @prod.Nombre?', this)">
                                                <button type="submit" style="background: none; border: none; color: var(--error); cursor: pointer; font-size: 0.875rem; text-decoration: underline;">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (Model.ActiveSubTab == "proveedores")
            {
                <div class="card" style="padding: 1.5rem; background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <input type="text" id="searchProveedores" placeholder="Buscar proveedor..." class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchProveedores', 'tableProveedores')" />
                    </div>
                    <div style="overflow-x: auto;">
                        <table id="tableProveedores" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                    <th style="padding: 0.75rem;">ID</th>
                                    <th style="padding: 0.75rem;">Empresa</th>
                                    <th style="padding: 0.75rem;">Tipo Productos</th>
                                    <th style="padding: 0.75rem;">Teléfono</th>
                                    <th style="padding: 0.75rem;">Email</th>
                                    <th style="padding: 0.75rem;">Estado</th>
                                    <th style="padding: 0.75rem;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prov in Model.Proveedores)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; color: var(--gray-500); font-weight: 600;">@prov.Id</td>
                                        <td style="padding: 0.75rem; font-weight: 500; color: var(--purple-900);">@prov.Nombre</td>
                                        <td style="padding: 0.75rem;">@prov.TipoProductos</td>
                                        <td style="padding: 0.75rem;">@prov.Telefono</td>
                                        <td style="padding: 0.75rem;">@prov.Correo</td>
                                        <td style="padding: 0.75rem;">
                                            <span style="background-color: @(prov.Activo ? "var(--success)" : "var(--gray-400)"); color: white; padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem;">
                                                @(prov.Activo ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td style="padding: 0.75rem;">
                                            <button type="button" onclick="openEditSupplierModal('@prov.Id', '@System.Web.HttpUtility.JavaScriptStringEncode(prov.Nombre)', '@System.Web.HttpUtility.JavaScriptStringEncode(prov.TipoProductos)', '@System.Web.HttpUtility.JavaScriptStringEncode(prov.Telefono)', '@System.Web.HttpUtility.JavaScriptStringEncode(prov.Correo)')" style="background: none; border: none; color: var(--purple-700); cursor: pointer; font-size: 0.875rem; text-decoration: underline; margin-right: 0.5rem;">✏️ Editar</button>
                                            <form asp-controller="Supplier" asp-action="Delete" asp-route-id="@prov.Id" method="post" style="display:inline;" onsubmit="confirmDelete(event, '¿Deseas eliminar al proveedor @prov.Nombre?', this)">
                                                <button type="submit" style="background: none; border: none; color: var(--error); cursor: pointer; font-size: 0.875rem; text-decoration: underline;">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (Model.ActiveSubTab == "pedidos")
            {
                <div class="card" style="padding: 1.5rem; background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <input type="text" id="searchPedidosProveedores" placeholder="Buscar pedido a proveedor..." class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchPedidosProveedores', 'tablePedidosProveedores')" />
                    </div>
                    <div style="overflow-x: auto;">
                        <table id="tablePedidosProveedores" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                    <th style="padding: 0.75rem;">ID</th>
                                    <th style="padding: 0.75rem;">Proveedor</th>
                                    <th style="padding: 0.75rem;">Fecha Pedido</th>
                                    <th style="padding: 0.75rem;">Entrega Estimada</th>
                                    <th style="padding: 0.75rem;">Total</th>
                                    <th style="padding: 0.75rem;">Estado</th>
                                    <th style="padding: 0.75rem;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ped in Model.PedidosProveedores)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; color: var(--purple-700); font-weight: 600;">#PED-@ped.Id.ToString("D4")</td>
                                        <td style="padding: 0.75rem; font-weight: 500; color: var(--purple-900);">@(ped.Supplier?.Nombre ?? ped.SupplierId)</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@ped.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@(ped.FechaEstimadaEntrega?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                        <td style="padding: 0.75rem; font-weight: 600;">@ped.Total.ToString("C")</td>
                                        <td style="padding: 0.75rem;">
                                            <span style="background-color: @(ped.Estado == "Recibido" ? "var(--success)" : ped.Estado == "Parcial" ? "var(--warning)" : ped.Estado == "Cancelado" ? "var(--error)" : "var(--purple-600)"); color: white; padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                                                @ped.Estado
                                            </span>
                                        </td>
                                        <td style="padding: 0.75rem;">
                                            <button type="button" onclick="openRecibirPedidoModal(@ped.Id)" style="background: none; border: none; color: var(--purple-700); cursor: pointer; font-size: 0.875rem; text-decoration: underline; margin-right: 0.5rem;">
                                                📦 Ver / Recibir
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (Model.ActiveSubTab == "historial")
            {
                <div class="card" style="padding: 1.5rem; background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <input type="text" id="searchHistorial" placeholder="Buscar en historial..." class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchHistorial', 'tableHistorial')" />
                    </div>
                    <div style="overflow-x: auto;">
                        <table id="tableHistorial" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                    <th style="padding: 0.75rem;">ID</th>
                                    <th style="padding: 0.75rem;">Producto</th>
                                    <th style="padding: 0.75rem;">Bodega</th>
                                    <th style="padding: 0.75rem;">Tipo</th>
                                    <th style="padding: 0.75rem;">Cantidad</th>
                                    <th style="padding: 0.75rem;">Fecha</th>
                                    <th style="padding: 0.75rem;">Responsable</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mov in Model.HistorialMovimientos)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; color: var(--gray-500);">#MOV-@mov.Id</td>
                                        <td style="padding: 0.75rem; font-weight: 500; color: var(--purple-900);">@(mov.Product?.Nombre ?? "Producto #" + mov.ProductId)</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@(mov.Warehouse?.Nombre ?? "Bodega Principal")</td>
                                        <td style="padding: 0.75rem;">
                                            <span style="background-color: @(mov.Tipo?.ToLower() == "entrada" ? "var(--success)" : "var(--warning)"); color: white; padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; text-transform: uppercase;">
                                                @mov.Tipo
                                            </span>
                                        </td>
                                        <td style="padding: 0.75rem; font-weight: 600;">@mov.Cantidad</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@mov.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td style="padding: 0.75rem;">@(mov.Responsable ?? "Administrador")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        <!-- ==================== SECCIÓN VENTAS ==================== -->
        @if (Model.ActiveSection == "ventas")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;">Listado de Ventas</h1>
                <button type="button" onclick="document.getElementById('modal-venta').style.display='flex'" 
                        style="background-color: var(--purple-600); color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: background-color 0.2s ease;"
                        onmouseover="this.style.backgroundColor='var(--purple-700)'" onmouseout="this.style.backgroundColor='var(--purple-600)'">
                    <span>+ Registrar Nueva Venta</span>
                </button>
            </div>

            <div class="card" style="padding: 1.5rem; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <input type="text" id="searchVentas" placeholder="Buscar venta o cliente..." class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchVentas', 'tableVentas')" />
                </div>
                <div style="overflow-x: auto;">
                    <table id="tableVentas" style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">Venta</th>
                                <th style="padding: 0.75rem;">Cliente</th>
                                <th style="padding: 0.75rem;">Fecha</th>
                                <th style="padding: 0.75rem;">Total</th>
                                <th style="padding: 0.75rem;">Estado</th>
                                <th style="padding: 0.75rem;">Actualizar Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Ventas)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-700);">#ORD-@v.Id.ToString("D4")</td>
                                    <td style="padding: 0.75rem;">@(v.User?.Nombre ?? "Cliente")</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@v.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-900);">@v.Total.ToString("C")</td>
                                    <td style="padding: 0.75rem;">
                                        <span style="background-color: var(--purple-100); color: var(--purple-800); padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem;">
                                            @v.Estado
                                        </span>
                                    </td>
                                    <td style="padding: 0.75rem;">
                                        <form asp-controller="Order" asp-action="UpdateStatus" method="post" style="display:flex; gap:0.5rem; align-items:center;">
                                            <input type="hidden" name="id" value="@v.Id" />
                                            <select name="estado" style="padding: 0.25rem; border-radius: 0.25rem; border: 1px solid var(--gray-300); font-size: 0.85rem;">
                                                <option value="pendiente" selected="@(v.Estado == "pendiente")">Pendiente</option>
                                                <option value="procesando" selected="@(v.Estado == "procesando")">Procesando</option>
                                                <option value="enviado" selected="@(v.Estado == "enviado")">Enviado</option>
                                                <option value="entregado" selected="@(v.Estado == "entregado")">Entregado</option>
                                                <option value="cancelado" selected="@(v.Estado == "cancelado")">Cancelado</option>
                                            </select>
                                            <button type="submit" class="btn btn-primary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">Guardar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SECCIÓN CITAS ==================== -->
        @if (Model.ActiveSection == "citas")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;">Gestión de Citas Médicas</h1>
                <button class="btn btn-primary" onclick="document.getElementById('modal-cita').style.display='flex'">
                    + Nueva Cita
                </button>
            </div>

            <div class="card" style="padding: 1.5rem; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <input type="text" id="searchCitas" placeholder="Buscar cita o paciente..." class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchCitas', 'tableCitas')" />
                </div>
                <div style="overflow-x: auto;">
                    <table id="tableCitas" style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">ID</th>
                                <th style="padding: 0.75rem;">Paciente</th>
                                <th style="padding: 0.75rem;">Servicio</th>
                                <th style="padding: 0.75rem;">Fecha y Hora</th>
                                <th style="padding: 0.75rem;">Estado</th>
                                <th style="padding: 0.75rem;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Citas)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; color: var(--gray-500);">#CITA-@c.Id</td>
                                    <td style="padding: 0.75rem; font-weight: 500;">@(c.User?.Nombre ?? "Paciente")</td>
                                    <td style="padding: 0.75rem;">@c.Servicio</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@c.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="padding: 0.75rem;">
                                        <form asp-controller="Dashboard" asp-action="UpdateAppointmentStatus" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <select name="estado" style="padding: 0.2rem 0.4rem; border-radius: 0.25rem; font-size: 0.8rem;" onchange="this.form.submit()">
                                                <option value="pendiente" selected="@(c.Estado == "pendiente")">Pendiente</option>
                                                <option value="confirmada" selected="@(c.Estado == "confirmada")">Confirmada</option>
                                                <option value="completada" selected="@(c.Estado == "completada")">Completada</option>
                                                <option value="cancelada" selected="@(c.Estado == "cancelada")">Cancelada</option>
                                            </select>
                                        </form>
                                    </td>
                                    <td style="padding: 0.75rem;">
                                        <form asp-controller="Dashboard" asp-action="DeleteAppointment" method="post" style="display:inline;" onsubmit="confirmDelete(event, '¿Deseas eliminar la cita #@c.Id?', this)">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" style="background: none; border: none; color: var(--error); cursor: pointer; font-size: 0.875rem; text-decoration: underline;">Eliminar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SECCIÓN USUARIOS ==================== -->
        @if (Model.ActiveSection == "usuarios")
        {
            <div style="margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); font-size: 1.75rem; margin: 0;">Gestión de Usuarios</h1>
                <p style="color: var(--gray-500); font-size: 0.9rem; margin-top: 0.25rem;">Administra los clientes y empleados del sistema</p>
            </div>

            <!-- Sub-tabs -->
            <div style="display: flex; border-bottom: 2px solid var(--purple-200); margin-bottom: 1.5rem;">
                <a href="?section=usuarios&subtab=clientes" style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "clientes" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "clientes" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px; text-decoration: none;">
                    👥 Clientes
                </a>
                <a href="?section=usuarios&subtab=trabajadores" style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "trabajadores" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "trabajadores" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px; text-decoration: none;">
                    👔 Trabajadores (Empleados)
                </a>
            </div>

            @if (Model.ActiveSubTab == "clientes")
            {
                <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.75rem; box-shadow: var(--shadow-md);">
                    <!-- Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                        <h2 style="color: var(--purple-900); font-size: 1.35rem; font-weight: 700; margin: 0;">Clientes Registrados</h2>
                        <button type="button" onclick="document.getElementById('modal-crear-cliente').style.display='flex'" 
                                style="background-color: var(--purple-600); color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: background-color 0.2s ease;"
                                onmouseover="this.style.backgroundColor='var(--purple-700)'" onmouseout="this.style.backgroundColor='var(--purple-600)'">
                            <span>+ Nuevo Usuario</span>
                        </button>
                    </div>

                    <!-- Barra Superior DataTable (Fondo morado) -->
                    <form id="clientesFilterForm" method="get" action="/Dashboard/Admin" style="background-color: var(--purple-900); color: white; padding: 0.85rem 1.25rem; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                        <input type="hidden" name="section" value="usuarios" />
                        <input type="hidden" name="subtab" value="clientes" />
                        <input type="hidden" name="clientesPage" value="1" />

                        <!-- Selector Registros -->
                        <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500;">
                            <span>Mostrar</span>
                            <select name="clientesPageSize" style="background-color: white; color: var(--gray-900); border: 1px solid var(--purple-300); border-radius: 0.375rem; padding: 0.35rem 0.6rem; font-size: 0.875rem; cursor: pointer; font-weight: 600;" onchange="document.getElementById('clientesFilterForm').submit();">
                                @foreach (var size in new[] { 5, 10, 25, 50 })
                                {
                                    if (Model.ClientesPageSize == size)
                                    {
                                        <option value="@size" selected>@size</option>
                                    }
                                    else
                                    {
                                        <option value="@size">@size</option>
                                    }
                                }
                            </select>
                            <span>registros</span>
                        </div>

                        <!-- Búsqueda y Toggle Inactivos -->
                        <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.875rem;">
                            <label style="display: flex; align-items: center; gap: 0.35rem; font-weight: 500; cursor: pointer;">
                                <input type="checkbox" name="includeInactive" value="true" @(ViewBag.IncludeInactive == true ? "checked" : "") onchange="document.getElementById('clientesFilterForm').submit();" />
                                Mostrar inactivos
                            </label>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <label for="searchClientesInput" style="font-weight: 500;">Buscar:</label>
                                <input type="text" id="searchClientesInput" name="clientesSearch" value="@Model.ClientesSearchTerm" 
                                       placeholder="Buscar por nombre o email" 
                                       style="padding: 0.4rem 0.8rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); font-size: 0.875rem; width: 240px; color: var(--gray-900);" 
                                       onkeyup="filterClientSideClientes(this.value)" />
                                <button type="submit" style="background-color: var(--purple-600); color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.85rem; font-weight: 600;">Filtrar</button>
                            </div>
                        </div>
                    </form>

                    <!-- Tabla de Clientes -->
                    <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-top: none; border-bottom-left-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                        <table id="tableClientes" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                            <thead>
                                <tr style="background-color: var(--purple-50); border-bottom: 2px solid var(--purple-200); color: var(--purple-900);">
                                    <th style="padding: 0.85rem 1rem; font-weight: 700;">ID</th>
                                    <th style="padding: 0.85rem 1rem; font-weight: 700;">Nombre</th>
                                    <th style="padding: 0.85rem 1rem; font-weight: 700;">Email</th>
                                    <th style="padding: 0.85rem 1rem; font-weight: 700;">Teléfono</th>
                                    <th style="padding: 0.85rem 1rem; font-weight: 700;">Fecha Registro</th>
                                    <th style="padding: 0.85rem 1rem; font-weight: 700; text-align: center;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Clientes.Any())
                                {
                                    @foreach (var cli in Model.Clientes)
                                    {
                                        <tr style="border-bottom: 1px solid var(--purple-100); transition: background-color 0.15s ease; @(!cli.Activo ? "opacity: 0.6; background-color: var(--gray-50);" : "")" onmouseover="this.style.backgroundColor='var(--purple-50)'" onmouseout="this.style.backgroundColor='transparent'">
                                            <td style="padding: 0.85rem 1rem; color: var(--gray-500); font-weight: 600;">#@cli.Id</td>
                                            <td style="padding: 0.85rem 1rem; font-weight: 600; color: var(--purple-900);">
                                                @cli.NombreCompleto
                                                @if (!cli.Activo)
                                                {
                                                    <span style="background-color: var(--gray-200); color: var(--gray-700); padding: 0.15rem 0.4rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 700; margin-left: 0.35rem;">Inactivo</span>
                                                }
                                            </td>
                                            <td style="padding: 0.85rem 1rem; color: var(--gray-800);">@cli.Email</td>
                                            <td style="padding: 0.85rem 1rem; color: var(--gray-700);">@(cli.Telefono ?? "N/A")</td>
                                            <td style="padding: 0.85rem 1rem; color: var(--gray-600);">@cli.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                            <td style="padding: 0.85rem 1rem; text-align: center;">
                                                <div style="display: flex; gap: 0.5rem; justify-content: center; align-items: center;">
                                                    <button type="button" onclick="openEditClientModal(@cli.Id, '@cli.Nombre', '@cli.Apellido', '@cli.Email', '@(cli.Telefono ?? "")')"
                                                            style="background: transparent; color: var(--purple-700); border: 1px solid var(--purple-600); padding: 0.35rem 0.65rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;"
                                                            onmouseover="this.style.backgroundColor='var(--purple-600)'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--purple-700)';">
                                                        ✏️ Editar
                                                    </button>

                                                    @if (cli.Activo)
                                                    {
                                                        <button type="button" onclick="confirmDeleteUser(@cli.Id, '@cli.NombreCompleto')"
                                                                style="background: transparent; color: var(--error); border: 1px solid var(--error); padding: 0.35rem 0.65rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;"
                                                                onmouseover="this.style.backgroundColor='var(--error)'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--error)';">
                                                            🗑️ Eliminar
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <form method="post" action="/User/ReactivateUser" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@cli.Id" />
                                                            <button type="submit"
                                                                    style="background: transparent; color: var(--success); border: 1px solid var(--success); padding: 0.35rem 0.65rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;"
                                                                    onmouseover="this.style.backgroundColor='var(--success)'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--success)';">
                                                                🔄 Reactivar
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" style="padding: 2rem; text-align: center; color: var(--gray-500); font-style: italic;">
                                            No se encontraron clientes registrados o que coincidan con la búsqueda.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Footer DataTable: Paginación -->
                    @{
                        var inicioCliReg = Model.ClientesTotalCount == 0 ? 0 : ((Model.ClientesPage - 1) * Model.ClientesPageSize) + 1;
                        var finCliReg = Math.Min(Model.ClientesPage * Model.ClientesPageSize, Model.ClientesTotalCount);
                    }
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.25rem; flex-wrap: wrap; gap: 1rem; font-size: 0.875rem;">
                        <div style="color: var(--gray-600); font-weight: 500;">
                            Mostrando registros del <strong>@inicioCliReg</strong> al <strong>@finCliReg</strong> de un total de <strong>@Model.ClientesTotalCount</strong> registros
                        </div>

                        @if (Model.ClientesTotalPages > 1)
                        {
                            <div style="display: flex; gap: 0.35rem; align-items: center;">
                                @if (Model.ClientesPage > 1)
                                {
                                    <a href="/Dashboard/Admin?section=usuarios&subtab=clientes&clientesPage=@(Model.ClientesPage - 1)&clientesPageSize=@Model.ClientesPageSize&clientesSearch=@Model.ClientesSearchTerm"
                                       style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                        &laquo; Anterior
                                    </a>
                                }
                                else
                                {
                                    <span style="padding: 0.35rem 0.75rem; border: 1px solid var(--gray-200); border-radius: 0.375rem; color: var(--gray-400); font-size: 0.85rem; background: var(--gray-50); cursor: not-allowed;">
                                        &laquo; Anterior
                                    </span>
                                }

                                @for (int p = 1; p <= Model.ClientesTotalPages; p++)
                                {
                                    if (p == Model.ClientesPage)
                                    {
                                        <span style="padding: 0.35rem 0.75rem; border-radius: 0.375rem; background-color: var(--purple-600); color: white; font-weight: 700; font-size: 0.85rem;">
                                            @p
                                        </span>
                                    }
                                    else
                                    {
                                        <a href="/Dashboard/Admin?section=usuarios&subtab=clientes&clientesPage=@p&clientesPageSize=@Model.ClientesPageSize&clientesSearch=@Model.ClientesSearchTerm"
                                           style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                            @p
                                        </a>
                                    }
                                }

                                @if (Model.ClientesPage < Model.ClientesTotalPages)
                                {
                                    <a href="/Dashboard/Admin?section=usuarios&subtab=clientes&clientesPage=@(Model.ClientesPage + 1)&clientesPageSize=@Model.ClientesPageSize&clientesSearch=@Model.ClientesSearchTerm"
                                       style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                        Siguiente &raquo;
                                    </a>
                                }
                                else
                                {
                                    <span style="padding: 0.35rem 0.75rem; border: 1px solid var(--gray-200); border-radius: 0.375rem; color: var(--gray-400); font-size: 0.85rem; background: var(--gray-50); cursor: not-allowed;">
                                        Siguiente &raquo;
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else if (Model.ActiveSubTab == "trabajadores")
            {
                <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.75rem; box-shadow: var(--shadow-md);">
                    <!-- Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                        <h2 style="color: var(--purple-900); font-size: 1.35rem; font-weight: 700; margin: 0;">Trabajadores (Empleados)</h2>
                        <button type="button" onclick="document.getElementById('modal-crear-trabajador').style.display='flex'" 
                                style="background-color: var(--purple-600); color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: background-color 0.2s ease;"
                                onmouseover="this.style.backgroundColor='var(--purple-700)'" onmouseout="this.style.backgroundColor='var(--purple-600)'">
                            <span>+ Nuevo Trabajador</span>
                        </button>
                    </div>

                    <!-- Barra Superior DataTable (Fondo morado) -->
                    <form id="trabajadoresFilterForm" method="get" action="/Dashboard/Admin" style="background-color: var(--purple-900); color: white; padding: 0.85rem 1.25rem; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                        <input type="hidden" name="section" value="usuarios" />
                        <input type="hidden" name="subtab" value="trabajadores" />
                        <input type="hidden" name="trabajadoresPage" value="1" />

                        <!-- Selector Registros -->
                        <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500;">
                            <span>Mostrar</span>
                            <select name="trabajadoresPageSize" style="background-color: white; color: var(--gray-900); border: 1px solid var(--purple-300); border-radius: 0.375rem; padding: 0.35rem 0.6rem; font-size: 0.875rem; cursor: pointer; font-weight: 600;" onchange="document.getElementById('trabajadoresFilterForm').submit();">
                                @foreach (var size in new[] { 5, 10, 25, 50 })
                                {
                                    if (Model.TrabajadoresPageSize == size)
                                    {
                                        <option value="@size" selected>@size</option>
                                    }
                                    else
                                    {
                                        <option value="@size">@size</option>
                                    }
                                }
                            </select>
                            <span>registros</span>
                        </div>

                        <!-- Búsqueda y Toggle Inactivos -->
                        <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.875rem;">
                            <label style="display: flex; align-items: center; gap: 0.35rem; font-weight: 500; cursor: pointer;">
                                <input type="checkbox" name="includeInactive" value="true" @(ViewBag.IncludeInactive == true ? "checked" : "") onchange="document.getElementById('trabajadoresFilterForm').submit();" />
                                Mostrar inactivos
                            </label>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <label for="searchTrabajadoresInput" style="font-weight: 500;">Buscar:</label>
                                <input type="text" id="searchTrabajadoresInput" name="trabajadoresSearch" value="@Model.TrabajadoresSearchTerm" 
                                       placeholder="Buscar por nombre o email" 
                                       style="padding: 0.4rem 0.8rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); font-size: 0.875rem; width: 240px; color: var(--gray-900);" 
                                       onkeyup="filterClientSideTrabajadores(this.value)" />
                                <button type="submit" style="background-color: var(--purple-600); color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.85rem; font-weight: 600;">Filtrar</button>
                            </div>
                        </div>
                    </form>

                    <!-- Tabla de Trabajadores -->
                    <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-top: none; border-bottom-left-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                        <table id="tableTrabajadores" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                            <thead>
                                <tr style="background-color: var(--purple-50); border-bottom: 2px solid var(--purple-200); color: var(--purple-900);">
                                    <th style="padding: 0.85rem 1rem; font-weight: 700;">Nombre</th>
                                    <th style="padding: 0.85rem 1rem; font-weight: 700;">Email</th>
                                    <th style="padding: 0.85rem 1rem; font-weight: 700;">Teléfono</th>
                                    <th style="padding: 0.85rem 1rem; font-weight: 700;">Rol</th>
                                    <th style="padding: 0.85rem 1rem; font-weight: 700; text-align: center;">Pedidos</th>
                                    <th style="padding: 0.85rem 1rem; font-weight: 700; text-align: center;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Trabajadores.Any())
                                {
                                    @foreach (var emp in Model.Trabajadores)
                                    {
                                        var badgeBg = emp.Rol.ToLower() switch
                                        {
                                            "administrador" or "admin" => "var(--purple-600)",
                                            "vendedor" or "ventas" => "#2563eb",
                                            "trabajador" => "var(--success)",
                                            _ => "var(--gray-500)"
                                        };
                                        var rolDisplay = emp.Rol.ToLower() switch
                                        {
                                            "administrador" or "admin" => "Administrador",
                                            "vendedor" or "ventas" => "Vendedor",
                                            "trabajador" => "Trabajador",
                                            _ => "Solo Lectura"
                                        };

                                        <tr style="border-bottom: 1px solid var(--purple-100); transition: background-color 0.15s ease; @(!emp.Activo ? "opacity: 0.6; background-color: var(--gray-50);" : "")" onmouseover="this.style.backgroundColor='var(--purple-50)'" onmouseout="this.style.backgroundColor='transparent'">
                                            <td style="padding: 0.85rem 1rem; font-weight: 600; color: var(--purple-900);">
                                                @emp.Nombre
                                                @if (!emp.Activo)
                                                {
                                                    <span style="background-color: var(--gray-200); color: var(--gray-700); padding: 0.15rem 0.4rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 700; margin-left: 0.35rem;">Inactivo</span>
                                                }
                                            </td>
                                            <td style="padding: 0.85rem 1rem; color: var(--gray-800);">@emp.Email</td>
                                            <td style="padding: 0.85rem 1rem; color: var(--gray-700);">@(emp.Telefono ?? "N/A")</td>
                                            <td style="padding: 0.85rem 1rem;">
                                                <span style="background-color: @badgeBg; color: white; padding: 0.3rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; display: inline-block;">
                                                    @rolDisplay
                                                </span>
                                            </td>
                                            <td style="padding: 0.85rem 1rem; text-align: center; font-weight: 700; color: var(--purple-900);">
                                                @emp.PedidosCount
                                            </td>
                                            <td style="padding: 0.85rem 1rem; text-align: center;">
                                                <div style="display: flex; gap: 0.5rem; justify-content: center; align-items: center;">
                                                    <button type="button" onclick="openEditEmployeeModal(@emp.Id, '@emp.Nombre', '@emp.Email', '@(emp.Telefono ?? "")', '@emp.Puesto', '@emp.Departamento', @emp.Salario, '@emp.Rol', @emp.Activo.ToString().ToLower())"
                                                            style="background: transparent; color: var(--purple-700); border: 1px solid var(--purple-600); padding: 0.35rem 0.65rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;"
                                                            onmouseover="this.style.backgroundColor='var(--purple-600)'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--purple-700)';">
                                                        ✏️ Editar
                                                    </button>

                                                    @if (emp.Activo)
                                                    {
                                                        <button type="button" onclick="confirmDeleteEmployee(@emp.Id, '@emp.Nombre')"
                                                                style="background: transparent; color: var(--error); border: 1px solid var(--error); padding: 0.35rem 0.65rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;"
                                                                onmouseover="this.style.backgroundColor='var(--error)'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--error)';">
                                                            🗑️ Eliminar
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <form method="post" action="/User/ReactivateEmployee" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@emp.Id" />
                                                            <button type="submit"
                                                                    style="background: transparent; color: var(--success); border: 1px solid var(--success); padding: 0.35rem 0.65rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;"
                                                                    onmouseover="this.style.backgroundColor='var(--success)'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--success)';">
                                                                🔄 Reactivar
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" style="padding: 2rem; text-align: center; color: var(--gray-500); font-style: italic;">
                                            No se encontraron trabajadores registrados o que coincidan con la búsqueda.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Footer DataTable: Paginación -->
                    @{
                        var inicioEmpReg = Model.TrabajadoresTotalCount == 0 ? 0 : ((Model.TrabajadoresPage - 1) * Model.TrabajadoresPageSize) + 1;
                        var finEmpReg = Math.Min(Model.TrabajadoresPage * Model.TrabajadoresPageSize, Model.TrabajadoresTotalCount);
                    }
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.25rem; flex-wrap: wrap; gap: 1rem; font-size: 0.875rem;">
                        <div style="color: var(--gray-600); font-weight: 500;">
                            Mostrando registros del <strong>@inicioEmpReg</strong> al <strong>@finEmpReg</strong> de un total de <strong>@Model.TrabajadoresTotalCount</strong> registros
                        </div>

                        @if (Model.TrabajadoresTotalPages > 1)
                        {
                            <div style="display: flex; gap: 0.35rem; align-items: center;">
                                @if (Model.TrabajadoresPage > 1)
                                {
                                    <a href="/Dashboard/Admin?section=usuarios&subtab=trabajadores&trabajadoresPage=@(Model.TrabajadoresPage - 1)&trabajadoresPageSize=@Model.TrabajadoresPageSize&trabajadoresSearch=@Model.TrabajadoresSearchTerm"
                                       style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                        &laquo; Anterior
                                    </a>
                                }
                                else
                                {
                                    <span style="padding: 0.35rem 0.75rem; border: 1px solid var(--gray-200); border-radius: 0.375rem; color: var(--gray-400); font-size: 0.85rem; background: var(--gray-50); cursor: not-allowed;">
                                        &laquo; Anterior
                                    </span>
                                }

                                @for (int p = 1; p <= Model.TrabajadoresTotalPages; p++)
                                {
                                    if (p == Model.TrabajadoresPage)
                                    {
                                        <span style="padding: 0.35rem 0.75rem; border-radius: 0.375rem; background-color: var(--purple-600); color: white; font-weight: 700; font-size: 0.85rem;">
                                            @p
                                        </span>
                                    }
                                    else
                                    {
                                        <a href="/Dashboard/Admin?section=usuarios&subtab=trabajadores&trabajadoresPage=@p&trabajadoresPageSize=@Model.TrabajadoresPageSize&trabajadoresSearch=@Model.TrabajadoresSearchTerm"
                                           style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                            @p
                                        </a>
                                    }
                                }

                                @if (Model.TrabajadoresPage < Model.TrabajadoresTotalPages)
                                {
                                    <a href="/Dashboard/Admin?section=usuarios&subtab=trabajadores&trabajadoresPage=@(Model.TrabajadoresPage + 1)&trabajadoresPageSize=@Model.TrabajadoresPageSize&trabajadoresSearch=@Model.TrabajadoresSearchTerm"
                                       style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                        Siguiente &raquo;
                                    </a>
                                }
                                else
                                {
                                    <span style="padding: 0.35rem 0.75rem; border: 1px solid var(--gray-200); border-radius: 0.375rem; color: var(--gray-400); font-size: 0.85rem; background: var(--gray-50); cursor: not-allowed;">
                                        Siguiente &raquo;
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }

        <!-- ==================== SECCIÓN FACTURAS ==================== -->
        <!-- ==================== SECCIÓN FACTURAS ==================== -->
        @if (Model.ActiveSection == "facturas")
        {
            <div style="margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); font-size: 1.75rem; margin: 0;">Facturas</h1>
                <p style="color: var(--gray-500); font-size: 0.9rem; margin-top: 0.25rem;">Gestiona tu negocio desde un solo lugar</p>
            </div>

            <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.75rem; box-shadow: var(--shadow-md);">
                <!-- Header de la sección de la tabla con botón Nueva Factura -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                    <h2 style="color: var(--purple-900); font-size: 1.35rem; font-weight: 700; margin: 0;">Gestión de Facturas</h2>
                    <button type="button" onclick="document.getElementById('modal-factura').style.display='flex'" 
                            style="background-color: var(--purple-600); color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: background-color 0.2s ease;"
                            onmouseover="this.style.backgroundColor='var(--purple-700)'" onmouseout="this.style.backgroundColor='var(--purple-600)'">
                        <span>+ Nueva Factura</span>
                    </button>
                </div>

                <!-- Barra Superior DataTable (Fondo morado) -->
                <form id="facturasFilterForm" method="get" action="/Dashboard/Admin" style="background-color: var(--purple-900); color: white; padding: 0.85rem 1.25rem; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                    <input type="hidden" name="section" value="facturas" />
                    <input type="hidden" name="page" value="1" />

                    <!-- Selector Registros por página -->
                    <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500;">
                        <span>Mostrar</span>
                        <select name="pageSize" style="background-color: white; color: var(--gray-900); border: 1px solid var(--purple-300); border-radius: 0.375rem; padding: 0.35rem 0.6rem; font-size: 0.875rem; cursor: pointer; font-weight: 600;" onchange="document.getElementById('facturasFilterForm').submit();">
                            @foreach (var size in new[] { 5, 10, 25, 50 })
                            {
                                if (Model.FacturasPageSize == size)
                                {
                                    <option value="@size" selected>@size</option>
                                }
                                else
                                {
                                    <option value="@size">@size</option>
                                }
                            }
                        </select>
                        <span>registros</span>
                    </div>

                    <!-- Búsqueda en tiempo real / envío -->
                    <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem;">
                        <label for="searchFacturasInput" style="font-weight: 500;">Buscar:</label>
                        <input type="text" id="searchFacturasInput" name="searchTerm" value="@Model.FacturasSearchTerm" 
                               placeholder="Buscar por número, cliente" 
                               style="padding: 0.4rem 0.8rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); font-size: 0.875rem; width: 240px; color: var(--gray-900);" 
                               onkeyup="filterClientSideFacturas(this.value)" />
                        <button type="submit" style="background-color: var(--purple-600); color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.85rem; font-weight: 600;">Filtrar</button>
                    </div>
                </form>

                <!-- Tabla de Facturas -->
                <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-top: none; border-bottom-left-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                    <table id="tableFacturas" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                        <thead>
                            <tr style="background-color: var(--purple-50); border-bottom: 2px solid var(--purple-200); color: var(--purple-900);">
                                <th style="padding: 0.85rem 1rem; font-weight: 700;">Número</th>
                                <th style="padding: 0.85rem 1rem; font-weight: 700;">Cliente</th>
                                <th style="padding: 0.85rem 1rem; font-weight: 700;">Fecha</th>
                                <th style="padding: 0.85rem 1rem; font-weight: 700;">Total</th>
                                <th style="padding: 0.85rem 1rem; font-weight: 700;">Estado</th>
                                <th style="padding: 0.85rem 1rem; font-weight: 700; text-align: center;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Facturas.Any())
                            {
                                @foreach (var fac in Model.Facturas)
                                {
                                    var clientName = fac.Order?.User != null ? fac.Order.User.NombreCompleto : "Cliente N/A";
                                    var badgeBg = fac.Estado.ToLower() switch
                                    {
                                        "pagada" => "var(--success)",
                                        "cancelada" => "var(--error)",
                                        _ => "var(--warning)"
                                    };
                                    var estadoDisplay = fac.Estado.ToLower() switch
                                    {
                                        "pagada" => "Pagada",
                                        "cancelada" => "Cancelada",
                                        _ => "Pendiente"
                                    };

                                    <tr style="border-bottom: 1px solid var(--purple-100); transition: background-color 0.15s ease;" onmouseover="this.style.backgroundColor='var(--purple-50)'" onmouseout="this.style.backgroundColor='transparent'">
                                        <td style="padding: 0.85rem 1rem; font-weight: 700; color: var(--purple-700);">@fac.NumeroFactura</td>
                                        <td style="padding: 0.85rem 1rem; font-weight: 500; color: var(--gray-800);">@clientName</td>
                                        <td style="padding: 0.85rem 1rem; color: var(--gray-600);">@fac.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td style="padding: 0.85rem 1rem; font-weight: 700; color: var(--purple-900);">@fac.Total.ToString("C")</td>
                                        <td style="padding: 0.85rem 1rem;">
                                            <span style="background-color: @badgeBg; color: white; padding: 0.3rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; display: inline-block;">
                                                @estadoDisplay
                                            </span>
                                        </td>
                                        <td style="padding: 0.85rem 1rem; text-align: center;">
                                            <div style="display: flex; gap: 0.5rem; justify-content: center; align-items: center;">
                                                <!-- Botón Eliminar -->
                                                <button type="button" 
                                                        onclick="confirmDeleteInvoice(@fac.Id, '@fac.NumeroFactura')"
                                                        style="background: transparent; color: var(--error); border: 1px solid var(--error); padding: 0.35rem 0.65rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;"
                                                        onmouseover="this.style.backgroundColor='var(--error)'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--error)';">
                                                    🗑️ Eliminar
                                                </button>

                                                <!-- Botón Descargar PDF -->
                                                <a href="/Invoice/DownloadPdf/@fac.Id" target="_blank"
                                                   style="background-color: var(--purple-100); color: var(--purple-900); border: 1px solid var(--purple-300); padding: 0.35rem 0.65rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem; transition: all 0.2s ease;"
                                                   onmouseover="this.style.backgroundColor='var(--purple-700)'; this.style.color='white';" onmouseout="this.style.backgroundColor='var(--purple-100)'; this.style.color='var(--purple-900)';">
                                                    📄 PDF
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" style="padding: 2rem; text-align: center; color: var(--gray-500); font-style: italic;">
                                        No se encontraron facturas registradas o que coincidan con la búsqueda.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer DataTable: Conteo y Paginación -->
                @{
                    var inicioReg = Model.FacturasTotalCount == 0 ? 0 : ((Model.FacturasPage - 1) * Model.FacturasPageSize) + 1;
                    var finReg = Math.Min(Model.FacturasPage * Model.FacturasPageSize, Model.FacturasTotalCount);
                }
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.25rem; flex-wrap: wrap; gap: 1rem; font-size: 0.875rem;">
                    <div style="color: var(--gray-600); font-weight: 500;">
                        Mostrando registros del <strong>@inicioReg</strong> al <strong>@finReg</strong> de un total de <strong>@Model.FacturasTotalCount</strong> registros
                    </div>

                    @if (Model.FacturasTotalPages > 1)
                    {
                        <div style="display: flex; gap: 0.35rem; align-items: center;">
                            <!-- Botón Anterior -->
                            @if (Model.FacturasPage > 1)
                            {
                                <a href="/Dashboard/Admin?section=facturas&page=@(Model.FacturasPage - 1)&pageSize=@Model.FacturasPageSize&searchTerm=@Model.FacturasSearchTerm"
                                   style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                    &laquo; Anterior
                                </a>
                            }
                            else
                            {
                                <span style="padding: 0.35rem 0.75rem; border: 1px solid var(--gray-200); border-radius: 0.375rem; color: var(--gray-400); font-size: 0.85rem; background: var(--gray-50); cursor: not-allowed;">
                                    &laquo; Anterior
                                </span>
                            }

                            <!-- Números de Página -->
                            @for (int p = 1; p <= Model.FacturasTotalPages; p++)
                            {
                                if (p == Model.FacturasPage)
                                {
                                    <span style="padding: 0.35rem 0.75rem; border-radius: 0.375rem; background-color: var(--purple-600); color: white; font-weight: 700; font-size: 0.85rem;">
                                        @p
                                    </span>
                                }
                                else
                                {
                                    <a href="/Dashboard/Admin?section=facturas&page=@p&pageSize=@Model.FacturasPageSize&searchTerm=@Model.FacturasSearchTerm"
                                       style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                        @p
                                    </a>
                                }
                            }

                            <!-- Botón Siguiente -->
                            @if (Model.FacturasPage < Model.FacturasTotalPages)
                            {
                                <a href="/Dashboard/Admin?section=facturas&page=@(Model.FacturasPage + 1)&pageSize=@Model.FacturasPageSize&searchTerm=@Model.FacturasSearchTerm"
                                   style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                    Siguiente &raquo;
                                </a>
                            }
                            else
                            {
                                <span style="padding: 0.35rem 0.75rem; border: 1px solid var(--gray-200); border-radius: 0.375rem; color: var(--gray-400); font-size: 0.85rem; background: var(--gray-50); cursor: not-allowed;">
                                    Siguiente &raquo;
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        }

    </main>
</div>

<!-- Modal para Nuevo Producto -->
<div id="modal-producto" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div class="card" style="width: 100%; max-width: 500px; max-height: 90vh; overflow-y: auto; background: white;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h2 style="color: var(--purple-900); margin: 0;">Nuevo Producto</h2>
            <button onclick="document.getElementById('modal-producto').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
        </div>
        
        <form asp-controller="Product" asp-action="Create" method="post" style="display:flex; flex-direction:column; gap:1rem;">
            <div class="form-group">
                <label class="form-label">Nombre del Producto</label>
                <input name="Nombre" type="text" class="form-input" required />
            </div>
            
            <div class="row">
                <div class="col col-6">
                    <div class="form-group">
                        <label class="form-label">Precio Regular</label>
                        <input name="Precio" type="number" step="0.01" class="form-input" required />
                    </div>
                </div>
                <div class="col col-6">
                    <div class="form-group">
                        <label class="form-label">Precio Descuento (Opcional)</label>
                        <input name="PrecioDescuento" type="number" step="0.01" class="form-input" />
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col col-6">
                    <div class="form-group">
                        <label class="form-label">Categoría</label>
                        <input name="Categoria" type="text" class="form-input" required />
                    </div>
                </div>
                <div class="col col-6">
                    <div class="form-group">
                        <label class="form-label">Marca</label>
                        <input name="Marca" type="text" class="form-input" />
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col col-6">
                    <div class="form-group">
                        <label class="form-label">Stock Inicial</label>
                        <input name="Stock" type="number" class="form-input" required value="0" />
                    </div>
                </div>
                <div class="col col-6">
                    <div class="form-group" style="display:flex; align-items:center; height:100%; padding-top:2rem;">
                        <input name="Activo" type="checkbox" value="true" checked style="margin-right:0.5rem;" />
                        <label class="form-label" style="margin:0;">Activo</label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">URL de la Imagen</label>
                <input name="ImagenUrl" type="url" class="form-input" />
            </div>
            
            <div class="form-group">
                <label class="form-label">Descripción</label>
                <textarea name="Descripcion" class="form-input" rows="3"></textarea>
            </div>
            
            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <button type="button" onclick="document.getElementById('modal-producto').style.display='none'" class="btn btn-outline" style="flex: 1;">Cancelar</button>
                <button type="submit" class="btn btn-primary" style="flex: 1;">Guardar Producto</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal para Nueva Cita -->
<div id="modal-cita" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div class="card" style="width: 100%; max-width: 500px; background: white;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h2 style="color: var(--purple-900); margin: 0;">Programar Cita</h2>
            <button onclick="document.getElementById('modal-cita').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
