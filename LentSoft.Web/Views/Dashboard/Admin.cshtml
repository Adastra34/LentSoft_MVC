            <button type="button" onclick="document.getElementById('modal-admin-editar-cita').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
        </div>
        <form asp-controller="Dashboard" asp-action="EditAppointment" method="post" onsubmit="return validateCitaForm(this);" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
