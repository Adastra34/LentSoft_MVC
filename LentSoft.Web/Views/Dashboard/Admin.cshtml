                                    <td style="padding: 0.75rem;">
                                        @{
                                            var st = c.Estado?.ToLower() ?? "pendiente";
                                            var bg = st == "confirmada" ? "#D1FAE5" : st == "pendiente" ? "#FEF3C7" : st == "completada" ? "#DBEAFE" : "#FEE2E2";
                                            var fg = st == "confirmada" ? "#065F46" : st == "pendiente" ? "#92400E" : st == "completada" ? "#1E40AF" : "#991B1B";
                                        }
                                        <span style="background-color: @bg; color: @fg; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: capitalize;">
                                            @c.Estado
                                        </span>
                                    </td>
                                    <td style="padding: 0.75rem; text-align: right;">
                                        <div style="display: flex; gap: 0.5rem; justify-content: flex-end; flex-wrap: wrap;">
