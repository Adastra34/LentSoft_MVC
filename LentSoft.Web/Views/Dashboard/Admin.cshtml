                                    var badgeText = string.IsNullOrEmpty(fac.Estado) ? "Pendiente" : (char.ToUpper(fac.Estado[0]) + fac.Estado.Substring(1).ToLower());
                                    var clienteNombre = fac.Order?.User?.NombreCompleto ?? "Cliente Genérico";

                                    <tr style="border-bottom: 1px solid var(--purple-100);">
