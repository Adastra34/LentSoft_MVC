        // ==================== FILTROS Y BÚSQUEDA DE PRODUCTOS (CAMBIO 3) ====================
        const productFilters = {
            search: '',
            status: '',
            category: ''
        };

        function onProductSearchInput(input) {
            productFilters.search = (input.value || '').trim().toLowerCase();
            applyProductFilters();
        }

        function setProductStatusFilter(status) {
            productFilters.status = (status || '').trim().toLowerCase();
            applyProductFilters();
            document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
        }

        function setProductCategoryFilter(category) {
            productFilters.category = (category || '').trim().toLowerCase();
            applyProductFilters();
            document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
        }

        function applyProductFilters() {
            const table = document.getElementById('tableProducts');
            if (!table) return;
            const tbody = table.querySelector('tbody');
            if (!tbody) return;
            const rows = tbody.querySelectorAll('tr');

            const catAliases = {
                'lentes-sol': ['lentes-sol', 'gafas de sol', 'lentes de sol', 'gafas sol', 'sol'],
                'monturas': ['monturas', 'montura'],
                'lentes-contacto': ['lentes-contacto', 'lentes de contacto', 'contacto'],
                'lentes-graduados': ['lentes-graduados', 'lentes graduados', 'graduados'],
                'accesorios': ['accesorios', 'accesorio']
            };

            rows.forEach(row => {
                // 1. Coincidencia por búsqueda de texto
                let matchesSearch = true;
                if (productFilters.search) {
                    const rowText = row.textContent.toLowerCase();
                    matchesSearch = rowText.includes(productFilters.search);
                }

                // 2. Coincidencia por estado (comparación exacta para evitar falso positivo Activo/Inactivo)
                let matchesStatus = true;
                if (productFilters.status) {
                    const statusBtn = row.querySelector('.btn-product-status');
                    const currentStatus = (row.getAttribute('data-estado') || (statusBtn ? statusBtn.textContent : '')).trim().toLowerCase();
                    matchesStatus = (currentStatus === productFilters.status);
                }

                // 3. Coincidencia por categoría (slug o texto visible)
                let matchesCategory = true;
                if (productFilters.category) {
                    const rowCat = (row.getAttribute('data-categoria') || '').toLowerCase().trim();
                    const catCell = row.querySelector('.cell-categoria');
                    const catCellText = (catCell ? catCell.textContent : '').toLowerCase().trim();
                    
                    const targetAliases = catAliases[productFilters.category] || [productFilters.category];
                    matchesCategory = targetAliases.some(alias => rowCat === alias || catCellText === alias || rowCat.includes(alias) || catCellText.includes(alias));
                }

                row.style.display = (matchesSearch && matchesStatus && matchesCategory) ? '' : 'none';
            });
        }

        // ==================== FILTRADO GENÉRICO DE TABLAS ====================
        function filterTable(inputId, tableId) {
            if (tableId === 'tableProducts') {
                const input = document.getElementById(inputId);
                if (input) onProductSearchInput(input);
                return;
            }

            const input = document.getElementById(inputId);
            if (!input) return;
            const filter = input.value.toLowerCase().trim();
            const table = document.getElementById(tableId);
            if (!table) return;
            const trs = table.getElementsByTagName('tr');

            for (let i = 1; i < trs.length; i++) {
                if (!filter) {
                    trs[i].style.display = '';
                    continue;
                }
                let show = false;
                const tds = trs[i].getElementsByTagName('td');
                for (let j = 0; j < tds.length; j++) {
                    if (!tds[j]) continue;
                    const cellText = tds[j].textContent.toLowerCase().trim();
                    if (filter === 'activo') {
                        if (cellText === 'inactivo') continue; // Previene falso positivo con badge Inactivo
                        if (cellText === 'activo' || cellText.includes(filter)) {
                            show = true;
                            break;
                        }
                    } else if (filter === 'inactivo') {
                        if (cellText === 'inactivo' || cellText.includes(filter)) {
                            show = true;
                            break;
                        }
                    } else {
                        if (cellText.includes(filter)) {
                            show = true;
                            break;
                        }
                    }
                }
                trs[i].style.display = show ? '' : 'none';
            }
        }

