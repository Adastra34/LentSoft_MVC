                                   style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                    &laquo; Anterior
                                </a>
                            }
                            else
                            {
                                <span style="padding: 0.35rem 0.75rem; border: 1px solid var(--gray-200); border-radius: 0.375rem; color: var(--gray-400); font-size: 0.85rem; background: var(--gray-50); cursor: not-allowed;">
                                    &laquo; Anterior
                                </span>
                            }

                            @for (int p = 1; p <= Model.FacturasTotalPages; p++)
                            {
                                if (p == Model.FacturasPage)
                                {
                                    <span style="padding: 0.35rem 0.75rem; border-radius: 0.375rem; background-color: var(--purple-600); color: white; font-weight: 700; font-size: 0.85rem;">
                                        @p
                                    </span>
                                }
                                else
                                {
                                    <a href="?section=facturas&page=@p&pageSize=@Model.FacturasPageSize&searchTerm=@Model.FacturasSearchTerm"
                                       style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                        @p
                                    </a>
                                }
                            }

                            @if (Model.FacturasPage < Model.FacturasTotalPages)
                            {
                                <a href="?section=facturas&page=@(Model.FacturasPage + 1)&pageSize=@Model.FacturasPageSize&searchTerm=@Model.FacturasSearchTerm"
                                   style="padding: 0.35rem 0.75rem; border: 1px solid var(--purple-300); border-radius: 0.375rem; color: var(--purple-700); font-weight: 600; text-decoration: none; font-size: 0.85rem; background: white;">
                                    Siguiente &raquo;
                                </a>
                            }
                            else
                            {
                                <span style="padding: 0.35rem 0.75rem; border: 1px solid var(--gray-200); border-radius: 0.375rem; color: var(--gray-400); font-size: 0.85rem; background: var(--gray-50); cursor: not-allowed;">
                                    Siguiente &raquo;
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        @section Scripts {

    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script>
        function toggleAuditoria() {
            const panel = document.getElementById('panel-auditoria');
            const icon  = document.getElementById('icon-auditoria');
            if (panel.style.display === 'none') {
                panel.style.display = 'block';
                icon.textContent = '▼';
            } else {
                panel.style.display = 'none';
                icon.textContent = '▶';
            }
        }

        function showToast(msg, type = 'info') {
            if (typeof alertify !== 'undefined') {
                if (type === 'success') alertify.success(msg);
                else if (type === 'error') alertify.error(msg);
                else if (type === 'warning') (alertify.warning ? alertify.warning(msg) : alertify.error(msg));
                else alertify.message(msg);
                return;
            }
            let container = document.getElementById('inv-toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'inv-toast-container';
                container.style.cssText = 'position: fixed; bottom: 24px; right: 24px; z-index: 99999; display: flex; flex-direction: column; gap: 8px; max-width: 380px; pointer-events: none; font-family: system-ui, -apple-system, sans-serif;';
                document.body.appendChild(container);
            }
            const toast = document.createElement('div');
            const bg = type === 'success' ? '#059669' : (type === 'error' ? '#DC2626' : (type === 'warning' ? '#D97706' : '#7C3AED'));
            toast.style.cssText = `pointer-events: auto; padding: 12px 18px; border-radius: 8px; color: white; font-weight: 500; font-size: 0.875rem; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3); transition: all 0.25s ease; opacity: 0; transform: translateY(12px); display: flex; align-items: center; gap: 10px; background: ${bg};`;
            toast.innerHTML = `<span>${msg}</span>`;
            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.style.opacity = '1';
                toast.style.transform = 'translateY(0)';
            });
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(12px)';
                setTimeout(() => toast.remove(), 250);
            }, 4000);
        }

        // ==================== GRÁFICO RESUMEN INVENTARIO (CAMBIO 1) ====================
        let inventoryChartInstance = null;
        function initInventoryChart() {
            const canvas = document.getElementById('chartEvolucionVentas');
            if (!canvas) return;
            if (inventoryChartInstance) {
                inventoryChartInstance.resize();
                return;
            }
            const ctx = canvas.getContext('2d');
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EvolucionVentas.Select(x => x.Periodo)));
            const dataVentas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EvolucionVentas.Select(x => x.TotalVentas)));
            const dataPedidos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EvolucionVentas.Select(x => x.CantidadPedidos)));
            const dataEntradas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EvolucionVentas.Select(x => x.EntradasStock)));
            const dataSalidas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EvolucionVentas.Select(x => x.SalidasStock)));

            const gradient = ctx.createLinearGradient(0, 0, 0, 280);
            gradient.addColorStop(0, 'rgba(124, 58, 237, 0.35)');
            gradient.addColorStop(1, 'rgba(124, 58, 237, 0.02)');

            inventoryChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Ventas Totales ($)',
                            data: dataVentas,
                            borderColor: '#7c3aed',
                            backgroundColor: gradient,
                            borderWidth: 3,
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#7c3aed',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            pointHoverRadius: 7,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Cantidad de Pedidos',
                            data: dataPedidos,
                            borderColor: '#10B981',
                            backgroundColor: 'rgba(16, 185, 129, 0.08)',
                            borderWidth: 2,
                            borderDash: [5, 5],
                            fill: false,
                            tension: 0.35,
                            pointBackgroundColor: '#10B981',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            yAxisID: 'y1'
                        },
                        {
                            label: 'Entradas de Stock',
                            data: dataEntradas,
                            borderColor: '#3B82F6',
                            backgroundColor: 'rgba(59, 130, 246, 0.08)',
                            borderWidth: 2,
                            fill: false,
                            tension: 0.35,
                            pointBackgroundColor: '#3B82F6',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            yAxisID: 'y1'
                        },
                        {
                            label: 'Salidas de Stock',
                            data: dataSalidas,
                            borderColor: '#EF4444',
                            backgroundColor: 'rgba(239, 68, 68, 0.08)',
                            borderWidth: 2,
                            borderDash: [3, 3],
                            fill: false,
                            tension: 0.35,
                            pointBackgroundColor: '#EF4444',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                boxWidth: 14,
                                font: { family: 'inherit', weight: 600 }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    if (context.datasetIndex === 0) {
                                        return context.dataset.label + ': $' + Number(context.parsed.y).toLocaleString();
                                    } else if (context.datasetIndex === 1) {
                                        return context.dataset.label + ': ' + context.parsed.y + ' pedidos';
                                    } else if (context.datasetIndex === 2) {
                                        return context.dataset.label + ': +' + context.parsed.y + ' unid.';
                                    } else {
                                        return context.dataset.label + ': -' + context.parsed.y + ' unid.';
                                    }
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false }
                        },
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            grid: { color: 'rgba(0, 0, 0, 0.05)' },
                            ticks: {
                                callback: function(val) { return '$' + Number(val).toLocaleString(); }
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            grid: { drawOnChartArea: false },
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });
        }

        function abrirModalPedirAProveedor(productId, supplierId) {
