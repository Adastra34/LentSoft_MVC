                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Puesto</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Departamento</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Rol</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Salario</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem; text-align: center;">Estado</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem; text-align: center;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Trabajadores.Any())
                                {
                                    foreach (var emp in Model.Trabajadores)
                                    {
                                        <tr style="border-bottom: 1px solid var(--purple-100); transition: background-color 0.15s ease;" onmouseover="this.style.backgroundColor='var(--purple-50)';" onmouseout="this.style.backgroundColor='transparent';">
                                            <td style="padding: 0.75rem 1rem; color: var(--gray-500);">#@emp.Id</td>
                                            <td style="padding: 0.75rem 1rem; font-weight: 600; color: var(--purple-900);">@emp.Nombre</td>
                                            <td style="padding: 0.75rem 1rem; color: var(--gray-600);">@emp.Email</td>
                                            <td style="padding: 0.75rem 1rem; color: var(--gray-600);">@(string.IsNullOrWhiteSpace(emp.Telefono) ? "—" : emp.Telefono)</td>
                                            <td style="padding: 0.75rem 1rem; color: var(--gray-600);">@emp.Puesto</td>
                                            <td style="padding: 0.75rem 1rem; color: var(--gray-600);">@emp.Departamento</td>
                                            <td style="padding: 0.75rem 1rem;">
                                                <span style="background-color: var(--purple-100); color: var(--purple-800); padding: 0.2rem 0.5rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600;">
                                                    @emp.Rol
                                                </span>
                                            </td>
                                            <td style="padding: 0.75rem 1rem; font-weight: 600; color: var(--purple-800);">$@emp.Salario.ToString("N0")</td>
                                            <td style="padding: 0.75rem 1rem; text-align: center;">
                                                <span style="background-color: @(emp.Activo ? "var(--success)" : "var(--error)"); color: white; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                                                    @(emp.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td style="padding: 0.75rem 1rem; text-align: center;">
                                                <div class="table-actions-wrapper" style="justify-content: center;">
                                                    <button type="button" class="btn-action-edit btn-edit-employee" aria-label="Editar"
                                                        data-record='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { id = emp.Id, nombre = emp.Nombre, email = emp.Email, telefono = emp.Telefono ?? "", puesto = emp.Puesto, departamento = emp.Departamento, salario = emp.Salario, rol = emp.Rol, activo = emp.Activo }))'>
                                                        <icon name="pencil" class="icon-sm" /> <span>Editar</span>
                                                    </button>
                                                    @if (emp.Activo)
