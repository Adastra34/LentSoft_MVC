@model DashboardAdminViewModel
@{
    ViewData["Title"] = "Panel de Administración";
}

<div style="display: flex; min-height: 85vh; background-color: var(--purple-50);">
    <!-- Sidebar Sidebar Navigation -->
    <aside style="width: 260px; background-color: var(--purple-900); color: white; padding: 1.5rem 1rem; flex-shrink: 0;">
        <div style="padding: 0 0.5rem 1.5rem 0.5rem; border-bottom: 1px solid var(--purple-700); margin-bottom: 1.5rem;">
            <h2 style="color: white; font-size: 1.25rem; margin: 0;" data-i18n="admin.portal">Admin Dashboard</h2>
            <p style="color: var(--purple-200); font-size: 0.85rem; margin: 0.25rem 0 0 0;" data-i18n="admin.management">Gestión Integral LentSoft</p>
        </div>

        <nav style="display: flex; flex-direction: column; gap: 0.5rem;">
            <a href="?section=general" class="nav-item @(Model.ActiveSection == "general" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "general" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "general" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="admin.nav.general">
                📊 General
            </a>
            <a href="?section=inventario&subtab=productos" class="nav-item @(Model.ActiveSection == "inventario" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "inventario" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "inventario" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="admin.nav.inventory">
                📦 Inventario
            </a>
            <a href="?section=ventas" class="nav-item @(Model.ActiveSection == "ventas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "ventas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "ventas" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="admin.nav.sales">
                💳 Ventas
            </a>
            <a href="?section=citas" class="nav-item @(Model.ActiveSection == "citas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "citas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "citas" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="admin.nav.appointments">
                📅 Citas Médicas
            </a>
            <a href="?section=usuarios&subtab=clientes" class="nav-item @(Model.ActiveSection == "usuarios" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "usuarios" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "usuarios" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="admin.nav.users">
                👥 Usuarios
            </a>
            <a href="?section=facturas" class="nav-item @(Model.ActiveSection == "facturas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "facturas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "facturas" ? "var(--purple-700)" : "transparent"); font-weight: 500;" data-i18n="admin.nav.invoices">
                🧾 Facturas
            </a>
        </nav>
    </aside>

    <!-- Main Content Area -->
    <main style="flex: 1; padding: 2rem; overflow-y: auto;">
        
        <!-- ==================== SECCIÓN GENERAL ==================== -->
        @if (Model.ActiveSection == "general")
        {
            <h1 style="color: var(--purple-900); margin-bottom: 1.5rem; font-size: 1.75rem;" data-i18n="admin.general.title">Resumen General</h1>

            <!-- Stats Cards with % variation -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--purple-600); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="admin.general.monthly">Ventas del Mes</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.VentasDelMes.ToString("C")</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.VentasDelMes, Model.VentasDelMesAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.VentasDelMes, Model.VentasDelMesAnterior)
                        </span>
                    </div>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--info); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="admin.general.activeorders">Pedidos Activos</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.PedidosActivos</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.PedidosActivos, Model.PedidosActivosAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.PedidosActivos, Model.PedidosActivosAnterior)
                        </span>
                    </div>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--success); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="admin.general.totalclients">Clientes Totales</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.ClientesTotales</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.ClientesTotales, Model.ClientesTotalesAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.ClientesTotales, Model.ClientesTotalesAnterior)
                        </span>
                    </div>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--warning); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="admin.general.instock">Productos en Stock</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.ProductosEnStock</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.ProductosEnStock, Model.ProductosEnStockAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.ProductosEnStock, Model.ProductosEnStockAnterior)
                        </span>
                    </div>
                </div>
            </div>

            <!-- Tabla de pedidos recientes -->
            <div class="card" style="padding: 1.5rem; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <h2 style="color: var(--purple-800); font-size: 1.25rem; margin: 0;" data-i18n="admin.general.recentorders">Pedidos Recientes</h2>
                    <input type="text" id="searchRecentOrders" placeholder="Buscar pedido..." data-i18n-placeholder="admin.general.searchorder" class="form-input" style="width: 250px; padding: 0.4rem 0.75rem; font-size: 0.875rem;" onkeyup="filterTable('searchRecentOrders', 'tableRecentOrders')" />
                </div>
                <div style="overflow-x: auto;">
                    <table id="tableRecentOrders" style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">ID</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.client">Cliente</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.date">Fecha</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.total">Total</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.status">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.PedidosRecientes)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-700);">#ORD-@p.Id.ToString("D4")</td>
                                    <td style="padding: 0.75rem;">@(p.User?.Nombre ?? "Cliente")</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@p.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="padding: 0.75rem; font-weight: 600;">@p.Total.ToString("C")</td>
                                    <td style="padding: 0.75rem;">
                                        <span style="background-color: var(--purple-100); color: var(--purple-800); padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; text-transform: capitalize;">
                                            @p.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SECCIÓN INVENTARIO ==================== -->
        @if (Model.ActiveSection == "inventario")
        {
            var initialTab = string.IsNullOrEmpty(Model.ActiveSubTab) ? "productos" : Model.ActiveSubTab;
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;" data-i18n="admin.inv.title">Gestión de Inventario</h1>
                
                <div id="top-btn-productos" style="display: @(initialTab == "productos" ? "inline-block" : "none");">
                    <button class="btn btn-primary" onclick="document.getElementById('modal-producto').style.display='flex'" data-i18n="admin.inv.newproduct">
                        + Nuevo Producto
                    </button>
                </div>
                <div id="top-btn-proveedores" style="display: @(initialTab == "proveedores" ? "inline-block" : "none");">
                    <button class="btn btn-primary" onclick="document.getElementById('modal-crear-proveedor').style.display='flex'" data-i18n="admin.inv.newsupplier">
                        + Nuevo Proveedor
                    </button>
                </div>
                <div id="top-btn-historial" style="display: @(initialTab == "historial" ? "inline-block" : "none");">
                    <button type="button" onclick="exportMovimientosToExcel()" style="background-color: #10B981; color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                        📥 Exportar a Excel
                    </button>
                </div>
                <div id="top-btn-pedidos" style="display: @(initialTab == "pedidos" ? "inline-block" : "none");">
                    <div style="display: flex; gap: 0.5rem;">
                        <button id="btn-top-nuevo-pedido-venta" class="btn btn-primary" onclick="document.getElementById('modal-crear-pedido-venta').style.display='flex'">
                            + Nuevo Pedido Venta
                        </button>
                        <button id="btn-top-nuevo-pedido-proveedor" class="btn btn-primary" style="background-color: var(--purple-700); display: none;" onclick="document.getElementById('modal-crear-pedido-proveedor').style.display='flex'">
                            + Nuevo Pedido Proveedor
                        </button>
                    </div>
                </div>
            </div>

            <!-- Sub-tabs -->
            <div style="display: flex; border-bottom: 2px solid var(--purple-200); margin-bottom: 1.5rem;">
                <button id="nav-subtab-productos" type="button" onclick="switchInventorySubTab('productos')" style="padding: 0.75rem 1.5rem; font-weight: 600; background: none; border: none; cursor: pointer; color: @(initialTab == "productos" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(initialTab == "productos" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px;" data-i18n="admin.inv.tab.products">
                    Productos
                </button>
                <button id="nav-subtab-proveedores" type="button" onclick="switchInventorySubTab('proveedores')" style="padding: 0.75rem 1.5rem; font-weight: 600; background: none; border: none; cursor: pointer; color: @(initialTab == "proveedores" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(initialTab == "proveedores" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px;" data-i18n="admin.inv.tab.suppliers">
                    Proveedores
                </button>
                <button id="nav-subtab-historial" type="button" onclick="switchInventorySubTab('historial')" style="padding: 0.75rem 1.5rem; font-weight: 600; background: none; border: none; cursor: pointer; color: @(initialTab == "historial" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(initialTab == "historial" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px;" data-i18n="admin.inv.tab.history">
                    Historial de Movimientos
                </button>
                <button id="nav-subtab-pedidos" type="button" onclick="switchInventorySubTab('pedidos')" style="padding: 0.75rem 1.5rem; font-weight: 600; background: none; border: none; cursor: pointer; color: @(initialTab == "pedidos" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(initialTab == "pedidos" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px;">
                    📋 Pedidos
                </button>
            </div>

            <!-- CONTENIDO PESTAÑA PRODUCTOS -->
            <div id="subtab-content-productos" style="display: @(initialTab == "productos" ? "block" : "none");">
                <div class="card" style="padding: 1.5rem; background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <input type="text" id="searchProducts" placeholder="Buscar producto..." data-i18n-placeholder="admin.inv.searchproduct" class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchProducts', 'tableProducts')" oninput="filterTable('searchProducts', 'tableProducts')" />
                    </div>
                    <div style="overflow-x: auto;">
                        <table id="tableProducts" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                    <th style="padding: 0.75rem;">ID</th>
                                    <th style="padding: 0.75rem;" data-i18n="modal.sale.selectproduct">Nombre</th>
                                    <th style="padding: 0.75rem;" data-i18n="sales.inventory.category">Categoría</th>
                                    <th style="padding: 0.75rem;" data-i18n="sales.inventory.price">Precio</th>
                                    <th style="padding: 0.75rem;" data-i18n="modal.sale.qty">Stock</th>
                                    <th style="padding: 0.75rem;" data-i18n="sales.table.status">Estado</th>
                                    <th style="padding: 0.75rem;" data-i18n="sales.table.actions">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prod in Model.Productos)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; color: var(--gray-500);">#@prod.Id</td>
                                        <td style="padding: 0.75rem; font-weight: 500;">
                                            <a href="/Product/Details/@prod.Id" style="color: var(--purple-700); font-weight: 600; text-decoration: underline;">@prod.Nombre</a>
                                        </td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@prod.Categoria</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@prod.Precio.ToString("C")</td>
                                        <td style="padding: 0.75rem; color: @(prod.Stock < 10 ? "var(--error)" : "var(--gray-600)"); font-weight: @(prod.Stock < 10 ? "bold" : "normal");">
                                            @prod.Stock
                                        </td>
                                        <td style="padding: 0.75rem;">
                                            <button type="button" onclick="toggleProductStatus(@prod.Id, this)" style="background-color: @(prod.Activo ? "var(--success)" : "var(--error)"); color: white; border: none; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; cursor: pointer; font-weight: 600;" data-i18n="@(prod.Activo ? "admin.inv.active" : "admin.inv.inactive")">
                                                @(prod.Activo ? "Activo" : "Inactivo")
                                            </button>
                                        </td>
                                        <td style="padding: 0.75rem;">
                                            <div class="table-actions-wrapper">
                                                <button type="button" class="btn-action-edit" aria-label="Editar" onclick="openEditProductModal(@prod.Id, '@System.Web.HttpUtility.JavaScriptStringEncode(prod.Nombre)', '@System.Web.HttpUtility.JavaScriptStringEncode(prod.Descripcion ?? "")', @prod.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture), '@(prod.PrecioDescuento?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(prod.Categoria)', '@System.Web.HttpUtility.JavaScriptStringEncode(prod.Marca ?? "")', @prod.Stock, @(prod.Activo ? "true" : "false"), '@System.Web.HttpUtility.JavaScriptStringEncode(prod.ImagenUrl ?? "")')" data-i18n="admin.inv.edit">✏️ Editar</button>
                                                <form asp-controller="Product" asp-action="Delete" asp-route-id="@prod.Id" method="post" style="display:inline;" onsubmit="confirmDelete(event, '¿Deseas eliminar el producto @prod.Nombre?', this)">
                                                    <button type="submit" class="btn-action-delete" aria-label="Eliminar" data-i18n="admin.inv.delete">🗑️ Eliminar</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- CONTENIDO PESTAÑA PROVEEDORES -->
            <div id="subtab-content-proveedores" style="display: @(initialTab == "proveedores" ? "block" : "none");">
                <div class="card" style="padding: 1.5rem; background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <input type="text" id="searchProveedores" placeholder="Buscar proveedor..." data-i18n-placeholder="admin.inv.searchsupplier" class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchProveedores', 'tableProveedores')" oninput="filterTable('searchProveedores', 'tableProveedores')" />
                    </div>
                    <div style="overflow-x: auto;">
                        <table id="tableProveedores" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                    <th style="padding: 0.75rem;">ID</th>
                                    <th style="padding: 0.75rem;">Logo</th>
                                    <th style="padding: 0.75rem;" data-i18n="admin.inv.company">Empresa</th>
                                    <th style="padding: 0.75rem;">Contacto</th>
                                    <th style="padding: 0.75rem;" data-i18n="admin.inv.producttype">Tipo Productos</th>
                                    <th style="padding: 0.75rem;" data-i18n="admin.inv.phone">Teléfono</th>
                                    <th style="padding: 0.75rem;" data-i18n="admin.inv.email">Email</th>
                                    <th style="padding: 0.75rem;" data-i18n="sales.table.status">Estado</th>
                                    <th style="padding: 0.75rem;" data-i18n="sales.table.actions">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prov in Model.Proveedores)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; color: var(--gray-500); font-weight: 600;">@prov.Id</td>
                                        <td style="padding: 0.75rem;">
                                            @if (!string.IsNullOrEmpty(prov.LogoUrl))
                                            {
                                                <img src="@prov.LogoUrl" alt="@prov.Nombre" style="width: 32px; height: 32px; object-fit: cover; border-radius: 50%;" />
                                            }
                                            else
                                            {
                                                <span style="display:inline-block; width:32px; height:32px; background:var(--purple-100); color:var(--purple-700); border-radius:50%; text-align:center; line-height:32px; font-weight:bold; font-size:0.8rem;">🏢</span>
                                            }
                                        </td>
                                        <td style="padding: 0.75rem; font-weight: 500; color: var(--purple-900);">@prov.Nombre</td>
                                        <td style="padding: 0.75rem;">@(prov.Contacto ?? "N/A")</td>
                                        <td style="padding: 0.75rem;">@prov.TipoProductos</td>
                                        <td style="padding: 0.75rem;">@prov.Telefono</td>
                                        <td style="padding: 0.75rem;">@prov.Correo</td>
                                        <td style="padding: 0.75rem;">
                                            <button type="button" onclick="toggleSupplierStatus('@prov.Id', this)" style="background-color: @(prov.Activo ? "var(--success)" : "var(--gray-400)"); color: white; border: none; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; cursor: pointer; font-weight: 600;" data-i18n="@(prov.Activo ? "admin.inv.active" : "admin.inv.inactive")">
                                                @(prov.Activo ? "Activo" : "Inactivo")
                                            </button>
                                        </td>
                                        <td style="padding: 0.75rem;">
                                            <div class="table-actions-wrapper">
                                                <button type="button" class="btn-action-edit" aria-label="Editar" onclick="openEditSupplierModal('@prov.Id', '@System.Web.HttpUtility.JavaScriptStringEncode(prov.Nombre)', '@System.Web.HttpUtility.JavaScriptStringEncode(prov.Contacto ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(prov.TipoProductos)', '@System.Web.HttpUtility.JavaScriptStringEncode(prov.Telefono)', '@System.Web.HttpUtility.JavaScriptStringEncode(prov.Correo)', '@System.Web.HttpUtility.JavaScriptStringEncode(prov.LogoUrl ?? "")')" data-i18n="admin.inv.edit">✏️ Editar</button>
                                                <form asp-controller="Supplier" asp-action="Delete" asp-route-id="@prov.Id" method="post" style="display:inline;" onsubmit="confirmDelete(event, '¿Deseas eliminar al proveedor @prov.Nombre?', this)">
                                                    <button type="submit" class="btn-action-delete" aria-label="Eliminar" data-i18n="admin.inv.delete">🗑️ Eliminar</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- CONTENIDO PESTAÑA HISTORIAL -->
            <div id="subtab-content-historial" style="display: @(initialTab == "historial" ? "block" : "none");">
                <div class="card" style="padding: 1.5rem; background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <input type="text" id="searchHistorial" placeholder="Buscar en historial..." data-i18n-placeholder="admin.inv.searchhistory" class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchHistorial', 'tableHistorial')" oninput="filterTable('searchHistorial', 'tableHistorial')" />
                        
                        <div style="display: flex; gap: 0.75rem; align-items: center;">
                            <label style="font-weight: 600; font-size: 0.85rem; color: var(--purple-900);">Orden por Fecha:</label>
                            <select onchange="location.href='?section=inventario&subtab=historial&movSort=' + this.value" class="form-input" style="padding: 0.4rem 0.75rem; font-size: 0.85rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                                <option value="desc" selected="@(ViewBag.MovSort != "asc")">Más recientes primero (Descendente)</option>
                                <option value="asc" selected="@(ViewBag.MovSort == "asc")">Más antiguos primero (Ascendente)</option>
                            </select>
                        </div>
                    </div>
                    <div style="overflow-x: auto;">
                        <table id="tableHistorial" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                    <th style="padding: 0.75rem;">ID</th>
                                    <th style="padding: 0.75rem;" data-i18n="modal.sale.selectproduct">Producto</th>
                                    <th style="padding: 0.75rem;" data-i18n="admin.inv.type">Tipo</th>
                                    <th style="padding: 0.75rem;" data-i18n="admin.inv.qty">Cantidad</th>
                                    <th style="padding: 0.75rem; cursor: pointer;" onclick="location.href='?section=inventario&subtab=historial&movSort=@(ViewBag.MovSort == "asc" ? "desc" : "asc")'">Fecha @(ViewBag.MovSort == "asc" ? "▲" : "▼")</th>
                                    <th style="padding: 0.75rem;" data-i18n="admin.inv.responsible">Responsable</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mov in Model.HistorialMovimientos)
                                {
                                    var tipoKey = mov.Tipo?.ToLower() == "entrada" ? "admin.inv.inflow" : "admin.inv.outflow";
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; color: var(--gray-500);">#MOV-@mov.Id</td>
                                        <td style="padding: 0.75rem; font-weight: 500;">
                                            <a href="/Product/Details/@mov.ProductId" style="color: var(--purple-700); font-weight: 600; text-decoration: underline;">@(mov.NombreProducto ?? mov.Product?.Nombre ?? ("Producto #" + mov.ProductId))</a>
                                        </td>
                                        <td style="padding: 0.75rem;">
                                            <span style="background-color: @(mov.Tipo?.ToLower() == "entrada" ? "var(--success)" : "var(--warning)"); color: white; padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; text-transform: uppercase;" data-i18n="@tipoKey">
                                                @mov.Tipo
                                            </span>
                                        </td>
                                        <td style="padding: 0.75rem; font-weight: 600;">@mov.Cantidad</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600);">@mov.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td style="padding: 0.75rem;">@(mov.Responsable ?? "Administrador")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- CONTENIDO PESTAÑA PEDIDOS -->
            <div id="subtab-content-pedidos" style="display: @(initialTab == "pedidos" ? "block" : "none");">
                <!-- Pestañas internas de Pedidos: Ventas vs Proveedores (Sin recarga de página) -->
                <div style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem; background: var(--purple-100); padding: 0.35rem; border-radius: 0.5rem; width: fit-content;">
                    <button id="tab-btn-pedidos-ventas" type="button" onclick="switchPedidosTab('ventas')" style="padding: 0.5rem 1.25rem; font-weight: 600; font-size: 0.9rem; border-radius: 0.375rem; border: none; cursor: pointer; background: var(--purple-700); color: white; transition: all 0.2s ease;">
                        🛒 Pedidos de Ventas
                    </button>
                    <button id="tab-btn-pedidos-proveedores" type="button" onclick="switchPedidosTab('proveedores')" style="padding: 0.5rem 1.25rem; font-weight: 600; font-size: 0.9rem; border-radius: 0.375rem; border: none; cursor: pointer; background: transparent; color: var(--purple-900); transition: all 0.2s ease;">
                        🚚 Pedidos a Proveedores
                    </button>
                </div>

                <!-- CONTENIDO PESTAÑA VENTAS (Independiente) -->
                <div id="content-pedidos-ventas" class="card" style="padding: 1.5rem; background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <input type="text" id="searchPedidosVentas" placeholder="Buscar pedido de venta..." class="form-input" style="width: 320px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchPedidosVentas', 'tablePedidosVentas')" oninput="filterTable('searchPedidosVentas', 'tablePedidosVentas')" />
                        <span style="font-size: 0.85rem; color: var(--gray-500);">* Manejo independiente sin acoplamiento al inventario</span>
                    </div>
                    <div style="overflow-x: auto;">
                        <table id="tablePedidosVentas" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                    <th style="padding: 0.75rem;">N° Pedido</th>
                                    <th style="padding: 0.75rem;">Cliente</th>
                                    <th style="padding: 0.75rem;">Producto</th>
                                    <th style="padding: 0.75rem;">Cantidad</th>
                                    <th style="padding: 0.75rem;">Precio U.</th>
                                    <th style="padding: 0.75rem;">Total</th>
                                    <th style="padding: 0.75rem;">Fecha</th>
                                    <th style="padding: 0.75rem;">Estado</th>
                                    <th style="padding: 0.75rem; text-align: right;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.PedidosVentas)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-900);">@p.NumeroPedido</td>
                                        <td style="padding: 0.75rem; color: var(--purple-900); font-weight: 500;">@p.ClienteNombre</td>
                                        <td style="padding: 0.75rem; font-weight: 500; color: var(--purple-700);">@p.ProductoNombre</td>
                                        <td style="padding: 0.75rem; font-weight: 600;">@p.Cantidad</td>
                                        <td style="padding: 0.75rem;">$@p.PrecioUnitario.ToString("N0")</td>
                                        <td style="padding: 0.75rem; font-weight: 700; color: var(--purple-800);">$@p.Total.ToString("N0")</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600); font-size: 0.85rem;">@p.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td style="padding: 0.75rem;">
                                            <span style="background-color: @(p.Estado.ToLower() == "entregado" ? "var(--success)" : p.Estado.ToLower() == "enviado" ? "#3B82F6" : p.Estado.ToLower() == "cancelado" ? "var(--danger)" : "var(--warning)"); color: white; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">
                                                @p.Estado
                                            </span>
                                        </td>
                                        <td style="padding: 0.75rem; text-align: right;">
                                            <button type="button" class="btn btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; margin-right: 0.25rem;" onclick="openEditSalesOrderModal(@p.Id, '@p.NumeroPedido', '@p.ClienteNombre', '@p.ProductoNombre', @p.Cantidad, @p.PrecioUnitario, '@p.Estado', '@p.Notas')">✏️ Editar</button>
                                            <form asp-action="DeleteSalesOrder" asp-controller="Dashboard" method="post" style="display: inline;" onsubmit="confirmDelete(event, '¿Seguro que deseas eliminar este pedido de venta?', this);">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn btn-danger" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;">🗑️</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- CONTENIDO PESTAÑA PROVEEDORES (Conectado a DB Inventario) -->
                <div id="content-pedidos-proveedores" class="card" style="padding: 1.5rem; background: white; display: none;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <input type="text" id="searchPedidosProveedores" placeholder="Buscar pedido a proveedor..." class="form-input" style="width: 320px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchPedidosProveedores', 'tablePedidosProveedores')" oninput="filterTable('searchPedidosProveedores', 'tablePedidosProveedores')" />
                        <span style="font-size: 0.85rem; color: var(--purple-700); font-weight: 600;">⚡ Conectado a la base de datos de Proveedores y Productos</span>
                    </div>
                    <div style="overflow-x: auto;">
                        <table id="tablePedidosProveedores" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                    <th style="padding: 0.75rem;">N° Pedido</th>
                                    <th style="padding: 0.75rem;">Proveedor (DB)</th>
                                    <th style="padding: 0.75rem;">Producto (DB)</th>
                                    <th style="padding: 0.75rem;">Cantidad</th>
                                    <th style="padding: 0.75rem;">Precio U.</th>
                                    <th style="padding: 0.75rem;">Total</th>
                                    <th style="padding: 0.75rem;">Fecha</th>
                                    <th style="padding: 0.75rem;">Estado</th>
                                    <th style="padding: 0.75rem; text-align: right;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.PedidosProveedores)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-900);">@p.NumeroPedido</td>
                                        <td style="padding: 0.75rem; font-weight: 500; color: var(--purple-900);">@(p.Supplier?.Nombre ?? "Proveedor ID: " + p.SupplierId)</td>
                                        <td style="padding: 0.75rem; font-weight: 500;">
                                            <a href="/Product/Details/@p.ProductId" style="color: var(--purple-700); font-weight: 600; text-decoration: underline;">@(p.Product?.Nombre ?? "Producto ID: " + p.ProductId)</a>
                                        </td>
                                        <td style="padding: 0.75rem; font-weight: 600;">@p.Cantidad</td>
                                        <td style="padding: 0.75rem;">$@p.PrecioUnitario.ToString("N0")</td>
                                        <td style="padding: 0.75rem; font-weight: 700; color: var(--purple-900);">$@p.Total.ToString("N0")</td>
                                        <td style="padding: 0.75rem; color: var(--gray-600); font-size: 0.85rem;">@p.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td style="padding: 0.75rem;">
                                            <span style="background-color: @(p.Estado.ToLower() == "recibido" ? "var(--success)" : p.Estado.ToLower() == "cancelado" ? "var(--danger)" : "var(--warning)"); color: white; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">
                                                @p.Estado
                                            </span>
                                        </td>
                                        <td style="padding: 0.75rem; text-align: right;">
                                            <button type="button" class="btn btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; margin-right: 0.25rem;" onclick="openEditSupplierOrderModal(@p.Id, '@p.NumeroPedido', '@p.SupplierId', @p.ProductId, @p.Cantidad, @p.PrecioUnitario, '@p.Estado', '@p.Notas')">✏️ Editar</button>
                                            <form asp-action="DeleteSupplierOrder" asp-controller="Dashboard" method="post" style="display: inline;" onsubmit="confirmDelete(event, '¿Seguro que deseas eliminar este pedido a proveedor?', this);">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn btn-danger" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;">🗑️</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- ==================== SECCIÓN VENTAS ==================== -->
        @if (Model.ActiveSection == "ventas")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;" data-i18n="admin.sales.title">Listado de Ventas</h1>
                <button type="button" onclick="document.getElementById('modal-venta').style.display='flex'" 
                        style="background-color: var(--purple-600); color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: background-color 0.2s ease;"
                        onmouseover="this.style.backgroundColor='var(--purple-700)'" onmouseout="this.style.backgroundColor='var(--purple-600)'">
                    <span data-i18n="sales.btn.new">+ Registrar Nueva Venta</span>
                </button>
            </div>

            <div class="card" style="padding: 1.5rem; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <input type="text" id="searchVentas" placeholder="Buscar venta o cliente..." data-i18n-placeholder="admin.sales.search" class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchVentas', 'tableVentas')" />
                </div>
                <div style="overflow-x: auto;">
                    <table id="tableVentas" style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;" data-i18n="sales.table.order">Venta</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.client">Cliente</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.date">Fecha</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.total">Total</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.status">Estado</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.currentstatus">Actualizar Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Ventas)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-700);">#ORD-@v.Id.ToString("D4")</td>
                                    <td style="padding: 0.75rem;">@(v.User?.Nombre ?? "Cliente")</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@v.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-900);">@v.Total.ToString("C")</td>
                                    <td style="padding: 0.75rem;">
                                        <span style="background-color: var(--purple-100); color: var(--purple-800); padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem;">
                                            @v.Estado
                                        </span>
                                    </td>
                                    <td style="padding: 0.75rem;">
                                        <form asp-controller="Order" asp-action="UpdateStatus" method="post" style="display:flex; gap:0.5rem; align-items:center;">
                                            <input type="hidden" name="id" value="@v.Id" />
                                            <select name="estado" style="padding: 0.25rem; border-radius: 0.25rem; border: 1px solid var(--gray-300); font-size: 0.85rem;">
                                                <option value="pendiente" selected="@(v.Estado == "pendiente")" data-i18n="sales.status.pending">Pendiente</option>
                                                <option value="procesando" selected="@(v.Estado == "procesando")" data-i18n="sales.status.processing">Procesando</option>
                                                <option value="enviado" selected="@(v.Estado == "enviado")" data-i18n="sales.status.shipped">Enviado</option>
                                                <option value="entregado" selected="@(v.Estado == "entregado")" data-i18n="sales.status.delivered">Entregado</option>
                                                <option value="cancelado" selected="@(v.Estado == "cancelado")" data-i18n="sales.status.cancelled">Cancelado</option>
                                            </select>
                                            <button type="submit" class="btn btn-primary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" data-i18n="admin.sales.save">Guardar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SECCIÓN CITAS ==================== -->
        @if (Model.ActiveSection == "citas")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;" data-i18n="admin.citas.title">Gestión de Citas Médicas</h1>
                <button class="btn btn-primary" onclick="document.getElementById('modal-cita').style.display='flex'" data-i18n="admin.citas.new">
                    + Nueva Cita
                </button>
            </div>

            <div class="card" style="padding: 1.5rem; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <input type="text" id="searchCitas" placeholder="Buscar cita o paciente..." data-i18n-placeholder="admin.citas.search" class="form-input" style="width: 300px; padding: 0.4rem 0.75rem;" onkeyup="filterTable('searchCitas', 'tableCitas')" />
                </div>
                <div style="overflow-x: auto;">
                    <table id="tableCitas" style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--purple-200); color: var(--gray-600);">
                                <th style="padding: 0.75rem;">ID</th>
                                <th style="padding: 0.75rem;" data-i18n="admin.citas.patient">Paciente</th>
                                <th style="padding: 0.75rem;">Optómetra</th>
                                <th style="padding: 0.75rem;" data-i18n="admin.citas.service">Servicio</th>
                                <th style="padding: 0.75rem;" data-i18n="admin.citas.datetime">Fecha y Hora</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.status">Estado</th>
                                <th style="padding: 0.75rem;" data-i18n="sales.table.actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Citas)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; color: var(--gray-500);">#CITA-@c.Id</td>
                                    <td style="padding: 0.75rem; font-weight: 500;">@(c.User?.Nombre ?? "Paciente")</td>
                                    <td style="padding: 0.75rem;">@(c.Optometra?.NombreCompleto ?? "Por asignar")</td>
                                    <td style="padding: 0.75rem;">@c.Servicio</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@c.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="padding: 0.75rem;">
                                        <form asp-controller="Dashboard" asp-action="UpdateAppointmentStatus" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <select name="estado" style="padding: 0.2rem 0.4rem; border-radius: 0.25rem; font-size: 0.8rem;" onchange="this.form.submit()">
                                                <option value="pendiente" selected="@(c.Estado == "pendiente")" data-i18n="sales.status.pending">Pendiente</option>
                                                <option value="confirmada" selected="@(c.Estado == "confirmada")" data-i18n="admin.citas.confirmed">Confirmada</option>
                                                <option value="completada" selected="@(c.Estado == "completada")" data-i18n="admin.citas.completed">Completada</option>
                                                <option value="cancelada" selected="@(c.Estado == "cancelada")" data-i18n="sales.status.cancelled">Cancelada</option>
                                            </select>
                                        </form>
                                    </td>
                                    <td style="padding: 0.75rem;">
                                        <div class="table-actions-wrapper">
                                            <form asp-controller="Dashboard" asp-action="DeleteAppointment" method="post" style="display:inline;" onsubmit="confirmDelete(event, '¿Deseas eliminar la cita #@c.Id?', this)">
                                                <input type="hidden" name="id" value="@c.Id" />
                                                <button type="submit" class="btn-action-delete" aria-label="Eliminar" data-i18n="admin.inv.delete">🗑️ Eliminar</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SECCIÓN USUARIOS ==================== -->
        @if (Model.ActiveSection == "usuarios")
        {
            <div style="margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); font-size: 1.75rem; margin: 0;" data-i18n="admin.users.title">Gestión de Usuarios</h1>
                <p style="color: var(--gray-500); font-size: 0.9rem; margin-top: 0.25rem;" data-i18n="admin.users.subtitle">Administra los clientes y empleados del sistema</p>
            </div>

            <!-- Sub-tabs -->
            <div style="display: flex; border-bottom: 2px solid var(--purple-200); margin-bottom: 1.5rem;">
                <a href="?section=usuarios&subtab=clientes" style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "clientes" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "clientes" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px; text-decoration: none;" data-i18n="admin.users.tab.clients">
                    👥 Clientes
                </a>
                <a href="?section=usuarios&subtab=trabajadores" style="padding: 0.75rem 1.5rem; font-weight: 600; color: @(Model.ActiveSubTab == "trabajadores" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(Model.ActiveSubTab == "trabajadores" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px; text-decoration: none;" data-i18n="admin.users.tab.employees">
                    👔 Trabajadores (Empleados)
                </a>
            </div>

            @if (Model.ActiveSubTab == "clientes")
            {
                <div class="card" style="padding: 1.5rem; background: white; border-radius: 0.75rem; box-shadow: var(--shadow-md);">
                    <!-- Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                        <h2 style="color: var(--purple-900); font-size: 1.35rem; font-weight: 700; margin: 0;" data-i18n="admin.users.regclients">Clientes Registrados</h2>
                        <button type="button" onclick="document.getElementById('modal-crear-cliente').style.display='flex'" 
