            </div>
        </form>
    </div>
</div>

<!-- Modal para Nueva Factura (Estilo DIAN) -->
<div id="modal-factura" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 550px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        
        <!-- Header Morado Tipo DIAN -->
        <div style="background: linear-gradient(135deg, var(--purple-700), var(--purple-600)); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.2rem; font-weight: 700;">
                    <span>📄</span> Factura Electrónica de Venta
                </div>
                <div style="font-size: 0.78rem; color: var(--purple-100); margin-top: 0.25rem; font-weight: 500;">
                    Resolución DIAN Nº 18764028920000 | Rango: FAC-0001 a FAC-5000
                </div>
            </div>
            <button type="button" onclick="document.getElementById('modal-factura').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white; line-height: 1;">&times;</button>
        </div>

        <!-- Formulario DIAN -->
        <form asp-controller="Invoice" asp-action="Create" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
            @Html.AntiForgeryToken()

            <!-- Seccion 1: Datos del Pedido -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span>📋</span> DATOS DEL PEDIDO
                </div>
                <div class="form-group">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Pedido Asociado *</label>
                    <select name="OrderId" class="form-input" required style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" onchange="updateNewInvoiceAmounts(this)">
                        <option value="">-- Seleccionar Pedido --</option>
                        @foreach (var ord in Model.PedidosDisponibles)
                        {
                            var usrName = ord.User != null ? ord.User.NombreCompleto : "Cliente";
                            <option value="@ord.Id" data-total="@ord.Total">#ORD-@ord.Id.ToString("D4") - @usrName (@ord.Total.ToString("C"))</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Seccion 2: Datos de Facturación -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span>📑</span> DATOS DE FACTURACIÓN (NÚMERO AUTO-GENERADO)
                </div>
                <div style="display: flex; gap: 1rem;">
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Estado *</label>
                        <select name="Estado" class="form-input" required style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);">
                            <option value="pendiente" selected>Pendiente</option>
                            <option value="pagada">Pagada</option>
                            <option value="cancelada">Cancelada</option>
                        </select>
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Método de Pago *</label>
                        <select name="MetodoPago" class="form-input" required style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);">
                            <option value="Efectivo" selected>Efectivo</option>
                            <option value="Tarjeta">Tarjeta Débito/Crédito</option>
                            <option value="Transferencia">Transferencia / PSE</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Seccion 3: Valores -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span>💰</span> VALORES (IVA 19% — ART. 468 E.T.)
                </div>
                <div style="display: flex; gap: 0.75rem;">
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem; margin-bottom: 0.35rem; display: block;">Subtotal</label>
                        <input id="newInvoiceSubtotal" name="Subtotal" type="number" step="0.01" class="form-input" readonly placeholder="Auto-calculado" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--gray-300); background-color: var(--gray-50);" />
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem; margin-bottom: 0.35rem; display: block;">IVA 19%</label>
                        <input id="newInvoiceImpuestos" name="Impuestos" type="number" step="0.01" class="form-input" readonly placeholder="Auto-calculado" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--gray-300); background-color: var(--gray-50);" />
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 700; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.35rem; display: block;">TOTAL</label>
                        <input id="newInvoiceTotal" name="Total" type="number" step="0.01" class="form-input" readonly placeholder="Auto-calculado" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); background-color: var(--purple-50); font-weight: 700; color: var(--purple-900);" />
                    </div>
                </div>
            </div>

            <!-- Warning Box CUFE DIAN -->
            <div style="background-color: #FEFCE8; border: 1px solid #FDE047; color: #854D0E; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.78rem; line-height: 1.4; display: flex; gap: 0.5rem; align-items: flex-start;">
                <span style="font-size: 0.9rem;">⚠️</span>
                <div>
                    Al crear esta factura se generará un <strong>CUFE</strong> (Código Único de Factura Electrónica) y estará disponible para descarga en formato PDF conforme a la Resolución DIAN.
                </div>
            </div>

            <!-- Botones -->
            <div style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-factura').style.display='none'" 
                        style="flex: 1; border: 2px solid var(--purple-600); color: var(--purple-600); background: transparent; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.88rem; cursor: pointer;">
                    Cancelar
                </button>
                <button type="submit" 
                        style="flex: 1.5; background-color: var(--purple-600); color: white; border: none; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.88rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem;">
                    <span>📄</span> Emitir Factura Electrónica
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal para Registrar Nueva Venta (Múltiples Productos) -->
<div id="modal-venta" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div style="width: 100%; max-width: 600px; background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3); max-height: 90vh; display: flex; flex-direction: column;">
        
        <!-- Header Morado -->
        <div style="background: linear-gradient(135deg, var(--purple-700), var(--purple-600)); color: white; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.2rem; font-weight: 700;">
                <span>💳</span> Registrar Nueva Venta
            </div>
            <button type="button" onclick="document.getElementById('modal-venta').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: white; line-height: 1;">&times;</button>
        </div>

        <!-- Formulario -->
        <form asp-controller="Order" asp-action="Create" method="post" onsubmit="return validateSaleFormAdmin()" style="padding: 1.5rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1.25rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="saleItemsJsonAdmin" name="ItemsJson" value="[]" />

            <!-- Sección 1: Datos del Cliente -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span>👤</span> DATOS DEL CLIENTE
                </div>

                <input type="hidden" id="selectedUserIdAdmin" name="UserId" value="" />

                <div style="margin-bottom: 0.75rem;">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">🔍 Seleccionar Cuenta / Cliente Registrado (Opcional)</label>
                    <select id="userSelectAdmin" class="form-input" onchange="onUserSelectedAdmin(this)" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-size: 0.85rem; background-color: white;">
                        <option value="">-- Buscar o Seleccionar Cliente Registrado --</option>
                        @foreach (var user in (Model.TodosLosClientes.Any() ? Model.TodosLosClientes : Model.Clientes))
                        {
                            <option value="@user.Id" 
                                    data-nombre="@user.Nombre" 
                                    data-apellido="@user.Apellido" 
                                    data-cedula="@user.NumeroDocumento" 
                                    data-telefono="@user.Telefono" 
                                    data-direccion="@user.Direccion">
                                @user.Nombre @user.Apellido (@(string.IsNullOrEmpty(user.NumeroDocumento) ? user.Email : "C.C. " + user.NumeroDocumento))
                            </option>
                        }
                    </select>
                </div>

                <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem;">
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">Nombre *</label>
                        <input id="saleNombreAdmin" name="Nombre" type="text" required placeholder="Ej: Juan" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" />
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">Apellido *</label>
                        <input id="saleApellidoAdmin" name="Apellido" type="text" required placeholder="Ej: Pérez" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" />
                    </div>
                </div>
                <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem;">
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">N° Cédula / Documento *</label>
                        <input id="saleCedulaAdmin" name="NumeroDocumento" type="text" required placeholder="Ej: 1012345678" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" />
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">Teléfono *</label>
                        <input id="saleTelefonoAdmin" name="Telefono" type="text" required placeholder="Ej: 3001234567" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" />
                    </div>
                </div>
                <div style="margin-bottom: 0.75rem;">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">Dirección *</label>
                    <input id="saleDireccionAdmin" name="Direccion" type="text" required placeholder="Ej: Calle 123 # 45-67" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);" />
                </div>
            </div>

            <!-- Sección 2: Agregar Productos -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span>👓</span> SELECCIONAR PRODUCTOS
                </div>
                <div style="display: flex; gap: 0.5rem; align-items: flex-end; margin-bottom: 0.75rem;">
                    <div style="flex: 2;">
                        <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">Producto</label>
                        <select id="newSaleProdSelectAdmin" class="form-input" style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);">
                            <option value="">-- Seleccionar Producto --</option>
                            @foreach (var prod in Model.Productos)
                            {
                                var precioFinal = prod.PrecioDescuento ?? prod.Precio;
                                <option value="@prod.Id" data-nombre="@prod.Nombre" data-precio="@precioFinal.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-iva="@prod.PorcentajeIva.ToString(System.Globalization.CultureInfo.InvariantCulture)">@prod.Nombre (@precioFinal.ToString("C") - IVA @prod.PorcentajeIva.ToString("0.#")%)</option>
                            }
                        </select>
                    </div>
                    <div style="width: 85px;">
                        <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">Cantidad</label>
                        <input id="newSaleQtyInputAdmin" type="number" min="1" value="1" oninput="if(this.value < 1) this.value = 1;" class="form-input" style="width: 100%; padding: 0.55rem 0.5rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); text-align: center;" />
                    </div>
                    <button type="button" onclick="addSaleItemAdmin()" style="background-color: var(--purple-600); color: white; border: none; padding: 0.6rem 0.9rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.82rem; cursor: pointer; white-space: nowrap; height: 38px;">
                        + Agregar
                    </button>
                </div>

                <!-- Tabla Lista de Productos Agregados -->
                <div style="border: 1px solid var(--purple-200); border-radius: 0.5rem; overflow: hidden; background: var(--gray-50);">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem;">
                        <thead>
                            <tr style="background-color: var(--purple-100); color: var(--purple-900); text-align: left;">
                                <th style="padding: 0.5rem 0.75rem;">Producto</th>
                                <th style="padding: 0.5rem; text-align: center;">Cant.</th>
                                <th style="padding: 0.5rem; text-align: right;">P. Unit.</th>
                                <th style="padding: 0.5rem; text-align: center;">IVA</th>
                                <th style="padding: 0.5rem 0.75rem; text-align: right;">Subtotal</th>
                                <th style="padding: 0.5rem; text-align: center;"></th>
                            </tr>
                        </thead>
                        <tbody id="saleItemsTableBodyAdmin">
                            <tr>
                                <td colspan="6" style="padding: 1rem; text-align: center; color: var(--gray-500); font-style: italic;">
                                    No ha agregado productos a esta venta aún.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Sección 3: Totales y Descuento -->
            <div>
                <div style="color: var(--purple-900); font-weight: 700; font-size: 0.85rem; border-bottom: 2px solid var(--purple-600); padding-bottom: 0.3rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span>💰</span> DESCUENTO Y TOTALES
                </div>
                <div style="display: flex; gap: 0.75rem;">
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">Descuento (%) *</label>
                        <select id="descuentoSelectAdmin" name="DescuentoPercent" class="form-input" required onchange="calculateSaleTotalsAdmin()" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); font-weight: 600;">
                            @for (int d = 0; d <= 30; d++)
                            {
                                var label = d == 0 ? "0% (Sin Descuento)" : $"{d}% Descuento";
                                <option value="@d">@label</option>
                            }
                        </select>
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">Subtotal (COP)</label>
                        <input id="subtotalDisplayAdmin" type="text" readonly value="COP $0" class="form-input" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--gray-300); background-color: var(--gray-50); font-weight: 600; text-align: right;" />
                    </div>
                    <div style="flex: 1;">
                        <label class="form-label" style="font-weight: 700; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">TOTAL VENTA (COP)</label>
                        <input id="totalDisplayAdmin" type="text" readonly value="COP $0" class="form-input" style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--purple-300); background-color: var(--purple-50); font-weight: 800; color: var(--purple-900); text-align: right; font-size: 0.95rem;" />
                    </div>
                </div>
            </div>

            <!-- Sección 4: Pago y Estado -->
            <div style="display: flex; gap: 0.75rem;">
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">Método de Pago *</label>
                    <select name="MetodoPagoSimulado" class="form-input" required style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);">
                        <option value="Efectivo" selected>Efectivo</option>
                        <option value="Tarjeta">Tarjeta Débito/Crédito</option>
                        <option value="Transferencia">Transferencia / PSE</option>
                    </select>
                </div>
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.8rem; margin-bottom: 0.3rem; display: block;">Estado Inicial *</label>
                    <select name="Estado" class="form-input" required style="width: 100%; padding: 0.55rem; border-radius: 0.5rem; border: 1px solid var(--purple-300);">
                        <option value="pendiente" selected>Pendiente</option>
                        <option value="procesando">Procesando</option>
                        <option value="enviado">Enviado</option>
                        <option value="entregado">Entregado</option>
                    </select>
                </div>
            </div>

            <!-- Botones -->
            <div style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-venta').style.display='none'" 
                        style="flex: 1; border: 2px solid var(--purple-600); color: var(--purple-600); background: transparent; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.88rem; cursor: pointer;">
                    Cancelar
                </button>
                <button type="submit" 
                        style="flex: 1.5; background-color: var(--purple-600); color: white; border: none; padding: 0.65rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.88rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem;">
                    <span>💳</span> Registrar Venta
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let saleItemsAdmin = [];

    function addSaleItemAdmin() {
        const prodSelect = document.getElementById('newSaleProdSelectAdmin');
        const qtyInput = document.getElementById('newSaleQtyInputAdmin');
        if (!prodSelect || !qtyInput) return;

        const productId = parseInt(prodSelect.value || '0', 10);
        const cantidad = parseInt(qtyInput.value || '1', 10);

        if (productId <= 0 || cantidad <= 0) {
            if (typeof alertify !== 'undefined') alertify.error('Seleccione un producto válido y una cantidad mayor a 0');
            else alert('Seleccione un producto válido');
            return;
        }

        const opt = prodSelect.options[prodSelect.selectedIndex];
        const nombre = opt.getAttribute('data-nombre');
        const precio = parseFloat(opt.getAttribute('data-precio') || '0');
        const iva = parseFloat(opt.getAttribute('data-iva') || '19');

        const existingIndex = saleItemsAdmin.findIndex(i => i.productId === productId);
        if (existingIndex >= 0) {
            saleItemsAdmin[existingIndex].cantidad += cantidad;
            saleItemsAdmin[existingIndex].subtotal = saleItemsAdmin[existingIndex].cantidad * precio;
        } else {
            saleItemsAdmin.push({
                productId: productId,
                nombre: nombre,
                cantidad: cantidad,
                precioUnitario: precio,
                ivaPercent: iva,
                subtotal: precio * cantidad
            });
        }

        prodSelect.value = '';
        qtyInput.value = 1;
        renderSaleItemsAdmin();
    }

    function removeSaleItemAdmin(index) {
        saleItemsAdmin.splice(index, 1);
        renderSaleItemsAdmin();
    }

    function renderSaleItemsAdmin() {
        const tbody = document.getElementById('saleItemsTableBodyAdmin');
        if (!tbody) return;

        if (saleItemsAdmin.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" style="padding: 1rem; text-align: center; color: var(--gray-500); font-style: italic;">No ha agregado productos a esta venta aún.</td></tr>`;
        } else {
            tbody.innerHTML = saleItemsAdmin.map((item, idx) => `
                <tr style="border-bottom: 1px solid var(--purple-100);">
                    <td style="padding: 0.5rem 0.75rem; font-weight: 600; color: var(--purple-900);">${item.nombre}</td>
                    <td style="padding: 0.5rem; text-align: center;">${item.cantidad}</td>
                    <td style="padding: 0.5rem; text-align: right;">COP $${Math.round(item.precioUnitario).toLocaleString('es-CO')}</td>
                    <td style="padding: 0.5rem; text-align: center;"><span style="background: var(--purple-100); color: var(--purple-800); padding: 0.15rem 0.45rem; border-radius: 0.25rem; font-weight: 700; font-size: 0.75rem;">${item.ivaPercent}%</span></td>
                    <td style="padding: 0.5rem 0.75rem; text-align: right; font-weight: 700;">COP $${Math.round(item.subtotal).toLocaleString('es-CO')}</td>
                    <td style="padding: 0.5rem; text-align: center;">
                        <button type="button" onclick="removeSaleItemAdmin(${idx})" style="background: none; border: none; color: var(--error); cursor: pointer; font-size: 1rem; font-weight: bold;">&times;</button>
                    </td>
                </tr>
            `).join('');
        }

        calculateSaleTotalsAdmin();
    }

    function calculateSaleTotalsAdmin() {
        const subtotalSum = saleItemsAdmin.reduce((acc, i) => acc + i.subtotal, 0);
        const descSelect = document.getElementById('descuentoSelectAdmin');
        const descPercent = parseInt(descSelect ? descSelect.value : '0', 10);

        const totalFinal = subtotalSum * (1 - (descPercent / 100));

        const subtotalDisplay = document.getElementById('subtotalDisplayAdmin');
        const totalDisplay = document.getElementById('totalDisplayAdmin');
        const jsonInput = document.getElementById('saleItemsJsonAdmin');

        if (subtotalDisplay) subtotalDisplay.value = 'COP $' + Math.round(subtotalSum).toLocaleString('es-CO');
        if (totalDisplay) totalDisplay.value = 'COP $' + Math.round(totalFinal).toLocaleString('es-CO');
        if (jsonInput) jsonInput.value = JSON.stringify(saleItemsAdmin.map(i => ({ productId: i.productId, cantidad: i.cantidad })));
    }

    function onUserSelectedAdmin(selectEl) {
        const option = selectEl.options[selectEl.selectedIndex];
        if (!selectEl.value) {
            document.getElementById('selectedUserIdAdmin').value = '';
            return;
        }
        const nombre = option.getAttribute('data-nombre') || '';
        const apellido = option.getAttribute('data-apellido') || '';
        const cedula = option.getAttribute('data-cedula') || '';
        const telefono = option.getAttribute('data-telefono') || '';
        const direccion = option.getAttribute('data-direccion') || '';

        document.getElementById('selectedUserIdAdmin').value = selectEl.value;
        if (nombre) document.getElementById('saleNombreAdmin').value = nombre;
        if (apellido) document.getElementById('saleApellidoAdmin').value = apellido;
        if (cedula) document.getElementById('saleCedulaAdmin').value = cedula;
        if (telefono) document.getElementById('saleTelefonoAdmin').value = telefono;
        if (direccion) document.getElementById('saleDireccionAdmin').value = direccion;
    }

    function validateSaleFormAdmin() {
        if (saleItemsAdmin.length === 0) {
            if (typeof alertify !== 'undefined') alertify.error('Debe agregar al menos un producto a la venta.');
            else alert('Debe agregar al menos un producto a la venta.');
            return false;
        }
        return true;
    }
    function filterTable(inputId, tableId) {
        const input = document.getElementById(inputId);
        const filter = input.value.toLowerCase();
        const table = document.getElementById(tableId);
        const trs = table.getElementsByTagName('tr');

        for (let i = 1; i < trs.length; i++) {
            let show = false;
            const tds = trs[i].getElementsByTagName('td');
            for (let j = 0; j < tds.length; j++) {
                if (tds[j] && tds[j].textContent.toLowerCase().includes(filter)) {
                    show = true;
                    break;
                }
            }
            trs[i].style.display = show ? '' : 'none';
        }
    }

    function updateNewInvoiceAmounts(selectElem) {
        const selectedOpt = selectElem.options[selectElem.selectedIndex];
        const total = parseFloat(selectedOpt.getAttribute('data-total') || '0');
        if (total > 0) {
            const subtotal = (total / 1.19).toFixed(2);
            const impuestos = (total - subtotal).toFixed(2);
            document.getElementById('newInvoiceSubtotal').value = subtotal;
            document.getElementById('newInvoiceImpuestos').value = impuestos;
            document.getElementById('newInvoiceTotal').value = total.toFixed(2);
        }
    }

    function openEditInvoiceModal(id, numero, orderId, subtotal, impuestos, total, estado, metodoPago, cliente) {
        document.getElementById('editInvoiceId').value = id;
        document.getElementById('editInvoiceOrderId').value = orderId;
        document.getElementById('editInvoiceNumeroDisplay').innerText = 'Factura ' + numero;
        document.getElementById('editInvoiceClienteDisplay').innerText = 'Cliente: ' + cliente;
        document.getElementById('editInvoiceEstado').value = estado.toLowerCase();
        document.getElementById('editInvoiceMetodoPago').value = metodoPago || 'Efectivo';
        document.getElementById('editInvoiceSubtotal').value = subtotal;
        document.getElementById('editInvoiceImpuestos').value = impuestos;
        document.getElementById('editInvoiceTotal').value = total;
        document.getElementById('modal-edit-factura').style.display = 'flex';
    }

    function confirmDeleteInvoice(id, numero) {
        if (typeof alertify !== 'undefined') {
            alertify.confirm(
                'Eliminar Factura',
                '¿Está seguro de que desea eliminar la factura <strong>' + numero + '</strong>? Esta acción no se puede deshacer.',
                function () {
                    executeInvoiceDelete(id);
                },
                function () {
                    alertify.message('Eliminación cancelada');
                }
            ).set('labels', { ok: 'Sí, eliminar', cancel: 'Cancelar' });
        } else if (confirm('¿Está seguro de eliminar la factura ' + numero + '?')) {
            executeInvoiceDelete(id);
        }
    }

    function executeInvoiceDelete(id) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Invoice/Delete/' + id;
        
        const tokenElem = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenElem) {
            const hiddenToken = document.createElement('input');
            hiddenToken.type = 'hidden';
            hiddenToken.name = '__RequestVerificationToken';
            hiddenToken.value = tokenElem.value;
            form.appendChild(hiddenToken);
        }

        document.body.appendChild(form);
        form.submit();
    }

    function filterClientSideFacturas(filterVal) {
        const filter = filterVal.toLowerCase();
        const table = document.getElementById('tableFacturas');
        if (!table) return;
        const trs = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < trs.length; i++) {
            let show = false;
            const tds = trs[i].getElementsByTagName('td');
            if (tds.length <= 1) continue;
            for (let j = 0; j < tds.length - 1; j++) {
                if (tds[j] && tds[j].textContent.toLowerCase().includes(filter)) {
                    show = true;
                    break;
                }
            }
            trs[i].style.display = show ? '' : 'none';
        }
    }

    function openEditClientModal(id, nombre, apellido, email, telefono) {
        document.getElementById('editClientId').value = id;
        document.getElementById('editClientNombre').value = nombre;
        document.getElementById('editClientApellido').value = apellido || '';
        document.getElementById('editClientEmail').value = email;
        document.getElementById('editClientTelefono').value = telefono || '';
        document.getElementById('modal-editar-cliente').style.display = 'flex';
    }

    function confirmDeleteUser(id, nombre) {
        if (typeof alertify !== 'undefined') {
            alertify.confirm(
                'Eliminar Usuario',
                '¿Está seguro de que desea eliminar al cliente/usuario <strong>' + nombre + '</strong>?',
                function () { executeUserDelete(id); },
                function () { alertify.message('Eliminación cancelada'); }
            ).set('labels', { ok: 'Sí, eliminar', cancel: 'Cancelar' });
        } else if (confirm('¿Está seguro de eliminar al usuario ' + nombre + '?')) {
            executeUserDelete(id);
        }
    }

    function executeUserDelete(id) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/User/Delete/' + id;
        
        const tokenElem = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenElem) {
            const hiddenToken = document.createElement('input');
            hiddenToken.type = 'hidden';
            hiddenToken.name = '__RequestVerificationToken';
            hiddenToken.value = tokenElem.value;
            form.appendChild(hiddenToken);
        }

        document.body.appendChild(form);
        form.submit();
    }

    function openEditEmployeeModal(id, nombre, email, telefono, puesto, departamento, salario, rol, activo) {
        document.getElementById('editEmployeeId').value = id;
        document.getElementById('editEmployeeNombre').value = nombre;
        document.getElementById('editEmployeeEmail').value = email;
        document.getElementById('editEmployeeTelefono').value = telefono || '';
        document.getElementById('editEmployeePuesto').value = puesto || '';
        document.getElementById('editEmployeeDepartamento').value = departamento || '';
        document.getElementById('editEmployeeSalario').value = salario;
        document.getElementById('editEmployeeRol').value = rol || 'Trabajador';
        document.getElementById('editEmployeeActivo').value = activo ? 'true' : 'false';
        document.getElementById('modal-editar-trabajador').style.display = 'flex';
    }

    function confirmDeleteEmployee(id, nombre) {
        if (typeof alertify !== 'undefined') {
            alertify.confirm(
                'Eliminar Trabajador',
                '¿Está seguro de que desea eliminar al trabajador <strong>' + nombre + '</strong>?',
                function () { executeEmployeeDelete(id); },
                function () { alertify.message('Eliminación cancelada'); }
            ).set('labels', { ok: 'Sí, eliminar', cancel: 'Cancelar' });
        } else if (confirm('¿Está seguro de eliminar al trabajador ' + nombre + '?')) {
            executeEmployeeDelete(id);
        }
    }

    function executeEmployeeDelete(id) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/User/DeleteEmployee/' + id;
        
        const tokenElem = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenElem) {
            const hiddenToken = document.createElement('input');
            hiddenToken.type = 'hidden';
            hiddenToken.name = '__RequestVerificationToken';
            hiddenToken.value = tokenElem.value;
            form.appendChild(hiddenToken);
        }

        document.body.appendChild(form);
        form.submit();
    }

    function filterClientSideClientes(filterVal) {
        const filter = filterVal.toLowerCase();
        const table = document.getElementById('tableClientes');
        if (!table) return;
        const trs = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < trs.length; i++) {
            let show = false;
            const tds = trs[i].getElementsByTagName('td');
            if (tds.length <= 1) continue;
            for (let j = 0; j < tds.length - 1; j++) {
                if (tds[j] && tds[j].textContent.toLowerCase().includes(filter)) {
                    show = true;
                    break;
                }
            }
            trs[i].style.display = show ? '' : 'none';
        }
    }

    function filterClientSideTrabajadores(filterVal) {
        const filter = filterVal.toLowerCase();
        const table = document.getElementById('tableTrabajadores');
        if (!table) return;
        const trs = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < trs.length; i++) {
            let show = false;
            const tds = trs[i].getElementsByTagName('td');
            if (tds.length <= 1) continue;
            for (let j = 0; j < tds.length - 1; j++) {
                if (tds[j] && tds[j].textContent.toLowerCase().includes(filter)) {
                    show = true;
                    break;
                }
            }
            trs[i].style.display = show ? '' : 'none';
        }
    }

    function openEditProductModal(id, nombre, descripcion, precio, precioDescuento, categoria, marca, stock, activo, imagenUrl) {
        document.getElementById('editProductId').value = id;
        document.getElementById('editProductNombre').value = nombre;
        document.getElementById('editProductDescripcion').value = descripcion || '';
        document.getElementById('editProductPrecio').value = precio;
        document.getElementById('editProductPrecioDescuento').value = precioDescuento || '';
        document.getElementById('editProductCategoria').value = categoria;
        document.getElementById('editProductMarca').value = marca || '';
        document.getElementById('editProductStock').value = stock;
        document.getElementById('editProductActivo').checked = (activo === true || activo === 'true');
        document.getElementById('editProductImagenUrl').value = imagenUrl || '';
        document.getElementById('modal-editar-producto').style.display = 'flex';
    }

    function openEditSupplierModal(id, nombre, tipoProductos, telefono, correo) {
        document.getElementById('editSupplierId').value = id;
        document.getElementById('editSupplierNombre').value = nombre;
        document.getElementById('editSupplierTipoProductos').value = tipoProductos;
        document.getElementById('editSupplierTelefono').value = telefono;
        document.getElementById('editSupplierCorreo').value = correo;
        document.getElementById('modal-editar-proveedor').style.display = 'flex';
    }
</script>

<!-- Modal para Crear Nuevo Cliente -->
<div id="modal-crear-cliente" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div class="card" style="width: 100%; max-width: 500px; max-height: 90vh; overflow-y: auto; background: white; border-radius: 0.75rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--purple-100);">
            <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem; font-weight: 700;">+ Nuevo Cliente</h2>
            <button onclick="document.getElementById('modal-crear-cliente').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
        </div>
        
        <form action="/User/CreateClient" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <div style="display: flex; gap: 0.75rem;">
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Nombre *</label>
                    <input name="Nombre" type="text" class="form-input" required placeholder="Ej: Juan" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
                </div>
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Apellido</label>
                    <input name="Apellido" type="text" class="form-input" placeholder="Ej: Pérez" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
                </div>
            </div>

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Email *</label>
                <input name="Email" type="email" class="form-input" required placeholder="cliente@example.com" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
            </div>

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Teléfono</label>
                <input name="Telefono" type="text" class="form-input" placeholder="3001234567" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
            </div>

            <div style="display: flex; gap: 0.75rem;">
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Tipo Doc.</label>
                    <select name="TipoDocumento" class="form-input" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                        <option value="CC">CC</option>
                        <option value="CE">CE</option>
                        <option value="TI">TI</option>
                        <option value="Pasaporte">Pasaporte</option>
                    </select>
                </div>
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Núm. Documento</label>
                    <input name="NumeroDocumento" type="text" class="form-input" placeholder="1023456789" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
                </div>
            </div>

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Contraseña (Opcional, defecto: user123)</label>
                <input name="Password" type="password" class="form-input" placeholder="••••••••" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem;">
                <button type="button" onclick="document.getElementById('modal-crear-cliente').style.display='none'" style="background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-300); padding: 0.5rem 1rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" style="background: var(--purple-600); color: white; border: none; padding: 0.5rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Guardar Cliente</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal para Editar Cliente -->
<div id="modal-editar-cliente" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div class="card" style="width: 100%; max-width: 500px; max-height: 90vh; overflow-y: auto; background: white; border-radius: 0.75rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--purple-100);">
            <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem; font-weight: 700;">✏️ Editar Cliente</h2>
