                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Nombre</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Correo</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Teléfono</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Puesto</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Departamento</th>
