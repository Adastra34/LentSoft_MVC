                                </div>
                            </div>
                        </div>
                    </div>
                    <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-top: none; border-bottom-left-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                        <table id="tablePedidosProveedores" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead style="background-color: var(--purple-50); color: var(--purple-900);">
                                <tr style="border-bottom: 2px solid var(--purple-200);">
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">N° Pedido</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Proveedor</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Producto</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem; text-align: center;">Cantidad</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem; text-align: center;">Precio U.</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem; text-align: center;">Total</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem; text-align: center;">Fecha</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem; text-align: center;">Estado</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem; text-align: center;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.PedidosProveedores)
                                {
                                    <tr style="border-bottom: 1px solid var(--purple-100);">
                                        <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-900);">@p.NumeroPedido</td>
                                        <td style="padding: 0.75rem; font-weight: 500; color: var(--purple-900);">@(p.Supplier?.Nombre ?? "Proveedor ID: " + p.SupplierId)</td>
                                        <td style="padding: 0.75rem; font-weight: 500;">
                                            <a href="/Product/Details/@p.ProductId" style="color: var(--purple-700); font-weight: 600; text-decoration: underline;">@(p.Product?.Nombre ?? "Producto ID: " + p.ProductId)</a>
                                        </td>
                                        <td style="padding: 0.75rem; text-align: center; font-weight: 600;">@p.Cantidad</td>
                                        <td style="padding: 0.75rem; text-align: center;">$@p.PrecioUnitario.ToString("N0")</td>
                                        <td style="padding: 0.75rem; text-align: center; font-weight: 700; color: var(--purple-900);">$@p.Total.ToString("N0")</td>
                                        <td style="padding: 0.75rem; text-align: center; color: var(--gray-600); font-size: 0.85rem;">@p.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td style="padding: 0.75rem; text-align: center;">
                                            @{
                                                var estProv = (p.Estado ?? "").ToLower().Trim();
                                                var bgProv = estProv == "recibido" || estProv == "entregado" || estProv == "pagado" ? "#10B981"
                                                           : estProv == "cancelado" ? "#EF4444"
                                                           : "#F97316";
                                            }
                                            <span style="background-color: @bgProv; color: white; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">
                                                @p.Estado
                                            </span>
                                        </td>
                                        <td style="padding: 0.75rem; text-align: center;">
                                            <div class="table-actions-wrapper" style="justify-content: center;">
                                                <button type="button" class="btn-action-edit btn-edit-supplier-order" aria-label="Editar"
                                                    data-record='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { id = p.Id, numeroPedido = p.NumeroPedido, supplierId = p.SupplierId, productId = p.ProductId, cantidad = p.Cantidad, precioUnitario = p.PrecioUnitario, estado = p.Estado, notas = p.Notas ?? "" }))'
                                                    data-i18n="admin.inv.edit">✏️ Editar</button>
                                                <form asp-action="DeleteSupplierOrder" asp-controller="Dashboard" method="post" style="display: inline;" class="form-delete-supplier-order">
                                                    <input type="hidden" name="id" value="@p.Id" />
                                                    <button type="submit" class="btn-action-delete" aria-label="Eliminar" data-i18n="admin.inv.delete">🗑️ Eliminar</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- ==================== SECCIÓN VENTAS ==================== -->
        @if (Model.ActiveSection == "ventas")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
