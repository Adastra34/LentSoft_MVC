                                    <a href="javascript:void(0)" onclick="filterTableByValue('searchPedidosProveedores', 'tablePedidosProveedores', '')" style="display: block; padding: 0.4rem 1rem; color: var(--gray-700); text-decoration: none; font-size: 0.85rem;">Todos los proveedores</a>
