@model DashboardAdminViewModel
@inject Microsoft.Extensions.Options.IOptions<LentSoft.Web.Services.InventorySettings> InventoryOptions
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Panel de Administración";
}

<div style="display: flex; min-height: 100vh; background-color: var(--purple-50);">
    <!-- Sidebar Sidebar Navigation -->
    <aside style="width: 260px; background-color: var(--purple-900); color: white; padding: 1.5rem 1rem; flex-shrink: 0;">
        <div style="padding: 0 0.5rem 1.5rem 0.5rem; border-bottom: 1px solid var(--purple-700); margin-bottom: 1.5rem;">
            <h2 style="color: white; font-size: 1.25rem; margin: 0;" data-i18n="admin.portal">Admin Dashboard</h2>
            <p style="color: var(--purple-200); font-size: 0.85rem; margin: 0.25rem 0 0 0;" data-i18n="admin.management">Gestión Integral LentSoft</p>
        </div>

        <nav style="display: flex; flex-direction: column; gap: 0.5rem;">
            <a href="?section=general" class="nav-item @(Model.ActiveSection == "general" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "general" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "general" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                <icon name="bar-chart-3" class="icon-sm" /> <span data-i18n="admin.nav.general">General</span>
            </a>
            <a href="?section=inventario&subtab=productos" class="nav-item @(Model.ActiveSection == "inventario" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "inventario" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "inventario" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                <icon name="package" class="icon-sm" /> <span data-i18n="admin.nav.inventory">Inventario</span>
            </a>
            <a href="?section=ventas" class="nav-item @(Model.ActiveSection == "ventas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "ventas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "ventas" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                <icon name="credit-card" class="icon-sm" /> <span data-i18n="admin.nav.sales">Ventas</span>
            </a>
            <a href="?section=citas" class="nav-item @(Model.ActiveSection == "citas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "citas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "citas" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                <icon name="calendar-days" class="icon-sm" /> <span data-i18n="admin.nav.appointments">Citas Médicas</span>
            </a>
            <a href="?section=usuarios&subtab=clientes" class="nav-item @(Model.ActiveSection == "usuarios" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "usuarios" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "usuarios" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                <icon name="users" class="icon-sm" /> <span data-i18n="admin.nav.users">Usuarios</span>
            </a>
            <a href="?section=facturas" class="nav-item @(Model.ActiveSection == "facturas" ? "active" : "")" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: @(Model.ActiveSection == "facturas" ? "white" : "var(--purple-200)"); background-color: @(Model.ActiveSection == "facturas" ? "var(--purple-700)" : "transparent"); font-weight: 500;">
                <icon name="receipt" class="icon-sm" /> <span data-i18n="admin.nav.invoices">Facturas</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content Area -->
    <main style="flex: 1; padding: 2rem; overflow-y: auto;">
        
        <!-- Barra Superior con Botón de Cerrar Sesión -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--purple-100); padding-bottom: 1rem;">
            <a asp-controller="Home" asp-action="Index" style="background-color: var(--purple-600); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; text-decoration: none; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='var(--purple-700)'" onmouseout="this.style.backgroundColor='var(--purple-600)'">
                <icon name="glasses" class="icon-sm" /> <span>Ir a la Tienda</span>
            </a>
            <div style="display: flex; align-items: center; gap: 1rem;">
                <span style="font-size: 0.9rem; color: var(--gray-600); font-weight: 500;">Hola, @(User.Identity?.Name ?? "Administrador")</span>
                <form asp-controller="Auth" asp-action="Logout" method="post" style="margin: 0;">
                    <button type="submit" class="btn" style="background-color: white; border: 1px solid var(--purple-300); color: var(--purple-700); padding: 0.4rem 0.8rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.35rem; transition: all 0.2s;" onmouseover="this.style.backgroundColor='var(--purple-50)';" onmouseout="this.style.backgroundColor='white';">
                        <icon name="log-out" class="icon-sm" /> <span>Cerrar Sesión</span>
                    </button>
                </form>
            </div>
        </div>
        
        <!-- ==================== SECCIÓN GENERAL ==================== -->
        @if (Model.ActiveSection == "general")
        {
            <h1 style="color: var(--purple-900); margin-bottom: 1.5rem; font-size: 1.75rem;" data-i18n="admin.general.title">Resumen General</h1>

            <!-- Stats Cards with % variation -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--purple-600); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="admin.general.monthly">Ventas del Mes</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.VentasDelMes.ToString("C")</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.VentasDelMes, Model.VentasDelMesAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.VentasDelMes, Model.VentasDelMesAnterior)
                        </span>
                    </div>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--info); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="admin.general.activeorders">Pedidos Activos</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.PedidosActivos</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.PedidosActivos, Model.PedidosActivosAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.PedidosActivos, Model.PedidosActivosAnterior)
                        </span>
                    </div>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--success); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="admin.general.totalclients">Clientes Totales</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.ClientesTotales</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.ClientesTotales, Model.ClientesTotalesAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.ClientesTotales, Model.ClientesTotalesAnterior)
                        </span>
                    </div>
                </div>

                <div class="card" style="padding: 1.25rem; border-left: 4px solid var(--warning); background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <p style="color: var(--gray-500); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.25rem;" data-i18n="admin.general.instock">Productos en Stock</p>
                            <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--purple-900); margin: 0;">@Model.ProductosEnStock</h3>
                        </div>
                        <span style="background-color: var(--purple-100); color: @DashboardAdminViewModel.GetVariacionColor(Model.ProductosEnStock, Model.ProductosEnStockAnterior); padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 700;">
                            @DashboardAdminViewModel.GetVariacion(Model.ProductosEnStock, Model.ProductosEnStockAnterior)
                        </span>
                    </div>
                </div>
            </div>

            <!-- Tabla de pedidos recientes -->
            <div class="card" style="padding: 1.5rem; background: white;">
                <h2 style="color: var(--purple-800); font-size: 1.25rem; margin: 0 0 1rem 0;" data-i18n="admin.general.recentorders">Pedidos Recientes</h2>
                <div style="background-color: var(--purple-900); color: white; padding: 0.85rem 1.25rem; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                    <div style="position: relative; display: flex; align-items: center; min-width: 260px; max-width: 380px; flex: 1;">
                        <span style="position: absolute; left: 0.75rem; color: var(--purple-600); font-size: 0.9rem; pointer-events: none; display: flex; align-items: center;"><icon name="search" class="icon-sm" /></span>
                        <input type="text" id="searchRecentOrders" placeholder="Buscar pedido..." data-i18n-placeholder="admin.general.searchorder" class="form-input" style="width: 100%; padding: 0.45rem 0.75rem 0.45rem 2.25rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); background: white; color: var(--gray-900); font-size: 0.85rem;" onkeyup="filterTable('searchRecentOrders', 'tableRecentOrders')" />
                    </div>
                </div>
                <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-top: none; border-bottom-left-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                    <table id="tableRecentOrders" style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead style="background-color: var(--purple-50); color: var(--purple-900);">
                            <tr style="border-bottom: 2px solid var(--purple-200);">
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">ID</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="sales.table.client">Cliente</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="sales.table.date">Fecha</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="sales.table.total">Total</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="sales.table.status">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.PedidosRecientes)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-700);">#ORD-@p.Id.ToString("D4")</td>
                                    <td style="padding: 0.75rem;">@(p.User != null ? p.User.NombreCompleto : "Cliente Genérico")</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@p.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="padding: 0.75rem; font-weight: 600;">@p.Total.ToString("C")</td>
                                    <td style="padding: 0.75rem;">
                                        <span style="background-color: var(--purple-100); color: var(--purple-800); padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; text-transform: capitalize;">
                                            @p.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SECCIÓN INVENTARIO ==================== -->
        @if (Model.ActiveSection == "inventario")
        {
            var initialTab = string.IsNullOrEmpty(Model.ActiveSubTab) ? "productos" : Model.ActiveSubTab;
            <div class="inv-header">
                <h1 class="inv-title" data-i18n="admin.inv.title">
                    <svg class="inv-icon" viewBox="0 0 24 24"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    Gestión de Inventario
                </h1>
            </div>

            <!-- Sub-tabs -->
            <div class="inv-subtabs">
                <button id="nav-subtab-resumen" type="button" onclick="switchInventorySubTab('resumen')" class="inv-subtab-btn @(initialTab == "resumen" ? "active" : "")">
                    <svg class="inv-icon" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    Resumen
                </button>
                <button id="nav-subtab-productos" type="button" onclick="switchInventorySubTab('productos')" class="inv-subtab-btn @(initialTab == "productos" ? "active" : "")" data-i18n="admin.inv.tab.products">
                    <svg class="inv-icon" viewBox="0 0 24 24"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    Productos
                </button>
                <button id="nav-subtab-proveedores" type="button" onclick="switchInventorySubTab('proveedores')" class="inv-subtab-btn @(initialTab == "proveedores" ? "active" : "")" data-i18n="admin.inv.tab.suppliers">
                    <svg class="inv-icon" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    Proveedores
                </button>
                <button id="nav-subtab-historial" type="button" onclick="switchInventorySubTab('historial')" class="inv-subtab-btn @(initialTab == "historial" ? "active" : "")" data-i18n="admin.inv.tab.history">
                    <svg class="inv-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Historial de Movimientos
                </button>
                <button id="nav-subtab-pedidos" type="button" onclick="switchInventorySubTab('pedidos')" class="inv-subtab-btn @(initialTab == "pedidos" ? "active" : "")">
                    <svg class="inv-icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    Pedidos
                </button>
            </div>

            <!-- Vistas Parciales del Módulo de Inventario -->
            <partial name="Inventario/_Resumen" model="Model" />
            <partial name="Inventario/_Productos" model="Model" />
            <partial name="Inventario/_Proveedores" model="Model" />
            <partial name="Inventario/_Historial" model="Model" />
            <partial name="Inventario/_Pedidos" model="Model" />
        }
        <!-- ==================== SECCIÓN VENTAS ==================== -->
        @if (Model.ActiveSection == "ventas")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;" data-i18n="admin.sales.title">Listado de Ventas</h1>
                <button type="button" onclick="document.getElementById('modal-venta').style.display='flex'" 
                        style="background-color: var(--purple-600); color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: background-color 0.2s ease;"
                        onmouseover="this.style.backgroundColor='var(--purple-700)'" onmouseout="this.style.backgroundColor='var(--purple-600)'">
                    <span data-i18n="sales.btn.new">+ Registrar Nueva Venta</span>
                </button>
            </div>

            <div class="card" style="padding: 1.5rem; background: white;">
                <div style="background-color: var(--purple-900); color: white; padding: 0.85rem 1.25rem; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                    <div style="position: relative; display: flex; align-items: center; min-width: 260px; max-width: 380px; flex: 1;">
                        <span style="position: absolute; left: 0.75rem; color: var(--purple-600); font-size: 0.9rem; pointer-events: none; display: flex; align-items: center;"><icon name="search" class="icon-sm" /></span>
                        <input type="text" id="searchVentas" placeholder="Buscar venta o cliente..." data-i18n-placeholder="admin.sales.search" class="form-input" style="width: 100%; padding: 0.45rem 0.75rem 0.45rem 2.25rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); background: white; color: var(--gray-900); font-size: 0.85rem;" onkeyup="filterTable('searchVentas', 'tableVentas')" />
                    </div>
                </div>
                <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-top: none; border-bottom-left-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                    <table id="tableVentas" style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead style="background-color: var(--purple-50); color: var(--purple-900);">
                            <tr style="border-bottom: 2px solid var(--purple-200);">
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="sales.table.order">Venta</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="sales.table.client">Cliente</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="sales.table.date">Fecha</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="sales.table.total">Total</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="sales.table.status">Estado</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="sales.table.currentstatus">Actualizar Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Ventas)
                            {
                                <tr style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-700);">#ORD-@v.Id.ToString("D4")</td>
                                    <td style="padding: 0.75rem;">@(v.User?.Nombre ?? "Cliente")</td>
                                    <td style="padding: 0.75rem; color: var(--gray-600);">@v.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="padding: 0.75rem; font-weight: 600; color: var(--purple-900);">@v.Total.ToString("C")</td>
                                    <td style="padding: 0.75rem;">
                                        <span style="background-color: var(--purple-100); color: var(--purple-800); padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem;">
                                            @v.Estado
                                        </span>
                                    </td>
                                    <td style="padding: 0.75rem;">
                                        <form asp-controller="Order" asp-action="UpdateStatus" method="post" style="display:flex; gap:0.5rem; align-items:center;">
                                            <input type="hidden" name="id" value="@v.Id" />
                                            <select name="estado" style="padding: 0.25rem; border-radius: 0.25rem; border: 1px solid var(--gray-300); font-size: 0.85rem;">
                                                <option value="pendiente" selected="@(v.Estado == "pendiente")" data-i18n="sales.status.pending">Pendiente</option>
                                                <option value="procesando" selected="@(v.Estado == "procesando")" data-i18n="sales.status.processing">Procesando</option>
                                                <option value="enviado" selected="@(v.Estado == "enviado")" data-i18n="sales.status.shipped">Enviado</option>
                                                <option value="entregado" selected="@(v.Estado == "entregado")" data-i18n="sales.status.delivered">Entregado</option>
                                                <option value="cancelado" selected="@(v.Estado == "cancelado")" data-i18n="sales.status.cancelled">Cancelado</option>
                                            </select>
                                            <button type="submit" class="btn btn-primary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" data-i18n="admin.sales.save">Guardar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ==================== SECCIÓN CITAS ==================== -->
        @if (Model.ActiveSection == "citas")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;" data-i18n="admin.citas.title">Gestión de Citas Médicas</h1>
                <button class="btn btn-primary" onclick="document.getElementById('modal-cita').style.display='flex'" data-i18n="admin.citas.new">
                    + Nueva Cita
                </button>
            </div>

            <!-- Filtros de Estado -->
            <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 1px solid var(--purple-200); padding-bottom: 0.5rem;" id="admin-citas-filters">
                <button class="filter-tab active" onclick="filterAdminCitasByEstado('Todos', this)" style="background-color: var(--purple-600); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">Todos</button>
                <button class="filter-tab" onclick="filterAdminCitasByEstado('pendiente', this)" style="background-color: var(--purple-50); color: var(--purple-700); border: 1px solid var(--purple-200); padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">Pendientes</button>
                <button class="filter-tab" onclick="filterAdminCitasByEstado('confirmada', this)" style="background-color: var(--purple-50); color: var(--purple-700); border: 1px solid var(--purple-200); padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">Confirmadas</button>
                <button class="filter-tab" onclick="filterAdminCitasByEstado('completada', this)" style="background-color: var(--purple-50); color: var(--purple-700); border: 1px solid var(--purple-200); padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">Completadas</button>
                <button class="filter-tab" onclick="filterAdminCitasByEstado('cancelada', this)" style="background-color: var(--purple-50); color: var(--purple-700); border: 1px solid var(--purple-200); padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">Canceladas</button>
            </div>

            <div class="card" style="padding: 1.5rem; background: white;">
                <div style="background-color: var(--purple-900); color: white; padding: 0.85rem 1.25rem; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                    <div style="position: relative; display: flex; align-items: center; min-width: 260px; max-width: 380px; flex: 1;">
                        <span style="position: absolute; left: 0.75rem; color: var(--purple-600); font-size: 0.9rem; pointer-events: none; display: flex; align-items: center;"><icon name="search" class="icon-sm" /></span>
                        <input type="text" id="searchAdminCitas" placeholder="Buscar cita o paciente..." data-i18n-placeholder="admin.citas.search" class="form-input" style="width: 100%; padding: 0.45rem 0.75rem 0.45rem 2.25rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); background: white; color: var(--gray-900); font-size: 0.85rem;" onkeyup="filterAdminCitasCombo()" />
                    </div>
                </div>

                <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-top: none; border-bottom-left-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                    <table id="tableAdminCitas" style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead style="background-color: var(--purple-50); color: var(--purple-900);">
                            <tr style="border-bottom: 2px solid var(--purple-200);">
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">ID</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="admin.citas.patient">Paciente</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Optómetra</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="admin.citas.service">Servicio</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="admin.citas.datetime">Fecha y Hora</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Reprogramaciones</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;" data-i18n="admin.citas.status">Estado</th>
                                <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem; text-align: right;" data-i18n="admin.citas.actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Citas)
                            {
                                <tr class="admin-cita-row" data-estado="@c.Estado?.ToLower()" style="border-bottom: 1px solid var(--purple-100);">
                                    <td style="padding: 0.75rem;">@c.Id</td>
                                    <td style="padding: 0.75rem; font-weight: 500;">
                                        @(c.User != null ? $"{c.User.Nombre} {c.User.Apellido}" : "Sin paciente")
                                    </td>
                                    <td style="padding: 0.75rem;">
                                        @(c.Optometra != null ? c.Optometra.Nombre.Split(' ')[0] : "Por asignar")
                                    </td>
                                    <td style="padding: 0.75rem;">@c.Servicio</td>
                                    <td style="padding: 0.75rem;">@c.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</td>
                                    <td style="padding: 0.75rem; text-align: center;">@c.VecesReprogramada</td>
                                    <td style="padding: 0.75rem;">
                                        @{
                                            var st = c.Estado?.ToLower() ?? "pendiente";
                                            var bg = st == "confirmada" ? "#D1FAE5" : st == "pendiente" ? "#FEF3C7" : st == "completada" ? "#DBEAFE" : "#FEE2E2";
                                            var fg = st == "confirmada" ? "#065F46" : st == "pendiente" ? "#92400E" : st == "completada" ? "#1E40AF" : "#991B1B";
                                        }
                                        <span style="background-color: @bg; color: @fg; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: capitalize;">
                                            @c.Estado
                                        </span>
                                    </td>
                                    <td style="padding: 0.75rem; text-align: right;">
                                        <div style="display: flex; gap: 0.5rem; justify-content: flex-end; flex-wrap: wrap;">
                                            <!-- Botón Ver Cita (Pill) -->
                                            <button style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.75rem; border-radius: 9999px; background-color: #EDE9FE; color: #5B21B6; border: 1px solid #DDD6FE; font-size: 0.8rem; font-weight: 500; cursor: pointer; transition: all 0.2s ease;" title="Ver Detalle"
                                                    data-id="@c.Id"
                                                    data-userid="@c.UserId"
                                                    data-paciente="@(c.User != null ? $"{c.User.Nombre} {c.User.Apellido}" : "")"
                                                    data-optometra="@(c.OptometraId?.ToString() ?? "")"
                                                    data-optometranombre="@(c.Optometra != null ? c.Optometra.Nombre : "Por asignar")"
                                                    data-servicio="@c.Servicio"
                                                    data-fechahora="@c.FechaHora.ToString("yyyy-MM-ddTHH:mm")"
                                                    data-estado="@c.Estado"
                                                    data-notas="@c.Notas"
                                                    data-vecesreprogramada="@c.VecesReprogramada"
                                                    onclick="abrirModalAdminVerCita(this)"
                                                    onmouseover="this.style.backgroundColor='#DDD6FE';" onmouseout="this.style.backgroundColor='#EDE9FE';">
                                                <icon name="eye" class="icon-sm" /> <span>Ver</span>
                                            </button>

                                            <!-- Botón Editar Cita (Pill) -->
                                            <button style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.75rem; border-radius: 9999px; background-color: #DBEAFE; color: #1E40AF; border: 1px solid #BFDBFE; font-size: 0.8rem; font-weight: 500; cursor: pointer; transition: all 0.2s ease;" title="Editar Cita"
                                                    data-id="@c.Id"
                                                    data-userid="@c.UserId"
                                                    data-paciente="@(c.User != null ? $"{c.User.Nombre} {c.User.Apellido}" : "")"
                                                    data-optometra="@(c.OptometraId?.ToString() ?? "")"
                                                    data-optometranombre="@(c.Optometra != null ? c.Optometra.Nombre : "Por asignar")"
                                                    data-servicio="@c.Servicio"
                                                    data-fechahora="@c.FechaHora.ToString("yyyy-MM-ddTHH:mm")"
                                                    data-estado="@c.Estado"
                                                    data-notas="@c.Notas"
                                                    data-vecesreprogramada="@c.VecesReprogramada"
                                                    onclick="abrirModalAdminEditarCita(this)"
                                                    onmouseover="this.style.backgroundColor='#BFDBFE';" onmouseout="this.style.backgroundColor='#DBEAFE';">
                                                <icon name="pencil" class="icon-sm" /> <span>Editar</span>
                                            </button>

                                            <!-- Dropdown para Cambio Rápido de Estado -->
                                            <form asp-action="UpdateAppointmentStatus" method="post" style="display: inline-block; margin: 0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@c.Id" />
                                                <select name="nuevoEstado" onchange="this.form.submit()" style="padding: 0.35rem 0.5rem; border-radius: 9999px; border: 1px solid var(--purple-200); font-size: 0.8rem; cursor: pointer;">
                                                    <option value="" disabled selected>Estado...</option>
                                                    <option value="pendiente">Pendiente</option>
                                                    <option value="confirmada">Confirmada</option>
                                                    <option value="completada">Completada</option>
                                                    <option value="cancelada">Cancelada</option>
                                                </select>
                                            </form>
                                            
                                            <!-- Botón Desactivar Cita (Pill con confirmación Alertify) -->
                                            <form asp-action="DeleteAppointment" method="post" class="form-delete-appointment" style="display: inline-block; margin: 0;" onsubmit="return confirmarDesactivarCita(event, this, '@(c.User != null ? $"{c.User.Nombre} {c.User.Apellido}" : "esta cita")');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@c.Id" />
                                                <button type="submit" style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.75rem; border-radius: 9999px; background-color: #FEE2E2; color: #991B1B; border: 1px solid #FECACA; font-size: 0.8rem; font-weight: 500; cursor: pointer; transition: all 0.2s ease;" title="Desactivar Cita" onmouseover="this.style.backgroundColor='#FCD34D'; this.style.color='#78350F';" onmouseout="this.style.backgroundColor='#FEE2E2'; this.style.color='#991B1B';">
                                                    <icon name="trash-2" class="icon-sm" /> <span>Desactivar</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Citas.Any())
                            {
                                <tr>
                                    <td colspan="8" style="padding: 2rem; text-align: center; color: var(--purple-400);">
                                        No hay citas programadas.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            var auditLog = ViewBag.AuditoriaCitas as IEnumerable<LentSoft.Web.Models.Entities.AuditoriaCita> ?? new List<LentSoft.Web.Models.Entities.AuditoriaCita>();
            <!-- Auditoría de Cambios de Estado (colapsable, solo lectura) -->
            <div style="margin-top: 1.5rem;">
                <button onclick="toggleAuditoria()" style="background: none; border: none; color: var(--purple-700); font-size: 0.9rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0;">
                    <span id="icon-auditoria">&#9654;</span>&nbsp;Historial de auditoría de estados (@auditLog.Count() registros)
                </button>
                <div id="panel-auditoria" style="display: none; margin-top: 0.75rem;">
                    <div class="card" style="padding: 1.25rem; background: white; border-radius: 0.5rem; box-shadow: var(--shadow-sm);">
                        <h3 style="color: var(--purple-800); font-size: 1rem; margin-bottom: 1rem; margin-top: 0;">Últimos 20 cambios de estado</h3>
                        <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-radius: 0.5rem;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
                                <thead style="background-color: var(--purple-50); color: var(--purple-900);">
                                    <tr style="border-bottom: 2px solid var(--purple-200);">
                                        <th style="padding: 0.6rem 0.75rem; text-align: left; font-weight: 700;">ID Cita</th>
                                        <th style="padding: 0.6rem 0.75rem; text-align: left; font-weight: 700;">Estado Anterior</th>
                                        <th style="padding: 0.6rem 0.75rem; text-align: left; font-weight: 700;">Estado Nuevo</th>
                                        <th style="padding: 0.6rem 0.75rem; text-align: left; font-weight: 700;">Fecha Cambio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!auditLog.Any())
                                    {
                                        <tr><td colspan="4" style="padding: 1.5rem; text-align: center; color: var(--purple-400);">No hay registros de auditoría todavía.</td></tr>
                                    }
                                    @foreach (var a in auditLog)
                                    {
                                        <tr style="border-bottom: 1px solid var(--purple-100);">
                                            <td style="padding: 0.6rem 0.75rem; color: var(--gray-500); font-weight: 600;">#CIT-@a.AppointmentId</td>
                                            <td style="padding: 0.6rem 0.75rem;">
                                                @{ var pb = (a.EstadoAnterior ?? "").ToLower(); }
                                                <span style="background-color: @(pb=="confirmada"?"#D1FAE5":pb=="pendiente"?"#FEF3C7":pb=="completada"?"#DBEAFE":"#FEE2E2"); color:@(pb=="confirmada"?"#065F46":pb=="pendiente"?"#92400E":pb=="completada"?"#1E40AF":"#991B1B"); padding:0.2rem 0.5rem; border-radius:9999px; font-size:0.75rem; font-weight:600; text-transform:capitalize;">@(a.EstadoAnterior ?? "—")</span>
                                            </td>
                                            <td style="padding: 0.6rem 0.75rem;">
                                                @{ var nb = (a.EstadoNuevo ?? "").ToLower(); }
                                                <span style="background-color: @(nb=="confirmada"?"#D1FAE5":nb=="pendiente"?"#FEF3C7":nb=="completada"?"#DBEAFE":"#FEE2E2"); color:@(nb=="confirmada"?"#065F46":nb=="pendiente"?"#92400E":nb=="completada"?"#1E40AF":"#991B1B"); padding:0.2rem 0.5rem; border-radius:9999px; font-size:0.75rem; font-weight:600; text-transform:capitalize;">@(a.EstadoNuevo ?? "—")</span>
                                            </td>
                                            <td style="padding: 0.6rem 0.75rem; color: var(--gray-600);">@a.FechaCambio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ==================== SECCIÓN USUARIOS ==================== -->
        @if (Model.ActiveSection == "usuarios")
        {
            var initialTab = string.IsNullOrEmpty(Model.ActiveSubTab) ? "clientes" : Model.ActiveSubTab;
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h1 style="color: var(--purple-900); margin: 0; font-size: 1.75rem;" data-i18n="admin.users.title">Gestión de Usuarios</h1>
                
                <div id="top-btn-clientes" style="display: @(initialTab == "clientes" ? "inline-block" : "none");">
                    <button class="btn btn-primary" onclick="document.getElementById('modal-crear-cliente').style.display='flex'">
                        + Nuevo Cliente
                    </button>
                </div>
                <div id="top-btn-trabajadores" style="display: @(initialTab == "trabajadores" ? "inline-block" : "none");">
                    <button class="btn btn-primary" onclick="document.getElementById('modal-crear-trabajador').style.display='flex'">
                        + Nuevo Trabajador
                    </button>
                </div>
            </div>

            <!-- Sub-tabs -->
            <div style="display: flex; border-bottom: 2px solid var(--purple-200); margin-bottom: 1.5rem;">
                <button id="nav-subtab-clientes" type="button" onclick="switchUsersSubTab('clientes')" style="padding: 0.75rem 1.5rem; font-weight: 600; background: none; border: none; cursor: pointer; color: @(initialTab == "clientes" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(initialTab == "clientes" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px; display: inline-flex; align-items: center; gap: 0.4rem;">
                    <icon name="users" class="icon-sm" /> <span>Clientes</span>
                </button>
                <button id="nav-subtab-trabajadores" type="button" onclick="switchUsersSubTab('trabajadores')" style="padding: 0.75rem 1.5rem; font-weight: 600; background: none; border: none; cursor: pointer; color: @(initialTab == "trabajadores" ? "var(--purple-700)" : "var(--gray-500)"); border-bottom: @(initialTab == "trabajadores" ? "3px solid var(--purple-600)" : "none"); margin-bottom: -2px; display: inline-flex; align-items: center; gap: 0.4rem;">
                    <icon name="briefcase" class="icon-sm" /> <span>Trabajadores</span>
                </button>
            </div>

            <!-- CONTENIDO PESTAÑA CLIENTES -->
            <div id="subtab-content-clientes" style="display: @(initialTab == "clientes" ? "block" : "none");">
                <div class="card" style="padding: 1.5rem; background: white;">
                    <div style="background-color: var(--purple-900); color: white; padding: 0.85rem 1.25rem; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                        <form method="get" style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin: 0;">
                            <input type="hidden" name="section" value="usuarios" />
                            <input type="hidden" name="subtab" value="clientes" />
                            <div style="position: relative; display: flex; align-items: center;">
                                <span style="position: absolute; left: 0.75rem; color: var(--purple-600); font-size: 0.9rem; pointer-events: none; display: flex; align-items: center;"><icon name="search" class="icon-sm" /></span>
                                <input type="text" name="searchTerm" value="@Model.ClientesSearchTerm" placeholder="Buscar cliente por nombre o correo..." class="form-input" style="width: 320px; padding: 0.45rem 0.75rem 0.45rem 2.25rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); background: white; color: var(--gray-900); font-size: 0.85rem;" />
                            </div>
                            <button type="submit" class="btn" style="background-color: var(--purple-600); color: white; border: none; padding: 0.45rem 0.9rem; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='var(--purple-700)';" onmouseout="this.style.backgroundColor='var(--purple-600)';">
                                Buscar
                            </button>
                            @if (!string.IsNullOrWhiteSpace(Model.ClientesSearchTerm))
                            {
                                <a href="?section=usuarios&subtab=clientes" class="btn" style="padding: 0.45rem 0.85rem; font-size: 0.85rem; background: rgba(255,255,255,0.2); color: white; text-decoration: none; border-radius: 0.375rem; font-weight: 500;">
                                    Limpiar
                                </a>
                            }
                        </form>
                        <span style="font-size: 0.85rem; color: var(--purple-200); font-weight: 500;">
                            Total: <strong style="color: white;">@Model.ClientesTotalCount</strong> cliente(s)
                        </span>
                    </div>

                    <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-top: none; border-bottom-left-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                        <table id="tableClientes" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead style="background-color: var(--purple-50); color: var(--purple-900);">
                                <tr style="border-bottom: 2px solid var(--purple-200);">
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">ID</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Nombre Completo</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Documento</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Correo</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Teléfono</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem;">Fecha Registro</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem; text-align: center;">Estado</th>
                                    <th style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.85rem; text-align: center;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Clientes.Any())
                                {
                                    foreach (var cli in Model.Clientes)
                                    {
                                        <tr style="border-bottom: 1px solid var(--purple-100); transition: background-color 0.15s ease;" onmouseover="this.style.backgroundColor='var(--purple-50)';" onmouseout="this.style.backgroundColor='transparent';">
                                            <td style="padding: 0.75rem 1rem; color: var(--gray-500);">#@cli.Id</td>
                                            <td style="padding: 0.75rem 1rem; font-weight: 600; color: var(--purple-900);">@cli.NombreCompleto</td>
                                            <td style="padding: 0.75rem 1rem; color: var(--gray-600);">@cli.TipoDocumento @cli.NumeroDocumento</td>
                                            <td style="padding: 0.75rem 1rem; color: var(--gray-600);">@cli.Email</td>
                                            <td style="padding: 0.75rem 1rem; color: var(--gray-600);">@(string.IsNullOrWhiteSpace(cli.Telefono) ? "—" : cli.Telefono)</td>
                                            <td style="padding: 0.75rem 1rem; color: var(--gray-600); font-size: 0.85rem;">@cli.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                            <td style="padding: 0.75rem 1rem; text-align: center;">
                                                <span style="background-color: @(cli.Activo ? "var(--success)" : "var(--error)"); color: white; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                                                    @(cli.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td style="padding: 0.75rem 1rem; text-align: center;">
                                                <div class="table-actions-wrapper" style="justify-content: center;">
                                                    <button type="button" class="btn-action-edit btn-edit-client" aria-label="Editar"
                                                        data-record='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { id = cli.Id, nombre = cli.Nombre, apellido = cli.Apellido, email = cli.Email, telefono = cli.Telefono ?? "", tipoDocumento = cli.TipoDocumento, numeroDocumento = cli.NumeroDocumento }))'>
                                                        <icon name="pencil" class="icon-sm" /> <span>Editar</span>
                                                    </button>
                                                    @if (cli.Activo)
                                                    {
                                                        <form asp-controller="User" asp-action="Delete" asp-route-id="@cli.Id" method="post" style="display:inline;" class="form-delete-client" data-nombre="@cli.NombreCompleto">
                                                            <button type="submit" class="btn-action-delete" aria-label="Desactivar"><icon name="trash-2" class="icon-sm" /> <span>Desactivar</span></button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form asp-controller="User" asp-action="ReactivateUser" asp-route-id="@cli.Id" method="post" style="display:inline;">
                                                            <button type="submit" style="background-color: var(--success); color: white; border: none; padding: 6px 16px; border-radius: 9999px; font-weight: 700; font-size: 0.85rem; cursor: pointer; line-height: 1.2; display: inline-flex; align-items: center; gap: 0.35rem;">
                                                                <icon name="check-circle" class="icon-sm" /> <span>Reactivar</span>
                                                            </button>
                                                        </form>
