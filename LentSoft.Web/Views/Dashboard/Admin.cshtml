<script>
    function addPurchaseOrderItemRow() {
        const body = document.getElementById('poItemsBody');
        const firstRow = body.firstElementChild;
        if (!firstRow) return;
        const newRow = firstRow.cloneNode(true);
        newRow.querySelector('select').value = '';
        newRow.querySelector('input[type="number"][name="cantidades"]').value = '1';
        newRow.querySelector('input[type="number"][name="costos"]').value = '0.00';
        body.appendChild(newRow);
    }

    async function openRecibirPedidoModal(orderId) {
        document.getElementById('recibirOrderId').value = orderId;
        const modal = document.getElementById('modal-recibir-pedido');
        const infoDiv = document.getElementById('recibirInfoContainer');
        const body = document.getElementById('recibirItemsBody');
        const btnGuardar = document.getElementById('btnGuardarRecepcion');
        const btnParcial = document.getElementById('btnGuardarRecepcionParcial');
        const actionPanel = document.getElementById('recibirActionPanel');

        infoDiv.innerHTML = 'Cargando detalles del pedido...';
        body.innerHTML = '<tr><td colspan="5" style="padding:1rem; text-align:center;">Cargando...</td></tr>';
        modal.style.display = 'flex';

        try {
            const resp = await fetch('/SupplierOrder/DetalleJson?id=' + orderId);
            if (!resp.ok) throw new Error('Error al consultar datos');
            const res = await resp.json();
            if (!res.success) throw new Error(res.message || 'Error');
            const o = res.data;

            const estOrder = (o.estado || '').toLowerCase();
            const orderChip = (estOrder === 'recibido' || estOrder === 'entregado' || estOrder === 'pagado')
                ? 'inv-chip-success'
                : (estOrder === 'cancelado' ? 'inv-chip-error' : 'inv-chip-warning');
            const orderLabel = o.estado ? (o.estado.charAt(0).toUpperCase() + o.estado.slice(1).toLowerCase()) : '';

            document.getElementById('recibirModalTitle').innerText = 'Recepción de Pedido - ' + o.numeroPedido;
            infoDiv.innerHTML = `
                <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                    <div><strong>Proveedor:</strong> ${o.supplierNombre} (${o.supplierContacto}) | <strong>Tel:</strong> ${o.supplierTelefono}</div>
                    <div><strong>Fecha:</strong> ${o.fecha} | <strong>Estado:</strong> <span class="inv-chip ${orderChip}">${orderLabel}</span></div>
                </div>
                <div style="margin-top: 0.35rem; font-size: 0.825rem; color: var(--gray-600);">
                    <strong>Dirección:</strong> ${o.supplierDireccion} | <strong>Entrega Estimada:</strong> ${o.supplierTiempoEntrega ? o.supplierTiempoEntrega + ' días' : 'No especificada'}
                </div>
            `;

            const pendiente = o.pendiente;
            body.innerHTML = `
                <tr>
                    <td style="font-weight: 600;">
                        ${o.productNombre}
                        <div style="font-size: 0.75rem; color: var(--gray-500);">SKU: ${o.productSku}</div>
                    </td>
                    <td style="text-align: right;">$${Number(o.precioUnitario).toLocaleString('es-CO')}</td>
                    <td style="text-align: center; font-weight: 600;">${o.cantidad}</td>
                    <td style="text-align: center; color: var(--purple-700); font-weight: 600;">${o.cantidadRecibida}</td>
                    <td style="text-align: center;">
                        <span class="inv-chip ${pendiente > 0 ? 'inv-chip-warning' : 'inv-chip-success'}">${pendiente}</span>
                    </td>
                </tr>
            `;

            const inputParcial = document.getElementById('recibirCantidadInput');
            if (inputParcial) {
                inputParcial.max = pendiente;
                inputParcial.value = pendiente > 0 ? pendiente : 0;
                inputParcial.disabled = pendiente <= 0;
            }

            if (btnGuardar) btnGuardar.disabled = pendiente <= 0;
            if (btnParcial) btnParcial.disabled = pendiente <= 0;
            if (actionPanel) actionPanel.style.display = pendiente <= 0 ? 'none' : 'block';
        } catch (e) {
            infoDiv.innerHTML = `<span style="color:var(--error); font-weight:600;">Error al cargar detalles: ${e.message}</span>`;
            body.innerHTML = '';
        }
    }

    async function confirmarRecepcionTotal() {
        const orderId = document.getElementById('recibirOrderId').value;
        if (!orderId) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        try {
            const resp = await fetch('/SupplierOrder/Recibir', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({ id: orderId, __RequestVerificationToken: token })
            });
            const res = await resp.json();
            if (res.success) {
                showToast(res.message, 'success');
                document.getElementById('modal-recibir-pedido').style.display = 'none';
                setTimeout(() => window.location.reload(), 800);
            } else {
                showToast(res.message || 'Error al recibir el pedido', 'error');
            }
        } catch (err) {
            showToast('Error de comunicación con el servidor', 'error');
        }
    }

    async function confirmarRecepcionParcial() {
        const orderId = document.getElementById('recibirOrderId').value;
        const cantInput = document.getElementById('recibirCantidadInput');
        const cant = parseInt(cantInput?.value || '0', 10);
        if (!orderId || isNaN(cant) || cant <= 0) {
            showToast('Ingrese una cantidad válida mayor a 0', 'warning');
            return;
        }
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        try {
            const resp = await fetch('/SupplierOrder/RecibirParcial', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({ id: orderId, cantidadRecibida: cant, __RequestVerificationToken: token })
            });
            const res = await resp.json();
            if (res.success) {
                showToast(res.message, 'success');
                document.getElementById('modal-recibir-pedido').style.display = 'none';
                setTimeout(() => window.location.reload(), 800);
            } else {
                showToast(res.message || 'Error al registrar recepción parcial', 'error');
            }
        } catch (err) {
            showToast('Error de comunicación con el servidor', 'error');
        }
    }

    async function abrirFichaProveedor(supplierId) {
        const modal = document.getElementById('modal-ficha-proveedor');
        if (!modal) return;
        modal.style.display = 'flex';
        
        const infoDiv = document.getElementById('ficha-proveedor-header');
        const prodsBody = document.getElementById('ficha-productos-body');
        const ordersBody = document.getElementById('ficha-pedidos-body');

        infoDiv.innerHTML = '<div style="padding:1rem; text-align:center;">Cargando ficha del proveedor...</div>';
        prodsBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:1rem;">Cargando productos...</td></tr>';
        ordersBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:1rem;">Cargando historial de pedidos...</td></tr>';

        try {
            const resp = await fetch('/Supplier/FichaProveedor?id=' + encodeURIComponent(supplierId));
            const res = await resp.json();
            if (!res.success) throw new Error(res.message || 'No se pudo cargar la información');
            const s = res.supplier;

            infoDiv.innerHTML = `
                <div style="display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap;">
                    ${s.logoUrl ? `<img src="${s.logoUrl}" style="width: 60px; height: 60px; object-fit: contain; border-radius: 8px; border: 1px solid var(--purple-200); background: white;" />` : `<div style="width: 60px; height: 60px; border-radius: 8px; background: var(--purple-100); color: var(--purple-800); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: bold;">${s.nombre.charAt(0)}</div>`}
                    <div style="flex: 1; min-width: 200px;">
                        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                            <h3 style="margin: 0; font-size: 1.2rem; color: var(--purple-900);">${s.nombre}</h3>
                            <span class="inv-chip ${s.activo ? 'inv-chip-success' : 'inv-chip-error'}">${s.activo ? 'Activo' : 'Inactivo'}</span>
                        </div>
                        <div style="font-size: 0.85rem; color: var(--gray-600); margin-top: 0.25rem;">
                            <strong>Código:</strong> ${s.id} | <strong>Tipo:</strong> ${s.tipoProductos}
                        </div>
                        <div style="font-size: 0.85rem; color: var(--gray-600); margin-top: 0.15rem;">
                            <strong>Contacto:</strong> ${s.contacto || 'N/A'} | <strong>Teléfono:</strong> ${s.telefono} | <strong>Email:</strong> ${s.correo}
                        </div>
                        <div style="font-size: 0.85rem; color: var(--gray-600); margin-top: 0.15rem;">
                            <strong>Dirección:</strong> ${s.direccion || 'No registrada'} | <strong>Entrega Estimada:</strong> ${s.tiempoEntregaDias ? s.tiempoEntregaDias + ' días hábiles' : 'No especificado'}
                        </div>
                    </div>
                </div>
            `;

            if (!res.productos || res.productos.length === 0) {
                prodsBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:1rem; color:var(--gray-500);">Este proveedor no tiene productos vinculados en el inventario.</td></tr>';
            } else {
                prodsBody.innerHTML = res.productos.map(p => `
                    <tr>
                        <td style="font-weight: 600; color: var(--purple-900);">${p.nombre}</td>
                        <td style="font-size: 0.8rem; color: var(--gray-600);">${p.sku || '-'}</td>
                        <td><span class="inv-chip inv-chip-purple">${p.categoria}</span></td>
                        <td style="text-align: right; font-weight: 600;">$${Number(p.precio).toLocaleString('es-CO')}</td>
                        <td style="text-align: center;">
                            <span class="inv-chip ${p.stock === 0 ? 'inv-chip-error' : (p.stock <= 10 ? 'inv-chip-warning' : 'inv-chip-success')}">${p.stock}</span>
                        </td>
                    </tr>
                `).join('');
            }

            if (!res.pedidos || res.pedidos.length === 0) {
                ordersBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:1rem; color:var(--gray-500);">No se registran órdenes de compra para este proveedor.</td></tr>';
            } else {
                ordersBody.innerHTML = res.pedidos.map(o => {
                    const est = (o.estado || '').toLowerCase();
                    const chip = (est === 'recibido' || est === 'entregado' || est === 'pagado') ? 'inv-chip-success' : (est === 'cancelado' ? 'inv-chip-error' : 'inv-chip-warning');
                    const estLabel = o.estado ? (o.estado.charAt(0).toUpperCase() + o.estado.slice(1).toLowerCase()) : '';
                    return `
                        <tr>
                            <td style="font-weight: 700; color: var(--purple-900);">${o.numeroPedido}</td>
                            <td style="font-size: 0.8rem; color: var(--gray-600);">${o.fecha}</td>
                            <td style="font-weight: 500;">${o.producto}</td>
                            <td style="text-align: center; font-weight: 600;">${o.cantidadRecibida} / ${o.cantidad}</td>
                            <td style="text-align: right; font-weight: 700;">$${Number(o.total).toLocaleString('es-CO')}</td>
                            <td style="text-align: center;"><span class="inv-chip ${chip}">${estLabel}</span></td>
                        </tr>
                    `;
                }).join('');
            }
        } catch (err) {
            infoDiv.innerHTML = `<span style="color:var(--error); font-weight:600;">Error: ${err.message}</span>`;
        }
    }

    function validateCitaForm(form) {
        const input = form.querySelector('input[type="datetime-local"]');
        if (!input) return true;
        const datetimeVal = input.value;
        if (!datetimeVal) return true;
        
        const dt = new Date(datetimeVal);
        if (dt.getDay() === 0) {
            if (typeof alertify !== 'undefined') {
                alertify.error("Las citas solo pueden agendarse de lunes a sábado.");
            } else {
                alert("Las citas solo pueden agendarse de lunes a sábado.");
            }
            return false;
        }
        
        const hours = dt.getHours();
        const minutes = dt.getMinutes();
        const decimalHour = hours + minutes / 60.0;
        if (decimalHour < 8.0 || (decimalHour + 1.0) > 18.0) {
            if (typeof alertify !== 'undefined') {
                alertify.error("El horario de citas es de 8:00 a.m. a 6:00 p.m.");
            } else {
                alert("El horario de citas es de 8:00 a.m. a 6:00 p.m.");
            }
            return false;
        }
        return true;
    }

    // Funciones específicas para Citas en Admin
    function filterAdminCitasByEstado(estado, btn) {
        document.querySelectorAll('#admin-citas-filters .filter-tab').forEach(b => b.classList.remove('active', 'selected-tab'));
        document.querySelectorAll('#admin-citas-filters .filter-tab').forEach(b => {
            b.style.backgroundColor = 'var(--purple-50)';
            b.style.color = 'var(--purple-700)';
            b.style.border = '1px solid var(--purple-200)';
        });
        
        btn.classList.add('active', 'selected-tab');
        btn.style.backgroundColor = 'var(--purple-600)';
        btn.style.color = 'white';
        btn.style.border = 'none';

        window.currentAdminCitaEstado = estado.toLowerCase();
        filterAdminCitasCombo();
    }

    function filterAdminCitasCombo() {
        var input = document.getElementById("searchAdminCitas");
        var filter = input.value.toLowerCase();
        var table = document.getElementById("tableAdminCitas");
        if (!table) return;
        var tr = table.getElementsByTagName("tbody")[0].getElementsByTagName("tr");
        var targetEstado = window.currentAdminCitaEstado || 'todos';

        for (var i = 0; i < tr.length; i++) {
            if (tr[i].getElementsByTagName("td").length > 1) {
                var textContent = tr[i].textContent || tr[i].innerText;
                var rowEstado = tr[i].getAttribute("data-estado");
                var matchText = textContent.toLowerCase().indexOf(filter) > -1;
                var matchEstado = (targetEstado === 'todos' || rowEstado === targetEstado);
                
                if (matchText && matchEstado) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }

    function abrirModalAdminVerCita(btn) {
        const pacEl = document.getElementById('admin-ver-cita-paciente');
        if (pacEl) pacEl.textContent = btn.getAttribute('data-paciente') || 'Sin paciente';
        
        const optEl = document.getElementById('admin-ver-cita-optometra');
        if (optEl) optEl.textContent = btn.getAttribute('data-optometranombre') || 'Por asignar';
        
        const srvEl = document.getElementById('admin-ver-cita-servicio');
        if (srvEl) srvEl.textContent = btn.getAttribute('data-servicio') || '-';
        
        const rawDate = btn.getAttribute('data-fechahora');
        const fechaEl = document.getElementById('admin-ver-cita-fecha');
        if (fechaEl) {
            if (rawDate) {
                const dateObj = new Date(rawDate);
                fechaEl.textContent = isNaN(dateObj) ? rawDate : dateObj.toLocaleString();
            } else {
                fechaEl.textContent = '-';
            }
        }
        
        const estSpan = document.getElementById('admin-ver-cita-estado');
        if (estSpan) {
            const statusVal = (btn.getAttribute('data-estado') || '').toLowerCase();
            estSpan.textContent = (btn.getAttribute('data-estado') || '').toUpperCase();
            if (statusVal === 'confirmada' || statusVal === 'completada') {
                estSpan.style.color = '#065F46';
                estSpan.style.backgroundColor = '#D1FAE5';
            } else if (statusVal === 'pendiente') {
                estSpan.style.color = '#92400E';
                estSpan.style.backgroundColor = '#FEF3C7';
            } else {
                estSpan.style.color = '#991B1B';
                estSpan.style.backgroundColor = '#FEE2E2';
            }
        }

        const repEl = document.getElementById('admin-ver-cita-reprog');
        if (repEl) repEl.textContent = btn.getAttribute('data-vecesreprogramada') || '0';

        const notEl = document.getElementById('admin-ver-cita-notas');
        if (notEl) notEl.textContent = btn.getAttribute('data-notas') || 'Ninguna';

        window.currentAdminCitaBtn = btn;
        const modal = document.getElementById('modal-admin-ver-cita');
        if (modal) modal.style.display = 'flex';
    }

    function abrirModalAdminEditarCitaDesdeVer() {
        const verModal = document.getElementById('modal-admin-ver-cita');
        if (verModal) verModal.style.display = 'none';

        if (window.currentAdminCitaBtn) {
            const btn = window.currentAdminCitaBtn;
            const elId = document.getElementById('admin-edit-cita-id');
            if (elId) elId.value = btn.getAttribute('data-id') || '';

            const elUser = document.getElementById('admin-edit-cita-userid');
            if (elUser) elUser.value = btn.getAttribute('data-userid') || '';

            const elPac = document.getElementById('admin-edit-cita-paciente-nombre');
            if (elPac) elPac.value = btn.getAttribute('data-paciente') || '';

            const elSrv = document.getElementById('admin-edit-cita-servicio');
            if (elSrv) elSrv.value = btn.getAttribute('data-servicio') || 'Consulta General';

            const elFecha = document.getElementById('admin-edit-cita-fechahora');
            if (elFecha) elFecha.value = btn.getAttribute('data-fechahora') || '';

            const elNotas = document.getElementById('admin-edit-cita-notas');
            if (elNotas) elNotas.value = btn.getAttribute('data-notas') || '';

            const elOpt = document.getElementById('admin-edit-cita-optometraid');
            if (elOpt) elOpt.value = btn.getAttribute('data-optometra') || '';
        }
        const editModal = document.getElementById('modal-admin-editar-cita');
        if (editModal) editModal.style.display = 'flex';
    }

    function abrirModalAdminEditarCita(btn) {
        window.currentAdminCitaBtn = btn;
        abrirModalAdminEditarCitaDesdeVer();
    }

    function confirmarDesactivarCita(e, form, pacienteNombre) {
        e.preventDefault();
        const msg = '¿Deseas desactivar la cita de ' + pacienteNombre + '? El registro no se eliminará, solo se desactivará.';
        if (typeof alertify !== 'undefined') {
            alertify.confirm('Confirmar Desactivación', msg,
                function () { form.submit(); },
                function () { showToast('Acción cancelada', 'info'); }
            ).set('labels', { ok: 'Sí, desactivar', cancel: 'Cancelar' });
        } else if (confirm(msg)) {
            form.submit();
        }
        return false;
    }

    function toggleAuditoria() {
        const panel = document.getElementById('panel-auditoria');
        const icon = document.getElementById('icon-auditoria');
        if (!panel) return;
        if (panel.style.display === 'none' || !panel.style.display) {
            panel.style.display = 'block';
            if (icon) icon.innerHTML = '&#9660;';
        } else {
            panel.style.display = 'none';
            if (icon) icon.innerHTML = '&#9654;';
        }
    }

</script>
