                <input id="editSupplierTelefono" name="Telefono" type="text" class="form-input" required style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
            </div>

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Correo Electrónico *</label>
                <input id="editSupplierCorreo" name="Correo" type="email" class="form-input" required style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem;">
                <button type="button" onclick="document.getElementById('modal-editar-proveedor').style.display='none'" style="background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-300); padding: 0.5rem 1rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" style="background: var(--purple-600); color: white; border: none; padding: 0.5rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Actualizar Proveedor</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal para Nuevo Movimiento de Inventario -->
<div id="modal-nuevo-movimiento" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div class="card" style="width: 100%; max-width: 500px; max-height: 90vh; overflow-y: auto; background: white; border-radius: 0.75rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--purple-100);">
            <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem; font-weight: 700;">+ Registrar Movimiento de Inventario</h2>
            <button onclick="document.getElementById('modal-nuevo-movimiento').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
        </div>
        
        <form asp-controller="InventoryMovement" asp-action="Create" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <div>
                <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem;">Producto *</label>
                <select name="ProductId" class="form-input" required style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                    <option value="">-- Seleccionar Producto --</option>
                    @foreach (var prod in Model.Productos)
                    {
                        <option value="@prod.Id">@prod.Nombre (Stock actual: @prod.Stock)</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem;">Bodega *</label>
                <select name="WarehouseId" class="form-input" required style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                    @foreach (var bod in Model.Bodegas)
                    {
                        <option value="@bod.Id">@bod.Nombre</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem;">Tipo de Movimiento *</label>
                <select name="Tipo" class="form-input" required style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                    <option value="Entrada" selected>Entrada (Sumar a Stock)</option>
                    <option value="Salida">Salida (Restar de Stock)</option>
                </select>
            </div>

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem;">Cantidad *</label>
                <input name="Cantidad" type="number" min="1" value="1" class="form-input" required style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
            </div>

            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Responsable (Opcional)</label>
                <input name="Responsable" type="text" class="form-input" placeholder="Nombre de quien realiza el movimiento" value="@(User.Identity?.Name ?? "Administrador")" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem;">
                <button type="button" onclick="document.getElementById('modal-nuevo-movimiento').style.display='none'" style="background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-300); padding: 0.5rem 1rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" style="background: var(--purple-600); color: white; border: none; padding: 0.5rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Guardar Movimiento</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal para Nuevo Pedido a Proveedor -->
<div id="modal-nuevo-pedido-proveedor" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div class="card" style="width: 100%; max-width: 700px; max-height: 90vh; overflow-y: auto; background: white; border-radius: 0.75rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--purple-100);">
            <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem; font-weight: 700;">+ Nuevo Pedido a Proveedor</h2>
            <button onclick="document.getElementById('modal-nuevo-pedido-proveedor').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
        </div>
        
        <form asp-controller="PurchaseOrder" asp-action="Create" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div>
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem;">Proveedor *</label>
                    <select name="supplierId" class="form-input" required style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                        <option value="">-- Seleccionar Proveedor --</option>
                        @foreach (var prov in Model.Proveedores)
                        {
                            <option value="@prov.Id">@prov.Nombre (@prov.Id)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem;">Fecha Estimada Entrega</label>
                    <input name="fechaEstimadaEntrega" type="date" class="form-input" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
                </div>
            </div>

            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <label class="form-label" style="font-weight: 600; color: var(--purple-900); font-size: 0.85rem; margin: 0;">Ítems del Pedido *</label>
                    <button type="button" onclick="addPurchaseOrderItemRow()" style="background: var(--purple-100); color: var(--purple-700); border: 1px solid var(--purple-300); padding: 0.25rem 0.6rem; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; cursor: pointer;">+ Agregar Producto</button>
                </div>

                <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-radius: 0.375rem;">
                    <table id="tablePurchaseOrderItems" style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
                        <thead>
                            <tr style="background: var(--purple-50); border-bottom: 1px solid var(--purple-200);">
                                <th style="padding: 0.5rem;">Producto</th>
                                <th style="padding: 0.5rem; width: 100px;">Cantidad</th>
                                <th style="padding: 0.5rem; width: 120px;">Costo Unit.</th>
                                <th style="padding: 0.5rem; width: 40px;"></th>
                            </tr>
                        </thead>
                        <tbody id="poItemsBody">
                            <tr>
                                <td style="padding: 0.5rem;">
                                    <select name="productIds" class="form-input" required style="width: 100%; padding: 0.35rem; font-size: 0.85rem;">
                                        <option value="">-- Seleccionar --</option>
                                        @foreach (var prod in Model.Productos)
                                        {
                                            <option value="@prod.Id">@prod.Nombre</option>
                                        }
                                    </select>
                                </td>
                                <td style="padding: 0.5rem;">
                                    <input name="cantidades" type="number" min="1" value="1" required style="width: 100%; padding: 0.35rem; font-size: 0.85rem;" />
                                </td>
                                <td style="padding: 0.5rem;">
                                    <input name="costos" type="number" step="0.01" min="0" value="0.00" required style="width: 100%; padding: 0.35rem; font-size: 0.85rem;" />
                                </td>
                                <td style="padding: 0.5rem; text-align: center;">
                                    <button type="button" onclick="this.closest('tr').remove()" style="background: none; border: none; color: var(--error); cursor: pointer; font-size: 1rem;">&times;</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem;">
                <button type="button" onclick="document.getElementById('modal-nuevo-pedido-proveedor').style.display='none'" style="background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-300); padding: 0.5rem 1rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" style="background: var(--purple-600); color: white; border: none; padding: 0.5rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Crear Pedido</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal para Ver / Recibir Pedido a Proveedor -->
<div id="modal-recibir-pedido" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div class="card" style="width: 100%; max-width: 700px; max-height: 90vh; overflow-y: auto; background: white; border-radius: 0.75rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--purple-100);">
            <h2 id="recibirModalTitle" style="color: var(--purple-900); margin: 0; font-size: 1.25rem; font-weight: 700;">Detalle y Recepción de Pedido</h2>
            <button onclick="document.getElementById('modal-recibir-pedido').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
        </div>

        <form asp-controller="PurchaseOrder" asp-action="Recibir" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="recibirOrderId" name="id" value="0" />

            <div id="recibirInfoContainer" style="background: var(--purple-50); padding: 0.75rem 1rem; border-radius: 0.375rem; font-size: 0.9rem; color: var(--purple-900);">
                <!-- Se llena con JS -->
            </div>

            <div style="overflow-x: auto; border: 1px solid var(--purple-200); border-radius: 0.375rem;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
                    <thead>
                        <tr style="background: var(--purple-50); border-bottom: 1px solid var(--purple-200);">
                            <th style="padding: 0.6rem;">Producto</th>
                            <th style="padding: 0.6rem;">Costo Unit.</th>
                            <th style="padding: 0.6rem;">Solicitado</th>
                            <th style="padding: 0.6rem; width: 140px;">Cant. Recibida</th>
                        </tr>
                    </thead>
                    <tbody id="recibirItemsBody">
                        <!-- Se llena con JS -->
                    </tbody>
                </table>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem;">
                <button type="button" onclick="document.getElementById('modal-recibir-pedido').style.display='none'" style="background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-300); padding: 0.5rem 1rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Cerrar</button>
                <button type="submit" id="btnGuardarRecepcion" style="background: var(--purple-600); color: white; border: none; padding: 0.5rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Guardar Recepción</button>
            </div>
        </form>
    </div>
</div>

<script>
    function addPurchaseOrderItemRow() {
        const body = document.getElementById('poItemsBody');
        const firstRow = body.firstElementChild;
        if (!firstRow) return;
        const newRow = firstRow.cloneNode(true);
        newRow.querySelector('select').value = '';
        newRow.querySelector('input[type="number"][name="cantidades"]').value = '1';
        newRow.querySelector('input[type="number"][name="costos"]').value = '0.00';
        body.appendChild(newRow);
    }

    async function openRecibirPedidoModal(orderId) {
        document.getElementById('recibirOrderId').value = orderId;
        document.getElementById('recibirModalTitle').innerText = 'Detalle y Recepción del Pedido #PED-' + String(orderId).padStart(4, '0');
        
        const infoDiv = document.getElementById('recibirInfoContainer');
        const body = document.getElementById('recibirItemsBody');
        infoDiv.innerHTML = 'Cargando detalles...';
        body.innerHTML = '<tr><td colspan="4" style="padding:1rem; text-align:center;">Cargando...</td></tr>';
        
        document.getElementById('modal-recibir-pedido').style.display = 'flex';

        try {
            const resp = await fetch('/PurchaseOrder/Details/' + orderId);
            if (!resp.ok) throw new Error('Error al cargar datos');
            const data = await resp.json();

            infoDiv.innerHTML = `<strong>Proveedor:</strong> ${data.supplierNombre} | <strong>Fecha:</strong> ${data.fechaPedido} | <strong>Estado:</strong> <span style="font-weight:bold; color:var(--purple-700);">${data.estado}</span> | <strong>Total:</strong> $${data.total.toFixed(2)}`;

            let html = '';
            data.items.forEach(item => {
                const isDisabled = data.estado === 'Cancelado';
                html += `
                    <tr style="border-bottom: 1px solid var(--purple-100);">
                        <td style="padding: 0.6rem; font-weight: 500;">
                            ${item.productoNombre}
                            <input type="hidden" name="itemIds" value="${item.id}" />
                        </td>
                        <td style="padding: 0.6rem;">$${item.costoUnitario.toFixed(2)}</td>
                        <td style="padding: 0.6rem; font-weight: bold;">${item.cantidadSolicitada}</td>
                        <td style="padding: 0.6rem;">
                            <input type="number" name="cantidadesRecibidas" min="${item.cantidadRecibida}" max="${item.cantidadSolicitada * 2}" value="${item.cantidadRecibida}" ${isDisabled ? 'disabled' : ''} class="form-input" style="width: 100%; padding: 0.3rem;" />
                        </td>
                    </tr>
                `;
            });
            body.innerHTML = html;
            document.getElementById('btnGuardarRecepcion').style.display = data.estado === 'Cancelado' ? 'none' : 'block';
        } catch (e) {
            infoDiv.innerHTML = '<span style="color:var(--error);">Error al cargar los detalles del pedido.</span>';
            body.innerHTML = '';
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

