                <textarea name="Notas" id="admin-edit-cita-notas" class="form-input" rows="2" placeholder="Notas clínicas o motivos de reprogramación..." style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300); resize: vertical;"></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-admin-editar-cita').style.display='none'" style="background: var(--gray-100); color: var(--gray-700); border: 1px solid var(--gray-300); padding: 0.6rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;">Cancelar</button>
                <button type="submit" style="background: var(--purple-600); color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;">
                    <icon name="save" class="icon-sm" /> <span>Guardar Cambios</span>
