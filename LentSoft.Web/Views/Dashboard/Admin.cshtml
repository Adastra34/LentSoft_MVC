            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Notas</label>
                <textarea id="editSupplierOrderNotas" name="Notas" class="form-input" rows="2" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);"></textarea>
