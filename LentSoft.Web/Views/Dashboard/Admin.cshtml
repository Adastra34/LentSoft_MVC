@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script>
        function showToast(msg, type = 'info') {
            if (typeof alertify !== 'undefined') {
                if (type === 'success') alertify.success(msg);
                else if (type === 'error') alertify.error(msg);
                else alertify.message(msg);
            } else {
                alert(msg);
            }
        }

        function switchInventorySubTab(subtabName) {
            const tabs = ['productos', 'proveedores', 'historial', 'pedidos'];
            tabs.forEach(t => {
                const content = document.getElementById('subtab-content-' + t);
                const btnNav = document.getElementById('nav-subtab-' + t);
                const topBtn = document.getElementById('top-btn-' + t);

                if (t === subtabName) {
                    if (content) content.style.display = 'block';
                    if (btnNav) {
                        btnNav.style.color = 'var(--purple-700)';
                        btnNav.style.borderBottom = '3px solid var(--purple-600)';
                    }
                    if (topBtn) topBtn.style.display = 'inline-block';
                } else {
                    if (content) content.style.display = 'none';
                    if (btnNav) {
                        btnNav.style.color = 'var(--gray-500)';
                        btnNav.style.borderBottom = 'none';
                    }
                    if (topBtn) topBtn.style.display = 'none';
                }
            });

            if (window.history && window.history.pushState) {
                const newUrl = '?section=inventario&subtab=' + subtabName;
                window.history.pushState({ path: newUrl }, '', newUrl);
            }
        }

        async function toggleProductStatus(id, btnElem) {
            try {
                const res = await fetch('/Product/ToggleStatus/' + id, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                if (data.success) {
                    btnElem.innerText = data.active ? 'Activo' : 'Inactivo';
                    btnElem.style.backgroundColor = data.active ? 'var(--success)' : 'var(--error)';
                    showToast(data.message, 'success');
                } else {
                    showToast(data.message || 'Error al cambiar estado', 'error');
                }
            } catch (e) {
                showToast('Error de comunicación con el servidor', 'error');
            }
        }

        async function toggleSupplierStatus(id, btnElem) {
            try {
                const res = await fetch('/Supplier/ToggleStatus/' + id, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                if (data.success) {
                    btnElem.innerText = data.active ? 'Activo' : 'Inactivo';
                    btnElem.style.backgroundColor = data.active ? 'var(--success)' : 'var(--gray-400)';
                    showToast(data.message, 'success');
                } else {
                    showToast(data.message || 'Error al cambiar estado', 'error');
                }
            } catch (e) {
                showToast('Error de comunicación con el servidor', 'error');
            }
        }

        async function confirmDelete(event, message, formElem) {
            if (event) event.preventDefault();

            const executeDelete = async () => {
                const submitBtn = formElem.querySelector('button[type="submit"]');
                if (submitBtn) submitBtn.disabled = true;

                try {
                    const formData = new FormData(formElem);
                    const actionUrl = formElem.getAttribute('action') || formElem.action;
                    const resp = await fetch(actionUrl, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    });

                    const data = await resp.json();
                    if (data.success) {
                        showToast(data.message || 'Registro eliminado correctamente', 'success');
                        const row = formElem.closest('tr');
                        if (row) {
                            row.style.transition = 'all 0.3s ease';
                            row.style.opacity = '0';
                            setTimeout(() => row.remove(), 300);
                        } else {
                            setTimeout(() => window.location.reload(), 500);
                        }
                    } else {
                        showToast(data.message || 'No se pudo eliminar el registro', 'error');
                        if (submitBtn) submitBtn.disabled = false;
                    }
                } catch (e) {
                    showToast('Error de comunicación con el servidor', 'error');
                    if (submitBtn) submitBtn.disabled = false;
                }
            };

            if (typeof alertify !== 'undefined') {
                alertify.confirm('Confirmar Eliminación', message,
                    function () { executeDelete(); },
                    function () { showToast('Eliminación cancelada', 'info'); }
                ).set('labels', { ok: 'Sí, eliminar', cancel: 'Cancelar' });
            } else if (confirm(message)) {
                executeDelete();
            }
        }

        function setupAjaxForms() {
            const ajaxForms = [
                { id: 'form-crear-producto', modalId: 'modal-producto' },
                { id: 'form-editar-producto', modalId: 'modal-editar-producto' },
                { id: 'form-crear-proveedor', modalId: 'modal-crear-proveedor' },
                { id: 'form-editar-proveedor', modalId: 'modal-editar-proveedor' },
                { id: 'form-crear-pedido-venta', modalId: 'modal-crear-pedido-venta' },
                { id: 'form-editar-pedido-venta', modalId: 'modal-editar-pedido-venta' },
                { id: 'form-crear-pedido-proveedor', modalId: 'modal-crear-pedido-proveedor' },
                { id: 'form-editar-pedido-proveedor', modalId: 'modal-editar-pedido-proveedor' }
            ];

            ajaxForms.forEach(item => {
                const formElem = document.getElementById(item.id);
                if (!formElem) return;

                formElem.addEventListener('submit', async function(e) {
                    e.preventDefault();

                    if (!formElem.checkValidity()) {
                        formElem.reportValidity();
                        return;
                    }

                    const submitBtn = formElem.querySelector('button[type="submit"]');
                    const origText = submitBtn ? submitBtn.innerText : '';
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerText = 'Guardando...';
                    }

                    try {
                        const formData = new FormData(formElem);
                        const actionUrl = formElem.getAttribute('action') || window.location.href;
                        const resp = await fetch(actionUrl, {
                            method: 'POST',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            body: formData
                        });

                        const data = await resp.json();

                        if (data.success) {
                            showToast(data.message || 'Operación realizada con éxito', 'success');
                            if (item.modalId) {
                                const modal = document.getElementById(item.modalId);
                                if (modal) modal.style.display = 'none';
                            }
                            setTimeout(() => {
                                window.location.reload();
                            }, 500);
                        } else {
                            showToast(data.message || 'Ocurrió un error al procesar la solicitud.', 'error');
                        }
                    } catch (err) {
                        showToast('Error de conexión al procesar la solicitud.', 'error');
                    } finally {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerText = origText;
                        }
                    }
                });
            });
        }

        function switchPedidosTab(tabName) {
            const contentVentas = document.getElementById('content-pedidos-ventas');
            const contentProveedores = document.getElementById('content-pedidos-proveedores');
            const btnVentas = document.getElementById('tab-btn-pedidos-ventas');
            const btnProveedores = document.getElementById('tab-btn-pedidos-proveedores');
            const btnTopVenta = document.getElementById('btn-top-nuevo-pedido-venta');
            const btnTopProveedor = document.getElementById('btn-top-nuevo-pedido-proveedor');

            if (!contentVentas || !contentProveedores) return;

            if (tabName === 'proveedores') {
                contentVentas.style.display = 'none';
                contentProveedores.style.display = 'block';

                btnProveedores.style.background = 'var(--purple-700)';
                btnProveedores.style.color = 'white';

                btnVentas.style.background = 'transparent';
                btnVentas.style.color = 'var(--purple-900)';

                if (btnTopVenta) btnTopVenta.style.display = 'none';
                if (btnTopProveedor) btnTopProveedor.style.display = 'inline-flex';
            } else {
                contentProveedores.style.display = 'none';
                contentVentas.style.display = 'block';

                btnVentas.style.background = 'var(--purple-700)';
                btnVentas.style.color = 'white';

                btnProveedores.style.background = 'transparent';
                btnProveedores.style.color = 'var(--purple-900)';

                if (btnTopVenta) btnTopVenta.style.display = 'inline-flex';
                if (btnTopProveedor) btnTopProveedor.style.display = 'none';
            }
        }

        function exportMovimientosToExcel() {
            const table = document.getElementById('tableHistorial');
            if (!table) {
                alert('No se encontró la tabla de historial de movimientos.');
                return;
            }

            const wb = XLSX.utils.table_to_book(table, { sheet: "Historial de Movimientos" });
            XLSX.writeFile(wb, "Historial_Movimientos_LentSoft.xlsx");
        }

        function openEditSalesOrderModal(id, numero, cliente, producto, cantidad, precio, estado, notas) {
            document.getElementById('editSalesOrderId').value = id;
            document.getElementById('editSalesOrderNumero').value = numero;
            document.getElementById('editSalesOrderCliente').value = cliente;
            document.getElementById('editSalesOrderProducto').value = producto;
            document.getElementById('editSalesOrderCantidad').value = cantidad;
            document.getElementById('editSalesOrderPrecio').value = precio;
            document.getElementById('editSalesOrderEstado').value = estado.toLowerCase();
            document.getElementById('editSalesOrderNotas').value = notas || '';
            document.getElementById('modal-editar-pedido-venta').style.display = 'flex';
        }

        function openEditSupplierOrderModal(id, numero, supplierId, productId, cantidad, precio, estado, notas) {
            document.getElementById('editSupplierOrderId').value = id;
            document.getElementById('editSupplierOrderNumero').value = numero;
            document.getElementById('editSupplierOrderSupplierId').value = supplierId;
            document.getElementById('editSupplierOrderProductId').value = productId;
            document.getElementById('editSupplierOrderCantidad').value = cantidad;
            document.getElementById('editSupplierOrderPrecio').value = precio;
            document.getElementById('editSupplierOrderEstado').value = estado.toLowerCase();
            document.getElementById('editSupplierOrderNotas').value = notas || '';
            document.getElementById('modal-editar-pedido-proveedor').style.display = 'flex';
        }

        document.addEventListener("DOMContentLoaded", function() {
            setupAjaxForms();
            const urlParams = new URLSearchParams(window.location.search);
            const subtab = urlParams.get('subtab');
            if (subtab && ['productos', 'proveedores', 'historial', 'pedidos'].includes(subtab)) {
                switchInventorySubTab(subtab);
            }
            const innerTab = urlParams.get('innerTab');
            if (innerTab === 'proveedores') {
                switchPedidosTab('proveedores');
            } else {
                switchPedidosTab('ventas');
            }
        });
    </script>
}

<!-- MODALES DE PEDIDOS -->
<div id="modal-crear-pedido-venta" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
    <div class="card" style="width: 100%; max-width: 550px; max-height: 90vh; overflow-y: auto; background: white; border-radius: 0.75rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--purple-100);">
