            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Optómetra Asignado *</label>
                <select name="OptometraId" id="admin-edit-cita-optometraid" class="form-input" required style="width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
