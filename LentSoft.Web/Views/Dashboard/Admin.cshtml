        function filterTableByValue(inputId, tableId, value) {
            if (tableId === 'tableProducts') {
                const valLower = (value || '').toLowerCase().trim();
                if (valLower === 'activo' || valLower === 'inactivo') {
                    setProductStatusFilter(valLower);
                } else if (['lentes-sol', 'monturas', 'lentes-contacto', 'lentes-graduados', 'accesorios'].includes(valLower)) {
                    setProductCategoryFilter(valLower);
                } else {
                    const input = document.getElementById(inputId);
                    if (input) input.value = value;
                    productFilters.search = valLower;
                    applyProductFilters();
                }
                document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
                return;
            }

            const input = document.getElementById(inputId);
            if (input) {
                input.value = value;
                filterTable(inputId, tableId);
            }
            document.querySelectorAll('[id^="filter-menu-"], [id^="category-menu-"]').forEach(m => m.style.display = 'none');
        }

