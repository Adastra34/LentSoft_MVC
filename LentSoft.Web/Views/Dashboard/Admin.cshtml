        <form asp-controller="Dashboard" asp-action="CreateAppointment" method="post" style="display:flex; flex-direction:column; gap:1rem;">
            <div class="form-group">
                <label class="form-label">Seleccionar Paciente</label>
                <select name="UserId" class="form-input" required>
                    @foreach (var cli in Model.Clientes)
                    {
                        <option value="@cli.Id">@cli.Nombre (@cli.Email)</option>
