                        <select id="editInvoiceMetodoPago" name="MetodoPago" class="form-input" style="width: 100%; padding: 0.5rem;">
                            <option value="Efectivo">Efectivo</option>
                            <option value="Tarjeta">Tarjeta Débito/Crédito</option>
                            <option value="Transferencia">Transferencia / PSE</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row" style="display: flex; gap: 1rem;">
                <div style="flex: 1;">
                    <div class="form-group">
                        <label class="form-label" style="font-weight: 600;">Subtotal ($)</label>
                        <input id="editInvoiceSubtotal" name="Subtotal" type="number" step="0.01" class="form-input" style="width: 100%; padding: 0.5rem;" required />
                    </div>
                </div>
                <div style="flex: 1;">
                    <div class="form-group">
                        <label class="form-label" style="font-weight: 600;">Impuestos ($)</label>
                        <input id="editInvoiceImpuestos" name="Impuestos" type="number" step="0.01" class="form-input" style="width: 100%; padding: 0.5rem;" required />
                    </div>
                </div>
                <div style="flex: 1;">
                    <div class="form-group">
                        <label class="form-label" style="font-weight: 600;">Total ($)</label>
                        <input id="editInvoiceTotal" name="Total" type="number" step="0.01" class="form-input" style="width: 100%; padding: 0.5rem;" required />
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <button type="button" onclick="document.getElementById('modal-edit-factura').style.display='none'" class="btn btn-outline" style="flex: 1;">Cancelar</button>
                <button type="submit" class="btn btn-primary" style="flex: 1; background-color: var(--purple-600); border: none; color: white;">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<script>
    function filterTable(inputId, tableId) {
        const input = document.getElementById(inputId);
        const filter = input.value.toLowerCase();
        const table = document.getElementById(tableId);
        const trs = table.getElementsByTagName('tr');

        for (let i = 1; i < trs.length; i++) {
            let show = false;
            const tds = trs[i].getElementsByTagName('td');
            for (let j = 0; j < tds.length; j++) {
                if (tds[j] && tds[j].textContent.toLowerCase().includes(filter)) {
                    show = true;
                    break;
                }
            }
            trs[i].style.display = show ? '' : 'none';
        }
    }

    function updateNewInvoiceAmounts(selectElem) {
        const selectedOpt = selectElem.options[selectElem.selectedIndex];
        const total = parseFloat(selectedOpt.getAttribute('data-total') || '0');
        if (total > 0) {
            const subtotal = (total / 1.19).toFixed(2);
            const impuestos = (total - subtotal).toFixed(2);
            document.getElementById('newInvoiceSubtotal').value = subtotal;
            document.getElementById('newInvoiceImpuestos').value = impuestos;
            document.getElementById('newInvoiceTotal').value = total.toFixed(2);
        }
    }

    function openEditInvoiceModal(id, numero, orderId, subtotal, impuestos, total, estado, metodoPago, cliente) {
        document.getElementById('editInvoiceId').value = id;
        document.getElementById('editInvoiceOrderId').value = orderId;
        document.getElementById('editInvoiceNumeroDisplay').innerText = 'Factura ' + numero;
        document.getElementById('editInvoiceClienteDisplay').innerText = 'Cliente: ' + cliente;
        document.getElementById('editInvoiceEstado').value = estado.toLowerCase();
        document.getElementById('editInvoiceMetodoPago').value = metodoPago || 'Efectivo';
        document.getElementById('editInvoiceSubtotal').value = subtotal;
        document.getElementById('editInvoiceImpuestos').value = impuestos;
        document.getElementById('editInvoiceTotal').value = total;
        document.getElementById('modal-edit-factura').style.display = 'flex';
    }

    function confirmDeleteInvoice(id, numero) {
        if (typeof alertify !== 'undefined') {
            alertify.confirm(
                'Eliminar Factura',
                '¿Está seguro de que desea eliminar la factura <strong>' + numero + '</strong>? Esta acción no se puede deshacer.',
                function () {
                    executeInvoiceDelete(id);
                },
                function () {
                    alertify.message('Eliminación cancelada');
                }
            ).set('labels', { ok: 'Sí, eliminar', cancel: 'Cancelar' });
        } else if (confirm('¿Está seguro de eliminar la factura ' + numero + '?')) {
            executeInvoiceDelete(id);
        }
    }

    function executeInvoiceDelete(id) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Invoice/Delete/' + id;
        
        const tokenElem = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenElem) {
            const hiddenToken = document.createElement('input');
            hiddenToken.type = 'hidden';
            hiddenToken.name = '__RequestVerificationToken';
            hiddenToken.value = tokenElem.value;
            form.appendChild(hiddenToken);
        }

        document.body.appendChild(form);
        form.submit();
    }

    function openEditProductModalFromBtn(btn) {
        document.getElementById('editProductId').value = btn.getAttribute('data-id');
        document.getElementById('editProductNombre').value = btn.getAttribute('data-nombre') || '';
        document.getElementById('editProductCategoriaId').value = btn.getAttribute('data-categoria-id') || '';
        document.getElementById('editProductMarca').value = btn.getAttribute('data-marca') || '';
        document.getElementById('editProductPrecio').value = btn.getAttribute('data-precio') || '0';
        document.getElementById('editProductPrecioDescuento').value = btn.getAttribute('data-precio-descuento') || '';
        document.getElementById('editProductStock').value = btn.getAttribute('data-stock') || '0';
        document.getElementById('editProductActivo').checked = btn.getAttribute('data-activo') === 'true';
        document.getElementById('editProductImagenUrl').value = btn.getAttribute('data-imagen-url') || '';
        document.getElementById('editProductDescripcion').value = btn.getAttribute('data-descripcion') || '';
        document.getElementById('modal-edit-producto').style.display = 'flex';
    }

    function openEditProductModal(id, nombre, categoriaId, marca, precio, precioDescuento, stock, imagenUrl, activo, descripcion) {
        document.getElementById('editProductId').value = id;
        document.getElementById('editProductNombre').value = nombre || '';
        document.getElementById('editProductCategoriaId').value = categoriaId || '';
        document.getElementById('editProductMarca').value = marca || '';
        document.getElementById('editProductPrecio').value = precio || 0;
        document.getElementById('editProductPrecioDescuento').value = (precioDescuento !== null && precioDescuento !== undefined && precioDescuento !== 'null') ? precioDescuento : '';
        document.getElementById('editProductStock').value = stock || 0;
        document.getElementById('editProductActivo').checked = (activo === true || activo === 'true');
        document.getElementById('editProductImagenUrl').value = imagenUrl || '';
        document.getElementById('editProductDescripcion').value = descripcion || '';
        document.getElementById('modal-edit-producto').style.display = 'flex';
    }

    function openEditProveedorModalFromBtn(btn) {
        document.getElementById('editProveedorId').value = btn.getAttribute('data-id');
        document.getElementById('editProveedorNombre').value = btn.getAttribute('data-nombre') || '';
        document.getElementById('editProveedorContacto').value = btn.getAttribute('data-contacto') || '';
        document.getElementById('editProveedorTelefono').value = btn.getAttribute('data-telefono') || '';
        document.getElementById('editProveedorEmail').value = btn.getAttribute('data-email') || '';
        document.getElementById('editProveedorTipoProducto').value = btn.getAttribute('data-tipo-producto') || '';
        document.getElementById('editProveedorEstado').value = (btn.getAttribute('data-estado') || 'activo').toLowerCase();
        document.getElementById('modal-edit-proveedor').style.display = 'flex';
    }

    function openEditProveedorModal(id, nombre, contacto, telefono, email, tipoProducto, estado) {
        document.getElementById('editProveedorId').value = id;
        document.getElementById('editProveedorNombre').value = nombre || '';
        document.getElementById('editProveedorContacto').value = contacto || '';
        document.getElementById('editProveedorTelefono').value = telefono || '';
        document.getElementById('editProveedorEmail').value = email || '';
        document.getElementById('editProveedorTipoProducto').value = tipoProducto || '';
        document.getElementById('editProveedorEstado').value = (estado || 'activo').toLowerCase();
        document.getElementById('modal-edit-proveedor').style.display = 'flex';
    }

    function filterClientSideFacturas(filterVal) {
        const filter = filterVal.toLowerCase();
        const table = document.getElementById('tableFacturas');
        if (!table) return;
        const trs = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < trs.length; i++) {
            let show = false;
            const tds = trs[i].getElementsByTagName('td');
            if (tds.length <= 1) continue;
            for (let j = 0; j < tds.length - 1; j++) {
                if (tds[j] && tds[j].textContent.toLowerCase().includes(filter)) {
                    show = true;
                    break;
                }
            }
            trs[i].style.display = show ? '' : 'none';
        }
    }
</script>
