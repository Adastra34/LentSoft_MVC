<!-- Modal Crear Cliente -->
<div id="modal-crear-cliente" style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; padding: 1rem;" onclick="if(event.target === this) this.style.display='none'">
    <div class="card" style="width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto; background: white; border-radius: 0.75rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--purple-100);">
            <h2 style="color: var(--purple-900); margin: 0; font-size: 1.25rem; font-weight: 700;">✨ Nuevo Cliente</h2>
            <button type="button" onclick="document.getElementById('modal-crear-cliente').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-500);">&times;</button>
        </div>
        <form asp-controller="User" asp-action="CreateClient" method="post" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            @Html.AntiForgeryToken()
            <div style="display: flex; gap: 1rem;">
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Nombre *</label>
                    <input name="Nombre" type="text" class="form-input" required minlength="2" maxlength="100" placeholder="Ej: Juan" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
                </div>
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Apellido *</label>
                    <input name="Apellido" type="text" class="form-input" required minlength="2" maxlength="100" placeholder="Ej: Pérez" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
                </div>
            </div>
            <div style="display: flex; gap: 1rem;">
                <div style="width: 130px;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Tipo Doc. *</label>
                    <select name="TipoDocumento" class="form-input" required style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);">
                        <option value="CC">CC</option>
                        <option value="CE">CE</option>
                        <option value="TI">TI</option>
                        <option value="Pasaporte">Pasaporte</option>
                    </select>
                </div>
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Número de Documento *</label>
                    <input name="NumeroDocumento" type="text" class="form-input" required maxlength="30" placeholder="Ej: 1020304050" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
                </div>
            </div>
            <div style="display: flex; gap: 1rem;">
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Correo Electrónico *</label>
                    <input name="Email" type="email" class="form-input" required maxlength="100" placeholder="cliente@correo.com" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
                </div>
                <div style="flex: 1;">
                    <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Teléfono</label>
                    <input name="Telefono" type="tel" class="form-input" placeholder="Ej: 3001234567" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
                </div>
            </div>
            <div>
                <label class="form-label" style="font-weight: 600; color: var(--gray-700); font-size: 0.85rem;">Contraseña Inicial</label>
                <input name="Password" type="password" class="form-input" placeholder="Opcional (si se deja vacío, se genera una automáticamente)" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.375rem; border: 1px solid var(--purple-300);" />
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('modal-crear-cliente').style.display='none'" class="btn" style="background: var(--gray-100); color: var(--gray-700); padding: 0.5rem 1rem;">Cancelar</button>
                <button type="submit" class="btn btn-primary" style="padding: 0.5rem 1.25rem;">Crear Cliente</button>
            </div>
        </form>
    </div>
</div>

