@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<main style="min-height: calc(100vh - 140px); background: linear-gradient(135deg, var(--purple-50), var(--purple-100)); display: flex; align-items: center; justify-content: center; padding: 2.5rem 1rem;">
    <div style="width: 100%; max-width: 480px; background: white; border-radius: 1.25rem; box-shadow: var(--shadow-xl); padding: 3rem 2.5rem;">

        <!-- Link Volver -->
        <a asp-controller="Auth" asp-action="Login" style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--purple-700); font-size: 0.875rem; font-weight: 600; margin-bottom: 1.75rem;">
            ← Volver al inicio de sesión
        </a>

        <!-- Título -->
        <h1 style="text-align: center; color: var(--purple-700); font-size: 1.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; font-family: var(--font-primary); margin-bottom: 0.75rem;">
            Recuperar Contraseña
        </h1>

        <!-- Texto descriptivo -->
        <p style="text-align: center; color: var(--gray-500); font-size: 0.9rem; line-height: 1.6; margin-bottom: 2rem;">
            Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.
        </p>

        <!-- Mensaje de éxito si existe -->
        @if (ViewBag.SuccessMessage != null)
        {
            <div style="background-color: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 0.75rem; padding: 1rem 1.25rem; margin-bottom: 1.5rem; text-align: center;">
                <p style="color: #065F46; font-size: 0.875rem; font-weight: 500; margin: 0;">
                    ✅ @ViewBag.SuccessMessage
                </p>
            </div>
        }

        <!-- Mensaje de error si existe -->
        @if (ViewBag.ErrorMessage != null)
        {
            <div style="background-color: #FEF2F2; border: 1px solid #FECACA; border-radius: 0.75rem; padding: 1rem 1.25rem; margin-bottom: 1.5rem; text-align: center;">
                <p style="color: #991B1B; font-size: 0.875rem; font-weight: 500; margin: 0;">
                    ❌ @ViewBag.ErrorMessage
                </p>
            </div>
        }

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post" style="display: flex; flex-direction: column; gap: 1.25rem;">
            @Html.AntiForgeryToken()

            <!-- Email -->
            <div class="form-group" style="margin-bottom: 0;">
                <div style="position: relative;">
                    <span style="position: absolute; left: 1.1rem; top: 50%; transform: translateY(-50%); font-size: 1.1rem; color: var(--gray-400);">✉️</span>
                    <input type="email" name="email" placeholder="Correo electrónico" class="form-input" required
                           style="border-radius: 9999px; padding: 0.75rem 1.25rem 0.75rem 2.75rem; border: 1.5px solid var(--border); width: 100%;" />
                </div>
            </div>

            <!-- Botón Submit -->
            <button type="submit" class="btn"
                    style="width: 100%; background: linear-gradient(135deg, var(--purple-600), var(--purple-700)); color: white; border: none; border-radius: 9999px; padding: 0.85rem; font-size: 0.95rem; font-weight: 700; cursor: pointer; transition: opacity 0.2s; letter-spacing: 0.3px;"
                    onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                Enviar enlace de recuperación
            </button>
        </form>
    </div>
</main>
