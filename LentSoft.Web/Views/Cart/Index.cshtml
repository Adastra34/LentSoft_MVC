@model LentSoft.Web.Models.Entities.Cart
@{
    ViewData["Title"] = "Carrito de Compras";
    var cartItems = Model?.CartItems.ToList() ?? new List<CartItem>();
    var totalGeneral = cartItems.Sum(ci => ci.Subtotal);
}

<main style="padding: 2.5rem 0; min-height: 80vh; background: var(--purple-50); font-family: var(--font-secondary);">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
        
        <h1 style="color: var(--purple-900); font-size: 2rem; font-weight: 800; font-family: var(--font-primary); margin-bottom: 2rem;" data-i18n="cart.title">
            Tu Carrito de Compras
        </h1>

        <div id="cartContentWrapper">
            @if (!cartItems.Any())
            {
                <div style="text-align: center; padding: 4rem 2rem; background: white; border-radius: 1.25rem; box-shadow: var(--shadow-md); border: 1.5px solid var(--gray-100);">
                    <div style="font-size: 4.5rem; margin-bottom: 1.5rem;">🛒</div>
                    <h3 style="color: var(--purple-900); font-family: var(--font-primary); font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem;" data-i18n="cart.empty">Tu carrito está vacío</h3>
                    <p style="color: var(--gray-500); font-size: 0.95rem; margin-bottom: 1.5rem; max-width: 320px; margin-left: auto; margin-right: auto;" data-i18n="cart.empty.desc">
                        Parece que aún no has agregado productos. Explora nuestro catálogo y encuentra lo que necesitas.
                    </p>
                    <a asp-controller="Product" asp-action="Tienda" class="btn" style="background: linear-gradient(135deg, var(--purple-600), var(--purple-800)); color: white; padding: 0.75rem 2rem; border-radius: 9999px; font-weight: 700; font-size: 0.95rem; box-shadow: 0 4px 12px rgba(124,58,237,0.3); display: inline-block; text-decoration: none;" data-i18n="cart.goshop">
                        Ir a la Tienda
                    </a>
                </div>
            }
            else
            {
                <div style="display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 2.5rem; align-items: start;">
                    
                    <!-- Left: Cart Items List -->
                    <div style="background: white; border-radius: 1.25rem; box-shadow: var(--shadow-md); overflow: hidden; border: 1px solid var(--gray-100);">
                        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                            <thead>
                                <tr style="background: var(--purple-100); border-bottom: 1.5px solid var(--gray-200); color: var(--purple-900); font-weight: 700;">
                                    <th style="padding: 1.25rem 1rem;" data-i18n="cart.product">Producto</th>
                                    <th style="padding: 1.25rem 1rem; text-align: center;" data-i18n="cart.price">Precio</th>
                                    <th style="padding: 1.25rem 1rem; text-align: center;" data-i18n="cart.qty">Cantidad</th>
                                    <th style="padding: 1.25rem 1rem; text-align: right;" data-i18n="cart.subtotal">Subtotal</th>
                                    <th style="padding: 1.25rem 1rem; text-align: center;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in cartItems)
                                {
                                    <tr id="cart-item-@item.ProductId" style="border-bottom: 1px solid var(--gray-100); transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='var(--purple-50)'" onmouseout="this.style.backgroundColor='transparent'">
                                        <!-- Product Details -->
                                        <td style="padding: 1.25rem 1rem; display: flex; align-items: center; gap: 1rem;">
                                            <div style="width: 60px; height: 60px; border-radius: 0.5rem; background: var(--gray-50); display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid var(--gray-200); flex-shrink: 0;">
                                                @if (item.Product.ImagenUrl != null)
                                                {
                                                    <img src="@item.Product.ImagenUrl" alt="@item.Product.Nombre" style="max-width: 100%; max-height: 100%; object-fit: contain; padding: 0.25rem;" />
                                                }
                                                else
                                                {
                                                    <span style="font-size: 1.5rem;">👓</span>
                                                }
                                            </div>
                                            <div>
                                                <a href="/Product/Details/@item.ProductId" style="color: var(--purple-900); font-weight: 700; text-decoration: none; font-family: var(--font-primary); font-size: 0.95rem; line-height: 1.3; display: block;" onmouseover="this.style.color='var(--purple-600)'" onmouseout="this.style.color='var(--purple-900)'" data-i18n-product-name="@item.Product.Nombre">
                                                    @item.Product.Nombre
                                                </a>
                                                <span style="color: var(--gray-400); font-size: 0.75rem; text-transform: uppercase; font-weight: 600;"><span data-i18n="cart.brand">Marca:</span> @(item.Product.Marca ?? "LentSoft")</span>
                                            </div>
                                        </td>
                                        
                                        <!-- Price -->
                                        <td style="padding: 1.25rem 1rem; text-align: center; font-weight: 600; color: var(--gray-700);">
                                            @item.PrecioUnitario.ToString("C")
                                        </td>
                                        
                                        <!-- Quantity controls -->
                                        <td style="padding: 1.25rem 1rem; text-align: center;">
                                            <div style="display: inline-flex; align-items: center; border: 1.5px solid var(--gray-300); border-radius: 9999px; overflow: hidden; background: white;">
                                                <button type="button" onclick="changeQuantity(@item.ProductId, -1)" style="border: none; background: transparent; width: 32px; height: 32px; font-weight: 700; cursor: pointer; color: var(--gray-600); outline: none; transition: background 0.2s;" onmouseover="this.style.background='var(--gray-100)'" onmouseout="this.style.background='transparent'">−</button>
                                                <input type="text" id="qty-@item.ProductId" value="@item.Cantidad" readonly style="width: 32px; text-align: center; border: none; font-weight: 700; font-size: 0.85rem; color: var(--purple-900); outline: none; background: transparent;" />
                                                <button type="button" onclick="changeQuantity(@item.ProductId, 1)" style="border: none; background: transparent; width: 32px; height: 32px; font-weight: 700; cursor: pointer; color: var(--gray-600); outline: none; transition: background 0.2s;" onmouseover="this.style.background='var(--gray-100)'" onmouseout="this.style.background='transparent'">+</button>
                                            </div>
                                        </td>
                                        
                                        <!-- Subtotal -->
                                        <td style="padding: 1.25rem 1rem; text-align: right; font-weight: 700; color: var(--purple-700); font-size: 0.95rem;" id="subtotal-@item.ProductId">
                                            @item.Subtotal.ToString("C")
                                        </td>
                                        
                                        <!-- Delete item -->
                                        <td style="padding: 1.25rem 1rem; text-align: center;">
                                            <button type="button" onclick="confirmRemove(@item.ProductId)" style="border: none; background: transparent; font-size: 1.2rem; cursor: pointer; color: var(--error); transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.15)'" onmouseout="this.style.transform='scale(1)'" title="Eliminar artículo">
                                                🗑️
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Right: Summary Box -->
                    <div style="background: white; border-radius: 1.25rem; padding: 1.75rem; box-shadow: var(--shadow-md); border: 1px solid var(--gray-100); display: flex; flex-direction: column; gap: 1.5rem;">
                        <h3 style="color: var(--purple-900); font-family: var(--font-primary); font-size: 1.25rem; font-weight: 700; margin: 0; border-bottom: 1.5px solid var(--gray-100); padding-bottom: 0.75rem;" data-i18n="cart.summary">
                            Resumen de Compra
                        </h3>

                        <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.9rem; color: var(--gray-700);">
                            <div style="display: flex; justify-content: space-between;">
                                <span data-i18n="cart.products">Productos</span>
                                <span style="font-weight: 600;" id="summaryTotalCount">@cartItems.Sum(ci => ci.Cantidad) unidades</span>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span data-i18n="cart.shipping">Envío</span>
                                <span style="color: var(--success); font-weight: 700;" data-i18n="cart.free">Gratis</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; border-top: 1.5px solid var(--gray-100); padding-top: 1rem; margin-top: 0.5rem;">
                                <strong style="color: var(--purple-900); font-size: 1.1rem; font-family: var(--font-primary);" data-i18n="cart.total">Total General</strong>
                                <strong style="color: var(--purple-700); font-size: 1.25rem;" id="summaryTotalGeneral">@totalGeneral.ToString("C")</strong>
                            </div>
                        </div>

                        <a asp-controller="Checkout" asp-action="Index" class="btn" style="background: linear-gradient(135deg, var(--purple-600), var(--purple-800)); color: white; border: none; border-radius: 0.75rem; padding: 0.9rem; font-size: 1rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: transform 0.2s; box-shadow: 0 4px 12px rgba(124,58,237,0.3); text-align: center; text-decoration: none;"
                                onmouseover="this.style.transform='translateY(-2px)'"
                                onmouseout="this.style.transform='translateY(0)'" data-i18n="cart.checkout">
                            Proceder al pago 💳
                        </a>
                        
                        <a asp-controller="Product" asp-action="Tienda" style="color: var(--purple-600); text-align: center; font-size: 0.85rem; font-weight: 600; text-decoration: none;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'" data-i18n="cart.continue">
                            ← Continuar Comprando
                        </a>
                    </div>

                </div>
            }
        </div>

    </div>
</main>

@section Scripts {
    <script>
        // Update quantities asynchronously via AJAX
        async function changeQuantity(productId, delta) {
            const qtyInput = document.getElementById('qty-' + productId);
            if (!qtyInput) return;

            let currentQty = parseInt(qtyInput.value);
            let newQty = currentQty + delta;
            
            if (newQty <= 0) {
                confirmRemove(productId);
                return;
            }

            try {
                const resp = await fetch('/Cart/UpdateQuantity', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'productId=' + productId + '&cantidad=' + newQty
                });
                const data = await resp.json();
                if (data.success) {
                    qtyInput.value = data.cantidad;
                    document.getElementById('subtotal-' + productId).textContent = data.subtotal;
                    document.getElementById('summaryTotalGeneral').textContent = data.totalGeneral;
                    updateItemCountSummary();
                } else {
                    alertify.error('Error al actualizar cantidad');
                }
            } catch (e) {
                console.error(e);
            }
        }

        // Helper to count total quantity in the client UI
        function updateItemCountSummary() {
            let total = 0;
            const qtyInputs = document.querySelectorAll('input[id^="qty-"]');
            qtyInputs.forEach(input => {
                total += parseInt(input.value);
            });
            document.getElementById('summaryTotalCount').textContent = total + ' unidades';
        }

        // Prompt confirmation for removal
        function confirmRemove(productId) {
            alertify.confirm('Eliminar artículo', '¿Estás seguro de que deseas quitar este artículo del carrito?', 
                async function() {
                    try {
                        const resp = await fetch('/Cart/RemoveItem', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: 'productId=' + productId
                        });
                        const data = await resp.json();
                        if (data.success) {
                            // Fade out row
                            const row = document.getElementById('cart-item-' + productId);
                            if (row) {
                                row.style.opacity = '0';
                                setTimeout(() => {
                                    row.remove();
                                    // Check if cart is now empty
                                    if (data.count === 0) {
                                        renderEmptyCartState();
                                    } else {
                                        document.getElementById('summaryTotalGeneral').textContent = data.totalGeneral;
                                        updateItemCountSummary();
                                    }
                                }, 300);
                            }
                            alertify.success('Artículo eliminado');
                        }
                    } catch (e) {
                        console.error(e);
                    }
                }, 
                function() {}
            ).set('labels', {ok:'Quitar', cancel:'Cancelar'});
        }

        // Render empty cart dynamically
        function renderEmptyCartState() {
            const wrapper = document.getElementById('cartContentWrapper');
            wrapper.innerHTML = `
                <div style="text-align: center; padding: 4rem 2rem; background: white; border-radius: 1.25rem; box-shadow: var(--shadow-md); border: 1.5px solid var(--gray-100);">
                    <div style="font-size: 4.5rem; margin-bottom: 1.5rem;">🛒</div>
                    <h3 style="color: var(--purple-900); font-family: var(--font-primary); font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem;">Tu carrito está vacío</h3>
                    <p style="color: var(--gray-500); font-size: 0.95rem; margin-bottom: 1.5rem; max-width: 320px; margin-left: auto; margin-right: auto;">
                        Parece que aún no has agregado productos. Explora nuestro catálogo y encuentra lo que necesitas.
                    </p>
                    <a href="/Product/Tienda" class="btn" style="background: linear-gradient(135deg, var(--purple-600), var(--purple-800)); color: white; padding: 0.75rem 2rem; border-radius: 9999px; font-weight: 700; font-size: 0.95rem; box-shadow: 0 4px 12px rgba(124,58,237,0.3); display: inline-block; text-decoration: none;">
                        Ir a la Tienda
                    </a>
                </div>
            `;
        }
    </script>
}
