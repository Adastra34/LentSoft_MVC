# ── Configuración de SQL Server ──
MSSQL_SA_PASSWORD=TuPasswordFuerte123!

# ── Cadena de Conexión (usar el nombre del servicio de compose: sqlserver) ──
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=LentSoftDB;User Id=sa;Password=TuPasswordFuerte123!;TrustServerCertificate=True;

# ── Claves Secretas JWT (mínimo 32 caracteres cada una) ──
PasswordResetJwt__SecretKey=tu-clave-secreta-para-password-reset-minimo-32-chars
SaleConfirmationJwt__SecretKey=tu-clave-secreta-para-confirmacion-venta-min-32
MobileJwt__SecretKey=tu-clave-secreta-para-mobile-jwt-api-minimo-32-chars

# ── API Key de Google Gemini ──
Gemini__ApiKey=tu-gemini-api-key-aqui

# ── Configuración de Correo Electrónico (SMTP) ──
EmailSettings__SmtpServer=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUser=tu-correo@gmail.com
EmailSettings__SmtpPassword=tu-password-de-aplicacion-smtp
EmailSettings__FromEmail=tu-correo@gmail.com
EmailSettings__FromName=LentSoft
